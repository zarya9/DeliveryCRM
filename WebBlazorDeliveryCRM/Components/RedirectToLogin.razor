@using System.Security.Claims
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

<p class="text-muted small p-3">Проверка доступа…</p>

@code {
    private bool _handled;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _handled)
            return;
        _handled = true;

        var path = AuthRouteHelper.GetPathOnly(Navigation.Uri);
        if (AuthRouteHelper.IsAuthPage(path))
            return;

        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
        {
            var role = state.User.FindFirst(ClaimTypes.Role)?.Value
                       ?? state.User.FindFirst("role")?.Value;
            if (AuthRouteHelper.CanAccessPathForRole(role, path))
            {
                TryNavigate(path);
                return;
            }

            TryNavigate("/access-denied");
            return;
        }

        var returnUrl = Uri.EscapeDataString(path);
        TryNavigate($"/login?ReturnUrl={returnUrl}");
    }

    private void TryNavigate(string url)
    {
        try
        {
            Navigation.NavigateTo(url, replace: true);
        }
        catch (Microsoft.AspNetCore.Components.NavigationException)
        {
            // Blazor debug: redirect interrupts render.
        }
    }
}
