@inject NavigationManager Navigation

<p>Перенаправление на страницу входа… <a href="/login">Войти</a></p>

@code {
    protected override void OnInitialized()
    {
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        var path = "/" + relative.TrimStart('/');
        if (path.StartsWith("/login", StringComparison.OrdinalIgnoreCase))
            return;
        try
        {
            Navigation.NavigateTo("/login", forceLoad: true, replace: true);
        }
        catch (Microsoft.AspNetCore.Components.NavigationException)
        {
            // In some debug modes Blazor throws NavigationException to interrupt rendering on redirect.
        }
    }
}
