@using WebBlazorDeliveryCRM.Components.Shared
@inject CustomAuthenticationStateProvider AuthState
@inject ChatHubClientService ChatHub
@inject ChatUnreadStateService ChatUnreadState
@inject NavigationManager Navigation
@implements IDisposable

<div class="sidebar-header">
    <div class="d-flex align-items-center gap-2">
        <HugeIcon Name="delivery-truck-01" CssClass="sidebar-title-icon" />
        <h2 class="sidebar-title">Курьер</h2>
    </div>
</div>
<nav class="sidebar-nav">
    <NavLink href="/courier/shift" class="sidebar-link" Match="NavLinkMatch.All">
        <HugeIcon Name="calendar-03" CssClass="icon" /> <span class="sidebar-label">Смена и геолокация</span>
    </NavLink>
    <NavLink href="/courier/route" class="sidebar-link">
        <HugeIcon Name="route-02" CssClass="icon" /> <span class="sidebar-label">Мой маршрут</span>
    </NavLink>
    <NavLink href="/courier/orders" class="sidebar-link">
        <HugeIcon Name="invoice-01" CssClass="icon" /> <span class="sidebar-label">Мои заказы</span>
    </NavLink>
    <NavLink href="/courier/chat" class="@(ChatUnreadState.HasAnyChatUnread ? "sidebar-link sidebar-nav-chat-unread" : "sidebar-link")">
        <span class="sidebar-chat-icon-slot sidebar-chat-icon-slot--with-badge">
            <HugeIcon Name="message-01" CssClass="icon" />
            @if (ChatUnreadState.TotalChatUnreadCount > 0)
            {
                <span class="sidebar-chat-badge" aria-label="Непрочитанные сообщения">@((ChatUnreadState.TotalChatUnreadCount > 99) ? "99+" : ChatUnreadState.TotalChatUnreadCount.ToString())</span>
            }
        </span>
        <span class="sidebar-label">Чат</span>
    </NavLink>
    <NavLink href="/courier/notifications" class="sidebar-link">
        <HugeIcon Name="notification-01" CssClass="icon" /> <span class="sidebar-label">Уведомления</span>
    </NavLink>
    <NavLink href="/courier/profile" class="sidebar-link">
        <HugeIcon Name="user-03" CssClass="icon" /> <span class="sidebar-label">Профиль</span>
    </NavLink>
</nav>
<div class="sidebar-footer">
    <button type="button" class="sidebar-link sidebar-link-button sidebar-link-logout" @onclick="LogoutAsync" title="Выйти">
        <HugeIcon Name="logout-01" CssClass="icon" /> <span class="sidebar-label">Выйти</span>
    </button>
</div>

@code {
    private PeriodicTimer? _refreshTimer;
    private CancellationTokenSource? _refreshCts;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        ChatUnreadState.Changed += OnUnreadChanged;
        await ChatUnreadState.RefreshAsync();
        StartUnreadRefreshLoop();
        StateHasChanged();
    }

    private void StartUnreadRefreshLoop()
    {
        StopUnreadRefreshLoop();
        _refreshCts = new CancellationTokenSource();
        _refreshTimer = new PeriodicTimer(TimeSpan.FromSeconds(15));
        _ = RunUnreadRefreshAsync(_refreshCts.Token);
    }

    private async Task RunUnreadRefreshAsync(CancellationToken ct)
    {
        try
        {
            while (_refreshTimer is not null && await _refreshTimer.WaitForNextTickAsync(ct))
                await ChatUnreadState.RefreshAsync();
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void OnUnreadChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void StopUnreadRefreshLoop()
    {
        _refreshCts?.Cancel();
        _refreshCts?.Dispose();
        _refreshCts = null;
        _refreshTimer?.Dispose();
        _refreshTimer = null;
    }

    private async Task LogoutAsync()
    {
        try
        {
            await ChatHub.StopAsync();
        }
        catch
        {
        }

        await AuthState.MarkUserAsLoggedOutAsync();
        Navigation.NavigateTo("/login", forceLoad: true, replace: true);
    }

    public void Dispose()
    {
        ChatUnreadState.Changed -= OnUnreadChanged;
        StopUnreadRefreshLoop();
    }
}
