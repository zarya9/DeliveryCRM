@using WebBlazorDeliveryCRM.Components.Shared
@inject ChatUnreadStateService ChatUnreadState
@implements IDisposable

<div class="sidebar-header">
    <h2 class="sidebar-title">Курьер</h2>
</div>
<nav class="sidebar-nav">
    <NavLink href="/courier/shift" class="sidebar-link" Match="NavLinkMatch.All">
        <HugeIcon Name="calendar-03" CssClass="icon" /> <span class="sidebar-label">Смена и геолокация</span>
    </NavLink>
    <NavLink href="/courier/orders" class="sidebar-link">
        <HugeIcon Name="invoice-01" CssClass="icon" /> <span class="sidebar-label">Мои заказы</span>
    </NavLink>
    <NavLink href="/courier/chat" class="@(ChatUnreadState.HasAnyChatUnread ? "sidebar-link sidebar-nav-chat-unread" : "sidebar-link")">
        <span class="sidebar-chat-icon-slot">
            <HugeIcon Name="message-01" CssClass="icon" />
        </span>
        <span class="sidebar-label">Чат</span>
    </NavLink>
    <NavLink href="/courier/notifications" class="sidebar-link">
        <HugeIcon Name="notification-01" CssClass="icon" /> <span class="sidebar-label">Уведомления</span>
    </NavLink>
    <NavLink href="/courier/profile" class="sidebar-link">
        <HugeIcon Name="user-03" CssClass="icon" /> <span class="sidebar-label">Профиль</span>
    </NavLink>
</nav>

@code {
    private PeriodicTimer? _refreshTimer;
    private CancellationTokenSource? _refreshCts;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        ChatUnreadState.Changed += OnUnreadChanged;
        await ChatUnreadState.RefreshAsync();
        StartUnreadRefreshLoop();
        StateHasChanged();
    }

    private void StartUnreadRefreshLoop()
    {
        StopUnreadRefreshLoop();
        _refreshCts = new CancellationTokenSource();
        _refreshTimer = new PeriodicTimer(TimeSpan.FromSeconds(15));
        _ = RunUnreadRefreshAsync(_refreshCts.Token);
    }

    private async Task RunUnreadRefreshAsync(CancellationToken ct)
    {
        try
        {
            while (_refreshTimer is not null && await _refreshTimer.WaitForNextTickAsync(ct))
                await ChatUnreadState.RefreshAsync();
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void OnUnreadChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void StopUnreadRefreshLoop()
    {
        _refreshCts?.Cancel();
        _refreshCts?.Dispose();
        _refreshCts = null;
        _refreshTimer?.Dispose();
        _refreshTimer = null;
    }

    public void Dispose()
    {
        ChatUnreadState.Changed -= OnUnreadChanged;
        StopUnreadRefreshLoop();
    }
}
