@using WebBlazorDeliveryCRM.Components.Shared
@inject CustomAuthenticationStateProvider AuthState
@inject ChatHubClientService ChatHub
@inject ChatUnreadStateService ChatUnreadState
@inject NavigationManager Navigation

<div class="sidebar-header">
    <div class="d-flex align-items-center gap-2">
        <HugeIcon Name="store-01" CssClass="sidebar-title-icon" />
        <h2 class="sidebar-title">Клиент</h2>
    </div>
</div>
<nav class="sidebar-nav">
    <NavLink href="/customer" class="sidebar-link" Match="NavLinkMatch.Prefix">
        <HugeIcon Name="home-01" CssClass="icon" /> <span class="sidebar-label">Главная</span>
    </NavLink>
    <NavLink href="/customer/orders" class="sidebar-link">
        <HugeIcon Name="invoice-01" CssClass="icon" /> <span class="sidebar-label">Мои заказы</span>
    </NavLink>
    <NavLink href="/customer/orders/history" class="sidebar-link">
        <HugeIcon Name="clock-01" CssClass="icon" /> <span class="sidebar-label">История заказов</span>
    </NavLink>
    <NavLink href="/customer/tracking" class="sidebar-link">
        <HugeIcon Name="location-01" CssClass="icon" /> <span class="sidebar-label">Отслеживание</span>
    </NavLink>
    <NavLink href="/customer/profile" class="sidebar-link">
        <HugeIcon Name="user-03" CssClass="icon" /> <span class="sidebar-label">Профиль</span>
    </NavLink>
    <NavLink href="/customer/shifts" class="sidebar-link">
        <HugeIcon Name="calendar-03" CssClass="icon" /> <span class="sidebar-label">Смены</span>
    </NavLink>
    <NavLink href="/customer/chat" class="@(ChatUnreadState.HasAnyChatUnread ? "sidebar-link sidebar-nav-chat-unread" : "sidebar-link")">
        <span class="sidebar-chat-icon-slot sidebar-chat-icon-slot--with-badge">
            <HugeIcon Name="message-01" CssClass="icon" />
            @if (ChatUnreadState.TotalChatUnreadCount > 0)
            {
                <span class="sidebar-chat-badge" aria-label="Непрочитанные сообщения">@((ChatUnreadState.TotalChatUnreadCount > 99) ? "99+" : ChatUnreadState.TotalChatUnreadCount.ToString())</span>
            }
        </span>
        <span class="sidebar-label">Чат</span>
    </NavLink>
</nav>
<div class="sidebar-footer">
    <button type="button" class="sidebar-link sidebar-link-button sidebar-link-logout" @onclick="LogoutAsync" title="Выйти">
        <HugeIcon Name="logout-01" CssClass="icon" /> <span class="sidebar-label">Выйти</span>
    </button>
</div>

@code {
    private async Task LogoutAsync()
    {
        try
        {
            await ChatHub.StopAsync();
        }
        catch
        {
        }

        await AuthState.MarkUserAsLoggedOutAsync();
        Navigation.NavigateTo("/login", forceLoad: true, replace: true);
    }
}
