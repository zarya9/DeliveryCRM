@using WebBlazorDeliveryCRM.Components.Shared
@inject CustomAuthenticationStateProvider AuthState
@inject ChatHubClientService ChatHub
@inject ChatUnreadStateService ChatUnreadState
@inject NavigationManager Navigation
@implements IDisposable

<div class="sidebar-header">
    <h2 class="sidebar-title">Логист</h2>
</div>
<nav class="sidebar-nav">
    <NavLink href="/logistician" class="sidebar-link" Match="NavLinkMatch.All">
        <HugeIcon Name="dashboard-square-01" CssClass="icon" /> <span class="sidebar-label">Распределение</span>
    </NavLink>
    <NavLink href="/logistician/chat" class="@(ChatUnreadState.HasAnyChatUnread ? "sidebar-link sidebar-nav-chat-unread" : "sidebar-link")">
        <span class="sidebar-chat-icon-slot">
            <HugeIcon Name="message-01" CssClass="icon" />
        </span>
        <span class="sidebar-label">Чат</span>
    </NavLink>
    <NavLink href="/logistician/hubs" class="sidebar-link">
        <HugeIcon Name="store-01" CssClass="icon" /> <span class="sidebar-label">Склады (просмотр)</span>
    </NavLink>
    <NavLink href="/logistician/routes" class="sidebar-link">
        <HugeIcon Name="route-02" CssClass="icon" /> <span class="sidebar-label">Маршруты</span>
    </NavLink>
    <NavLink href="/logistician/couriers" class="sidebar-link">
        <HugeIcon Name="user-group" CssClass="icon" /> <span class="sidebar-label">Курьеры</span>
    </NavLink>
    <NavLink href="/logistician/fleet" class="sidebar-link">
        <HugeIcon Name="delivery-truck-01" CssClass="icon" /> <span class="sidebar-label">Автопарк</span>
    </NavLink>
    <NavLink href="/logistician/analytics" class="sidebar-link">
        <HugeIcon Name="analytics-up" CssClass="icon" /> <span class="sidebar-label">Аналитика</span>
    </NavLink>
    <NavLink href="/logistician/monitoring" class="sidebar-link">
        <HugeIcon Name="activity-01" CssClass="icon" /> <span class="sidebar-label">Мониторинг</span>
    </NavLink>
    <NavLink href="/logistician/profile" class="sidebar-link">
        <HugeIcon Name="user-03" CssClass="icon" /> <span class="sidebar-label">Профиль</span>
    </NavLink>
    <NavLink href="/logistician/shifts" class="sidebar-link">
        <HugeIcon Name="calendar-03" CssClass="icon" /> <span class="sidebar-label">Смены</span>
    </NavLink>
</nav>
<div class="sidebar-footer">
    <button type="button" class="sidebar-link sidebar-link-button sidebar-link-logout" @onclick="LogoutAsync" title="Выйти">
        <HugeIcon Name="logout-01" CssClass="icon" /> <span class="sidebar-label">Выйти</span>
    </button>
</div>

@code {
    private PeriodicTimer? _refreshTimer;
    private CancellationTokenSource? _refreshCts;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        ChatUnreadState.Changed += OnUnreadChanged;
        await ChatUnreadState.RefreshAsync();
        StartUnreadRefreshLoop();
        StateHasChanged();
    }

    private void StartUnreadRefreshLoop()
    {
        StopUnreadRefreshLoop();
        _refreshCts = new CancellationTokenSource();
        _refreshTimer = new PeriodicTimer(TimeSpan.FromSeconds(15));
        _ = RunUnreadRefreshAsync(_refreshCts.Token);
    }

    private async Task RunUnreadRefreshAsync(CancellationToken ct)
    {
        try
        {
            while (_refreshTimer is not null && await _refreshTimer.WaitForNextTickAsync(ct))
            {
                await ChatUnreadState.RefreshAsync();
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void OnUnreadChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void StopUnreadRefreshLoop()
    {
        _refreshCts?.Cancel();
        _refreshCts?.Dispose();
        _refreshCts = null;
        _refreshTimer?.Dispose();
        _refreshTimer = null;
    }

    private async Task LogoutAsync()
    {
        try
        {
            await ChatHub.StopAsync();
        }
        catch
        {
        }

        await AuthState.MarkUserAsLoggedOutAsync();
        Navigation.NavigateTo("/login", forceLoad: true, replace: true);
    }

    public void Dispose()
    {
        ChatUnreadState.Changed -= OnUnreadChanged;
        StopUnreadRefreshLoop();
    }
}
