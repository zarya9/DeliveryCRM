@using System.Security.Claims
@using WebBlazorDeliveryCRM.Components.Shared
@inject AuthenticationStateProvider AuthStateProvider
@inject ChatUnreadStateService ChatUnreadState
@implements IDisposable

<div class="sidebar-header">
    <h2 class="sidebar-title">@(_fullName ?? "Менеджер")</h2>
    @if (!string.IsNullOrEmpty(_email))
    {
        <p class="text-muted" style="font-size: 0.825rem; margin: 0;">@_email</p>
    }
</div>
<nav class="sidebar-nav">
    <NavLink href="/manager" class="sidebar-link" Match="NavLinkMatch.All">
        <HugeIcon Name="dashboard-square-01" CssClass="icon" /> <span class="sidebar-label">Дашборд</span>
    </NavLink>
    <NavLink href="/manager/chat" class="@(ChatUnreadState.HasAnyChatUnread ? "sidebar-link sidebar-nav-chat-unread" : "sidebar-link")">
        <span class="sidebar-chat-icon-slot">
            <HugeIcon Name="message-01" CssClass="icon" />
        </span>
        <span class="sidebar-label">Чат</span>
    </NavLink>
    <NavLink href="/manager/orders" class="sidebar-link">
        <HugeIcon Name="invoice-01" CssClass="icon" /> <span class="sidebar-label">Заказы</span>
    </NavLink>
    <NavLink href="/manager/leads" class="sidebar-link">
        <HugeIcon Name="task-01" CssClass="icon" /> <span class="sidebar-label">Лиды</span>
    </NavLink>
    <NavLink href="/manager/employees" class="sidebar-link">
        <HugeIcon Name="user-group" CssClass="icon" /> <span class="sidebar-label">Сотрудники</span>
    </NavLink>
    <NavLink href="/manager/hubs" class="sidebar-link">
        <HugeIcon Name="store-01" CssClass="icon" /> <span class="sidebar-label">Склады (хабы)</span>
    </NavLink>
    <NavLink href="/manager/analytics" class="sidebar-link">
        <HugeIcon Name="analytics-up" CssClass="icon" /> <span class="sidebar-label">Аналитика</span>
    </NavLink>
    <NavLink href="/manager/geoanalytics" class="sidebar-link">
        <HugeIcon Name="location-01" CssClass="icon" /> <span class="sidebar-label">Геоаналитика</span>
    </NavLink>
    <NavLink href="/manager/profile" class="sidebar-link">
        <HugeIcon Name="user-03" CssClass="icon" /> <span class="sidebar-label">Профиль</span>
    </NavLink>
    <NavLink href="/manager/billing" class="sidebar-link">
        <HugeIcon Name="wallet-01" CssClass="icon" /> <span class="sidebar-label">Оплата и тариф</span>
    </NavLink>
    <NavLink href="/manager/communication-templates" class="sidebar-link">
        <HugeIcon Name="edit-01" CssClass="icon" /> <span class="sidebar-label">Шаблоны сообщений</span>
    </NavLink>
    <NavLink href="/manager/scheduled-reports" class="sidebar-link">
        <HugeIcon Name="calendar-03" CssClass="icon" /> <span class="sidebar-label">Плановые отчеты</span>
    </NavLink>
    @if (_isAdmin)
    {
        <NavLink href="/admin/audit" class="sidebar-link">
            <HugeIcon Name="audit-01" CssClass="icon" /> <span class="sidebar-label">Аудит</span>
        </NavLink>
    }
</nav>

@code {
    private string? _fullName;
    private string? _email;
    private bool _isAdmin;
    private PeriodicTimer? _refreshTimer;
    private CancellationTokenSource? _refreshCts;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = state.User;
        _email = user.FindFirst(ClaimTypes.Email)?.Value
                 ?? user.FindFirst("email")?.Value;
        _fullName = user.FindFirst(ClaimTypes.Name)?.Value;
        var role = user.FindFirst(ClaimTypes.Role)?.Value
                   ?? user.FindFirst("role")?.Value
                   ?? user.FindFirst("http://schemas.microsoft.com/ws/2008/06/identity/claims/role")?.Value;
        _isAdmin = string.Equals(role, "Админ", StringComparison.Ordinal)
            || string.Equals(role, "Администратор", StringComparison.Ordinal);
        ChatUnreadState.Changed += OnUnreadChanged;
        await ChatUnreadState.RefreshAsync();
        StartUnreadRefreshLoop();
        StateHasChanged();
    }

    private void StartUnreadRefreshLoop()
    {
        StopUnreadRefreshLoop();
        _refreshCts = new CancellationTokenSource();
        _refreshTimer = new PeriodicTimer(TimeSpan.FromSeconds(15));
        _ = RunUnreadRefreshAsync(_refreshCts.Token);
    }

    private async Task RunUnreadRefreshAsync(CancellationToken ct)
    {
        try
        {
            while (_refreshTimer is not null && await _refreshTimer.WaitForNextTickAsync(ct))
            {
                await ChatUnreadState.RefreshAsync();
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void OnUnreadChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void StopUnreadRefreshLoop()
    {
        _refreshCts?.Cancel();
        _refreshCts?.Dispose();
        _refreshCts = null;
        _refreshTimer?.Dispose();
        _refreshTimer = null;
    }

    public void Dispose()
    {
        ChatUnreadState.Changed -= OnUnreadChanged;
        StopUnreadRefreshLoop();
    }
}
