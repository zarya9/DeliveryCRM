@using System.Security.Claims
@inject AuthenticationStateProvider AuthStateProvider

<div class="sidebar-header">
    <h2 class="sidebar-title">@(_fullName ?? "Менеджер")</h2>
    @if (!string.IsNullOrEmpty(_email))
    {
        <p class="text-muted" style="font-size: 0.825rem; margin: 0;">@_email</p>
    }
</div>
<nav class="sidebar-nav">
    <NavLink href="/manager" class="sidebar-link" Match="NavLinkMatch.All">
        <span class="icon">⌂</span> Дашборд
    </NavLink>
    <NavLink href="/manager/notifications" class="sidebar-link">
        <span class="icon">◉</span> Уведомления
    </NavLink>
    <NavLink href="/manager/chat" class="sidebar-link">
        <span class="icon">✉</span> Чат
    </NavLink>
    <NavLink href="/manager/orders" class="sidebar-link">
        <span class="icon">▤</span> Заказы
    </NavLink>
    <NavLink href="/manager/leads" class="sidebar-link">
        <span class="icon">◎</span> Лиды
    </NavLink>
    <NavLink href="/manager/employees" class="sidebar-link">
        <span class="icon">◍</span> Сотрудники
    </NavLink>
    <NavLink href="/manager/hubs" class="sidebar-link">
        <span class="icon">▣</span> Склады (хабы)
    </NavLink>
    <NavLink href="/manager/analytics" class="sidebar-link">
        <span class="icon">▦</span> Аналитика
    </NavLink>
    <NavLink href="/manager/billing" class="sidebar-link">
        <span class="icon">₽</span> Оплата и тариф
    </NavLink>
    <NavLink href="/manager/communication-templates" class="sidebar-link">
        <span class="icon">✎</span> Шаблоны сообщений
    </NavLink>
    <NavLink href="/manager/scheduled-reports" class="sidebar-link">
        <span class="icon">⌚</span> Плановые отчеты
    </NavLink>
    @if (_isAdmin)
    {
        <NavLink href="/admin/audit" class="sidebar-link">
            <span class="icon">≣</span> Аудит
        </NavLink>
    }
</nav>

@code {
    private string? _fullName;
    private string? _email;
    private bool _isAdmin;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = state.User;
        _email = user.FindFirst(ClaimTypes.Email)?.Value
                 ?? user.FindFirst("email")?.Value;
        _fullName = user.FindFirst(ClaimTypes.Name)?.Value;
        var role = user.FindFirst(ClaimTypes.Role)?.Value
                   ?? user.FindFirst("role")?.Value
                   ?? user.FindFirst("http://schemas.microsoft.com/ws/2008/06/identity/claims/role")?.Value;
        _isAdmin = string.Equals(role, "Админ", StringComparison.Ordinal);
        StateHasChanged();
    }
}
