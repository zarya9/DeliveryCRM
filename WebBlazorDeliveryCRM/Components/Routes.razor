@rendermode InteractiveServer
@using WebBlazorDeliveryCRM.Components.Pages
<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
            <NotAuthorized>
                @if (context.User.Identity?.IsAuthenticated != true)
                {
                    <RedirectToLogin />
                }
                else
                {
                    <div class="alert alert-warning border-warning shadow-sm mb-0" style="max-width: 42rem;" role="status">
                        <strong class="d-block">Нет доступа</strong>
                        <span class="small">У этой учётной записи нет прав на выбранный раздел. Выберите другой пункт меню или обратитесь к администратору.</span>
                    </div>
                }
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(Layout.MainLayout)">
            <NotFoundView />
        </LayoutView>
    </NotFound>
</Router>
