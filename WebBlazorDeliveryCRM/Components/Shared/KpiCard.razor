<div class="dms-card dms-stat-card h-100">
    <div class="dms-stat-title d-inline-flex align-items-center gap-2 flex-wrap">
        @if (!string.IsNullOrWhiteSpace(IconName))
        {
            <HugeIcon Name="@IconName" CssClass="dms-icon-sm" />
        }
        @Title
    </div>
    <div class="dms-stat-value">@Value</div>
    @if (!string.IsNullOrWhiteSpace(Meta))
    {
        <div class="dms-stat-meta">@Meta</div>
    }
</div>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public string? Meta { get; set; }
    [Parameter] public string? IconName { get; set; }
}
