@implements IAsyncDisposable
@using System.Security.Claims
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.AspNetCore.Components.Web
@using System.Globalization
@using WebBlazorDeliveryCRM.Models
@using WebBlazorDeliveryCRM.Components.Shared
@inject ChatHubClientService ChatHubClient
@inject ChatApiService ChatApi
@inject EmployeesApiService EmployeesApi
@inject UserPresenceApiService PresenceApi
@inject AuthenticationStateProvider AuthStateProvider
@inject AppNotificationService Notify
@inject ChatUnreadStateService ChatUnreadState
@inject IJSRuntime JS
@inject NavigationManager Navigation

<div class="dms-card chat-shell @(_mobileChatOpen ? "mobile-chat-open" : "mobile-list-open")">
    <aside class="chat-list">
        <div class="p-2 border-bottom">
            <input class="form-control form-control-sm" placeholder="Поиск сотрудника..." @bind="_chatSearch" @bind:event="oninput" />
            @if (SearchedEmployees.Count > 0)
            {
                <div class="chat-user-search-results mt-2">
                    @foreach (var e in SearchedEmployees)
                    {
                        <button type="button" class="chat-user-search-item" @onclick="() => OpenDirectChatWithUserAsync(e.Id)" title="@e.FullName">
                            @FormatChatEmployeeDisplay(e)
                        </button>
                    }
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(_chatSearch))
            {
                <div class="small text-muted mt-2">Сотрудник не найден</div>
            }
        </div>
        <div class="chat-list-items">
            @foreach (var room in RoomsForList)
            {
                <button type="button" class="chat-item @(room.ChatRoomId == _activeRoomId ? "active" : "")"
                        @onclick="() => OpenRoomAsync(room.ChatRoomId)">
                    <span class="chat-avatar">
                        @if (TryGetRoomAvatarUrl(room, out var roomAvatarUrl))
                        {
                            <img src="@roomAvatarUrl"
                                 alt="@GetRoomDisplayName(room)"
                                 class="chat-avatar-img"
                                 @onerror="() => OnRoomAvatarError(room.ChatRoomId)" />
                        }
                        else
                        {
                            <span class="chat-avatar-initials">@GetInitials(GetRoomDisplayName(room))</span>
                        }
                    </span>
                    <span class="chat-item-content">
                        <span class="chat-item-top">
                            <span class="chat-item-name">@GetRoomDisplayName(room)</span>
                            <span class="chat-item-time">@FormatRoomTime(room.LastMessageAt)</span>
                        </span>
                        <span class="chat-item-preview">@GetRoomPreview(room.LastMessageText)</span>
                    </span>
                    @if (room.UnreadCount > 0)
                    {
                        <span class="chat-unread-dot" title="Непрочитанные сообщения"></span>
                    }
                </button>
            }
        </div>
    </aside>

    <section class="chat-main">
        <div class="chat-mobile-header">
            <button type="button" class="btn btn-sm btn-outline-secondary chat-back-btn" @onclick="BackToRoomList">
                Назад
            </button>
            <div class="chat-mobile-title">@ActiveRoomTitle</div>
        </div>
        <div class="chat-peer-header @(IsDirectActiveRoom ? "chat-peer-header-clickable" : "")"
             @onclick="OpenPeerProfile">
            <div class="chat-peer-header-main">
                <div class="chat-peer-title">@ActiveRoomTitle</div>
                @if (IsDirectActiveRoom)
                {
                    <div class="chat-peer-status">@ActivePeerStatusText</div>
                }
            </div>
            <div class="chat-peer-search" @onclick:stopPropagation="true">
                <span class="chat-peer-search-icon" aria-hidden="true">🔎</span>
                <input class="chat-peer-search-input"
                       placeholder="Поиск по сообщениям"
                       @bind="_messageSearch"
                       @bind:event="oninput" />
            </div>
        </div>
        <div id="company-chat-messages" class="company-chat-messages flex-grow-1 overflow-auto mb-2 chat-messages">
            @if (FilteredMessages.Count == 0)
            {
                <div class="chat-empty">
                    <div class="chat-empty-box">Сообщений пока нет</div>
                </div>
            }
            else
            {
                @foreach (var m in FilteredMessages)
                {
                    <div class="chat-bubble-wrap @(m.IsMine ? "mine" : "other")">
                        <div class="chat-bubble">
                            @if (ShouldShowSenderName(m))
                            {
                                <div class="chat-sender-name">@GetSenderDisplayName(m)</div>
                            }
                            @if (_editingMessageId == m.Id && m.IsMine)
                            {
                                <div class="d-flex gap-2 flex-wrap">
                                    <input class="form-control form-control-sm" @bind="_editingText" @bind:event="oninput" />
                                    <button type="button" class="btn btn-sm btn-primary" @onclick="SaveEdit">OK</button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CancelEdit">✕</button>
                                </div>
                            }
                            else
                            {
                                <div>@m.Text</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(m.AttachmentUrl))
                            {
                                <div class="mt-2 p-2 border rounded bg-body-tertiary">
                                    <div class="small d-flex align-items-center gap-2">
                                        <a href="@m.AttachmentUrl" @onclick:preventDefault="true" @onclick="(() => DownloadAttachmentAsync(m))">@m.AttachmentFileName</a>
                                    </div>
                                    @if (m.IsImageAttachment)
                                    {
                                        <img src="@m.AttachmentUrl" alt="@m.AttachmentFileName" class="rounded mt-2 border chat-image-preview" />
                                    }
                                </div>
                            }
                            <div class="small text-muted mt-1 d-flex justify-content-between">
                                <span>@m.SentAt.ToLocalTime().ToString("HH:mm") @if (m.EditedAt.HasValue) { <span>(изм.)</span> }</span>
                                @if (m.IsMine)
                                {
                                    <span class="d-flex gap-1">
                                        <button type="button" class="btn btn-sm btn-link p-0" @onclick="() => StartEdit(m.Id)">
                                            <HugeIcon Name="pencil-edit-01" CssClass="chat-action-icon" />
                                        </button>
                                        <button type="button" class="btn btn-sm btn-link p-0 text-danger" @onclick="() => DeleteForEveryone(m.Id)">
                                            <HugeIcon Name="delete-02" CssClass="chat-action-icon" />
                                        </button>
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        <div class="d-flex flex-wrap gap-1 mb-2">
            @foreach (var quick in CurrentQuickReplies)
            {
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => ApplyQuickReply(quick)">@quick</button>
            }
        </div>

        <div class="chat-composer"
             @ondragover:preventDefault
             @ondrop:preventDefault
             @ondrop="OnDropFileAsync">
            <label class="chat-clip-btn" for="chat-file-input" title="Прикрепить файл">
                <HugeIcon Name="attachment-01" CssClass="chat-action-icon" />
                <InputFile id="chat-file-input" OnChange="OnFileSelected" style="display:none" />
            </label>
            <input class="chat-composer-input"
                   placeholder="Сообщение"
                   @bind="_newMessage"
                   @bind:event="oninput"
                   @onkeydown="OnKeyDown" />
            <button type="button" class="chat-send-btn" disabled="@(!CanSendMessage)" @onclick="SendMessageAsync" title="Отправить">
                <HugeIcon Name="sent" CssClass="chat-action-icon" />
            </button>
        </div>
        @if (!string.IsNullOrWhiteSpace(_attachmentName))
        {
            <div class="small text-muted mt-1 d-flex align-items-center gap-2">
                <span>@_attachmentName</span>
                <button type="button" class="btn btn-sm btn-link p-0 text-danger" @onclick="ClearAttachment">Убрать</button>
                @if (_uploadingAttachment)
                {
                    <span class="text-muted">Загрузка...</span>
                }
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(_attachmentUrl) && IsImageFile(_attachmentName))
        {
            <img src="@_attachmentUrl" alt="preview" class="rounded border mt-2 chat-image-preview" />
        }
    </section>
</div>

@if (_showPeerProfile && ActivePeer is not null)
{
    <div class="employee-modal-backdrop" @onclick="ClosePeerProfile">
        <div class="employee-modal employee-modal--employee-detail" @onclick:stopPropagation="true">
            <div class="employee-detail-header d-flex justify-content-between align-items-start">
                <h2 class="h5 mb-0">Профиль собеседника</h2>
                <button type="button" class="btn-close" aria-label="Закрыть" @onclick="ClosePeerProfile"></button>
            </div>

            <div class="employee-detail-body">
                <div class="employee-detail-avatar-wrap">
                    <div class="chat-peer-profile-avatar">@GetInitials(ActivePeer.FullName)</div>
                </div>
                <div class="employee-detail-fields">
                    <div class="employee-detail-row">
                        <div class="employee-detail-row-text">
                            <span class="employee-detail-label">ФИО</span>
                            <span class="employee-detail-value">@ActivePeer.FullName</span>
                        </div>
                        <HugeIcon Name="user-03" CssClass="employee-detail-row-icon" />
                    </div>
                    <div class="employee-detail-row">
                        <div class="employee-detail-row-text">
                            <span class="employee-detail-label">Статус</span>
                            <span class="employee-detail-value">@ActivePeerStatusText</span>
                        </div>
                        <HugeIcon Name="time-01" CssClass="employee-detail-row-icon" />
                    </div>
                    @if (!string.IsNullOrWhiteSpace(ActivePeer.Email))
                    {
                        <div class="employee-detail-row">
                            <div class="employee-detail-row-text">
                                <span class="employee-detail-label">Почта</span>
                                <span class="employee-detail-value">@ActivePeer.Email</span>
                            </div>
                            <HugeIcon Name="mail-01" CssClass="employee-detail-row-icon" />
                        </div>
                    }
                    <div class="employee-detail-row">
                        <div class="employee-detail-row-text">
                            <span class="employee-detail-label">Должность</span>
                            <span class="employee-detail-value">@ActivePeer.Role</span>
                        </div>
                        <HugeIcon Name="briefcase-01" CssClass="employee-detail-row-icon" />
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int? TargetUserId { get; set; }

    [Parameter]
    public int? TargetRoomId { get; set; }

    /// <summary>
    /// Если задано вместе с личным чатом и история пуста, один раз отправляется приветствие по заказу.
    /// </summary>
    [Parameter]
    public string? AutoIntroOrderName { get; set; }

    private readonly List<ChatMessageVm> _messages = new();
    private readonly List<ChatRoomListItemDto> _rooms = new();
    private readonly Dictionary<int, string> _roomKinds = new();
    private readonly Dictionary<int, string> _employeeNames = new();
    private readonly HashSet<int> _roomsWithAvatarError = new();
    private readonly List<EmployeesApiService.EmployeeDto> _employees = new();
    private string _chatSearch = string.Empty;
    private string _messageSearch = string.Empty;
    private string _newMessage = string.Empty;
    private int _currentUserId;
    private int _companyId;
    private bool _viewerIsClient;
    private bool _initialized;
    private int _activeRoomId;
    private string _activeRoomKind = "company";
    private bool _mobileChatOpen;
    private int? _lastHandledTargetUserId;
    private int? _lastHandledTargetRoomId;
    /// <summary>Совпадение userId+orderName для повторного открытия чата с тем же менеджером по другому заказу.</summary>
    private string? _lastHandledDirectOpenSignature;
    private int? _pendingDirectPeerUserId;
    private bool _showPeerProfile;
    private HashSet<int> _onlineUserIds = new();
    private int? _editingMessageId;
    private string _editingText = string.Empty;
    private bool _uploadingAttachment;
    private string? _attachmentUrl;
    private string? _attachmentName;
    private readonly string[] _categories = ["greeting", "clarification", "sla", "closing"];
    private string _selectedCategory = "greeting";
    private string _templateSearch = string.Empty;
    private readonly List<QuickReplyTemplateDto> _dbTemplates = new();
    private readonly Dictionary<string, string[]> _defaultRepliesByCategory = new Dictionary<string, string[]>
    {
        { "greeting", new[] { "Здравствуйте! Чем могу помочь?", "Добрый день! Я на связи." } },
        { "clarification", new[] { "Уточните, пожалуйста, номер заказа.", "Нужны детали: адрес и контакт получателя." } },
        { "sla", new[] { "Есть риск задержки, контролируем SLA.", "Проверяем логистику, вернусь с ETA." } },
        { "closing", new[] { "Вопрос закрыт, спасибо!", "Если что-то потребуется, пишите." } }
    };

    private bool CanSendMessage => _activeRoomId > 0 && (!string.IsNullOrWhiteSpace(_newMessage) || !string.IsNullOrWhiteSpace(_attachmentUrl));
    private ChatRoomListItemDto? ActiveRoom => _rooms.FirstOrDefault(r => r.ChatRoomId == _activeRoomId);
    private bool IsDirectActiveRoom => string.Equals(_activeRoomKind, "direct", StringComparison.OrdinalIgnoreCase);
    private int? ActivePeerUserId => IsDirectActiveRoom ? ActiveRoom?.PeerUserId : null;
    private EmployeesApiService.EmployeeDto? ActivePeer
        => ActivePeerUserId.HasValue ? _employees.FirstOrDefault(e => e.Id == ActivePeerUserId.Value) : null;
    private string ActivePeerStatusText
    {
        get
        {
            if (!ActivePeerUserId.HasValue)
                return string.Empty;
            if (_onlineUserIds.Contains(ActivePeerUserId.Value))
                return "онлайн";
            if (TryGetPeerLastSeen(ActivePeerUserId.Value, out var lastSeen))
                return FormatPeerLastSeen(lastSeen);
            return "был(а) недавно";
        }
    }
    private string ActiveRoomTitle
    {
        get
        {
            var room = _rooms.FirstOrDefault(r => r.ChatRoomId == _activeRoomId);
            return room is null ? "Чат" : GetRoomDisplayName(room);
        }
    }
    private List<ChatRoomListItemDto> RoomsForList => _rooms
        .OrderByDescending(r => r.LastMessageAt ?? DateTime.MinValue)
        .ToList();
    private List<EmployeesApiService.EmployeeDto> SearchedEmployees =>
        string.IsNullOrWhiteSpace(_chatSearch)
            ? new List<EmployeesApiService.EmployeeDto>()
            : _employees
                .Where(e => e.Id != _currentUserId)
                .Where(e => e.FullName.Contains(_chatSearch, StringComparison.OrdinalIgnoreCase))
                .OrderBy(e => e.FullName)
                .Take(8)
                .ToList();
    private IEnumerable<string> CurrentQuickReplies =>
        (_defaultRepliesByCategory.TryGetValue(_selectedCategory, out var arr) ? arr : Array.Empty<string>())
        .Concat(_dbTemplates
            .Where(t => string.Equals(t.Category, _selectedCategory, StringComparison.OrdinalIgnoreCase))
            .Where(t => string.IsNullOrWhiteSpace(_templateSearch)
                || t.Title.Contains(_templateSearch, StringComparison.OrdinalIgnoreCase)
                || t.Content.Contains(_templateSearch, StringComparison.OrdinalIgnoreCase))
            .Select(t => t.Content)
            .Distinct());
    private List<ChatMessageVm> FilteredMessages
        => _messages
            .Where(m =>
                string.IsNullOrWhiteSpace(_messageSearch) ||
                m.Text.Contains(_messageSearch, StringComparison.OrdinalIgnoreCase) ||
                (m.SenderName?.Contains(_messageSearch, StringComparison.OrdinalIgnoreCase) ?? false))
            .OrderBy(m => m.SentAt)
            .ToList();

    // В выпадающем поиске — только фамилия и имя (одна строка).
    private static string FormatChatEmployeeDisplay(EmployeesApiService.EmployeeDto e)
    {
        var full = (e.FullName ?? "").Trim();
        if (string.IsNullOrEmpty(full))
            return "—";
        var parts = full.Split(new[] { ' ', '\t', '\u00A0' }, StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length <= 2)
            return full;
        return $"{parts[0]} {parts[1]}";
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = state.User;
            if (!int.TryParse(user.FindFirst(ClaimTypes.NameIdentifier)?.Value, out _currentUserId))
                return;
            _ = int.TryParse(user.FindFirst("companyId")?.Value, out _companyId);
            _viewerIsClient = user.IsInRole("Клиент");

            _employees.AddRange(await EmployeesApi.GetByCompanyAsync(_companyId));
            _onlineUserIds = await PresenceApi.GetOnlineUserIdsAsync(_companyId);
            foreach (var employee in _employees)
            {
                _employeeNames[employee.Id] = employee.FullName;
            }

            var ensure = await ChatApi.EnsureCompanyRoomAsync();
            if (ensure.ok)
                _activeRoomId = ensure.roomId;

            await ReloadRoomsAsync();
            await LoadTemplatesAsync();

            SubscribeHubEvents();
            await ChatHubClient.StartAsync();
            if (_activeRoomId > 0)
            {
                await ChatHubClient.JoinRoomAsync(_activeRoomId);
                await LoadHistoryAsync(_activeRoomId);
                await MarkActiveRoomAsReadAsync();
            }

            if (TargetRoomId.HasValue && TargetRoomId.Value > 0)
            {
                // #region agent log
                AppendDebugLog("run1", "H2", "CompanyChatPanel.razor:OnInitializedAsync:targetRoom", "TargetRoomId detected on init", new
                {
                    targetRoomId = TargetRoomId,
                    targetUserId = TargetUserId,
                    activeRoomIdBefore = _activeRoomId
                });
                // #endregion
                await OpenRoomAsync(TargetRoomId.Value);
                _lastHandledTargetRoomId = TargetRoomId.Value;
            }
            else if (TargetUserId.HasValue && TargetUserId.Value > 0)
            {
                _lastHandledDirectOpenSignature = $"{TargetUserId.Value}|{AutoIntroOrderName ?? ""}";
                _pendingDirectPeerUserId = TargetUserId.Value;
                await TryOpenDirectChatWithUserAsync(TargetUserId.Value, showError: false);
                _lastHandledTargetUserId = TargetUserId.Value;
                await TrySendOrderIntroFromQueryAsync();
            }

            _initialized = true;
        }
        catch (HttpRequestException ex) when (ex.StatusCode is System.Net.HttpStatusCode.Unauthorized or System.Net.HttpStatusCode.Forbidden)
        {
            Notify.ShowWarning("Сессия истекла. Войдите заново.");
            if (AuthStateProvider is CustomAuthenticationStateProvider customAuth)
                await customAuth.MarkUserAsLoggedOutAsync();
            Navigation.NavigateTo("/login", forceLoad: true, replace: true);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_initialized)
            return;

        // #region agent log
        AppendDebugLog("run1", "H2", "CompanyChatPanel.razor:OnParametersSetAsync", "Parameters set", new
        {
            targetRoomId = TargetRoomId,
            targetUserId = TargetUserId,
            lastHandledTargetRoomId = _lastHandledTargetRoomId,
            lastHandledTargetUserId = _lastHandledTargetUserId,
            activeRoomId = _activeRoomId,
            activeRoomKind = _activeRoomKind
        });
        // #endregion

        if (TargetRoomId.HasValue && TargetRoomId.Value > 0)
        {
            if (_lastHandledTargetRoomId == TargetRoomId.Value)
                return;

            await OpenRoomAsync(TargetRoomId.Value);
            _lastHandledTargetRoomId = TargetRoomId.Value;
            return;
        }

        if (!TargetUserId.HasValue || TargetUserId.Value <= 0)
            return;

        var sig = $"{TargetUserId.Value}|{AutoIntroOrderName ?? ""}";
        if (string.Equals(_lastHandledDirectOpenSignature, sig, StringComparison.Ordinal))
            return;

        _lastHandledDirectOpenSignature = sig;
        _pendingDirectPeerUserId = TargetUserId.Value;
        await TryOpenDirectChatWithUserAsync(TargetUserId.Value, showError: false);
        _lastHandledTargetUserId = TargetUserId.Value;
        await TrySendOrderIntroFromQueryAsync();
    }

    private async Task ReloadRoomsAsync()
    {
        _rooms.Clear();
        var rooms = await ChatApi.GetRoomsListAsync();
        _rooms.AddRange(rooms);
        _roomKinds.Clear();
        foreach (var room in rooms)
        {
            _roomKinds[room.ChatRoomId] = room.RoomKind ?? "company";
            if (string.Equals(room.RoomKind, "direct", StringComparison.OrdinalIgnoreCase)
                && room.PeerUserId is > 0
                && IsUsableDirectRoomTitle(room.Name))
            {
                _employeeNames[room.PeerUserId.Value] = FormatDirectTitleForViewer(room.Name.Trim());
            }
        }
        if (_activeRoomId == 0 && _rooms.Count > 0)
            _activeRoomId = _rooms[0].ChatRoomId;
        _activeRoomKind = _roomKinds.GetValueOrDefault(_activeRoomId, "company");
    }

    private async Task OpenRoomAsync(int roomId)
    {
        if (roomId <= 0) return;
        // #region agent log
        AppendDebugLog("run1", "H5", "CompanyChatPanel.razor:OpenRoomAsync:start", "OpenRoomAsync called", new
        {
            roomId,
            activeRoomIdBefore = _activeRoomId,
            activeRoomKindBefore = _activeRoomKind
        });
        // #endregion

        if (roomId == _activeRoomId)
        {
            _mobileChatOpen = true;
            await MarkActiveRoomAsReadAsync();
            await ReloadRoomsAsync();
            await ChatUnreadState.RefreshAsync();
            return;
        }

        if (_activeRoomId > 0)
            await ChatHubClient.LeaveRoomAsync(_activeRoomId);
        _activeRoomId = roomId;
        _activeRoomKind = _roomKinds.GetValueOrDefault(roomId, "company");
        _showPeerProfile = false;
        _messages.Clear();
        await ChatHubClient.JoinRoomAsync(_activeRoomId);
        await LoadHistoryAsync(_activeRoomId);
        await MarkActiveRoomAsReadAsync();
        await ReloadRoomsAsync();
        await ChatUnreadState.RefreshAsync();
        _mobileChatOpen = true;
        // #region agent log
        AppendDebugLog("run1", "H5", "CompanyChatPanel.razor:OpenRoomAsync:done", "OpenRoomAsync completed", new
        {
            roomIdOpened = roomId,
            activeRoomIdAfter = _activeRoomId,
            activeRoomKindAfter = _activeRoomKind
        });
        // #endregion
    }

    private async Task LoadHistoryAsync(int roomId)
    {
        var history = await ChatApi.GetMessagesAsync(roomId, 0, 200);
        _messages.Clear();
        _messages.AddRange(history
            .Where(x => !x.Is_deleted)
            .OrderBy(x => x.Sent_at)
            .Select(x => ChatMessageVm.FromDto(x, _currentUserId)));
        StateHasChanged();
        await ScrollMessagesToBottomAsync();
    }

    private async Task OpenDirectChatWithUserAsync(int userId)
        => await TryOpenDirectChatWithUserAsync(userId, showError: true);

    private async Task TrySendOrderIntroFromQueryAsync()
    {
        if (string.IsNullOrWhiteSpace(AutoIntroOrderName))
            return;
        if (!IsDirectActiveRoom || _activeRoomId <= 0)
            return;
        if (_messages.Count > 0)
            return;

        var title = AutoIntroOrderName.Trim();
        if (title.Length > 500)
            title = title[..500];
        var safe = title.Replace("\"", "'");
        var body = $"Здравствуйте! Пишу вам касаемо заказа \"{safe}\"";

        var (introOk, introMsg) = await ChatApi.SendMessageAsync(_activeRoomId, body, null);
        if (!introOk)
        {
            Notify.ShowWarning("Не удалось отправить первое сообщение — напишите менеджеру вручную.");
            return;
        }

        if (introMsg != null)
            AppendMessageIfNew(ChatMessageVm.FromDto(introMsg, _currentUserId));

        await ReloadRoomsAsync();
        await MarkActiveRoomAsReadAsync();
        await ChatUnreadState.RefreshAsync();
        await ScrollMessagesToBottomAsync();
    }

    private async Task<bool> TryOpenDirectChatWithUserAsync(int userId, bool showError)
    {
        if (userId <= 0)
            return false;
        // #region agent log
        AppendDebugLog("run1", "H3", "CompanyChatPanel.razor:TryOpenDirectChatWithUserAsync:start", "Trying open direct chat", new
        {
            userId,
            showError,
            activeRoomIdBefore = _activeRoomId,
            activeRoomKindBefore = _activeRoomKind
        });
        // #endregion
        var created = await ChatApi.CreateOrGetDirectRoomAsync(userId);
        // #region agent log
        AppendDebugLog("run1", "H3", "CompanyChatPanel.razor:TryOpenDirectChatWithUserAsync:result", "CreateOrGetDirectRoomAsync returned", new
        {
            userId,
            ok = created.ok,
            roomId = created.roomId
        });
        // #endregion
        if (!created.ok || created.roomId <= 0)
        {
            if (showError)
                Notify.ShowError("Не удалось открыть личный чат.");
            return false;
        }
        await ReloadRoomsAsync();
        _chatSearch = string.Empty;
        await OpenRoomAsync(created.roomId);
        _pendingDirectPeerUserId = null;
        return true;
    }

    private void BackToRoomList()
    {
        _mobileChatOpen = false;
    }

    private void OpenPeerProfile()
    {
        if (!IsDirectActiveRoom || ActivePeer is null)
            return;
        _showPeerProfile = true;
    }

    private void ClosePeerProfile()
    {
