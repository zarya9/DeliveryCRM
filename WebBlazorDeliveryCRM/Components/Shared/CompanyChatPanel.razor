    private async Task SendMessageAsync()
    {
        if (!_initialized) return;
        // #region agent log
        AppendDebugLog("run1", "H4", "CompanyChatPanel.razor:SendMessageAsync:start", "SendMessageAsync called", new
        {
            activeRoomId = _activeRoomId,
            activeRoomKind = _activeRoomKind,
            pendingDirectPeerUserId = _pendingDirectPeerUserId,
            hasText = !string.IsNullOrWhiteSpace(_newMessage),
            hasAttachment = !string.IsNullOrWhiteSpace(_attachmentUrl)
        });
        // #endregion
        if (_pendingDirectPeerUserId.HasValue)
        {
            var opened = await TryOpenDirectChatWithUserAsync(_pendingDirectPeerUserId.Value, showError: false);
            if (!opened)
            {
                Notify.ShowError("Не удалось открыть личный чат.");
                return;
            }
        }
        if (_activeRoomId <= 0) return;
        var text = _newMessage.Trim();
        if (string.IsNullOrEmpty(text) && string.IsNullOrWhiteSpace(_attachmentUrl))
            return;

        var (ok, sent) = await ChatApi.SendMessageAsync(_activeRoomId, text, _attachmentUrl);
        // #region agent log
        AppendDebugLog("run1", "H4", "CompanyChatPanel.razor:SendMessageAsync:sendResult", "SendMessageAsync result", new
        {
            activeRoomId = _activeRoomId,
            activeRoomKind = _activeRoomKind,
            ok
        });
        // #endregion
        if (!ok)
        {
            Notify.ShowError("Сообщение не отправлено.");
            return;
        }

        _newMessage = string.Empty;
        _attachmentUrl = null;
        _attachmentName = null;
        if (sent != null)
            AppendMessageIfNew(ChatMessageVm.FromDto(sent, _currentUserId));
        else
            await LoadHistoryAsync(_activeRoomId);

        await ReloadRoomsAsync();
        await MarkActiveRoomAsReadAsync();
        await ChatUnreadState.RefreshAsync();
        await ScrollMessagesToBottomAsync();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
