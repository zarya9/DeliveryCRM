@implements IAsyncDisposable
@using System.Security.Claims
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.AspNetCore.Components.Web
@using WebBlazorDeliveryCRM.Components.Shared
@inject ChatHubClientService ChatHubClient
@inject ChatApiService ChatApi
@inject EmployeesApiService EmployeesApi
@inject AuthenticationStateProvider AuthStateProvider
@inject AppNotificationService Notify
@inject ChatUnreadStateService ChatUnreadState
@inject IJSRuntime JS

<div class="dms-card telegram-chat-shell">
    <aside class="telegram-chat-list">
        <div class="p-2 border-bottom">
            <input class="form-control form-control-sm" placeholder="Поиск сотрудника..." @bind="_chatSearch" @bind:event="oninput" />
            @if (SearchedEmployees.Count > 0)
            {
                <div class="telegram-user-search-results mt-2">
                    @foreach (var e in SearchedEmployees)
                    {
                        <button type="button" class="telegram-user-search-item" @onclick="() => OpenDirectChatWithUserAsync(e.Id)">
                            @e.FullName
                        </button>
                    }
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(_chatSearch))
            {
                <div class="small text-muted mt-2">Сотрудник не найден</div>
            }
        </div>
        <div class="telegram-chat-list-items">
            @foreach (var room in RoomsForList)
            {
                <button type="button" class="telegram-chat-item @(room.ChatRoomId == _activeRoomId ? "active" : "")"
                        @onclick="() => OpenRoomAsync(room.ChatRoomId)">
                    <span class="telegram-chat-avatar">@GetInitials(room.Name)</span>
                    <span class="telegram-chat-item-content">
                        <span class="telegram-chat-item-top">
                            <span class="telegram-chat-item-name">@room.Name</span>
                            <span class="telegram-chat-item-time">@FormatRoomTime(room.LastMessageAt)</span>
                        </span>
                        <span class="telegram-chat-item-preview">@GetRoomPreview(room.LastMessageText)</span>
                    </span>
                    @if (room.UnreadCount > 0)
                    {
                        <span class="telegram-chat-unread-dot" title="Непрочитанные сообщения"></span>
                    }
                </button>
            }
        </div>
    </aside>

    <section class="telegram-chat-main">
        <div class="company-chat-messages flex-grow-1 overflow-auto mb-2 telegram-chat-messages">
            @if (FilteredMessages.Count == 0)
            {
                <div class="telegram-empty-chat">
                    <div class="telegram-empty-chat-box">Сообщений пока нет</div>
                </div>
            }
            else
            {
                @foreach (var m in FilteredMessages)
                {
                    <div class="telegram-bubble-wrap @(m.IsMine ? "mine" : "other")">
                        <div class="telegram-bubble">
                            @if (ShouldShowSenderName(m))
                            {
                                <div class="telegram-sender-name">@GetSenderDisplayName(m)</div>
                            }
                            @if (_editingMessageId == m.Id && m.IsMine)
                            {
                                <div class="d-flex gap-2 flex-wrap">
                                    <input class="form-control form-control-sm" @bind="_editingText" @bind:event="oninput" />
                                    <button type="button" class="btn btn-sm btn-primary" @onclick="SaveEdit">OK</button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CancelEdit">✕</button>
                                </div>
                            }
                            else
                            {
                                <div>@m.Text</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(m.AttachmentUrl))
                            {
                                <div class="mt-2 p-2 border rounded bg-body-tertiary">
                                    <div class="small d-flex align-items-center gap-2">
                                        <span>@GetFileIcon(m.AttachmentFileName)</span>
                                        <a href="@m.AttachmentUrl" @onclick:preventDefault="true" @onclick="(() => DownloadAttachmentAsync(m))">@m.AttachmentFileName</a>
                                    </div>
                                    @if (m.IsImageAttachment)
                                    {
                                        <img src="@m.AttachmentUrl" alt="@m.AttachmentFileName" class="rounded mt-2 border telegram-image-preview" />
                                    }
                                </div>
                            }
                            <div class="small text-muted mt-1 d-flex justify-content-between">
                                <span>@m.SentAt.ToLocalTime().ToString("HH:mm") @if (m.EditedAt.HasValue) { <span>(изм.)</span> }</span>
                                @if (m.IsMine)
                                {
                                    <span class="d-flex gap-1">
                                        <button type="button" class="btn btn-sm btn-link p-0" @onclick="() => StartEdit(m.Id)">
                                            <HugeIcon Name="pencil-edit-01" CssClass="telegram-action-icon" />
                                        </button>
                                        <button type="button" class="btn btn-sm btn-link p-0 text-danger" @onclick="() => DeleteForEveryone(m.Id)">
                                            <HugeIcon Name="delete-02" CssClass="telegram-action-icon" />
                                        </button>
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        <div class="d-flex flex-wrap gap-1 mb-2">
            @foreach (var quick in CurrentQuickReplies)
            {
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => ApplyQuickReply(quick)">@quick</button>
            }
        </div>

        <div class="telegram-composer"
             @ondragover:preventDefault
             @ondrop:preventDefault
             @ondrop="OnDropFileAsync">
            <label class="telegram-clip-btn" for="chat-file-input" title="Прикрепить файл">
                <HugeIcon Name="attachment-01" CssClass="telegram-action-icon" />
                <InputFile id="chat-file-input" OnChange="OnFileSelected" style="display:none" />
            </label>
            <input class="telegram-composer-input"
                   placeholder="Сообщение"
                   @bind="_newMessage"
                   @bind:event="oninput"
                   @onkeydown="OnKeyDown" />
            <button type="button" class="telegram-send-btn" disabled="@(!CanSendMessage)" @onclick="SendMessageAsync" title="Отправить">
                <HugeIcon Name="sent" CssClass="telegram-action-icon" />
            </button>
        </div>
        @if (!string.IsNullOrWhiteSpace(_attachmentName))
        {
            <div class="small text-muted mt-1 d-flex align-items-center gap-2">
                <span>@GetFileIcon(_attachmentName) @_attachmentName</span>
                <button type="button" class="btn btn-sm btn-link p-0 text-danger" @onclick="ClearAttachment">Убрать</button>
                @if (_uploadingAttachment)
                {
                    <span class="text-muted">Загрузка...</span>
                }
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(_attachmentUrl) && IsImageFile(_attachmentName))
        {
            <img src="@_attachmentUrl" alt="preview" class="rounded border mt-2 telegram-image-preview" />
        }
    </section>
</div>

@code {
    [Parameter]
    public int? TargetUserId { get; set; }

    private readonly List<ChatMessageVm> _messages = new();
    private readonly List<ChatRoomListItemDto> _rooms = new();
    private readonly Dictionary<int, string> _roomKinds = new();
    private readonly Dictionary<int, string> _employeeNames = new();
    private readonly List<EmployeesApiService.EmployeeDto> _employees = new();
    private string _chatSearch = string.Empty;
    private string _newMessage = string.Empty;
    private int _currentUserId;
    private int _companyId;
    private bool _initialized;
    private int _activeRoomId;
    private string _activeRoomKind = "company";
    private int? _lastHandledTargetUserId;
    private int? _editingMessageId;
    private string _editingText = string.Empty;
    private bool _uploadingAttachment;
    private string? _attachmentUrl;
    private string? _attachmentName;
    private readonly string[] _categories = ["greeting", "clarification", "sla", "closing"];
    private string _selectedCategory = "greeting";
    private string _templateSearch = string.Empty;
    private readonly List<QuickReplyTemplateDto> _dbTemplates = new();
    private readonly Dictionary<string, string[]> _defaultRepliesByCategory = new Dictionary<string, string[]>
    {
        { "greeting", new[] { "Здравствуйте! Чем могу помочь?", "Добрый день! Я на связи." } },
        { "clarification", new[] { "Уточните, пожалуйста, номер заказа.", "Нужны детали: адрес и контакт получателя." } },
        { "sla", new[] { "Есть риск задержки, контролируем SLA.", "Проверяем логистику, вернусь с ETA." } },
        { "closing", new[] { "Вопрос закрыт, спасибо!", "Если что-то потребуется, пишите." } }
    };

    private bool CanSendMessage => _activeRoomId > 0 && (!string.IsNullOrWhiteSpace(_newMessage) || !string.IsNullOrWhiteSpace(_attachmentUrl));
    private List<ChatRoomListItemDto> RoomsForList => _rooms
        .Where(r => r.LastMessageAt.HasValue || !string.IsNullOrWhiteSpace(r.LastMessageText))
        .OrderByDescending(r => r.LastMessageAt ?? DateTime.MinValue)
        .ToList();
    private List<EmployeesApiService.EmployeeDto> SearchedEmployees =>
        string.IsNullOrWhiteSpace(_chatSearch)
            ? new List<EmployeesApiService.EmployeeDto>()
            : _employees
                .Where(e => e.Id != _currentUserId)
                .Where(e => e.FullName.Contains(_chatSearch, StringComparison.OrdinalIgnoreCase))
                .OrderBy(e => e.FullName)
                .Take(8)
                .ToList();
    private IEnumerable<string> CurrentQuickReplies =>
        (_defaultRepliesByCategory.TryGetValue(_selectedCategory, out var arr) ? arr : Array.Empty<string>())
        .Concat(_dbTemplates
            .Where(t => string.Equals(t.Category, _selectedCategory, StringComparison.OrdinalIgnoreCase))
            .Where(t => string.IsNullOrWhiteSpace(_templateSearch)
                || t.Title.Contains(_templateSearch, StringComparison.OrdinalIgnoreCase)
                || t.Content.Contains(_templateSearch, StringComparison.OrdinalIgnoreCase))
            .Select(t => t.Content)
            .Distinct());
    private List<ChatMessageVm> FilteredMessages => _messages.OrderBy(m => m.SentAt).ToList();

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = state.User;
        if (!int.TryParse(user.FindFirst(ClaimTypes.NameIdentifier)?.Value, out _currentUserId))
            return;
        _ = int.TryParse(user.FindFirst("companyId")?.Value, out _companyId);

        _employees.AddRange(await EmployeesApi.GetByCompanyAsync(_companyId));
        foreach (var employee in _employees)
        {
            _employeeNames[employee.Id] = employee.FullName;
        }

        var ensure = await ChatApi.EnsureCompanyRoomAsync();
        if (ensure.ok)
            _activeRoomId = ensure.roomId;

        await ReloadRoomsAsync();
        await LoadTemplatesAsync();

        var connection = await ChatHubClient.GetConnectionAsync();
        connection.On<IncomingMessage>("ReceiveMessage", msg =>
        {
            return InvokeAsync(async () =>
            {
                if (msg.chatRoomId != _activeRoomId)
                {
                    await ReloadRoomsAsync();
                    await ChatUnreadState.RefreshAsync();
                    if (msg.senderId != _currentUserId && IsDirectRoom(msg.chatRoomId))
                    {
                        var senderName = string.IsNullOrWhiteSpace(msg.senderName) ? "Сотрудник" : msg.senderName!;
                        Notify.ShowInfo($"Новое личное сообщение от {senderName}.", pushWhenHidden: true);
                    }
                    return;
                }

                if (_messages.Any(x => x.Id == msg.id)) return;
                _messages.Add(ChatMessageVm.FromIncoming(msg, _currentUserId));
                await MarkActiveRoomAsReadAsync();
                StateHasChanged();
            });
        });
        connection.On<MessageEditedSignal>("MessageEdited", msg =>
        {
            var existing = _messages.FirstOrDefault(x => x.Id == msg.messageId);
            if (existing is null) return;
            existing.Text = msg.newText ?? existing.Text;
            existing.EditedAt = msg.editedAt;
            InvokeAsync(StateHasChanged);
        });
        connection.On<MessageDeletedSignal>("MessageDeleted", msg =>
        {
            _messages.RemoveAll(x => x.Id == msg.messageId);
            InvokeAsync(StateHasChanged);
        });

        await ChatHubClient.StartAsync();
        if (_activeRoomId > 0)
        {
            await connection.SendAsync("JoinRoom", _activeRoomId);
            await LoadHistoryAsync(_activeRoomId);
            await MarkActiveRoomAsReadAsync();
        }

        if (TargetUserId.HasValue && TargetUserId.Value > 0 && TargetUserId.Value != _currentUserId)
        {
            await OpenDirectChatWithUserAsync(TargetUserId.Value);
            _lastHandledTargetUserId = TargetUserId.Value;
        }

        _initialized = true;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_initialized || !TargetUserId.HasValue || TargetUserId.Value <= 0 || TargetUserId.Value == _currentUserId)
            return;
        if (_lastHandledTargetUserId == TargetUserId.Value)
            return;

        await OpenDirectChatWithUserAsync(TargetUserId.Value);
        _lastHandledTargetUserId = TargetUserId.Value;
    }

    private async Task ReloadRoomsAsync()
    {
        _rooms.Clear();
        var rooms = await ChatApi.GetRoomsListAsync();
        _rooms.AddRange(rooms);
        _roomKinds.Clear();
        foreach (var room in rooms)
        {
            _roomKinds[room.ChatRoomId] = room.RoomKind ?? "company";
        }
        if (_activeRoomId == 0 && _rooms.Count > 0)
            _activeRoomId = _rooms[0].ChatRoomId;
        _activeRoomKind = _roomKinds.GetValueOrDefault(_activeRoomId, "company");
    }

    private async Task OpenRoomAsync(int roomId)
    {
        if (roomId <= 0) return;

        if (roomId == _activeRoomId)
        {
            await MarkActiveRoomAsReadAsync();
            await ReloadRoomsAsync();
            await ChatUnreadState.RefreshAsync();
            return;
        }

        var conn = ChatHubClient.Connection;
        if (conn != null && _activeRoomId > 0)
            await conn.SendAsync("LeaveRoom", _activeRoomId);
        _activeRoomId = roomId;
        _activeRoomKind = _roomKinds.GetValueOrDefault(roomId, "company");
        _messages.Clear();
        if (conn != null)
            await conn.SendAsync("JoinRoom", _activeRoomId);
        await LoadHistoryAsync(_activeRoomId);
        await MarkActiveRoomAsReadAsync();
        await ReloadRoomsAsync();
        await ChatUnreadState.RefreshAsync();
    }

    private async Task LoadHistoryAsync(int roomId)
    {
        var history = await ChatApi.GetMessagesAsync(roomId, 0, 200);
        _messages.Clear();
        _messages.AddRange(history
            .Where(x => !x.Is_deleted)
            .OrderBy(x => x.Sent_at)
            .Select(x => ChatMessageVm.FromDto(x, _currentUserId)));
        StateHasChanged();
    }

    private async Task OpenDirectChatWithUserAsync(int userId)
    {
        if (userId <= 0 || userId == _currentUserId)
            return;
        var created = await ChatApi.CreateOrGetDirectRoomAsync(userId);
        if (!created.ok || created.roomId <= 0)
        {
            Notify.ShowError("Не удалось открыть личный чат.");
            return;
        }
        await ReloadRoomsAsync();
        _chatSearch = string.Empty;
        await OpenRoomAsync(created.roomId);
    }

    private async Task SendMessageAsync()
    {
        if (!_initialized || _activeRoomId <= 0) return;
        var text = _newMessage.Trim();
        if (string.IsNullOrEmpty(text) && string.IsNullOrWhiteSpace(_attachmentUrl))
            return;

        var ok = await ChatApi.SendMessageAsync(_activeRoomId, text, _attachmentUrl);
        if (!ok)
        {
            Notify.ShowError("Сообщение не отправлено.");
            return;
        }

        _newMessage = string.Empty;
        _attachmentUrl = null;
        _attachmentName = null;
        await ReloadRoomsAsync();
        await MarkActiveRoomAsReadAsync();
        await ChatUnreadState.RefreshAsync();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
            await SendMessageAsync();
    }

    private void StartEdit(int messageId)
    {
        var m = _messages.FirstOrDefault(x => x.Id == messageId && x.IsMine);
        if (m is null) return;
        _editingMessageId = messageId;
        _editingText = m.Text;
    }

    private async Task SaveEdit()
    {
        if (!_editingMessageId.HasValue) return;
        var text = _editingText.Trim();
        if (string.IsNullOrWhiteSpace(text)) return;
        var ok = await ChatApi.EditMessageAsync(_editingMessageId.Value, text);
        if (!ok)
            Notify.ShowError("Не удалось отредактировать сообщение.");
        _editingMessageId = null;
        _editingText = string.Empty;
    }

    private void CancelEdit()
    {
        _editingMessageId = null;
        _editingText = string.Empty;
    }

    private async Task DeleteForEveryone(int messageId)
    {
        var ok = await ChatApi.DeleteMessageAsync(messageId);
        if (!ok)
            Notify.ShowError("Не удалось удалить сообщение.");
    }

    private void ApplyQuickReply(string text)
    {
        _newMessage = text;
    }

    private async Task LoadTemplatesAsync()
    {
        _dbTemplates.Clear();
        _dbTemplates.AddRange(await ChatApi.GetQuickRepliesAsync(null, null));
    }

    private async Task SelectCategory(string category)
    {
        _selectedCategory = category;
        await LoadTemplatesAsync();
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;
        await UploadFileAsync(file);
    }

    private async Task OnDropFileAsync(DragEventArgs _)
    {
        // Browser drag-drop for InputFile has limitations in Blazor Server;
        // keep handler to preserve UX hint and prevent default behavior.
        await Task.CompletedTask;
    }

    private async Task UploadFileAsync(IBrowserFile file)
    {
        _uploadingAttachment = true;
        _attachmentName = file.Name;
        try
        {
            var result = await ChatApi.UploadChatAttachmentAsync(file);
            if (!result.ok || string.IsNullOrWhiteSpace(result.path))
            {
                Notify.ShowError(result.error ?? "Не удалось загрузить файл.");
                _attachmentUrl = null;
                _attachmentName = null;
                return;
            }
            _attachmentUrl = result.path;
            Notify.ShowSuccess("Файл прикреплен.");
        }
        finally
        {
            _uploadingAttachment = false;
        }
    }

    private void ClearAttachment()
    {
        _attachmentUrl = null;
        _attachmentName = null;
    }

    private static string CategoryLabel(string category) => category switch
    {
        "greeting" => "Приветствие",
        "clarification" => "Уточнение",
        "sla" => "SLA/Задержка",
        "closing" => "Закрытие",
        _ => category
    };

    private async Task DownloadAttachmentAsync(ChatMessageVm message)
    {
        if (string.IsNullOrWhiteSpace(message.AttachmentUrl))
            return;
        try
        {
            await JS.InvokeVoidAsync("fileDownload.saveFromUrl", message.AttachmentUrl, message.AttachmentFileName);
        }
        catch
        {
            Notify.ShowError("Не удалось скачать вложение.");
        }
    }

    private static bool IsImageFile(string? fileName)
    {
        var ext = Path.GetExtension(fileName ?? string.Empty).ToLowerInvariant();
        return ext is ".jpg" or ".jpeg" or ".png" or ".gif" or ".webp";
    }

    private static string GetFileIcon(string? fileName)
    {
        var ext = Path.GetExtension(fileName ?? string.Empty).ToLowerInvariant();
        return ext switch
        {
            ".jpg" or ".jpeg" or ".png" or ".gif" or ".webp" => "🖼️",
            ".pdf" => "📕",
            ".doc" or ".docx" => "📄",
            ".xls" or ".xlsx" or ".csv" => "📊",
            ".zip" => "🗜️",
            _ => "📎"
        };
    }

    private static string ExtractFileName(string? urlOrPath)
    {
        if (string.IsNullOrWhiteSpace(urlOrPath))
            return "Вложение";
        try
        {
            if (Uri.TryCreate(urlOrPath, UriKind.Absolute, out var uri))
                return Path.GetFileName(uri.LocalPath);
        }
        catch { }
        return Path.GetFileName(urlOrPath);
    }

    private static string GetRoomPreview(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return "Пока нет сообщений";
        return text.Length > 34 ? $"{text[..34]}…" : text;
    }

    private static string FormatRoomTime(DateTime? dt)
    {
        if (!dt.HasValue)
            return string.Empty;
        return dt.Value.ToLocalTime().ToString("HH:mm");
    }

    private static string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1)
            return parts[0][0].ToString().ToUpperInvariant();
        return $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[1][0])}";
    }

    private bool IsDirectRoom(int roomId)
        => string.Equals(_roomKinds.GetValueOrDefault(roomId, "company"), "direct", StringComparison.OrdinalIgnoreCase);

    private bool ShouldShowSenderName(ChatMessageVm message)
        => !message.IsMine && !string.Equals(_activeRoomKind, "direct", StringComparison.OrdinalIgnoreCase);

    private string GetSenderDisplayName(ChatMessageVm message)
    {
        if (!string.IsNullOrWhiteSpace(message.SenderName))
            return message.SenderName!;
        if (_employeeNames.TryGetValue(message.SenderId, out var name) && !string.IsNullOrWhiteSpace(name))
            return name;
        return $"Пользователь #{message.SenderId}";
    }

    private async Task MarkActiveRoomAsReadAsync()
    {
        if (_activeRoomId <= 0)
            return;
        await ChatApi.MarkAllAsReadAsync(_activeRoomId);
    }

    public async ValueTask DisposeAsync()
    {
        var connection = ChatHubClient.Connection;
        if (connection != null && _activeRoomId > 0)
        {
            try
            {
                await connection.SendAsync("LeaveRoom", _activeRoomId);
            }
            catch { }
        }
    }

    private sealed class ChatMessageVm
    {
        public int Id { get; set; }
        public int SenderId { get; set; }
        public string? SenderName { get; set; }
        public string Text { get; set; } = "";
        public string? AttachmentUrl { get; set; }
        public string AttachmentFileName { get; set; } = "Вложение";
        public bool IsImageAttachment { get; set; }
        public DateTime SentAt { get; set; }
        public DateTime? EditedAt { get; set; }
        public bool IsMine { get; set; }

        public static ChatMessageVm FromDto(ChatMessageDto dto, int currentUserId) => new()
        {
            Id = dto.ID_ChatMessage,
            SenderId = dto.Sender_id,
            SenderName = dto.SenderName,
            Text = dto.MessageText,
            AttachmentUrl = dto.AttachmentUrl,
            AttachmentFileName = ExtractFileName(dto.AttachmentUrl),
            IsImageAttachment = IsImageFile(ExtractFileName(dto.AttachmentUrl)),
            SentAt = dto.Sent_at,
            EditedAt = dto.Edited_at,
            IsMine = dto.Sender_id == currentUserId
        };

        public static ChatMessageVm FromIncoming(IncomingMessage msg, int currentUserId) => new()
        {
            Id = msg.id,
            SenderId = msg.senderId,
            SenderName = msg.senderName,
            Text = msg.messageText,
            AttachmentUrl = msg.attachmentUrl,
            AttachmentFileName = ExtractFileName(msg.attachmentUrl),
            IsImageAttachment = IsImageFile(ExtractFileName(msg.attachmentUrl)),
            SentAt = msg.sentAt,
            IsMine = msg.senderId == currentUserId
        };
    }

    private sealed class IncomingMessage
    {
        public int id { get; set; }
        public int chatRoomId { get; set; }
        public int senderId { get; set; }
        public string? senderName { get; set; }
        public string messageText { get; set; } = "";
        public string? attachmentUrl { get; set; }
        public DateTime sentAt { get; set; }
    }

    private sealed class MessageEditedSignal
    {
        public int messageId { get; set; }
        public string? newText { get; set; }
        public DateTime? editedAt { get; set; }
    }

    private sealed class MessageDeletedSignal
    {
        public int messageId { get; set; }
    }
}
