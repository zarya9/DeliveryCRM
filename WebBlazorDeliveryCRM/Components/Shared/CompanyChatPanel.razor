    private static bool IsImageFile(string? fileName)
    {
        var ext = Path.GetExtension(fileName ?? string.Empty).ToLowerInvariant();
        return ext is ".jpg" or ".jpeg" or ".png" or ".gif" or ".webp";
    }

    private static string ExtractFileName(string? urlOrPath)
    {
        if (string.IsNullOrWhiteSpace(urlOrPath))
            return "Вложение";
        try
        {
            if (Uri.TryCreate(urlOrPath, UriKind.Absolute, out var uri))
                return Path.GetFileName(uri.LocalPath);
        }
        catch { }
        return Path.GetFileName(urlOrPath);
    }

    private static string GetRoomPreview(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return "Пока нет сообщений";
        return text.Length > 34 ? $"{text[..34]}…" : text;
    }

    private static string FormatRoomTime(DateTime? dt)
    {
        if (!dt.HasValue)
            return string.Empty;
        var local = dt.Value.ToLocalTime();
        var today = DateTime.Now.Date;

        if (local.Date == today)
            return local.ToString("HH:mm");

        if (local.Date >= today.AddDays(-6))
            return CultureInfo.GetCultureInfo("ru-RU").TextInfo.ToTitleCase(local.ToString("ddd", CultureInfo.GetCultureInfo("ru-RU")));

        return local.ToString("dd/MM");
    }

    private static string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1)
            return parts[0][0].ToString().ToUpperInvariant();
        return $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[1][0])}";
    }

    private bool IsDirectRoom(int roomId)
        => string.Equals(_roomKinds.GetValueOrDefault(roomId, "company"), "direct", StringComparison.OrdinalIgnoreCase);

    private static bool IsUsableDirectRoomTitle(string? title)
    {
        if (string.IsNullOrWhiteSpace(title))
            return false;
        var t = title.Trim();
        if (t.StartsWith("Чат #", StringComparison.OrdinalIgnoreCase))
            return false;
        if (t.StartsWith("ЛС", StringComparison.OrdinalIgnoreCase) || t.StartsWith("DM", StringComparison.OrdinalIgnoreCase))
            return false;
        return true;
    }

    private string FormatDirectTitleForViewer(string title)
    {
        if (_viewerIsClient)
            return title;
        return StripCompanyPrefix(title);
    }

    private static string StripCompanyPrefix(string title)
    {
        var colon = title.IndexOf(':');
        if (colon < 0)
            return title;
        var person = title[(colon + 1)..].Trim();
        return person.Length > 0 ? person : title;
    }

    private string GetRoomDisplayName(ChatRoomListItemDto room)
    {
        if (string.Equals(room.RoomKind, "direct", StringComparison.OrdinalIgnoreCase) && room.PeerUserId.HasValue)
        {
            var fromApi = room.Name?.Trim();
            if (IsUsableDirectRoomTitle(fromApi))
                return FormatDirectTitleForViewer(fromApi!);

            if (_employeeNames.TryGetValue(room.PeerUserId.Value, out var fio) && !string.IsNullOrWhiteSpace(fio))
                return fio;

            return $"Пользователь #{room.PeerUserId.Value}";
        }

        var fallback = room.Name?.Trim();
        if (!string.IsNullOrWhiteSpace(fallback) &&
            (fallback.StartsWith("ЛС", StringComparison.OrdinalIgnoreCase) || fallback.StartsWith("DM", StringComparison.OrdinalIgnoreCase)))
            return "Пользователь";

        return string.IsNullOrWhiteSpace(fallback) ? "Чат" : fallback;
    }

    private bool TryGetRoomAvatarUrl(ChatRoomListItemDto room, out string avatarUrl)
    {
        avatarUrl = string.Empty;
        if (_roomsWithAvatarError.Contains(room.ChatRoomId))
            return false;
        if (!string.Equals(room.RoomKind, "direct", StringComparison.OrdinalIgnoreCase))
            return false;
        if (!room.PeerUserId.HasValue || room.PeerUserId.Value <= 0)
            return false;

        avatarUrl = ChatApi.BuildAvatarUrl(room.PeerUserId.Value);
        return true;
    }

    private void OnRoomAvatarError(int roomId)
        => _roomsWithAvatarError.Add(roomId);

    private bool ShouldShowSenderName(ChatMessageVm message)
        => !message.IsMine && !string.Equals(_activeRoomKind, "direct", StringComparison.OrdinalIgnoreCase);

    private string GetSenderDisplayName(ChatMessageVm message)
    {
        if (!string.IsNullOrWhiteSpace(message.SenderName))
            return message.SenderName!;
        if (_employeeNames.TryGetValue(message.SenderId, out var name) && !string.IsNullOrWhiteSpace(name))
            return name;
        return $"Пользователь #{message.SenderId}";
    }

    private bool TryGetPeerLastSeen(int peerUserId, out DateTime localTime)
    {
        localTime = default;
        var dt = _rooms
            .Where(r => string.Equals(r.RoomKind, "direct", StringComparison.OrdinalIgnoreCase) && r.PeerUserId == peerUserId)
            .Select(r => r.LastMessageAt)
            .Where(v => v.HasValue)
            .Select(v => v!.Value)
            .OrderByDescending(v => v)
            .FirstOrDefault();
        if (dt == default)
            return false;
        localTime = dt.ToLocalTime();
        return true;
    }

    private static string FormatPeerLastSeen(DateTime localTime)
    {
        var today = DateTime.Now.Date;
        if (localTime.Date == today)
            return $"был(а) в {localTime:HH:mm}";
        if (localTime.Date == today.AddDays(-1))
            return $"был(а) вчера в {localTime:HH:mm}";
        return $"был(а) в сети {localTime:dd/MM}";
    }

