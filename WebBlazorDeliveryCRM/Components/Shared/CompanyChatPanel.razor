    private bool _hubEventsSubscribed;

    private void SubscribeHubEvents()
    {
        if (_hubEventsSubscribed)
            return;
        _hubEventsSubscribed = true;
        ChatHubClient.MessageReceived += OnChatMessageReceivedAsync;
        ChatHubClient.MessageEdited += OnChatMessageEditedAsync;
        ChatHubClient.MessageDeleted += OnChatMessageDeletedAsync;
        ChatHubClient.UserPresenceChanged += OnUserPresenceChangedAsync;
    }

    private void UnsubscribeHubEvents()
    {
        if (!_hubEventsSubscribed)
            return;
        _hubEventsSubscribed = false;
        ChatHubClient.MessageReceived -= OnChatMessageReceivedAsync;
        ChatHubClient.MessageEdited -= OnChatMessageEditedAsync;
        ChatHubClient.MessageDeleted -= OnChatMessageDeletedAsync;
        ChatHubClient.UserPresenceChanged -= OnUserPresenceChangedAsync;
    }

    private Task OnChatMessageReceivedAsync(ChatIncomingMessage msg)
        => InvokeAsync(async () =>
        {
            if (msg.ChatRoomId != _activeRoomId)
            {
                await ReloadRoomsAsync();
                await ChatUnreadState.RefreshAsync();
                if (msg.SenderId != _currentUserId && IsDirectRoom(msg.ChatRoomId))
                {
                    var senderName = string.IsNullOrWhiteSpace(msg.SenderName) ? "Сотрудник" : msg.SenderName!;
                    Notify.ShowInfo($"Новое личное сообщение от {senderName}.", pushWhenHidden: true);
                }
                return;
            }

            AppendMessageIfNew(ChatMessageVm.FromIncoming(msg, _currentUserId));
            await MarkActiveRoomAsReadAsync();
            StateHasChanged();
            await ScrollMessagesToBottomAsync();
        });

    private Task OnChatMessageEditedAsync(ChatHubClientService.MessageEditedSignal msg)
        => InvokeAsync(() =>
        {
            var existing = _messages.FirstOrDefault(x => x.Id == msg.messageId);
            if (existing is null)
                return Task.CompletedTask;
            existing.Text = msg.newText ?? existing.Text;
            existing.EditedAt = msg.editedAt;
            StateHasChanged();
            return Task.CompletedTask;
        });

    private Task OnChatMessageDeletedAsync(int messageId)
        => InvokeAsync(() =>
        {
            _messages.RemoveAll(x => x.Id == messageId);
            StateHasChanged();
            return Task.CompletedTask;
        });

    private Task OnUserPresenceChangedAsync(UserPresenceChangedDto payload)
        => InvokeAsync(() =>
        {
            if (payload.Online)
                _onlineUserIds.Add(payload.UserId);
            else
                _onlineUserIds.Remove(payload.UserId);
            StateHasChanged();
            return Task.CompletedTask;
        });

    private void AppendMessageIfNew(ChatMessageVm vm)
    {
        if (_messages.Any(x => x.Id == vm.Id))
            return;
        _messages.Add(vm);
    }

    public async ValueTask DisposeAsync()
    {
        UnsubscribeHubEvents();
        if (_activeRoomId > 0)
            await ChatHubClient.LeaveRoomAsync(_activeRoomId);
    }

    private sealed class ChatMessageVm
    {
        public int Id { get; set; }
        public int SenderId { get; set; }
        public string? SenderName { get; set; }
        public string Text { get; set; } = "";
        public string? AttachmentUrl { get; set; }
        public string AttachmentFileName { get; set; } = "Вложение";
        public bool IsImageAttachment { get; set; }
        public DateTime SentAt { get; set; }
        public DateTime? EditedAt { get; set; }
        public bool IsMine { get; set; }

        public static ChatMessageVm FromDto(ChatMessageDto dto, int currentUserId) => new()
        {
            Id = dto.ID_ChatMessage,
            SenderId = dto.Sender_id,
            SenderName = dto.SenderName,
            Text = dto.MessageText,
            AttachmentUrl = dto.AttachmentUrl,
            AttachmentFileName = ExtractFileName(dto.AttachmentUrl),
            IsImageAttachment = IsImageFile(ExtractFileName(dto.AttachmentUrl)),
            SentAt = dto.Sent_at,
            EditedAt = dto.Edited_at,
            IsMine = dto.Sender_id == currentUserId
        };

        public static ChatMessageVm FromIncoming(ChatIncomingMessage msg, int currentUserId) => new()
        {
            Id = msg.Id,
            SenderId = msg.SenderId,
            SenderName = msg.SenderName,
            Text = msg.MessageText,
            AttachmentUrl = msg.AttachmentUrl,
            AttachmentFileName = ExtractFileName(msg.AttachmentUrl),
            IsImageAttachment = IsImageFile(ExtractFileName(msg.AttachmentUrl)),
            SentAt = msg.SentAt,
            IsMine = msg.SenderId == currentUserId
        };
    }

