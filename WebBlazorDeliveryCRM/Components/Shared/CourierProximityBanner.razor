@using WebBlazorDeliveryCRM.Models
@using WebBlazorDeliveryCRM.Services
@implements IDisposable
@inject CourierProximityState Proximity
@inject OrdersApiService OrdersApi
@inject AppNotificationService Notify
@inject NavigationManager Nav

@if (_stop is not null && !IsRouteMapPage)
{
    <div class="courier-proximity-banner" role="status">
        <div class="courier-proximity-banner__body">
            <div class="courier-proximity-banner__text">
                <strong>Заказ №@_stop.OrderNumber</strong>
                <span class="d-block small">@_stop.Title · ~@_stop.DistanceMeters.ToString("0") м</span>
                @if (!string.IsNullOrWhiteSpace(_stop.AddressLine))
                {
                    <span class="d-block small text-muted">@_stop.AddressLine</span>
                }
            </div>
            <button type="button"
                    class="btn btn-success btn-sm flex-shrink-0"
                    disabled="@_busy"
                    @onclick="ConfirmAsync">
                @(_busy ? "…" : ActionButtonLabel)
            </button>
        </div>
    </div>
}

@code {
    private NearbyDeliveryStopDto? _stop;
    private bool _busy;

    private bool IsPickup =>
        string.Equals(_stop?.StopKind, "Pickup", StringComparison.OrdinalIgnoreCase);

    private string ActionButtonLabel => IsPickup ? "Забрал" : "Доставлен";

    /// <summary>На «Карта маршрута» свой toast сверху — не дублируем нижний баннер.</summary>
    private bool IsRouteMapPage =>
        Nav.Uri.Contains("/courier/route", StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        Proximity.Changed += OnProximityChanged;
        _stop = Proximity.PrimaryNearby;
    }

    private void OnProximityChanged()
    {
        _stop = Proximity.PrimaryNearby;
        InvokeAsync(StateHasChanged);
    }

    private async Task ConfirmAsync()
    {
        if (_stop is null)
            return;

        _busy = true;
        try
        {
            if (_stop.AssignmentId > 0)
            {
                var result = await OrdersApi.CompleteRouteStopAsync(_stop.AssignmentId, null);
                if (result == null)
                {
                    Notify.ShowError("Не удалось обновить статус. Проверьте смену и маршрут.");
                    return;
                }

                if (result.OrderDelivered)
                    Notify.ShowSuccess($"Заказ №{result.OrderNumber} доставлен. Клиенту отправлено уведомление.");
                else if (IsPickup)
                    Notify.ShowSuccess($"Заказ №{result.OrderNumber} забран. Статус: {result.NewStatusName ?? "В пути"}.");
                else
                    Notify.ShowSuccess($"Точка выполнена. Статус: {result.NewStatusName ?? "обновлён"}.");
            }
            else if (IsPickup)
            {
                var statuses = await OrdersApi.GetOrderStatusesAsync();
                var inTransitId = statuses.FirstOrDefault(s =>
                    string.Equals(s.Name, "В пути", StringComparison.OrdinalIgnoreCase))?.Id;
                if (!inTransitId.HasValue || inTransitId.Value <= 0)
                {
                    Notify.ShowError("Статус «В пути» не найден в системе.");
                    return;
                }

                if (!await OrdersApi.ChangeStatusAsync(_stop.OrderId, inTransitId.Value))
                {
                    Notify.ShowError("Не удалось отметить забор заказа.");
                    return;
                }

                Notify.ShowSuccess($"Заказ №{_stop.OrderNumber} забран.");
            }
            else
            {
                var statuses = await OrdersApi.GetOrderStatusesAsync();
                var deliveredId = statuses.FirstOrDefault(s =>
                    string.Equals(s.Name, "Доставлен", StringComparison.OrdinalIgnoreCase))?.Id;
                if (!deliveredId.HasValue || deliveredId.Value <= 0)
                {
                    Notify.ShowError("Статус «Доставлен» не найден в системе.");
                    return;
                }

                if (!await OrdersApi.ChangeStatusAsync(_stop.OrderId, deliveredId.Value))
                {
                    Notify.ShowError("Не удалось отметить заказ как доставленный.");
                    return;
                }

                Notify.ShowSuccess($"Заказ №{_stop.OrderNumber} доставлен. Клиенту отправлено уведомление.");
            }

            Proximity.Clear();
        }
        finally
        {
            _busy = false;
        }
    }

    public void Dispose() => Proximity.Changed -= OnProximityChanged;
}
