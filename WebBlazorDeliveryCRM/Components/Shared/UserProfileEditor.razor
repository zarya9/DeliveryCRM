@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Forms
@using WebBlazorDeliveryCRM.Services
@inject AuthenticationStateProvider AuthStateProvider
@inject AccountApiService AccountApi
@inject ClientsApiService ClientsApi
@inject AppNotificationService Notify
@inject IConfiguration Configuration
@inject NavigationManager Navigation

<PageTitle>@Title</PageTitle>

<div class="dms-page-header">
    <h1 class="@(string.IsNullOrEmpty(TitleIconName) ? null : "dms-page-title-with-icon")">
        @if (!string.IsNullOrEmpty(TitleIconName))
        {
            <HugeIcon Name="@TitleIconName" CssClass="dms-page-title-icon" />
        }
        @Title
    </h1>
    <p class="subtitle">Личный кабинет, данные аккаунта и безопасность</p>
</div>

<div class="dms-card profile-shell">
    @if (_loading)
    {
        <p class="text-muted mb-0">Загрузка профиля...</p>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger mb-0">@_error</div>
    }
    else
    {
        <div class="profile-column">
            <div class="profile-avatar-card">
                <img src="@AvatarUrl" alt="Аватар" class="profile-avatar-img" @onerror="OnAvatarError" />
                <div class="profile-name">@DisplayName</div>
                <div class="profile-meta"><strong>Должность:</strong> @_roleName</div>
                <div class="profile-meta"><strong>Дата рождения:</strong> @_birthDateText</div>
                <div class="profile-meta"><strong>Компания:</strong> @_companyName</div>
                <div class="profile-meta"><strong>Почтовый адрес:</strong> @_email</div>
                <div class="mt-2 d-flex gap-2 justify-content-start flex-wrap">
                    <label class="btn btn-outline-secondary btn-sm mb-0">
                        Загрузить аватар
                        <InputFile class="d-none" OnChange="OnAvatarSelected" accept=".jpg,.jpeg,.png,.gif,.webp,image/*" />
                    </label>
                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="ToggleEditProfile">
                        @(_isEditProfile ? "Отменить" : "Редактировать")
                    </button>
                </div>
            </div>

            @if (_isEditProfile)
            {
                <div class="row g-3 mt-2">
                    <div class="col-md-4">
                        <label class="form-label">Имя</label>
                        <input class="form-control form-control-lg" @bind="_fName" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Фамилия</label>
                        <input class="form-control form-control-lg" @bind="_name" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Отчество</label>
                        <input class="form-control form-control-lg" @bind="_patronymic" />
                    </div>
                    <div class="col-12">
                        <button type="button" class="btn btn-primary px-4" disabled="@_savingProfile" @onclick="SaveProfileAsync">
                            @(_savingProfile ? "Сохранение..." : "Сохранить")
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

<div class="dms-card mt-3 profile-shell">
    <h2 class="dms-card-title @(string.IsNullOrEmpty(TitleIconName) ? "mb-1" : "dms-card-title-with-icon mb-1")">
        @if (!string.IsNullOrEmpty(TitleIconName))
        {
            <HugeIcon Name="settings-01" CssClass="dms-card-title-icon" />
        }
        Смена пароля
    </h2>
    <p class="text-muted small mb-2">Смена пароля — через восстановление по коду из письма.</p>
    <button type="button" class="btn btn-link btn-sm p-0" @onclick="GoForgotPassword">Забыли пароль?</button>
</div>

@code {
    [Parameter] public string Title { get; set; } = "Данные о сотруднике";
    /// <summary>Имя иконки HugeIcon для заголовка страницы; при null — без иконки.</summary>
    [Parameter] public string? TitleIconName { get; set; }

    private bool _loading = true;
    private string? _error;
    private int _currentUserId;
    private string _email = string.Empty;
    private string _fName = string.Empty;
    private string _name = string.Empty;
    private string _patronymic = string.Empty;
    private string _roleName = "—";
    private string _companyName = "—";
    private string _birthDateText = "Не указана";
    private bool _savingProfile;
    private bool _isEditProfile;
    private long _avatarVersion = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
    private bool _avatarFailed;

    private string DisplayName
    {
        get
        {
            var v = $"{_fName} {_name} {_patronymic}".Trim();
            return string.IsNullOrWhiteSpace(v) ? "Сотрудник" : v;
        }
    }

    private string AvatarUrl => _avatarFailed
        ? "/favicon.png"
        : (_currentUserId > 0
            ? BuildAvatarApiUrl(_currentUserId)
            : "/favicon.png");

    private string BuildAvatarApiUrl(int userId)
    {
        var raw = Configuration["ApiBaseUrl"];
        var apiBase = string.IsNullOrWhiteSpace(raw) ? "http://localhost:5220" : raw.TrimEnd('/');
        var q = $"v={_avatarVersion}";
        return $"{apiBase}/api/Files/avatar/{userId}?{q}";
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = state.User;
            var userIdRaw = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            if (!int.TryParse(userIdRaw, out _currentUserId))
            {
                _error = "Не удалось определить текущего пользователя.";
                return;
            }

            _email = user.FindFirst(ClaimTypes.Email)?.Value
                ?? user.FindFirst("email")?.Value
                ?? string.Empty;
            _roleName = user.FindFirst(ClaimTypes.Role)?.Value ?? "—";
            _companyName = user.FindFirst("company")?.Value ?? "—";

            var fullName = user.FindFirst(ClaimTypes.Name)?.Value?.Trim() ?? string.Empty;
            if (!string.IsNullOrWhiteSpace(fullName))
            {
                var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                if (parts.Length > 0) _fName = parts[0];
                if (parts.Length > 1) _name = parts[1];
                if (parts.Length > 2) _patronymic = string.Join(' ', parts.Skip(2));
            }

            var fullUser = await AccountApi.GetMyUserAsync(_currentUserId);
            if (fullUser is not null && !string.IsNullOrWhiteSpace(fullUser.BirthDate))
                _birthDateText = fullUser.BirthDate!;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveProfileAsync()
    {
        _savingProfile = true;
        try
        {
            var (ok, error) = await AccountApi.UpdateMyAccountAsync(new WebBlazorDeliveryCRM.Models.UpdateMyAccountRequestDto
            {
                FName = _fName,
                Name = _name,
                Patronumic = _patronymic
            });

            if (!ok)
            {
                Notify.ShowError(error ?? "Не удалось сохранить профиль.");
                return;
            }

            Notify.ShowSuccess("Профиль обновлён.");
            _isEditProfile = false;
        }
        finally
        {
            _savingProfile = false;
        }
    }

    private async Task OnAvatarSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null || _currentUserId <= 0)
            return;

        var ext = Path.GetExtension(file.Name).ToLowerInvariant();
        if (ext is not ".jpg" and not ".jpeg" and not ".png" and not ".gif" and not ".webp")
        {
            Notify.ShowWarning("Выберите изображение: JPG, PNG, GIF или WEBP.");
            return;
        }

        var (ok, error) = await ClientsApi.UploadAvatarAsync(_currentUserId, file);
        if (!ok)
        {
            Notify.ShowError(error ?? "Не удалось загрузить аватар.");
            return;
        }

        Notify.ShowSuccess("Аватар обновлён.");
        _avatarFailed = false;
        _avatarVersion = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        StateHasChanged();
    }

    private void ToggleEditProfile() => _isEditProfile = !_isEditProfile;

    private void GoForgotPassword()
    {
        var q = string.IsNullOrWhiteSpace(_email) ? string.Empty : $"?email={Uri.EscapeDataString(_email)}";
        Navigation.NavigateTo("/forgot-password" + q, forceLoad: true);
    }
    private void OnAvatarError()
    {
        _avatarFailed = true;
        StateHasChanged();
    }
}
