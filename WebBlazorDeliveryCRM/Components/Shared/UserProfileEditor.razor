@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Forms
@using WebBlazorDeliveryCRM.Services
@inject AuthenticationStateProvider AuthStateProvider
@inject AccountApiService AccountApi
@inject ClientsApiService ClientsApi
@inject AppNotificationService Notify

<PageTitle>@Title</PageTitle>

<div class="dms-page-header">
    <h1>@Title</h1>
    <p class="subtitle">Личный кабинет, данные аккаунта и безопасность</p>
</div>

<div class="dms-card profile-shell">
    @if (_loading)
    {
        <p class="text-muted mb-0">Загрузка профиля...</p>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger mb-0">@_error</div>
    }
    else
    {
        <div class="profile-column">
            <div class="profile-avatar-card">
                <img src="@AvatarUrl" alt="Аватар" class="profile-avatar-img" @onerror="OnAvatarError" />
                <div class="profile-name">@DisplayName</div>
                <div class="profile-meta"><strong>Должность:</strong> @_roleName</div>
                <div class="profile-meta"><strong>Дата рождения:</strong> @_birthDateText</div>
                <div class="profile-meta"><strong>Компания:</strong> @_companyName</div>
                <div class="profile-meta"><strong>Логин (почта):</strong> @_email</div>
                <div class="mt-2 d-flex gap-2 justify-content-start flex-wrap">
                    <label class="btn btn-outline-secondary btn-sm mb-0">
                        Загрузить аватар
                        <InputFile class="d-none" OnChange="OnAvatarSelected" accept=".jpg,.jpeg,.png,.gif,.webp,image/*" />
                    </label>
                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="ToggleEditProfile">
                        @(_isEditProfile ? "Отменить" : "Редактировать")
                    </button>
                </div>
            </div>

            @if (_isEditProfile)
            {
                <div class="row g-3 mt-2">
                    <div class="col-md-4">
                        <label class="form-label">Имя</label>
                        <input class="form-control form-control-lg" @bind="_fName" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Фамилия</label>
                        <input class="form-control form-control-lg" @bind="_name" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Отчество</label>
                        <input class="form-control form-control-lg" @bind="_patronymic" />
                    </div>
                    <div class="col-12">
                        <button type="button" class="btn btn-primary px-4" disabled="@_savingProfile" @onclick="SaveProfileAsync">
                            @(_savingProfile ? "Сохранение..." : "Сохранить")
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

<div class="dms-card mt-3 profile-shell">
    <h2 class="dms-card-title mb-1">Смена пароля</h2>
    <p class="text-muted small mb-2">Если не помните пароль, откройте форму восстановления.</p>
    <button type="button" class="btn btn-link p-0" @onclick="OpenPasswordModal">Забыли пароль?</button>
</div>

@if (_showPasswordModal)
{
    <div class="profile-modal-backdrop" @onclick="ClosePasswordModal">
        <div class="profile-modal-card" @onclick:stopPropagation="true">
            <h3 class="h5 mb-2">Смена пароля</h3>
            <p class="small text-muted mb-3">Введите текущий пароль и новый пароль для обновления.</p>
            <div class="mb-2">
                <label class="form-label">Текущий пароль</label>
                <input type="password" class="form-control" @bind="_currentPassword" autocomplete="current-password" />
            </div>
            <div class="mb-3">
                <label class="form-label">Новый пароль</label>
                <input type="password" class="form-control" @bind="_newPassword" autocomplete="new-password" />
            </div>
            <div class="d-flex gap-2 justify-content-end">
                <button type="button" class="btn btn-outline-secondary" @onclick="ClosePasswordModal">Отмена</button>
                <button type="button" class="btn btn-primary" disabled="@_savingPassword" @onclick="SavePasswordAsync">
                    @(_savingPassword ? "Сохранение..." : "Сменить пароль")
                </button>
            </div>
        </div>
    </div>
}

<style>
    .profile-shell {
        border: 1px solid rgba(148, 163, 184, 0.25);
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
    }

    .profile-avatar-card {
        border: 1px solid rgba(148, 163, 184, 0.22);
        border-radius: 14px;
        padding: 1rem;
        text-align: left;
        background: linear-gradient(180deg, rgba(15, 23, 42, 0.04) 0%, rgba(15, 23, 42, 0.01) 100%);
    }
    .profile-column {
        display: flex;
        flex-direction: column;
        gap: .75rem;
    }

    .profile-avatar-img {
        width: 136px;
        height: 136px;
        border-radius: 10px;
        object-fit: cover;
        border: 3px solid rgba(255, 255, 255, 0.9);
        box-shadow: 0 8px 20px rgba(15, 23, 42, 0.18);
        margin-bottom: .75rem;
        display: block;
    }

    .profile-name {
        font-weight: 700;
        font-size: 1.05rem;
        line-height: 1.25;
    }

    .profile-email {
        color: var(--bs-secondary-color);
        font-size: .9rem;
        margin-top: .25rem;
        word-break: break-all;
    }
    .profile-meta {
        font-size: .93rem;
        margin-top: .3rem;
    }
    .profile-modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.45);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1200;
    }
    .profile-modal-card {
        width: min(95vw, 520px);
        background: #fff;
        border-radius: 12px;
        padding: 1rem;
        box-shadow: 0 20px 50px rgba(2, 6, 23, 0.3);
    }
</style>

@code {
    [Parameter] public string Title { get; set; } = "Профиль";

    private bool _loading = true;
    private string? _error;
    private int _currentUserId;
    private string _email = string.Empty;
    private string _fName = string.Empty;
    private string _name = string.Empty;
    private string _patronymic = string.Empty;
    private string _roleName = "—";
    private string _companyName = "—";
    private string _birthDateText = "Не указана";
    private string _currentPassword = string.Empty;
    private string _newPassword = string.Empty;
    private bool _savingProfile;
    private bool _savingPassword;
    private bool _isEditProfile;
    private bool _showPasswordModal;
    private long _avatarVersion = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
    private bool _avatarFailed;

    private string DisplayName
    {
        get
        {
            var v = $"{_fName} {_name}".Trim();
            return string.IsNullOrWhiteSpace(v) ? "Пользователь" : v;
        }
    }

    private string AvatarUrl => _avatarFailed
        ? "/favicon.png"
        : (_currentUserId > 0
            ? $"/api/Files/avatar/{_currentUserId}?v={_avatarVersion}"
            : "/favicon.png");

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = state.User;
            var userIdRaw = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            if (!int.TryParse(userIdRaw, out _currentUserId))
            {
                _error = "Не удалось определить текущего пользователя.";
                return;
            }

            _email = user.FindFirst(ClaimTypes.Email)?.Value
                ?? user.FindFirst("email")?.Value
                ?? string.Empty;
            _roleName = user.FindFirst(ClaimTypes.Role)?.Value ?? "—";
            _companyName = user.FindFirst("company")?.Value ?? "—";

            // Не дергаем отдельный endpoint профиля пользователя:
            // некоторые окружения возвращают перегруженный User-объект, что ломает страницу.
            var fullName = user.FindFirst(ClaimTypes.Name)?.Value?.Trim() ?? string.Empty;
            if (!string.IsNullOrWhiteSpace(fullName))
            {
                var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                if (parts.Length > 0) _fName = parts[0];
                if (parts.Length > 1) _name = parts[1];
                if (parts.Length > 2) _patronymic = string.Join(' ', parts.Skip(2));
            }

            var fullUser = await AccountApi.GetMyUserAsync(_currentUserId);
            if (fullUser is not null && !string.IsNullOrWhiteSpace(fullUser.BirthDate))
                _birthDateText = fullUser.BirthDate!;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveProfileAsync()
    {
        _savingProfile = true;
        try
        {
            var (ok, error) = await AccountApi.UpdateMyAccountAsync(new WebBlazorDeliveryCRM.Models.UpdateMyAccountRequestDto
            {
                FName = _fName,
                Name = _name,
                Patronumic = _patronymic
            });

            if (!ok)
            {
                Notify.ShowError(error ?? "Не удалось сохранить профиль.");
                return;
            }

            Notify.ShowSuccess("Профиль обновлён.");
            _isEditProfile = false;
        }
        finally
        {
            _savingProfile = false;
        }
    }

    private async Task SavePasswordAsync()
    {
        if (string.IsNullOrWhiteSpace(_currentPassword) || string.IsNullOrWhiteSpace(_newPassword))
        {
            Notify.ShowWarning("Введите текущий и новый пароль.");
            return;
        }

        _savingPassword = true;
        try
        {
            var (ok, error) = await AccountApi.UpdateMyAccountAsync(new WebBlazorDeliveryCRM.Models.UpdateMyAccountRequestDto
            {
                CurrentPassword = _currentPassword,
                NewPassword = _newPassword
            });

            if (!ok)
            {
                Notify.ShowError(error ?? "Не удалось сменить пароль.");
                return;
            }

            _currentPassword = string.Empty;
            _newPassword = string.Empty;
            Notify.ShowSuccess("Пароль обновлён.");
            ClosePasswordModal();
        }
        finally
        {
            _savingPassword = false;
        }
    }

    private async Task OnAvatarSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null || _currentUserId <= 0)
            return;

        var ext = Path.GetExtension(file.Name).ToLowerInvariant();
        if (ext is not ".jpg" and not ".jpeg" and not ".png" and not ".gif" and not ".webp")
        {
            Notify.ShowWarning("Выберите изображение: JPG, PNG, GIF или WEBP.");
            return;
        }

        var (ok, error) = await ClientsApi.UploadAvatarAsync(_currentUserId, file);
        if (!ok)
        {
            Notify.ShowError(error ?? "Не удалось загрузить аватар.");
            return;
        }

        Notify.ShowSuccess("Аватар обновлён.");
        _avatarFailed = false;
        _avatarVersion = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        StateHasChanged();
    }

    private void ToggleEditProfile() => _isEditProfile = !_isEditProfile;
    private void OpenPasswordModal() => _showPasswordModal = true;
    private void ClosePasswordModal() => _showPasswordModal = false;
    private void OnAvatarError()
    {
        _avatarFailed = true;
        StateHasChanged();
    }
}
