@implements IDisposable
@using Microsoft.AspNetCore.SignalR.Client
@using WebBlazorDeliveryCRM.Models
@using WebBlazorDeliveryCRM.Services
@inject NotificationsApiService NotificationsApi
@inject ChatHubClientService ChatHub
@inject AppNotificationService Notify

<div class="dms-card">
    <div class="notifications-inbox-toolbar d-flex justify-content-between align-items-center mb-3">
        <h2 class="dms-card-title @(string.IsNullOrEmpty(ToolbarTitleIconName) ? null : "dms-card-title-with-icon") mb-0">
            @if (!string.IsNullOrEmpty(ToolbarTitleIconName))
            {
                <HugeIcon Name="@ToolbarTitleIconName" CssClass="dms-card-title-icon" />
            }
            Входящие
        </h2>
        <div class="d-flex gap-2 flex-wrap align-items-center">
            <label class="small text-muted mb-0" for="notif-filter-select">Фильтр</label>
            <select id="notif-filter-select" class="form-select form-select-sm notifications-filter-select" value="@_selectedFilter" @onchange="OnFilterChanged">
                <option value="all">Все уведомления</option>
                <option value="unread">Только непрочитанные</option>
                <option value="critical">Только критичные</option>
                <option value="ack">Требуют подтверждения</option>
            </select>
        </div>
    </div>

    @if (_loading && _items is null)
    {
        <p class="text-muted">Загрузка…</p>
    }
    else if (_items is null || _items.Count == 0)
    {
        <p class="text-muted mb-0">Пока нет уведомлений. Они появятся при новых сообщениях в чатах и других событиях.</p>
    }
    else
    {
        <div class="list-group notifications-list">
            @foreach (var n in _items.OrderByDescending(x => x.SentAt))
            {
                <div class="list-group-item list-group-item-action d-flex flex-column flex-md-row gap-2 notifications-item @(n.IsRead ? "" : "notifications-item--unread")">
                    <div class="flex-grow-1">
                        <div class="d-flex flex-wrap gap-2 align-items-baseline">
                            <strong class="notifications-title">@n.Title</strong>
                            @if (!string.IsNullOrEmpty(n.TypeName))
                            {
                                <StatusBadge Text="@n.TypeName" Tone="neutral" />
                            }
                            @if (!n.IsRead)
                            {
                                <StatusBadge Text="Новое" Tone="primary" />
                            }
                            @if (n.IsCritical)
                            {
                                <StatusBadge Text="Критичное" Tone="danger" />
                            }
                            @if (n.RequiresAck && !n.AcknowledgedAt.HasValue)
                            {
                                <StatusBadge Text="Нужно подтвердить" Tone="warning" />
                            }
                        </div>
                        <p class="mb-1 mt-1 small notifications-message">@n.Message</p>
                        <div class="text-muted small notifications-meta">
                            @n.SentAt.ToString("dd.MM.yyyy")
                            @if (n.OrderId.HasValue)
                            {
                                <span> · Заказ #@n.OrderId</span>
                            }
                        </div>
                        @if (n.ShiftId.HasValue)
                        {
                            <a class="btn btn-sm btn-outline-primary mt-2" href="@($"/logistician/shifts/{n.ShiftId.Value}")">
                                Итоговый маршрут смены
                            </a>
                        }
                    </div>
                    @if (!n.IsRead)
                    {
                        <div>
                            <button type="button" class="btn btn-sm btn-outline-primary" disabled="@_marking" @onclick="() => MarkRead(n)">
                                Прочитано
                            </button>
                            @if (n.RequiresAck && !n.AcknowledgedAt.HasValue)
                            {
                                <button type="button" class="btn btn-sm btn-outline-danger ms-1" disabled="@_marking" @onclick="() => Ack(n)">
                                    Подтвердить
                                </button>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    /// <summary>Иконка слева от «Входящие»; null — без иконки (старый вид).</summary>
    [Parameter] public string? ToolbarTitleIconName { get; set; }

    private List<NotificationItemDto>? _items;
    private bool _loading = true;
    private bool _marking;
    private IDisposable? _hubSub;
    private string _selectedFilter = "all";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await Reload();

        try
        {
            var conn = await ChatHub.GetConnectionAsync();
            await ChatHub.StartAsync();
            _hubSub = conn.On<NotificationReceivedSignalDto>("NotificationReceived", _ =>
            {
                return Reload(showSpinner: false);
            });
        }
        catch
        {
            /* SignalR опционален */
        }
    }

    private async Task Reload(bool showSpinner = true)
    {
        if (showSpinner)
        {
            _loading = true;
            StateHasChanged();
        }
        try
        {
            var onlyUnread = _selectedFilter == "unread";
            var onlyCritical = _selectedFilter == "critical";
            var onlyAckRequired = _selectedFilter == "ack";
            _items = await NotificationsApi.GetMineAsync(
                onlyCritical: onlyCritical,
                onlyUnread: onlyUnread,
                onlyRequiresAck: onlyAckRequired) ?? new();
        }
        finally
        {
            if (showSpinner)
                _loading = false;
            StateHasChanged();
        }
    }

    private async Task OnFilterChanged(ChangeEventArgs e)
    {
        _selectedFilter = e.Value?.ToString() ?? "all";
        await Reload();
    }

    private async Task MarkRead(NotificationItemDto n)
    {
        _marking = true;
        try
        {
            if (await NotificationsApi.MarkAsReadAsync(n.Id))
            {
                n.IsRead = true;
                StateHasChanged();
            }
        }
        finally
        {
            _marking = false;
        }
    }

    private async Task Ack(NotificationItemDto n)
    {
        _marking = true;
        try
        {
            if (await NotificationsApi.AcknowledgeAsync(n.Id))
            {
                n.AcknowledgedAt = DateTime.UtcNow;
                n.IsRead = true;
                StateHasChanged();
            }
        }
        finally
        {
            _marking = false;
        }
    }

    public void Dispose()
    {
        _hubSub?.Dispose();
    }
}
