@implements IDisposable
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using WebBlazorDeliveryCRM.Models
@using WebBlazorDeliveryCRM.Services
@using WebBlazorDeliveryCRM.Utilities
@inject NotificationsApiService NotificationsApi
@inject ChatHubClientService ChatHub
@inject AppNotificationService Notify
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject NotificationsUnreadStateService UnreadState
@inject IJSRuntime JS

<div class="dms-card notifications-inbox-card">
    <div class="notifications-inbox-toolbar">
        <h2 class="dms-card-title @(string.IsNullOrEmpty(ToolbarTitleIconName) ? null : "dms-card-title-with-icon") mb-0">
            @if (!string.IsNullOrEmpty(ToolbarTitleIconName))
            {
                <HugeIcon Name="@ToolbarTitleIconName" CssClass="dms-card-title-icon" />
            }
            Входящие
        </h2>
        <div class="notifications-inbox-filter">
            <select id="notif-filter-select" class="form-select form-select-sm notifications-filter-select" value="@_selectedFilter" @onchange="OnFilterChanged">
                <option value="all">Все уведомления</option>
                <option value="unread">Только непрочитанные</option>
                <option value="critical">Только критичные</option>
                <option value="ack">Требуют подтверждения</option>
            </select>
        </div>
    </div>

    @if (_loading && _items is null)
    {
        <p class="text-muted mb-0">Загрузка…</p>
    }
    else if (_items is null || _items.Count == 0)
    {
        <div class="notifications-empty">
            <HugeIcon Name="notification-01" CssClass="notifications-empty-icon" />
            <p class="mb-0 text-muted">Пока нет уведомлений. Здесь появятся события по заказам, сменам и SLA.</p>
        </div>
    }
    else
    {
        <div class="notifications-list">
            @foreach (var n in _items.OrderByDescending(x => x.SentAt))
            {
                var visual = NotificationVisuals.Resolve(n);
                var canOpen = ResolveCanOpen(n);
                <article class="notifications-item @(n.IsRead ? "notifications-item--read" : "notifications-item--unread") @(canOpen ? "notifications-item--clickable" : "")"
                         data-notification-id="@(n.IsRead ? null : n.Id)"
                         role="@(canOpen ? "button" : null)"
                         tabindex="@(canOpen ? 0 : -1)"
                         @onclick="() => OnItemClickAsync(n)"
                         @onkeydown="e => OnItemKeydownAsync(e, n)">
                    <div class="notifications-item-icon notifications-item-icon--@visual.Tone" title="@visual.CategoryLabel">
                        <HugeIcon Name="@visual.IconName" CssClass="notifications-item-icon-svg" />
                    </div>
                    <div class="notifications-item-body">
                        <div class="notifications-item-head">
                            <div class="notifications-item-titles">
                                <span class="notifications-item-category">@visual.CategoryLabel</span>
                                <strong class="notifications-title">@n.Title</strong>
                            </div>
                            <div class="notifications-item-badges">
                                @if (n.IsCritical)
                                {
                                    <StatusBadge Text="Критичное" Tone="danger" />
                                }
                                @if (n.RequiresAck && !n.AcknowledgedAt.HasValue)
                                {
                                    <StatusBadge Text="Подтвердить" Tone="warning" />
                                }
                            </div>
                        </div>
                        <p class="notifications-message mb-0">@n.Message</p>
                        <div class="notifications-meta">
                            <span>@n.SentAt.ToString("dd.MM.yyyy")</span>
                            @if (n.OrderId.HasValue)
                            {
                                <span> · Заказ #@n.OrderId</span>
                            }
                            @if (n.ShiftId.HasValue)
                            {
                                <span> · Смена #@n.ShiftId</span>
                            }
                        </div>
                    </div>
                    @if (n.RequiresAck && !n.AcknowledgedAt.HasValue)
                    {
                        <div class="notifications-item-actions" @onclick:stopPropagation="true">
                            <button type="button" class="btn btn-sm btn-outline-danger" disabled="@_marking" @onclick="() => Ack(n)">
                                Подтвердить
                            </button>
                        </div>
                    }
                </article>
            }
        </div>
    }
</div>

@code {
    [Parameter] public string? ToolbarTitleIconName { get; set; }

    private List<NotificationItemDto>? _items;
    private bool _loading = true;
    private bool _marking;
    private IDisposable? _hubSub;
    private string _selectedFilter = "all";
    private string? _role;
    private DotNetObjectReference<NotificationsInbox>? _dotNetRef;
    private string? _observeFingerprint;
    private readonly HashSet<int> _autoMarkInFlight = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);

            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            _role = state.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
                     ?? state.User.FindFirst("role")?.Value;

            await Reload();

            try
            {
                var conn = await ChatHub.GetConnectionAsync();
                await ChatHub.StartAsync();
                _hubSub = conn.On<NotificationReceivedSignalDto>("NotificationReceived", _ =>
                {
                    return Reload(showSpinner: false);
                });
            }
            catch
            {
                /* SignalR опционален */
            }
        }

        await EnsureVisibilityObserverAsync();
    }

    private async Task EnsureVisibilityObserverAsync()
    {
        if (_items is null || _loading || _dotNetRef is null)
            return;

        var fingerprint = string.Join(',', _items.Where(x => !x.IsRead).Select(x => x.Id));
        if (fingerprint == _observeFingerprint)
            return;

        _observeFingerprint = fingerprint;

        try
        {
            await JS.InvokeVoidAsync("deliveryCrmNotificationsInbox.observe", _dotNetRef, ".notifications-list");
        }
        catch
        {
            // JS interop may fail during prerender/dispose
        }
    }

    [JSInvokable]
    public async Task OnNotificationVisible(int notificationId)
    {
        if (_items is null || notificationId <= 0)
            return;

        var item = _items.FirstOrDefault(x => x.Id == notificationId);
        if (item is null || item.IsRead)
            return;

        if (!_autoMarkInFlight.Add(notificationId))
            return;

        try
        {
            await MarkReadAsync(item);
        }
        finally
        {
            _autoMarkInFlight.Remove(notificationId);
        }
    }

    private async Task Reload(bool showSpinner = true)
    {
        if (showSpinner)
        {
            _loading = true;
            StateHasChanged();
        }
        try
        {
            var onlyUnread = _selectedFilter == "unread";
            var onlyCritical = _selectedFilter == "critical";
            var onlyAckRequired = _selectedFilter == "ack";
            _items = await NotificationsApi.GetMineAsync(
                onlyCritical: onlyCritical,
                onlyUnread: onlyUnread,
                onlyRequiresAck: onlyAckRequired) ?? new();

            _observeFingerprint = null;
            await UnreadState.RefreshAsync();
        }
        finally
        {
            if (showSpinner)
                _loading = false;
            StateHasChanged();
        }
    }

    private async Task OnFilterChanged(ChangeEventArgs e)
    {
        _selectedFilter = e.Value?.ToString() ?? "all";
        await Reload();
    }

    private bool ResolveCanOpen(NotificationItemDto n)
        => NotificationVisuals.ResolveTargetUrl(n, _role) is not null;

    private async Task OnItemClickAsync(NotificationItemDto n)
    {
        var url = NotificationVisuals.ResolveTargetUrl(n, _role);
        if (string.IsNullOrEmpty(url))
            return;

        if (!n.IsRead)
            await MarkReadAsync(n);

        Navigation.NavigateTo(url);
    }

    private async Task OnItemKeydownAsync(KeyboardEventArgs e, NotificationItemDto n)
    {
        if (e.Key is "Enter" or " ")
            await OnItemClickAsync(n);
    }

    private async Task MarkReadAsync(NotificationItemDto n)
    {
        if (n.IsRead)
            return;

        if (await NotificationsApi.MarkAsReadAsync(n.Id))
        {
            n.IsRead = true;
            UnreadState.SetIfDifferent(Math.Max(0, UnreadState.Count - 1));
            _observeFingerprint = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task Ack(NotificationItemDto n)
    {
        _marking = true;
        try
        {
            if (await NotificationsApi.AcknowledgeAsync(n.Id))
            {
                n.AcknowledgedAt = DateTime.UtcNow;
                if (!n.IsRead)
                    await MarkReadAsync(n);
                else
                    await InvokeAsync(StateHasChanged);
            }
        }
        finally
        {
            _marking = false;
        }
    }

    public void Dispose()
    {
        _hubSub?.Dispose();
        _dotNetRef?.Dispose();
        try
        {
            _ = JS.InvokeVoidAsync("deliveryCrmNotificationsInbox.disconnect");
        }
        catch
        {
        }
    }
}
