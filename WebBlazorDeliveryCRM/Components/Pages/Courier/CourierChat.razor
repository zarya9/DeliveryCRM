@page "/courier/chat"
@layout CourierLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = CourierAccessRoles.AuthorizeList)]
@using WebBlazorDeliveryCRM.Services
@using Microsoft.AspNetCore.Components

<PageTitle>Чат — Курьер</PageTitle>

<div class="dms-page-header">
    <h1 class="dms-page-title-with-icon">
        <HugeIcon Name="message-01" CssClass="dms-page-title-icon" />
        Чат
    </h1>
</div>

<CompanyChatPanel TargetUserId="@UserId" />

@code {
    [SupplyParameterFromQuery(Name = "userId")]
    public int? UserId { get; set; }
}
