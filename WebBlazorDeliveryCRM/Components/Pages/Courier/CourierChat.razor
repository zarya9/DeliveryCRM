@page "/courier/chat"
@layout CourierLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Курьер")]
@using Microsoft.AspNetCore.Components

<PageTitle>Чат — Курьер</PageTitle>

<div class="dms-page-header">
    <h1 class="dms-page-title-with-icon">
        <HugeIcon Name="message-01" CssClass="dms-page-title-icon" />
        Чат
    </h1>
    <p class="subtitle mb-0">Переписка с коллегами компании. Выберите сотрудника в списке или откройте комнату по ссылке.</p>
</div>

<CompanyChatPanel TargetUserId="@UserId" />

@code {
    [SupplyParameterFromQuery(Name = "userId")]
    public int? UserId { get; set; }
}
