@page "/courier/shift"
@layout CourierLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Курьер")]
@using System.Linq
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using WebBlazorDeliveryCRM.Services
@inject AuthenticationStateProvider AuthState
@inject CouriersApiService CouriersApi
@inject AppNotificationService Notify
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Смена и геолокация — Курьер</PageTitle>

<div class="dms-page-header">
    <h1 class="dms-page-title-with-icon">
        <HugeIcon Name="calendar-03" CssClass="dms-page-title-icon" />
        Смена и координаты
    </h1>
    <p class="subtitle">
        Сначала начните смену. В сеть и передача координат доступны только при активной смене. Разрешите доступ к геолокации в браузере.
        Позиция обновляется непрерывно (GPS watch) и отправляется на сервер каждые несколько секунд при движении.
    </p>
</div>

@if (_loading)
{
    <p class="text-muted">Загрузка…</p>
}
else if (_profileId is null)
{
    <div class="alert alert-warning">Профиль курьера не найден. Обратитесь к администратору компании.</div>
}
else
{
    <div class="dms-card mb-3">
        <h2 class="dms-card-title dms-card-title-with-icon">
            <HugeIcon Name="clock-01" CssClass="dms-card-title-icon" />
            Статус смены
        </h2>
        @if (_shiftActive && _shiftId.HasValue)
        {
            <p class="mb-2">Смена открыта @( _shiftStartedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "—" ).</p>
            <button type="button" class="btn btn-outline-danger d-inline-flex align-items-center gap-1" disabled="@_busy" @onclick="EndShiftAsync">
                <HugeIcon Name="moon-02" CssClass="dms-icon-sm" />
                <span>Завершить смену</span>
            </button>
        }
        else
        {
            <p class="text-muted mb-2">Смена не начата.</p>
            <button type="button" class="btn btn-primary dms-btn-primary d-inline-flex align-items-center gap-1" disabled="@_busy" @onclick="StartShiftAsync">
                <HugeIcon Name="sun-03" CssClass="dms-icon-sm" />
                <span>Начать смену</span>
            </button>
        }
    </div>

    <div class="dms-card mb-3">
        <h2 class="dms-card-title dms-card-title-with-icon">
            <HugeIcon Name="location-01" CssClass="dms-card-title-icon" />
            В сеть и координаты
        </h2>
        @if (!_shiftActive)
        {
            <p class="text-muted mb-0">Начните смену, чтобы включить «В сеть» и передачу координат.</p>
        }
        else
        {
            <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
                @if (_online)
                {
                    <button type="button" class="btn btn-outline-secondary d-inline-flex align-items-center gap-1" disabled="@_busy" @onclick="GoOfflineAsync">
                        <HugeIcon Name="moon-02" CssClass="dms-icon-sm" />
                        <span>Выйти из сети</span>
                    </button>
                    <span class="text-success small">Координаты отправляются в реальном времени при движении.</span>
                }
                else
                {
                    <button type="button" class="btn btn-primary dms-btn-primary d-inline-flex align-items-center gap-1" disabled="@_busy" @onclick="GoOnlineAsync">
                        <HugeIcon Name="activity-01" CssClass="dms-icon-sm" />
                        <span>В сеть + геолокация</span>
                    </button>
                }
            </div>
            @if (_lastGeoError is not null)
            {
                <div class="alert alert-warning py-2 small mb-0">@_lastGeoError</div>
            }
            <p class="small text-muted mb-0 mt-2">
                Нет GPS или нужен тест?
                <a href="/courier/manual-location">Задать точку на карте вручную</a> (джойстик и перетаскивание).
            </p>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(_mapRouteUrl))
    {
        <div class="dms-card mb-3">
            <h2 class="dms-card-title dms-card-title-with-icon">
                <HugeIcon Name="route-02" CssClass="dms-card-title-icon" />
                Маршрут смены
            </h2>
            <p class="small text-muted mb-2">Можно открыть маршрут в внешнем приложении карт.</p>
            <a href="@_mapRouteUrl" target="_blank" rel="noopener noreferrer" class="btn btn-outline-primary d-inline-flex align-items-center gap-1">
                <HugeIcon Name="route-02" CssClass="dms-icon-sm" />
                <span>Открыть в Яндекс Картах</span>
            </a>
        </div>
    }
}

@code {
    private int? _profileId;
    private bool _shiftActive;
    private int? _shiftId;
    private DateTime? _shiftStartedAt;
    private bool _online;
    private bool _busy;
    private bool _loading = true;
    private string? _lastGeoError;
    private DotNetObjectReference<CourierShift>? _geoDotNetRef;
    private string? _mapRouteUrl;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var state = await AuthState.GetAuthenticationStateAsync();
        var uidStr = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (!int.TryParse(uidStr, out var uid))
        {
            _loading = false;
            return;
        }

        var profile = await CouriersApi.GetByUserIdAsync(uid);
        _profileId = profile?.ID_CourierProfile;
        if (_profileId.HasValue)
        {
            await RefreshShiftStateAsync();
            await RefreshRouteLinkAsync();
        }

        _loading = false;
        StateHasChanged();
    }

    private async Task RefreshShiftStateAsync()
    {
        if (!_profileId.HasValue) return;
        var (active, sid, ts) = await CouriersApi.GetActiveShiftAsync(_profileId.Value);
        _shiftActive = active;
        _shiftId = sid;
        _shiftStartedAt = ts;
    }

    private async Task RefreshRouteLinkAsync()
    {
        if (!_profileId.HasValue) return;
        var activeOrders = await CouriersApi.GetActiveOrdersAsync(_profileId.Value) ?? new List<WebBlazorDeliveryCRM.Models.OrderDto>();
        var first = activeOrders.FirstOrDefault(o => o.DeliveryAddress?.Latitude.HasValue == true && o.DeliveryAddress.Longitude.HasValue == true)
                    ?? activeOrders.FirstOrDefault(o => o.PickupAddress?.Latitude.HasValue == true && o.PickupAddress.Longitude.HasValue == true);
        var lat = first?.DeliveryAddress?.Latitude ?? first?.PickupAddress?.Latitude;
        var lon = first?.DeliveryAddress?.Longitude ?? first?.PickupAddress?.Longitude;
        if (!lat.HasValue || !lon.HasValue)
        {
            _mapRouteUrl = null;
            return;
        }
        _mapRouteUrl = $"https://yandex.ru/maps/?rtext=~{lat.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)},{lon.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}&rtt=auto";
    }

    private async Task StartShiftAsync()
    {
        if (!_profileId.HasValue) return;
        _busy = true;
        try
        {
            var (ok, sid, err) = await CouriersApi.StartShiftAsync(_profileId.Value);
            if (!ok)
            {
                Notify.ShowError(string.IsNullOrWhiteSpace(err) ? "Не удалось начать смену." : err!);
                return;
            }

            await RefreshShiftStateAsync();
            Notify.ShowSuccess("Смена начата.");
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private async Task EndShiftAsync()
    {
        if (!_shiftId.HasValue) return;
        _busy = true;
        try
        {
            await StopGeoAsync();
            var (ok, err) = await CouriersApi.EndShiftAsync(_shiftId.Value);
            if (!ok)
            {
                Notify.ShowError(string.IsNullOrWhiteSpace(err) ? "Не удалось завершить смену." : err!);
                return;
            }

            _online = false;
            await RefreshShiftStateAsync();
            Notify.ShowSuccess("Смена завершена.");
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private async Task GoOnlineAsync()
    {
        if (!_profileId.HasValue || !_shiftActive) return;
        _lastGeoError = null;
        _busy = true;
        try
        {
            var (okOn, errOn) = await CouriersApi.SetOnlineAsync(_profileId.Value, true);
            if (!okOn)
            {
                Notify.ShowError(string.IsNullOrWhiteSpace(errOn) ? "Не удалось выйти в сеть." : errOn!);
                return;
            }

            _online = true;
            var firstPos = await TryGetPositionSafeAsync();
            if (firstPos.HasValue)
            {
                var (okLoc, errLoc) = await CouriersApi.UpdateLocationAsync(_profileId.Value, firstPos.Value.lat, firstPos.Value.lon);
                if (!okLoc)
                    _lastGeoError = errLoc ?? "Ошибка отправки координат.";
            }
            else if (string.IsNullOrWhiteSpace(_lastGeoError))
            {
                _lastGeoError = "Координаты пока недоступны. Курьер уже в сети, повторим автоматически.";
            }

            await StartGeoWatchAsync();
            Notify.ShowSuccess("Вы в сети. Передаём координаты.");
        }
        catch (Exception ex)
        {
            _lastGeoError = ex.Message;
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private async Task GoOfflineAsync()
    {
        if (!_profileId.HasValue) return;
        await StopGeoAsync();
        _busy = true;
        try
        {
            await CouriersApi.SetOnlineAsync(_profileId.Value, false);
            _online = false;
            Notify.ShowInfo("Вы вышли из сети.");
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private async Task StartGeoWatchAsync()
    {
        await StopGeoWatchInternalAsync();
        _geoDotNetRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("courierGeo.startWatch", _geoDotNetRef);
    }

    /// <summary>Вызывается из courierGeo.watchPosition (throttle в JS).</summary>
    [JSInvokable]
    public async Task OnGeoPosition(double lat, double lon)
    {
        if (!_profileId.HasValue || !_online)
            return;
        try
        {
            var (ok, err) = await CouriersApi.UpdateLocationAsync(_profileId.Value, (decimal)lat, (decimal)lon);
            if (!ok)
                _lastGeoError = err ?? "Ошибка отправки координат.";
            else
                _lastGeoError = null;
        }
        catch
        {
            _lastGeoError = "Не удалось отправить координаты.";
        }

        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnGeoWatchError(string message)
    {
        if (message.Contains("GEO_1", StringComparison.OrdinalIgnoreCase))
            _lastGeoError = "Нет доступа к геолокации. Разрешите доступ для сайта в настройках браузера.";
        else if (message.Contains("GEO_2", StringComparison.OrdinalIgnoreCase))
            _lastGeoError = "Не удалось вычислить место (код 2 — не про запрет браузера). На ПК: Параметры Windows → конфиденциальность → «Местоположение»: включено и для браузера; Wi‑Fi/сеть. На телефоне — включите службы локации и GPS.";
        else if (message.Contains("GEO_3", StringComparison.OrdinalIgnoreCase))
            _lastGeoError = "Не удалось определить координаты (таймаут).";
        else
            _lastGeoError = $"Геолокация: {message}";

        // Геоданные недоступны — прерываем режим «в сети», чтобы не показывать устаревшую позицию как активную.
        await ForceOfflineWhenGeoUnavailableAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ForceOfflineWhenGeoUnavailableAsync()
    {
        if (!_profileId.HasValue || !_online)
            return;

        try
        {
            await StopGeoWatchInternalAsync();
            await CouriersApi.SetOnlineAsync(_profileId.Value, false);
            _online = false;
        }
        catch
        {
            // Ошибка переключения online не должна ронять UI; пользователь увидит причину в _lastGeoError.
        }
    }

    private async Task<(decimal lat, decimal lon)?> TryGetPositionSafeAsync()
    {
        try
        {
            var pos = await JS.InvokeAsync<double[]>("courierGeo.tryGetPosition");
            if (pos is { Length: 2 })
            {
                _lastGeoError = null;
                return ((decimal)pos[0], (decimal)pos[1]);
            }
        }
        catch (JSException jsEx)
        {
            var message = jsEx.Message ?? string.Empty;
            if (message.Contains("GEO_1", StringComparison.OrdinalIgnoreCase))
            {
                _lastGeoError = "Нет доступа к геолокации. Разрешите доступ для сайта в настройках браузера.";
                return null;
            }

            if (message.Contains("GEO_2", StringComparison.OrdinalIgnoreCase))
            {
                _lastGeoError = "Не удалось вычислить место (код 2). Включите «Местоположение» в Windows и для вашего браузера, проверьте Wi‑Fi; на ПК без GPS точность ниже, чем у телефона.";
                return null;
            }

            if (message.Contains("GEO_3", StringComparison.OrdinalIgnoreCase))
            {
                _lastGeoError = "Не удалось определить координаты (таймаут, код 3). Попробуйте ещё раз.";
                return null;
            }

            if (message.Contains("not supported", StringComparison.OrdinalIgnoreCase)
                || message.Contains("не поддерж", StringComparison.OrdinalIgnoreCase))
            {
                _lastGeoError = "Браузер не поддерживает геолокацию.";
                return null;
            }

            if (message.Contains("timeout", StringComparison.OrdinalIgnoreCase))
            {
                _lastGeoError = "Не удалось определить координаты (таймаут). Попробуйте ещё раз.";
                return null;
            }

            _lastGeoError = "Нет доступа к геолокации. Разрешите доступ для сайта в настройках браузера.";
            return null;
        }
        catch
        {
            _lastGeoError = "Не удалось получить координаты. Проверьте доступ к геолокации.";
            return null;
        }

        _lastGeoError = "Не удалось получить координаты.";
        return null;
    }

    private async Task StopGeoWatchInternalAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("courierGeo.stopWatch");
        }
        catch
        {
            /* ignore */
        }

        _geoDotNetRef?.Dispose();
        _geoDotNetRef = null;
    }

    private async Task StopGeoAsync()
    {
        await StopGeoWatchInternalAsync();
    }

    public async ValueTask DisposeAsync()
    {
        await StopGeoWatchInternalAsync();
    }
}
