@page "/customer/orders"
@layout CustomerLayout
@using WebBlazorDeliveryCRM.Models
@using WebBlazorDeliveryCRM.Services
@using WebBlazorDeliveryCRM.Components.Shared
@using WebBlazorDeliveryCRM.Utilities
@using System.Security.Claims
@inject ClientsApiService ClientsApi
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Navigation

<PageTitle>Мои заказы — Клиент</PageTitle>

<div class="dms-page-header d-flex flex-wrap justify-content-between align-items-start gap-2">
    <div>
        <h1 class="dms-page-title-with-icon mb-1">
            <HugeIcon Name="invoice-01" CssClass="dms-page-title-icon" />
            Мои заказы
        </h1>
        <p class="subtitle mb-0">Новый заказ — кнопка справа. Подробная история: <a href="/customer/orders/history">История заказов</a>.</p>
    </div>
    <button type="button"
            class="btn btn-outline-primary dms-icon-btn d-inline-flex align-items-center justify-content-center"
            title="Добавить заказ"
            aria-label="Добавить заказ"
            @onclick="OpenCreateModal">
        <HugeIcon Name="plus-sign" CssClass="dms-icon-sm" />
    </button>
</div>

<div class="dms-card">
    @if (_orders != null && _orders.Count > 0)
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0 dms-data-table">
                <thead>
                    <tr>
                        <DmsTableThIcon Icon="invoice-01">№</DmsTableThIcon>
                        <DmsTableThIcon Icon="calendar-03">Дата</DmsTableThIcon>
                        <DmsTableThIcon Icon="task-01">Название</DmsTableThIcon>
                        <DmsTableThIcon Icon="activity-01">Статус</DmsTableThIcon>
                        <DmsTableThIcon Icon="analytics-up">Сумма</DmsTableThIcon>
                        <DmsTableThIcon Icon="clock-01">Окно доставки</DmsTableThIcon>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in _orders)
                    {
                        <tr class="customer-order-table-row" @onclick="() => OpenOrderDetail(o)">
                            <td>@o.Order_Number</td>
                            <td class="text-nowrap">@o.Created_at.ToString("dd.MM.yyyy")</td>
                            <td>@o.Name</td>
                            <td>
                                <StatusBadge Text="@(o.OrderStatus?.Name ?? "—")" Tone="@OrderStatusUi.ToneForStatusName(o.OrderStatus?.Name)" />
                            </td>
                            <td class="text-nowrap">@($"{(o.Final_cost > 0 ? o.Final_cost : o.Estimated_cost):N2} ₽")</td>
                            <td>@FormatDeliveryWindow(o)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (_dataLoaded)
    {
        <p class="text-muted mb-0">Заказов пока нет.</p>
    }
    else
    {
        <p class="text-muted mb-0">Загрузка…</p>
    }
</div>

@if (_showCreateModal)
{
    <div class="employee-modal-backdrop" @onclick="CloseCreateModal">
        <div class="employee-modal employee-modal--order-wizard" @onclick:stopPropagation="true">
            <div class="d-flex justify-content-between align-items-center flex-shrink-0 mb-2">
                <h2 class="h6 mb-0 d-inline-flex align-items-center gap-2">
                    <HugeIcon Name="plus-sign" CssClass="dms-icon-sm" />
                    Новый заказ
                </h2>
                <button type="button" class="btn-close" aria-label="Закрыть" @onclick="CloseCreateModal"></button>
            </div>
            <div class="order-wizard-fill">
                <CustomerCreateOrderForm @key="_formMountKey"
                                         ShowCancel="true"
                                         OnSuccess="AfterOrderCreatedAsync"
                                         OnCancel="CloseCreateModal" />
            </div>
        </div>
    </div>
}

@if (_detailOrder is not null)
{
    <CustomerOrderDetailModal Order="_detailOrder" OnClose="CloseOrderDetailAsync" />
}

@code {
    private List<OrderDto>? _orders;
    private OrderDto? _detailOrder;
    private bool _showCreateModal;
    private int _formMountKey;
    private bool _dataLoaded;
    private bool _openCreateAfterLoad;

    [SupplyParameterFromQuery(Name = "new")]
    public string? New { get; set; }

    protected override void OnParametersSet()
    {
        if (string.Equals(New, "1", StringComparison.OrdinalIgnoreCase))
            _openCreateAfterLoad = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadOrdersAsync();
            _dataLoaded = true;
        }

        if (_openCreateAfterLoad && _dataLoaded)
        {
            _openCreateAfterLoad = false;
            OpenCreateModal();
            Navigation.NavigateTo("/customer/orders", replace: true);
            await InvokeAsync(StateHasChanged);
        }
        else if (firstRender)
            StateHasChanged();
    }

    private async Task LoadOrdersAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var userIdStr = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (!int.TryParse(userIdStr, out var userId))
        {
            _orders = new List<OrderDto>();
            return;
        }
        var client = await ClientsApi.GetByUserIdAsync(userId);
        if (client == null)
        {
            _orders = new List<OrderDto>();
            return;
        }
        _orders = await ClientsApi.GetOrdersAsync(client.ID_ClientProfile) ?? new List<OrderDto>();
    }

    private void OpenCreateModal()
    {
        _formMountKey++;
        _showCreateModal = true;
    }

    private void CloseCreateModal()
    {
        _showCreateModal = false;
    }

    private void OpenOrderDetail(OrderDto o) => _detailOrder = o;

    private Task CloseOrderDetailAsync()
    {
        _detailOrder = null;
        return Task.CompletedTask;
    }

    private async Task AfterOrderCreatedAsync()
    {
        _showCreateModal = false;
        await LoadOrdersAsync();
        StateHasChanged();
    }

    private static string FormatDeliveryWindow(OrderDto o)
    {
        var from = o.Eta_at;
        var to = o.Sla_due_at;
        if (!from.HasValue && !to.HasValue)
            return "—";
        if (!from.HasValue)
            return $"до {to:dd.MM.yyyy}";
        if (!to.HasValue)
            return $"с {from:dd.MM.yyyy}";
        if (from.Value.Date == to.Value.Date)
            return from.Value.ToString("dd.MM.yyyy");
        return $"с {from:dd.MM} по {to:dd.MM}";
    }
}
