@page "/customer/orders/history"
@layout CustomerLayout
@using System.Security.Claims
@using WebBlazorDeliveryCRM.Models
@using WebBlazorDeliveryCRM.Services
@using WebBlazorDeliveryCRM.Components.Shared
@using WebBlazorDeliveryCRM.Utilities
@inject ClientsApiService ClientsApi
@inject AuthenticationStateProvider AuthState
@inject OrdersApiService OrdersApi
@inject AppNotificationService Notify

<PageTitle>История заказов — Клиент</PageTitle>

<div class="dms-page-header">
    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
        <a href="/customer/orders" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1">
            <HugeIcon Name="invoice-01" CssClass="dms-icon-sm" />
            <span>К списку заказов</span>
        </a>
    </div>
    <h1 class="dms-page-title-with-icon">
        <HugeIcon Name="clock-01" CssClass="dms-page-title-icon" />
        История заказов
    </h1>
    <p class="subtitle">Название, даты, статусы, оплата и суммы по всем заказам.</p>
</div>

<div class="dms-card">
    @if (_orders != null && _orders.Count > 0)
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0 dms-data-table">
                <thead>
                    <tr>
                        <DmsTableThIcon Icon="invoice-01">№</DmsTableThIcon>
                        <DmsTableThIcon Icon="calendar-03">Создан</DmsTableThIcon>
                        <DmsTableThIcon Icon="task-01">Название</DmsTableThIcon>
                        <DmsTableThIcon Icon="activity-01">Статус</DmsTableThIcon>
                        <DmsTableThIcon Icon="analytics-up">Сумма</DmsTableThIcon>
                        <DmsTableThIcon Icon="wallet-01">Оплата</DmsTableThIcon>
                        <DmsTableThIcon Icon="pencil-edit-01" CssClass="text-nowrap">Действие</DmsTableThIcon>
                        <DmsTableThIcon Icon="briefcase-01">Приоритет</DmsTableThIcon>
                        <DmsTableThIcon Icon="clock-01">Окно доставки</DmsTableThIcon>
                        <DmsTableThIcon Icon="route-02">Маршрут</DmsTableThIcon>
                        <DmsTableThIcon Icon="delivery-truck-01">Доставлен</DmsTableThIcon>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in _orders.OrderByDescending(x => x.Created_at))
                    {
                        <tr class="customer-order-table-row" @onclick="() => OpenOrderDetail(o)">
                            <td>@o.Order_Number</td>
                            <td class="text-nowrap">@o.Created_at.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@o.Name</td>
                            <td>
                                <StatusBadge Text="@(o.OrderStatus?.Name ?? "—")" Tone="@OrderStatusUi.ToneForStatusName(o.OrderStatus?.Name)" />
                            </td>
                            <td class="text-nowrap">@FormatMoneyRub(o.Final_cost > 0 ? o.Final_cost : o.Estimated_cost)</td>
                            <td>
                                @if (o.Is_paid)
                                {
                                    <span class="badge text-bg-success d-inline-flex align-items-center gap-1">
                                        <HugeIcon Name="wallet-01" CssClass="dms-icon-sm" />
                                        <span>Оплачен</span>
                                    </span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill bg-warning text-dark d-inline-flex align-items-center gap-1 px-2 py-1">
                                        <HugeIcon Name="wallet-01" CssClass="dms-icon-sm flex-shrink-0" />
                                        <span>Не оплачен</span>
                                    </span>
                                }
                            </td>
                            <td>
                                @if (!o.Is_paid)
                                {
                                    <button type="button" class="btn btn-sm btn-primary d-inline-flex align-items-center gap-2"
                                            disabled="@IsPaying(o.ID_Order)"
                                            @onclick:stopPropagation="true"
                                            @onclick="() => PayAsync(o)">
                                        <HugeIcon Name="wallet-01" CssClass="dms-icon-sm flex-shrink-0" />
                                        <span>Оплатить</span>
                                    </button>
                                }
                            </td>
                            <td>@PriorityLabel(o.Priority)</td>
                            <td>@FormatDeliveryWindow(o)</td>
                            <td>@FormatRouteKind(o.DeliveryRouteKind)</td>
                            <td class="text-nowrap">@(o.Delivered_at.HasValue ? o.Delivered_at.Value.ToString("dd.MM.yyyy HH:mm") : "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (_loaded)
    {
        <p class="text-muted mb-0">Заказов пока нет.</p>
    }
    else
    {
        <p class="text-muted mb-0">Загрузка…</p>
    }
</div>

@if (_detailOrder is not null)
{
    <CustomerOrderDetailModal Order="_detailOrder" OnClose="CloseOrderDetailAsync" />
}

@code {
    private List<OrderDto>? _orders;
    private OrderDto? _detailOrder;
    private bool _loaded;
    private readonly HashSet<int> _payingIds = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var auth = await AuthState.GetAuthenticationStateAsync();
        var userIdStr = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (!int.TryParse(userIdStr, out var userId))
        {
            _loaded = true;
            StateHasChanged();
            return;
        }
        var client = await ClientsApi.GetByUserIdAsync(userId);
        if (client == null)
        {
            _loaded = true;
            StateHasChanged();
            return;
        }
        _orders = await ClientsApi.GetOrdersAsync(client.ID_ClientProfile) ?? new List<OrderDto>();
        _loaded = true;
        StateHasChanged();
    }

    private void OpenOrderDetail(OrderDto o) => _detailOrder = o;

    private Task CloseOrderDetailAsync()
    {
        _detailOrder = null;
        return Task.CompletedTask;
    }

    private bool IsPaying(int id) => _payingIds.Contains(id);

    private async Task PayAsync(OrderDto o)
    {
        _payingIds.Add(o.ID_Order);
        try
        {
            var (ok, err) = await OrdersApi.PayOrderAsync(o.ID_Order);
            if (!ok)
            {
                Notify.ShowError(err ?? "Не удалось оплатить.");
                return;
            }

            Notify.ShowSuccess("Оплата прошла успешно.");
            var auth = await AuthState.GetAuthenticationStateAsync();
            var userIdStr = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            if (int.TryParse(userIdStr, out var userId))
            {
                var client = await ClientsApi.GetByUserIdAsync(userId);
                if (client != null)
                    _orders = await ClientsApi.GetOrdersAsync(client.ID_ClientProfile) ?? new List<OrderDto>();
            }
        }
        finally
        {
            _payingIds.Remove(o.ID_Order);
            StateHasChanged();
        }
    }

    private static string FormatMoneyRub(decimal v) => $"{v:N2} ₽";

    private static string PriorityLabel(byte p) => p switch
    {
        3 => "Критически срочный",
        2 => "Критический",
        1 => "Срочный",
        _ => "Обычный"
    };

    private static string FormatRouteKind(string? k) => string.IsNullOrWhiteSpace(k) ? "—" : k switch
    {
        "LocalUrban" => "Город",
        "ViaHub" => "Через хаб",
        "DirectIntercity" => "Межгород",
        _ => k
    };

    private static string FormatDeliveryWindow(OrderDto o)
    {
        var from = o.Eta_at;
        var to = o.Sla_due_at;
        if (!from.HasValue && !to.HasValue)
            return "—";
        if (!from.HasValue)
            return $"до {to:dd.MM.yyyy}";
        if (!to.HasValue)
            return $"с {from:dd.MM.yyyy}";
        if (from.Value.Date == to.Value.Date)
            return from.Value.ToString("dd.MM.yyyy");
        return $"с {from:dd.MM} по {to:dd.MM}";
    }
}
