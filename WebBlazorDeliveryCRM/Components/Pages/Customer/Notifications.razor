@page "/customer/notifications"
@layout CustomerLayout
@implements IDisposable
@using Microsoft.AspNetCore.SignalR.Client
@using WebBlazorDeliveryCRM.Models
@using WebBlazorDeliveryCRM.Services
@using WebBlazorDeliveryCRM.Components.Shared
@inject NotificationsApiService NotificationsApi
@inject ChatHubClientService ChatHub
@inject AppNotificationService Notify

<PageTitle>Уведомления клиента</PageTitle>

<div class="dms-page-header">
    <h1>Уведомления</h1>
    <p class="subtitle">
        Здесь отображаются важные события по заказам и сообщениям.
    </p>
    <StatusBadge Text="@(_hubConnected ? "Realtime: подключено" : "Realtime: офлайн")"
                Tone="@(_hubConnected ? "success" : "warning")" />
</div>

<div class="dms-card">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="dms-card-title mb-0">Мои уведомления</h2>
        <div class="d-flex gap-2">
            <label class="d-flex align-items-center gap-1 small"><input type="checkbox" @bind="_onlyUnread" /> Непрочитанные</label>
            <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@_loading" @onclick="@(async () => await Reload())">
                @(_loading ? "…" : "Обновить")
            </button>
        </div>
    </div>

    @if (_loading && _items is null)
    {
        <p class="text-muted">Загрузка…</p>
    }
    else if (_items is null || _items.Count == 0)
    {
        <p class="text-muted mb-0">Пока нет уведомлений.</p>
    }
    else
    {
        <div class="list-group">
            @foreach (var n in _items.OrderByDescending(x => x.SentAt))
            {
                <div class="list-group-item list-group-item-action d-flex flex-column flex-md-row gap-2 @(n.IsRead ? "" : "list-group-item-primary bg-opacity-10")">
                    <div class="flex-grow-1">
                        <div class="d-flex flex-wrap gap-2 align-items-baseline">
                            <strong>@n.Title</strong>
                            @if (!n.IsRead)
                            {
                                <StatusBadge Text="Новое" Tone="primary" />
                            }
                            @if (n.IsCritical)
                            {
                                <StatusBadge Text="Критичное" Tone="danger" />
                            }
                        </div>
                        <p class="mb-1 mt-1 small">@n.Message</p>
                        <div class="text-muted small">
                            @n.SentAt.ToString("dd.MM.yyyy HH:mm")
                            @if (n.OrderId.HasValue)
                            {
                                <span> · Заказ #@n.OrderId</span>
                            }
                        </div>
                    </div>
                    @if (!n.IsRead)
                    {
                        <div>
                            <button type="button" class="btn btn-sm btn-outline-primary" disabled="@_marking" @onclick="() => MarkRead(n)">
                                Прочитано
                            </button>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    private List<NotificationItemDto>? _items;
    private bool _loading = true;
    private bool _marking;
    private IDisposable? _hubSub;
    private bool _onlyUnread;
    private bool _hubConnected;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await Reload();

        try
        {
            var conn = await ChatHub.GetConnectionAsync();
            await ChatHub.StartAsync();
            _hubConnected = conn.State == HubConnectionState.Connected;
            _hubSub = conn.On<NotificationReceivedSignalDto>("NotificationReceived", _ =>
            {
                Notify.ShowInfo("Новое уведомление");
                return Reload(showSpinner: false);
            });
        }
        catch
        {
            _hubConnected = false;
        }
    }

    private async Task Reload(bool showSpinner = true)
    {
        if (showSpinner)
        {
            _loading = true;
            StateHasChanged();
        }
        try
        {
            _items = await NotificationsApi.GetMineAsync(onlyUnread: _onlyUnread) ?? new();
        }
        finally
        {
            if (showSpinner)
                _loading = false;
            StateHasChanged();
        }
    }

    private async Task MarkRead(NotificationItemDto n)
    {
        _marking = true;
        try
        {
            if (await NotificationsApi.MarkAsReadAsync(n.Id))
            {
                n.IsRead = true;
                StateHasChanged();
            }
        }
        finally
        {
            _marking = false;
        }
    }

    public void Dispose()
    {
        _hubSub?.Dispose();
    }
}
