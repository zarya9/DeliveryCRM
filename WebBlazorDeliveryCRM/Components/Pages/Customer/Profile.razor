@page "/customer/profile"
@layout CustomerLayout
@using System.Linq
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Forms
@using WebBlazorDeliveryCRM.Components.Shared
@inject AuthenticationStateProvider AuthStateProvider
@inject ClientsApiService ClientsApi
@inject OrdersApiService OrdersApi
@inject AddressSuggestApiService AddressSuggestApi
@inject AppNotificationService Notify
@inject IJSRuntime JS
@inject IConfiguration Configuration

<PageTitle>Профиль — Клиент</PageTitle>

<div class="dms-page-header">
    <h1 class="dms-page-title-with-icon">
        <HugeIcon Name="user-03" CssClass="dms-page-title-icon" />
        Профиль клиента
    </h1>
    <p class="subtitle">Личный кабинет и данные профиля</p>
</div>

<div class="dms-card profile-shell">
    @if (_loading)
    {
        <p class="text-muted mb-0">Загрузка профиля...</p>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger mb-0">@_error</div>
    }
    else if (_profile is null)
    {
        <p class="text-muted mb-0">Профиль клиента не найден.</p>
    }
    else
    {
        <div class="profile-column">
            <div class="profile-avatar-card">
                <img src="@AvatarUrl" alt="Аватар" class="profile-avatar-img" @onerror="OnAvatarError" />
                <div class="profile-name">@DisplayName</div>
                <div class="profile-meta"><strong>Должность:</strong> Клиент</div>
                <div class="profile-meta"><strong>Рейтинг:</strong> @_profile.Rating.ToString("0.00")</div>
                <div class="profile-meta"><strong>Заказов всего:</strong> @_ordersCount</div>
                <div class="profile-meta"><strong>Последний заказ:</strong> @(_lastOrderAt?.ToString("dd.MM.yyyy HH:mm") ?? "—")</div>
                <div class="profile-meta"><strong>Почтовый адрес:</strong> @(string.IsNullOrWhiteSpace(_loginEmail) ? "—" : _loginEmail)</div>
                <div class="profile-meta"><strong>Адрес по умолчанию:</strong> @(string.IsNullOrWhiteSpace(_editDefaultAddress) ? "—" : _editDefaultAddress)</div>
                <div class="profile-meta"><strong>Предпочтительная оплата:</strong> @SelectedPaymentMethodName</div>
                <div class="mt-2 d-flex gap-2 justify-content-start flex-wrap">
                    <label class="btn btn-outline-secondary btn-sm mb-0">
                        Загрузить аватар
                        <InputFile class="d-none" OnChange="OnAvatarSelected" accept=".jpg,.jpeg,.png,.gif,.webp,image/*" />
                    </label>
                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="ToggleEditProfile">
                        @(_isEditProfile ? "Отменить" : "Редактировать")
                    </button>
                </div>
            </div>

            @if (_isEditProfile)
            {
                <div class="row g-3 mt-1">
                    <div class="col-md-6">
                        <label class="form-label">Имя</label>
                        <input class="form-control" @bind="_editFName" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Фамилия</label>
                        <input class="form-control" @bind="_editName" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label">Отчество</label>
                        <input class="form-control" @bind="_editPatronymic" />
                    </div>
                    <div class="col-md-8 position-relative">
                        <label class="form-label">Адрес по умолчанию</label>
                        <input class="form-control" value="@_editDefaultAddress" @oninput="OnProfileAddressInput" />
                        @if (_addressSuggestions.Count > 0)
                        {
                            <div class="position-absolute bg-body border rounded shadow-sm w-100 mt-1" style="z-index:50;max-height:240px;overflow:auto;">
                                @foreach (var s in _addressSuggestions)
                                {
                                    <button type="button" class="w-100 text-start border-0 bg-transparent p-2" @onclick="@(() => PickAddressSuggestion(s))">
                                        <div>@(s.PrimaryLine ?? s.DisplayName ?? "Адрес")</div>
                                        @if (!string.IsNullOrWhiteSpace(s.SecondaryLine))
                                        {
                                            <div class="small text-muted">@s.SecondaryLine</div>
                                        }
                                    </button>
                                }
                            </div>
                        }
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Предпочтительный способ оплаты</label>
                        <select class="form-select" @bind="_editPaymentMethodId">
                            @foreach (var method in _paymentMethods)
                            {
                                <option value="@method.ID_PaymentMethod">@method.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-12">
                        <button type="button" class="btn btn-primary d-inline-flex align-items-center gap-1" disabled="@_savingProfile" @onclick="SaveProfileAsync">
                            @if (_savingProfile)
                            {
                                <span>Сохранение...</span>
                            }
                            else
                            {
                                <HugeIcon Name="edit-01" CssClass="dms-icon-sm" />
                                <span>Сохранить изменения</span>
                            }
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

<div class="dms-card mt-3">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
        <h2 class="dms-card-title dms-card-title-with-icon mb-0">
            <HugeIcon Name="wallet-01" CssClass="dms-card-title-icon" />
            Привязанные карты
        </h2>
        <button type="button" class="btn btn-sm btn-primary d-inline-flex align-items-center gap-1" @onclick="OpenCardModal">
            <HugeIcon Name="plus-sign" CssClass="dms-icon-sm" />
            <span>Добавить карту</span>
        </button>
    </div>

    @if (_profile is not null)
    {
        @if (_cards.Count == 0)
        {
            <p class="text-muted mb-0">Карт пока нет.</p>
        }
        else
        {
            <div class="row g-3">
                @foreach (var c in _cards)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="border rounded p-3 h-100">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <PaymentBrandMark System="@c.PaymentSystem" />
                                    <strong>@(c.PaymentSystem ?? "Карта")</strong>
                                </div>
                                <span class="small text-muted">@c.Expiry</span>
                            </div>
                            <div class="mt-3 fs-5">@c.MaskedCard</div>
                            <div class="small text-muted mt-2">@c.CardHolder</div>
                            <div class="small text-muted">@c.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

@if (_showCardModal)
{
    <div class="employee-modal-backdrop" @onclick="CloseCardModal">
        <div class="employee-modal" @onclick:stopPropagation="true">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <h2 class="h5 mb-0 d-inline-flex align-items-center gap-2">
                    <HugeIcon Name="plus-sign" CssClass="dms-icon-sm" />
                    Добавить карту
                </h2>
                <button type="button" class="btn-close" aria-label="Закрыть" @onclick="CloseCardModal"></button>
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Номер карты</label>
                    <input class="form-control" placeholder="0000 0000 0000 0000" value="@_cardNumber" @oninput="OnCardNumberInput" />
                    <div class="small text-muted mt-1 d-inline-flex align-items-center flex-wrap gap-2">
                        <span>Платёжная система:</span>
                        <PaymentBrandMark System="@_cardPaymentSystem" />
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Срок</label>
                    <input class="form-control" placeholder="MM/YY" value="@_cardExpiryMonth" @oninput="OnCardExpiryInput" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">@_cardSecurityCodeLabel</label>
                    <input type="text"
                           inputmode="numeric"
                           maxlength="4"
                           autocomplete="cc-csc"
                           class="form-control"
                           value="@_cardCvv"
                           @oninput="OnCardCvvInput" />
                </div>
                <div class="col-md-12">
                    <label class="form-label">Владелец</label>
                    <input class="form-control" placeholder="IVAN IVANOV" @bind="_cardHolder" @bind:event="oninput" />
                </div>
            </div>

            <div class="d-flex gap-2 mt-3">
                <button class="btn btn-primary d-inline-flex align-items-center gap-1" disabled="@_bindingCard" @onclick="BindCardAsync">
                    @if (_bindingCard)
                    {
                        <span>Сохранение...</span>
                    }
                    else
                    {
                        <HugeIcon Name="wallet-01" CssClass="dms-icon-sm" />
                        <span>Привязать</span>
                    }
                </button>
                <button class="btn btn-outline-secondary" disabled="@_bindingCard" @onclick="CloseCardModal">Отмена</button>
            </div>
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private string? _error;
    private ClientProfileDto? _profile;
    private int _ordersCount;
    private DateTime? _lastOrderAt;
    private List<PaymentMethodDto> _paymentMethods = new();
    private string _editFName = string.Empty;
    private string _editName = string.Empty;
    private string _editPatronymic = string.Empty;
    private string _editDefaultAddress = string.Empty;
    private int _editPaymentMethodId;
    private bool _savingProfile;
    private string _avatarFallback = "/favicon.png";
    private List<AddressSuggestItemDto> _addressSuggestions = new();
    private CancellationTokenSource? _addressSuggestCts;
    private string _addressSuggestCity = "Казань";

    private List<BoundCardListItemDto> _cards = new();
    private bool _showCardModal;
    private string _cardNumber = string.Empty;
    private string _cardExpiryMonth = string.Empty; // YYYY-MM
    private string _cardHolder = string.Empty;
    private string _cardCvv = string.Empty;
    private string _cardPaymentSystem = "Не определена";
    private string _cardSecurityCodeLabel = "CVV";
    private bool _bindingCard;
    private string _loginEmail = "";
    private int _currentUserId;
    private bool _isEditProfile;

    private string DisplayName
    {
        get
        {
            var v = $"{_editName} {_editFName} {_editPatronymic}".Trim();
            return string.IsNullOrWhiteSpace(v) ? "Клиент" : v;
        }
    }

    private string SelectedPaymentMethodName =>
        _paymentMethods.FirstOrDefault(x => x.ID_PaymentMethod == _profile?.Preferred_payment_method_id)?.Name
        ?? "Не выбран";

    private long _profileAvatarVer;

    private string AvatarUrl => _profile?.User_id > 0
        ? BuildAvatarApiUrl(_profile.User_id)
        : _avatarFallback;

    private string BuildAvatarApiUrl(int userId)
    {
        var raw = Configuration["ApiBaseUrl"];
        var apiBase = string.IsNullOrWhiteSpace(raw) ? "http://localhost:5220" : raw.TrimEnd('/');
        var q = $"v={_profileAvatarVer}";
        return $"{apiBase}/api/Files/avatar/{userId}?{q}";
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            var userIdRaw = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            if (!int.TryParse(userIdRaw, out var userId))
            {
                _error = "Не удалось определить текущего пользователя.";
                return;
            }
            _currentUserId = userId;

            _profile = await ClientsApi.GetByUserIdAsync(userId);
            if (_profile is null)
            {
                _error = "Профиль клиента не найден.";
                return;
            }

            _profileAvatarVer = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
            _paymentMethods = await ClientsApi.GetPaymentMethodsAsync();

            var orders = await OrdersApi.GetByClientAsync(_profile.ID_ClientProfile) ?? new List<OrderDto>();
            _ordersCount = orders.Count;
            _lastOrderAt = orders.OrderByDescending(o => o.Created_at).FirstOrDefault()?.Created_at;
            _editFName = _profile.User?.FName ?? string.Empty;
            _editName = _profile.User?.Name ?? string.Empty;
            _editPatronymic = _profile.User?.Patronumic ?? string.Empty;
            _editDefaultAddress = _profile.Default_address ?? string.Empty;
            _editPaymentMethodId = _profile.Preferred_payment_method_id;
            _cards = await ClientsApi.GetBoundCardsAsync(_profile.ID_ClientProfile);

            var st = await AuthStateProvider.GetAuthenticationStateAsync();
            _loginEmail = st.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                          ?? st.User.FindFirst("email")?.Value
                          ?? "";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveProfileAsync()
    {
        if (_profile is null)
            return;

        _savingProfile = true;
        _error = null;
        try
        {
            var ok = await ClientsApi.UpdateProfileAsync(_profile.ID_ClientProfile, new UpdateClientProfileDto
            {
                FName = _editFName,
                Name = _editName,
                Patronumic = _editPatronymic,
                Default_address = _editDefaultAddress,
                Preferred_payment_method_id = _editPaymentMethodId
            });
            if (!ok)
            {
                _error = "Не удалось сохранить профиль.";
                return;
            }

            var clientId = _profile.ID_ClientProfile;
            _profile = await ClientsApi.GetProfileAsync(clientId);
            var orders = await OrdersApi.GetByClientAsync(clientId) ?? new List<OrderDto>();
            _ordersCount = orders.Count;
            _lastOrderAt = orders.OrderByDescending(o => o.Created_at).FirstOrDefault()?.Created_at;
            _isEditProfile = false;
            Notify.ShowSuccess("Профиль обновлён.");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _savingProfile = false;
        }
    }

    private void OpenCardModal()
    {
        _cardNumber = string.Empty;
        _cardExpiryMonth = string.Empty;
        _cardHolder = string.Empty;
        _cardCvv = string.Empty;
        _cardPaymentSystem = "Не определена";
        _cardSecurityCodeLabel = "CVV";
        _showCardModal = true;
    }

    private void CloseCardModal()
    {
        _showCardModal = false;
    }

    private void OnCardNumberInput(ChangeEventArgs e)
    {
        var raw = new string((e.Value?.ToString() ?? string.Empty).Where(char.IsDigit).Take(19).ToArray());
        _cardNumber = string.Join(" ", Enumerable.Range(0, (raw.Length + 3) / 4).Select(i => raw.Substring(i * 4, Math.Min(4, raw.Length - i * 4))));
        _cardPaymentSystem = DetectPaymentSystem(raw);
        _cardSecurityCodeLabel = GetSecurityCodeLabel(_cardPaymentSystem);
    }

    private void OnCardCvvInput(ChangeEventArgs e)
    {
        _cardCvv = new string((e.Value?.ToString() ?? string.Empty).Where(char.IsDigit).Take(4).ToArray());
    }

    private void OnCardExpiryInput(ChangeEventArgs e)
    {
        var raw = new string((e.Value?.ToString() ?? string.Empty).Where(char.IsDigit).Take(4).ToArray());
        if (raw.Length == 0)
        {
            _cardExpiryMonth = string.Empty;
            return;
        }
        if (raw.Length == 1)
        {
            var d = raw[0] - '0';
            if (d >= 2)
            {
                _cardExpiryMonth = $"0{d}/";
                return;
            }
            _cardExpiryMonth = raw;
            return;
        }
        if (raw.Length == 2)
        {
            var monthInt = int.Parse(raw);
            if (monthInt == 0)
                monthInt = 1;
            if (monthInt > 12)
                monthInt = 12;
            _cardExpiryMonth = $"{monthInt:00}/";
            return;
        }
        _cardExpiryMonth = $"{raw[..2]}/{raw[2..]}";
    }

    private async Task BindCardAsync()
    {
        if (_profile is null)
            return;

        var cardDigits = new string(_cardNumber.Where(char.IsDigit).ToArray());
        var cvvDigits = new string(_cardCvv.Where(char.IsDigit).ToArray());
        if (cardDigits.Length is < 15 or > 19
            || string.IsNullOrWhiteSpace(_cardExpiryMonth)
            || string.IsNullOrWhiteSpace(_cardHolder?.Trim())
            || cvvDigits.Length is < 3 or > 4)
        {
            Notify.ShowWarning("Заполните номер карты (15–19 цифр), срок, владельца и код безопасности (3–4 цифры).");
            return;
        }

        var expiry = ConvertMonthToCardExpiry(_cardExpiryMonth);
        if (string.IsNullOrWhiteSpace(expiry))
        {
            Notify.ShowWarning("Некорректный формат срока карты.");
            return;
        }

        _bindingCard = true;
        _error = null;
        try
        {
            var (ok, err) = await ClientsApi.BindCardAsync(_profile.ID_ClientProfile, new BindCardRequestDto
            {
                CardNumber = cardDigits,
                Expiry = expiry,
                CardHolder = _cardHolder.Trim().ToUpperInvariant(),
                Cvv = cvvDigits
            });
            if (!ok)
            {
                Notify.ShowError(err ?? "Не удалось привязать карту.");
                return;
            }

            _cards = await ClientsApi.GetBoundCardsAsync(_profile.ID_ClientProfile);
            _showCardModal = false;
            Notify.ShowSuccess("Карта привязана.");
        }
        catch (Exception ex)
        {
            Notify.ShowError(ex.Message);
        }
        finally
        {
            _bindingCard = false;
        }
    }

    private static string? ConvertMonthToCardExpiry(string monthValue)
    {
        if (string.IsNullOrWhiteSpace(monthValue))
            return null;
        var parts = monthValue.Split('/');
        if (parts.Length != 2)
            return null;
        var month = parts[0];
        var yearTwoDigits = parts[1];
        if (!int.TryParse(month, out var m) || m < 1 || m > 12)
            return null;
        if (yearTwoDigits.Length != 2)
            return null;
        return $"{month}/{yearTwoDigits}";
    }

    private void OnAvatarError()
    {
        _avatarFallback = "/favicon.png";
    }

    private async Task OnAvatarSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null || _currentUserId <= 0)
            return;
        var ext = System.IO.Path.GetExtension(file.Name).ToLowerInvariant();
        if (ext is not ".jpg" and not ".jpeg" and not ".png" and not ".gif" and not ".webp")
        {
            Notify.ShowWarning("Выберите изображение: JPG, PNG, GIF или WEBP.");
            return;
        }
        var (ok, error) = await ClientsApi.UploadAvatarAsync(_currentUserId, file);
        if (!ok)
        {
            Notify.ShowError(error ?? "Не удалось загрузить аватар.");
            return;
        }
        _profileAvatarVer = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        Notify.ShowSuccess("Аватар обновлен.");
        StateHasChanged();
    }

    private void ToggleEditProfile() => _isEditProfile = !_isEditProfile;

    private async Task OnProfileAddressInput(ChangeEventArgs e)
    {
        _editDefaultAddress = e.Value?.ToString() ?? string.Empty;
        _addressSuggestCts?.Cancel();
        _addressSuggestCts = new CancellationTokenSource();
        var token = _addressSuggestCts.Token;
        try
        {
            await Task.Delay(220, token);
            if (string.IsNullOrWhiteSpace(_editDefaultAddress) || _editDefaultAddress.Trim().Length < 3)
            {
                _addressSuggestions.Clear();
                return;
            }
            _addressSuggestions = await AddressSuggestApi.SuggestAsync(_editDefaultAddress, 7, _addressSuggestCity);
            StateHasChanged();
        }
        catch (TaskCanceledException)
        {
        }
    }

    private void PickAddressSuggestion(AddressSuggestItemDto item)
    {
        _editDefaultAddress = item.DisplayName ?? item.PrimaryLine ?? string.Empty;
        _addressSuggestions.Clear();
    }

    private static string DetectPaymentSystem(string digits)
    {
        if (string.IsNullOrWhiteSpace(digits))
            return "Не определена";
        if (digits.StartsWith("4"))
            return "Visa";
        if (digits.StartsWith("22"))
            return "Мир";
        if (digits.StartsWith("5"))
            return "Mastercard";
        if (digits.StartsWith("6"))
            return "UnionPay";
        return "Не определена";
    }

    private static string GetSecurityCodeLabel(string paymentSystem) => paymentSystem switch
    {
        "Mastercard" => "CVC",
        "Visa" => "CVV",
        "Мир" => "CVC",
        "UnionPay" => "CVN",
        _ => "CVV"
    };
}
