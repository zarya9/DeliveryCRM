@page "/customer/tracking"
@layout CustomerLayout
@using System.Security.Claims
@using WebBlazorDeliveryCRM.Components.Shared
@using WebBlazorDeliveryCRM.Utilities
@inject AuthenticationStateProvider AuthStateProvider
@inject ClientsApiService ClientsApi
@inject OrdersApiService OrdersApi
@inject AppNotificationService Notify

<PageTitle>Отслеживание заказа — Клиент</PageTitle>

<div class="dms-page-header">
    <h1 class="dms-page-title-with-icon">
        <HugeIcon Name="location-01" CssClass="dms-page-title-icon" />
        Отслеживание заказа
    </h1>
    <p class="subtitle">Нажмите строку заказа, чтобы открыть карточку с адресами и картой. Таймлайн — кнопкой справа.</p>
</div>

<div class="dms-card">
    @if (_loading)
    {
        <p class="text-muted mb-0">Загрузка заказов...</p>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger mb-0">@_error</div>
    }
    else if (_orders.Count == 0)
    {
        <p class="text-muted mb-0">Пока нет заказов для отслеживания.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm dms-data-table align-middle mb-0">
                <thead>
                    <tr>
                        <DmsTableThIcon Icon="invoice-01">№</DmsTableThIcon>
                        <DmsTableThIcon Icon="calendar-03">Создан</DmsTableThIcon>
                        <DmsTableThIcon Icon="task-01">Название</DmsTableThIcon>
                        <DmsTableThIcon Icon="activity-01">Статус</DmsTableThIcon>
                        <DmsTableThIcon Icon="audit-01" CssClass="text-nowrap text-end">Действие</DmsTableThIcon>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in _orders.OrderByDescending(x => x.Created_at))
                    {
                        <tr class="customer-order-table-row" @onclick="() => OpenOrderDetail(o)">
                            <td>@o.Order_Number</td>
                            <td class="text-nowrap">@o.Created_at.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@o.Name</td>
                            <td>
                                <StatusBadge Text="@(o.OrderStatus?.Name ?? "Статус уточняется")" Tone="@OrderStatusUi.ToneForStatusName(o.OrderStatus?.Name)" />
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1"
                                        type="button"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => LoadTimeline(o.ID_Order)">
                                    <HugeIcon Name="audit-01" CssClass="dms-icon-sm" />
                                    <span>Таймлайн</span>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (_selectedOrder is not null)
{
    <div class="dms-card mb-3">
        <h2 class="dms-card-title dms-card-title-with-icon">
            <HugeIcon Name="wallet-01" CssClass="dms-card-title-icon" />
            Оплата
        </h2>
        <div class="d-flex flex-wrap align-items-center gap-2">
            @if (_selectedOrder.Is_paid)
            {
                <span class="badge rounded-pill bg-success d-inline-flex align-items-center gap-1">
                    <HugeIcon Name="wallet-01" CssClass="dms-icon-sm flex-shrink-0" />
                    <span>Оплачен</span>
                </span>
            }
            else
            {
                <span class="badge rounded-pill bg-warning text-dark d-inline-flex align-items-center gap-1 px-2 py-1">
                    <HugeIcon Name="wallet-01" CssClass="dms-icon-sm flex-shrink-0" />
                    <span>Не оплачен</span>
                </span>
                <button type="button" class="btn btn-sm btn-primary d-inline-flex align-items-center gap-2" disabled="@_paying" @onclick="PaySelectedAsync">
                    <HugeIcon Name="wallet-01" CssClass="dms-icon-sm flex-shrink-0" />
                    <span>Оплатить</span>
                </button>
                <span class="small text-muted">К оплате: @FormatMoneyRub(_selectedOrder.Final_cost > 0 ? _selectedOrder.Final_cost : _selectedOrder.Estimated_cost)</span>
            }
        </div>
    </div>
}

@if (_timeline.Count > 0)
{
    <div class="dms-card">
        <h2 class="dms-card-title dms-card-title-with-icon">
            <HugeIcon Name="clock-01" CssClass="dms-card-title-icon" />
            Таймлайн выбранного заказа
        </h2>
        <ul class="mb-0">
            @foreach (var e in _timeline.OrderByDescending(x => x.Created_at))
            {
                <li class="mb-1">
                    <strong>@(string.IsNullOrWhiteSpace(e.Title) ? e.EventType : e.Title)</strong>
                    <span class="text-muted"> · @e.Created_at.ToString("dd.MM.yyyy HH:mm")</span>
                    @if (!string.IsNullOrWhiteSpace(e.Message))
                    {
                        <div class="small text-muted">@FormatTimelineMessage(e.Message)</div>
                    }
                </li>
            }
        </ul>
    </div>
}

@if (_detailOrder is not null)
{
    <CustomerOrderDetailModal Order="_detailOrder" OnClose="CloseOrderDetailAsync" />
}

@code {
    private bool _loading = true;
    private string? _error;
    private List<OrderDto> _orders = new();
    private List<OrderTimelineEventDto> _timeline = new();
    private int _selectedOrderId;
    private OrderDto? _selectedOrder;
    private OrderDto? _detailOrder;
    private bool _paying;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            var userIdRaw = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            if (!int.TryParse(userIdRaw, out var userId))
            {
                _error = "Не удалось определить текущего пользователя.";
                return;
            }

            var profile = await ClientsApi.GetByUserIdAsync(userId);
            if (profile is null)
            {
                _error = "Профиль клиента не найден.";
                return;
            }

            _orders = await OrdersApi.GetByClientAsync(profile.ID_ClientProfile) ?? new();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadTimeline(int orderId)
    {
        _selectedOrderId = orderId;
        _selectedOrder = _orders.FirstOrDefault(o => o.ID_Order == orderId);
        _timeline = await OrdersApi.GetTimelineAsync(orderId);
        StateHasChanged();
    }

    private void OpenOrderDetail(OrderDto o) => _detailOrder = o;

    private Task CloseOrderDetailAsync()
    {
        _detailOrder = null;
        return Task.CompletedTask;
    }

    private static string FormatMoneyRub(decimal v) => $"{v:N2} ₽";

    private static string FormatTimelineMessage(string? message)
    {
        if (string.IsNullOrWhiteSpace(message))
            return "";
        if (message.Contains("Предварительная стоимость", StringComparison.Ordinal) &&
            !message.Contains('\u20bd') && message.IndexOf("руб", StringComparison.OrdinalIgnoreCase) < 0)
        {
            var t = message.TrimEnd();
            if (t.EndsWith('.'))
                t = t[..^1];
            return t + " ₽.";
        }
        return message;
    }

    private async Task PaySelectedAsync()
    {
        if (_selectedOrder is null)
            return;
        _paying = true;
        try
        {
            var (ok, err) = await OrdersApi.PayOrderAsync(_selectedOrder.ID_Order);
            if (!ok)
            {
                Notify.ShowError(err ?? "Не удалось оплатить.");
                return;
            }

            Notify.ShowSuccess("Оплата прошла успешно.");
            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            var userIdRaw = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            if (int.TryParse(userIdRaw, out var userId))
            {
                var profile = await ClientsApi.GetByUserIdAsync(userId);
                if (profile is not null)
                    _orders = await OrdersApi.GetByClientAsync(profile.ID_ClientProfile) ?? new();
                _selectedOrder = _orders.FirstOrDefault(o => o.ID_Order == _selectedOrderId);
                _timeline = await OrdersApi.GetTimelineAsync(_selectedOrderId);
                StateHasChanged();
            }
        }
        finally
        {
            _paying = false;
            StateHasChanged();
        }
    }
}
