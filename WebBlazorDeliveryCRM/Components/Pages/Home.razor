@page "/home"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using System.Security.Claims
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Система управления службой доставки</PageTitle>

<div class="role-selector">
    <h1>Система управления службой доставки</h1>
    <p class="text-muted">Веб-приложение: выберите роль для входа в интерфейс.</p>
    <p class="auth-link"><a href="/login">Войти в систему (API)</a></p>
    <div class="role-links">
        <a href="/customer" class="role-card">
            <span class="role-icon">👤</span>
            <span class="role-name">Клиент</span>
            <span class="role-desc">Создание и отслеживание заказов</span>
        </a>
        <a href="/logistician" class="role-card">
            <span class="role-icon">🗺</span>
            <span class="role-name">Логист</span>
            <span class="role-desc">Распределение, маршруты, мониторинг</span>
        </a>
        <a href="/manager" class="role-card">
            <span class="role-icon">📊</span>
            <span class="role-name">Менеджер</span>
            <span class="role-desc">Дашборд, заказы, курьеры, аналитика</span>
        </a>
        <a href="/login" class="role-card">
            <span class="role-icon">🛵</span>
            <span class="role-name">Курьер</span>
            <span class="role-desc">Смена, геолокация, заказы и чат компании</span>
        </a>
    </div>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated != true)
        {
            Navigation.NavigateTo("/login", replace: true);
            return;
        }
        var roles = state.User.Claims
            .Where(c => c.Type == ClaimTypes.Role || c.Type == "role")
            .Select(c => c.Value)
            .Distinct()
            .ToList();
        string? role = roles.FirstOrDefault(r => r is "Клиент" or "Логист" or "Логистика" or "Менеджер" or "Админ" or "Администратор" or "Курьер")
                     ?? roles.FirstOrDefault();
        if (role == "Клиент")
            Navigation.NavigateTo("/customer", replace: true);
        else if (role == "Менеджер")
            Navigation.NavigateTo("/manager", replace: true);
        else if (role == "Логист" || string.Equals(role, "Логистика", StringComparison.Ordinal))
            Navigation.NavigateTo("/logistician", replace: true);
        else if (role == "Админ" || role == "Администратор")
            Navigation.NavigateTo("/admin/employees", replace: true);
        else if (role == "Курьер")
            Navigation.NavigateTo("/courier/shift", replace: true);
    }
}
