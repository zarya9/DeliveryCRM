@page "/home"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

<PageTitle>Система управления службой доставки</PageTitle>

<div class="role-selector">
    <h1>Система управления службой доставки</h1>
    <p class="text-muted">Веб-приложение: выберите роль для входа в интерфейс.</p>
    <p class="auth-link"><a href="/login">Войти в систему (API)</a></p>
    <div class="role-links">
        <a href="/customer" class="role-card">
            <span class="role-icon">👤</span>
            <span class="role-name">Клиент</span>
            <span class="role-desc">Создание и отслеживание заказов</span>
        </a>
        <a href="/logistician" class="role-card">
            <span class="role-icon">🗺</span>
            <span class="role-name">Логист</span>
            <span class="role-desc">Распределение, маршруты, мониторинг</span>
        </a>
        <a href="/manager" class="role-card">
            <span class="role-icon">📊</span>
            <span class="role-name">Менеджер</span>
            <span class="role-desc">Дашборд, заказы, курьеры, аналитика</span>
        </a>
    </div>
</div>
