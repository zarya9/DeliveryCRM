@page "/access-denied"
@layout LoginLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Нет доступа</PageTitle>

<div class="auth-shell">
    <div class="auth-card">
        <div class="auth-card-head">
            <h1>Нет доступа</h1>
            <p class="mb-0">У этой учётной записи нет прав на запрошенный раздел. Войдите под другой ролью или вернитесь в свой кабинет.</p>
        </div>
        <div class="d-flex flex-wrap gap-2 mt-3">
            <button type="button" class="btn btn-primary" @onclick="LogoutAndLogin">Войти другим пользователем</button>
            <a class="btn btn-outline-secondary" href="/home">На главную</a>
        </div>
    </div>
</div>

@code {
    private async Task LogoutAndLogin()
    {
        try
        {
            await JS.InvokeVoidAsync("deliveryCrmAuth.clearSession");
        }
        catch
        {
            // ignore
        }

        if (AuthStateProvider is WebBlazorDeliveryCRM.Services.CustomAuthenticationStateProvider custom)
            await custom.MarkUserAsLoggedOutAsync();

        Navigation.NavigateTo("/login", replace: true);
    }
}
