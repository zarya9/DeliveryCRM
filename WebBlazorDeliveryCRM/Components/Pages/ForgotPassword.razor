@page "/forgot-password"
@layout LoginLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using Microsoft.AspNetCore.WebUtilities
@inject AuthApiService AuthApi
@inject NavigationManager Navigation
@inject AppNotificationService Notify

<PageTitle>Восстановление пароля</PageTitle>

<div class="auth-shell">
    <div class="auth-card">
        <div class="auth-card-head">
            <h1>Восстановление пароля</h1>
            <p>Укажите email — пришлём код. Затем введите код и новый пароль.</p>
        </div>

        @if (_step == 0)
        {
            <div class="mb-3">
                <label class="form-label">Email</label>
                <input type="email" class="form-control" placeholder="example@mail.ru" @bind="_email" autocomplete="email" />
            </div>
            <button type="button" class="btn btn-primary dms-btn-primary w-100" disabled="@_loading" @onclick="SendCodeAsync">
                @(_loading ? "Отправка..." : "Отправить код")
            </button>
        }
        else
        {
            <p class="small text-muted mb-2">Письмо отправлено на <strong>@_email</strong>. Введите код из письма и новый пароль.</p>
            <div class="mb-2">
                <label class="form-label">Код из письма</label>
                <input type="text" class="form-control" inputmode="numeric" maxlength="12" @bind="_code" placeholder="000000" autocomplete="one-time-code" />
            </div>
            <div class="mb-2">
                <label class="form-label">Новый пароль</label>
                <input type="password" class="form-control" @bind="_newPassword" autocomplete="new-password" />
            </div>
            <div class="mb-3">
                <label class="form-label">Повторите пароль</label>
                <input type="password" class="form-control" @bind="_newPassword2" autocomplete="new-password" />
            </div>
            <button type="button" class="btn btn-primary dms-btn-primary w-100 mb-2" disabled="@_loading" @onclick="CompleteAsync">
                @(_loading ? "Сохранение..." : "Сменить пароль")
            </button>
            <button type="button" class="btn btn-outline-secondary w-100" disabled="@_loading" @onclick="BackToEmail">
                Изменить email
            </button>
        }

        <p class="mt-3 mb-0 small text-secondary">
            <a href="/login">Вернуться ко входу</a>
        </p>
    </div>
</div>

@code {
    private int _step;
    private string _email = "";
    private string _code = "";
    private string _newPassword = "";
    private string _newPassword2 = "";
    private bool _loading;

    protected override void OnInitialized()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("email", out var values))
        {
            var raw = values.FirstOrDefault();
            if (!string.IsNullOrWhiteSpace(raw))
                _email = Uri.UnescapeDataString(raw!);
        }
    }

    private async Task SendCodeAsync()
    {
        var email = _email?.Trim() ?? "";
        if (string.IsNullOrWhiteSpace(email))
        {
            Notify.ShowWarning("Введите email.");
            return;
        }

        _loading = true;
        try
        {
            var result = await AuthApi.RequestPasswordResetAsync(email);
            if (!result.Success)
            {
                Notify.ShowError(result.ErrorMessage ?? AuthApiService.ServerUnavailableUserMessage);
                return;
            }

            Notify.ShowSuccess(result.Message ?? "Запрос принят.");
            _step = 1;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task CompleteAsync()
    {
        if (string.IsNullOrWhiteSpace(_code) || string.IsNullOrWhiteSpace(_newPassword))
        {
            Notify.ShowWarning("Введите код и новый пароль.");
            return;
        }

        if (_newPassword != _newPassword2)
        {
            Notify.ShowWarning("Пароли не совпадают.");
            return;
        }

        _loading = true;
        try
        {
            var result = await AuthApi.CompletePasswordResetAsync(_email.Trim(), _code, _newPassword);
            if (!result.Success)
            {
                Notify.ShowError(result.ErrorMessage ?? "Не удалось сменить пароль.");
                return;
            }

            Notify.ShowSuccess(result.Message ?? "Пароль изменён.");
            Navigation.NavigateTo("/login", forceLoad: true);
        }
        finally
        {
            _loading = false;
        }
    }

    private void BackToEmail()
    {
        _step = 0;
        _code = "";
        _newPassword = "";
        _newPassword2 = "";
    }
}
