@page "/logistician/monitoring"
@layout LogisticianLayout
@using WebBlazorDeliveryCRM.Components.Shared
@using WebBlazorDeliveryCRM.Models
@using WebBlazorDeliveryCRM.Services
@inject MonitoringApiService MonitoringApi
@inject TrackingHubClientService TrackingHubClient
@inject IJSRuntime JS
@inject IConfiguration Configuration
@implements IDisposable

<PageTitle>Мониторинг — Логист</PageTitle>

<div class="dms-page-header">
    <h1>Мониторинг операций</h1>
    <p class="subtitle">
        Лента событий по заказам компании и карта: все курьеры компании и склады. Координаты курьеров в сети обновляются по SignalR в реальном времени; полная синхронизация карты периодическая.
    </p>
</div>

<div class="dms-stat-grid mb-3">
    <KpiCard Title="События за 48 ч" Value="@_feedCount.ToString()" Meta="по заказам компании" />
    <KpiCard Title="На смене" Value="@_onShiftCount.ToString()" Meta="активная смена без окончания" />
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="dms-card">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                <h2 class="dms-card-title mb-0">Лента событий</h2>
                <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_feedLoading" @onclick="ReloadFeedAsync">Обновить</button>
            </div>
            @if (_feedLoading && _feed.Count == 0)
            {
                <p class="text-muted mb-0">Загрузка…</p>
            }
            else if (_feed.Count == 0)
            {
                <p class="text-muted mb-0">Событий за выбранный период нет.</p>
            }
            else
            {
                <ul class="list-unstyled mb-0 monitoring-feed">
                    @foreach (var e in _feed)
                    {
                        <li class="monitoring-feed-item border-bottom pb-2 mb-2">
                            <div class="small text-muted">@e.Created_at.ToLocalTime().ToString("dd.MM.yyyy HH:mm") · заказ №@e.OrderNumber</div>
                            <div class="fw-semibold">@(string.IsNullOrWhiteSpace(e.Title) ? e.EventType : e.Title)</div>
                            @if (!string.IsNullOrWhiteSpace(e.Message))
                            {
                                <div class="small">@e.Message</div>
                            }
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
    <div class="col-lg-5">
        <div class="dms-card">
            <h2 class="dms-card-title">Карта</h2>
            <p class="small text-muted mb-2">Курьеры: live по WebSocket; склады и новые курьеры — при периодическом обновлении.</p>
            <div id="logistician-monitoring-map" style="height: 420px; width: 100%; border-radius: 8px;"></div>
        </div>
    </div>
</div>

@code {
    private List<MonitoringFeedItemDto> _feed = new();
    private bool _feedLoading = true;
    private int _feedCount;
    private int _onShiftCount;
    private PeriodicTimer? _feedTimer;
    private PeriodicTimer? _mapTimer;
    private CancellationTokenSource? _feedCts;
    private CancellationTokenSource? _mapCts;
    private IDisposable? _trackingHandler;
    private bool _mapReady;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await ReloadFeedAsync();
        await InitMapOnceAsync();
        await StartLiveTrackingAsync();
        StartRefreshLoops();
    }

    private async Task InitMapOnceAsync()
    {
        if (_mapReady) return;
        try
        {
            var osrmUrl = Configuration["Osrm:RouterBaseUrl"];
            await JS.InvokeVoidAsync("leafletMap.init", "logistician-monitoring-map", 55.7558, 37.6173, 11, null, osrmUrl, false, null);
            _mapReady = true;
            await RefreshMapAsync();
        }
        catch
        {
            // пререндер / нет DOM
        }
    }

    private async Task ReloadFeedAsync()
    {
        _feedLoading = true;
        StateHasChanged();
        try
        {
            _feed = await MonitoringApi.GetFeedAsync(48, 80);
            _feedCount = _feed.Count;
        }
        finally
        {
            _feedLoading = false;
            StateHasChanged();
        }
    }

    private async Task RefreshMapAsync()
    {
        if (!_mapReady) return;
        var live = await MonitoringApi.GetLiveMapAsync();
        _onShiftCount = live?.Couriers?.Count ?? 0;
        var markers = new List<object>();
        if (live?.Couriers != null)
        {
            foreach (var c in live.Couriers)
            {
                if (c.Lat == 0 && c.Lon == 0) continue;
                markers.Add(new { id = c.Id, lat = c.Lat, lon = c.Lon, title = c.Title ?? "Курьер", kind = "courier", online = c.Online });
            }
        }

        if (live?.Hubs != null)
        {
            foreach (var h in live.Hubs)
            {
                markers.Add(new { id = h.Id, lat = h.Lat, lon = h.Lon, title = h.Title ?? "Склад", kind = "hub" });
            }
        }

        await JS.InvokeVoidAsync("leafletMap.clearMarkers");
        if (markers.Count > 0)
            await JS.InvokeVoidAsync("leafletMap.setMarkers", markers);
        StateHasChanged();
    }

    private async Task StartLiveTrackingAsync()
    {
        try
        {
            var hub = await TrackingHubClient.GetConnectionAsync();
            await TrackingHubClient.EnsureStartedAsync();
            _trackingHandler?.Dispose();
            _trackingHandler = hub.On<CourierLocationPushDto>("CourierLocationUpdated", async payload =>
            {
                await InvokeAsync(async () =>
                {
                    if (!_mapReady || payload == null)
                        return;
                    await JS.InvokeVoidAsync(
                        "leafletMap.upsertCourierMarker",
                        payload.CourierProfileId,
                        payload.Lat,
                        payload.Lon,
                        payload.Title ?? $"Курьер #{payload.CourierProfileId}",
                        payload.Online);
                });
            });
        }
        catch
        {
            // SignalR необязателен: карта обновится по таймеру
        }
    }

    private void StartRefreshLoops()
    {
        StopRefreshLoops();
        _feedCts = new CancellationTokenSource();
        _mapCts = new CancellationTokenSource();
        _feedTimer = new PeriodicTimer(TimeSpan.FromSeconds(25));
        _mapTimer = new PeriodicTimer(TimeSpan.FromSeconds(90));
        _ = FeedLoopAsync(_feedCts.Token);
        _ = MapLoopAsync(_mapCts.Token);
    }

    private async Task FeedLoopAsync(CancellationToken ct)
    {
        try
        {
            while (_feedTimer is not null && await _feedTimer.WaitForNextTickAsync(ct))
                await ReloadFeedAsync();
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task MapLoopAsync(CancellationToken ct)
    {
        try
        {
            while (_mapTimer is not null && await _mapTimer.WaitForNextTickAsync(ct))
                await RefreshMapAsync();
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void StopRefreshLoops()
    {
        _feedCts?.Cancel();
        _feedCts?.Dispose();
        _feedCts = null;
        _mapCts?.Cancel();
        _mapCts?.Dispose();
        _mapCts = null;
        _feedTimer?.Dispose();
        _feedTimer = null;
        _mapTimer?.Dispose();
        _mapTimer = null;
    }

    public void Dispose()
    {
        _trackingHandler?.Dispose();
        _trackingHandler = null;
        StopRefreshLoops();
    }
}
