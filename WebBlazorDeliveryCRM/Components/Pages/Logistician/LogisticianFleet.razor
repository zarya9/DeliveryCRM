    private void CloseVehicleDetailsModal()
    {
        _showDetailsModal = false;
        _detailsVehicleId = null;
        _vehicleEditMode = false;
        _detailVehicle = null;
    }

    private void FillEditFromDetail()
    {
        if (_detailVehicle is null || _lookups is null)
            return;
        var v = _detailVehicle;
        _editVehicle = new CreateVehicleApiRequest
        {
            License_plate = v.License_plate ?? "",
            VIN = v.VIN ?? "",
            Category_id = v.Category_id > 0 ? v.Category_id : (_lookups.Categories.FirstOrDefault()?.Id ?? 0),
            Model_id = null,
            Brand_name = v.Brand_name ?? v.VehicleModel?.VehicleBrand?.Name ?? "",
            Model_name = v.Model_name ?? v.VehicleModel?.Name ?? "",
            Year = v.Year,
            Color = v.Color ?? "",
            BodyType_id = v.BodyType_id,
            Cargo_volume = v.Cargo_volume,
            Max_cargo_weight = v.Max_cargo_weight,
            FuelType_id = v.FuelType_id,
            FuelTank_Capacity = v.FuelTank_Capacity,
            Current_mileage = v.Current_mileage,
            Insurance_policy = v.Insurance_policy ?? "",
            Insurance_expires_at = v.Insurance_expires_at,
            Registration_expires_at = v.Registration_expires_at,
            Maintenance_due_at = v.Maintenance_due_at,
            Is_available = v.Is_available,
            CurrentCourier_id = v.CurrentCourier_id
        };
        _editVehicleYear = v.Year.Year > 0 ? v.Year.Year : DateTime.UtcNow.Year;
        _editVehicleCourierId = v.CurrentCourier_id ?? 0;
    }

    private void EnableVehicleEditMode()
    {
        if (_detailVehicle is null || _lookups is null)
        {
            Notify.ShowWarning("Нет данных или справочников для редактирования.");
            return;
        }
        FillEditFromDetail();
        _vehicleEditMode = true;
    }

    private void CancelVehicleEditMode()
    {
        _vehicleEditMode = false;
    }

    private Task OnEditCategoryChangedAfter()
    {
        var maxWeight = _lookups?.Categories.FirstOrDefault(c => c.Id == _editVehicle.Category_id)?.MaxWeight;
        if (maxWeight.HasValue && maxWeight.Value > 0)
            _editVehicle.Max_cargo_weight = maxWeight.Value;
        return Task.CompletedTask;
    }

    private void OnEditVinInput(ChangeEventArgs e)
    {
        _editVehicle.VIN = VinHelper.SanitizeInput(e.Value?.ToString());
    }

    private void OnEditLicensePlateInput(ChangeEventArgs e)
    {
        var raw = (e.Value?.ToString() ?? string.Empty).ToUpperInvariant();
        raw = raw.Replace('A', 'А').Replace('B', 'В').Replace('E', 'Е').Replace('K', 'К').Replace('M', 'М')
            .Replace('H', 'Н').Replace('O', 'О').Replace('P', 'Р').Replace('C', 'С').Replace('T', 'Т')
            .Replace('Y', 'У').Replace('X', 'Х');
        raw = new string(raw.Where(ch => char.IsDigit(ch) || "АВЕКМНОРСТУХ".Contains(ch)).ToArray());
        _editVehicle.License_plate = raw.Length > 9 ? raw[..9] : raw;
    }

    private async Task SaveVehicleEditsAsync()
    {
        if (!_detailsVehicleId.HasValue || _detailVehicle is null || _lookups is null)
            return;

        if (string.IsNullOrWhiteSpace(_editVehicle.License_plate) || string.IsNullOrWhiteSpace(_editVehicle.VIN))
        {
            Notify.ShowWarning("Укажите гос. номер и VIN.");
            return;
        }
        if (!System.Text.RegularExpressions.Regex.IsMatch(_editVehicle.License_plate, "^[АВЕКМНОРСТУХ]\\d{3}[АВЕКМНОРСТУХ]{2}\\d{2,3}$"))
        {
            Notify.ShowWarning("Гос. номер должен быть в формате А123ВС77.");
            return;
        }
        if (!VinHelper.IsValid(_editVehicle.VIN, out var vinErr))
        {
            Notify.ShowWarning(vinErr ?? "Некорректный VIN.");
            return;
        }
        if (string.IsNullOrWhiteSpace(_editVehicle.Brand_name) || string.IsNullOrWhiteSpace(_editVehicle.Model_name))
        {
            Notify.ShowWarning("Укажите марку и модель.");
            return;
        }
        if (_editVehicle.Category_id <= 0 || _editVehicle.BodyType_id <= 0 || _editVehicle.FuelType_id <= 0)
        {
            Notify.ShowWarning("Выберите категорию, кузов и топливо.");
            return;
        }

        _editVehicle.Year = new DateOnly(Math.Clamp(_editVehicleYear, 1980, 2100), 1, 1);
        _editVehicle.CurrentCourier_id = _editVehicleCourierId > 0 ? _editVehicleCourierId : null;

        _savingVehicleEdit = true;
        try
        {
            var (ok, err) = await VehiclesApi.UpdateVehicleAsync(_detailsVehicleId.Value, _editVehicle);
            if (!ok)
            {
                Notify.ShowError(string.IsNullOrWhiteSpace(err) ? "Не удалось сохранить ТС." : err!);
                return;
            }

            Notify.ShowSuccess("ТС обновлено.");
            _vehicleEditMode = false;
            _detailVehicle = await VehiclesApi.GetVehicleByIdAsync(_detailsVehicleId.Value) ?? _detailVehicle;
            await ReloadAsync();
        }
        finally
        {
            _savingVehicleEdit = false;
        }
    }

    private async Task DeleteSelectedVehicleAsync()
    {
        if (!_selectedVehicleId.HasValue)
            return;
        await DeleteVehicleByIdAsync(_selectedVehicleId.Value);
    }

    private async Task DeleteActiveVehicleAsync()
    {
        if (!_detailsVehicleId.HasValue)
            return;
        await DeleteVehicleByIdAsync(_detailsVehicleId.Value);
    }

    private async Task DeleteVehicleByIdAsync(int vehicleId)
    {
        var (ok, err) = await VehiclesApi.DeleteVehicleAsync(vehicleId);
        if (!ok)
        {
            Notify.ShowError(string.IsNullOrWhiteSpace(err) ? "Не удалось удалить ТС." : err!);
            return;
        }

        Notify.ShowSuccess("ТС удалено.");
        if (_selectedVehicleId == vehicleId)
            _selectedVehicleId = null;
        if (_detailsVehicleId == vehicleId)
            CloseVehicleDetailsModal();
        await ReloadAsync();
    }

    private async Task OpenAddVehicleModalAsync()
    {
        _newVehicle = CreateVehicleDefault();
        _newVehicleYear = DateTime.UtcNow.Year;
        _newVehicleCourierId = 0;
        var brandsFromApi = await VehiclesApi.GetCatalogBrandsAsync();
        _allCatalogModels = await VehiclesApi.GetCatalogModelsAsync(null);
        _catalogBrands = brandsFromApi.Count > 0
            ? brandsFromApi
            : _allCatalogModels
                .GroupBy(x => x.BrandId)
                .Select(g => new IdNameDto { Id = g.Key, Name = g.First().BrandName ?? "" })
                .OrderBy(b => b.Name)
                .ToList();
        _hasCatalogData = _catalogBrands.Count > 0 || _allCatalogModels.Count > 0;
        _selectedBrandId = 0;
        _selectedModelId = 0;
        _catalogHint = string.Empty;
        _showAddBrandPanel = false;
        _showAddModelPanel = false;
        _newCatalogBrandName = "";
        _newCatalogModelName = "";
        _newCatalogModelYear = _newVehicleYear;
        _showAddVehicleModal = true;
    }

    private async Task OnBrandSelectChanged(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Integer, System.Globalization.CultureInfo.InvariantCulture, out var id))
            return;
        if (id == AddCatalogEntrySentinel)
        {
            _newCatalogBrandName = "";
            _showAddBrandPanel = true;
            StateHasChanged();
            return;
        }

        _showAddBrandPanel = false;
        _selectedBrandId = id;
        await OnCatalogBrandChangedAfter();
    }

    private async Task OnModelSelectChanged(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Integer, System.Globalization.CultureInfo.InvariantCulture, out var id))
            return;
        if (id == AddCatalogEntrySentinel)
        {
            if (_selectedBrandId <= 0)
            {
                Notify.ShowWarning("Сначала выберите марку в списке, затем добавьте модель.");
                return;
            }

            _newCatalogModelName = "";
            _newCatalogModelYear = _newVehicleYear;
            _showAddModelPanel = true;
            StateHasChanged();
            return;
        }

        _showAddModelPanel = false;
        _selectedModelId = id;
        await OnCatalogModelChangedAfter();
    }

    private void CancelAddCatalogBrand() => _showAddBrandPanel = false;

    private void CancelAddCatalogModel() => _showAddModelPanel = false;

    private async Task SaveNewCatalogBrandAsync()
    {
        var name = (_newCatalogBrandName ?? string.Empty).Trim();
        if (name.Length == 0)
        {
            Notify.ShowWarning("Введите название марки.");
            return;
        }

        _savingCatalogBrand = true;
        try
        {
            var (ok, err, created) = await VehiclesApi.CreateCatalogBrandAsync(name);
            if (!ok || created is null)
            {
                Notify.ShowError(string.IsNullOrWhiteSpace(err) ? "Не удалось создать марку." : err!);
                return;
            }

            _catalogBrands = _catalogBrands
                .Where(b => b.Id != created.Id)
                .Append(created)
                .OrderBy(b => b.Name, StringComparer.OrdinalIgnoreCase)
                .ToList();
            _hasCatalogData = _catalogBrands.Count > 0 || _allCatalogModels.Count > 0;
            _selectedBrandId = created.Id;
            _showAddBrandPanel = false;
            Notify.ShowSuccess("Марка добавлена в справочник.");
            await OnCatalogBrandChangedAfter();
        }
        finally
        {
            _savingCatalogBrand = false;
        }
    }

    private async Task SaveNewCatalogModelAsync()
    {
        if (_selectedBrandId <= 0)
        {
            Notify.ShowWarning("Сначала выберите марку.");
            return;
        }

        var name = (_newCatalogModelName ?? string.Empty).Trim();
        if (name.Length == 0)
        {
            Notify.ShowWarning("Введите название модели.");
            return;
        }

        var year = Math.Clamp(_newCatalogModelYear, 1980, 2100);

        _savingCatalogModel = true;
        try
        {
            var (ok, err, created) = await VehiclesApi.CreateCatalogModelAsync(_selectedBrandId, name, year);
            if (!ok || created is null)
            {
                Notify.ShowError(string.IsNullOrWhiteSpace(err) ? "Не удалось создать модель." : err!);
                return;
            }

            if (_selectedBrandId > 0)
                _allCatalogModels = await VehiclesApi.GetCatalogModelsAsync(_selectedBrandId);
            else
                _allCatalogModels = await VehiclesApi.GetCatalogModelsAsync(null);

            _selectedModelId = created.Id;
            _newVehicle.Model_id = created.Id;
            _newVehicleYear = created.Year.Year;
            _newVehicle.Brand_name = created.BrandName ?? string.Empty;
            _newVehicle.Model_name = created.Name ?? string.Empty;
            _catalogHint = BuildCatalogHint(created);
            _showAddModelPanel = false;
            Notify.ShowSuccess("Модель добавлена в справочник и выбрана.");
            SyncBrandNameFromSelection();
            StateHasChanged();
        }
        finally
        {
            _savingCatalogModel = false;
        }
    }

    private async Task OnCatalogBrandChangedAfter()
    {
        _showAddModelPanel = false;
        _selectedModelId = 0;
        _newVehicle.Model_id = null;
        _newVehicle.Model_name = string.Empty;
        _catalogHint = string.Empty;

        if (_selectedBrandId > 0)
        {
            var byBrand = await VehiclesApi.GetCatalogModelsAsync(_selectedBrandId);
            if (byBrand.Count > 0)
            {
                _allCatalogModels = byBrand;
            }
            else
            {
                var selectedBrandName = _catalogBrands.FirstOrDefault(b => b.Id == _selectedBrandId)?.Name;
                if (!string.IsNullOrWhiteSpace(selectedBrandName))
                {
                    var all = await VehiclesApi.GetCatalogModelsAsync(null);
                    var byName = all
                        .Where(m => string.Equals((m.BrandName ?? string.Empty).Trim(), selectedBrandName.Trim(), StringComparison.OrdinalIgnoreCase))
                        .ToList();
                    _allCatalogModels = byName.Count > 0 ? byName : all;
                }
            }
        }
        else
        {
            _allCatalogModels = await VehiclesApi.GetCatalogModelsAsync(null);
        }

        if (_selectedModelId <= 0)
        {
            SyncBrandNameFromSelection();
            return;
        }

        var current = _allCatalogModels.FirstOrDefault(x => x.Id == _selectedModelId);
        if (current is null || (_selectedBrandId > 0 && current.BrandId != _selectedBrandId))
        {
            _selectedModelId = 0;
            _newVehicle.Model_id = null;
            _newVehicle.Model_name = string.Empty;
            _catalogHint = string.Empty;
        }

        SyncBrandNameFromSelection();
    }

    private Task OnCatalogModelChangedAfter()
    {
        var m = _allCatalogModels.FirstOrDefault(x => x.Id == _selectedModelId);
        if (m is null || _selectedModelId <= 0)
        {
            _newVehicle.Model_id = null;
            _newVehicle.Model_name = string.Empty;
            _catalogHint = string.Empty;
            SyncBrandNameFromSelection();
            return Task.CompletedTask;
        }

        _selectedBrandId = m.BrandId;
        _newVehicle.Model_id = m.Id;
        _newVehicleYear = m.Year.Year;
        _newVehicle.Brand_name = m.BrandName ?? string.Empty;
        _newVehicle.Model_name = m.Name ?? string.Empty;
        _catalogHint = BuildCatalogHint(m);
        SyncBrandNameFromSelection();
        return Task.CompletedTask;
    }

    private Task OnCategoryChangedAfter()
    {
        var maxWeight = _lookups?.Categories.FirstOrDefault(c => c.Id == _newVehicle.Category_id)?.MaxWeight;
        if (maxWeight.HasValue && maxWeight.Value > 0)
            _newVehicle.Max_cargo_weight = maxWeight.Value;
        return Task.CompletedTask;
    }

    private void SyncBrandNameFromSelection()
    {
        if (_selectedBrandId > 0)
            _newVehicle.Brand_name = _catalogBrands.FirstOrDefault(b => b.Id == _selectedBrandId)?.Name ?? string.Empty;
        else if ((_newVehicle.Model_id ?? 0) <= 0)
            _newVehicle.Brand_name = string.Empty;
    }

    private List<VehicleCatalogModelDto> GetFilteredCatalogModels()
    {
        IEnumerable<VehicleCatalogModelDto> q = _allCatalogModels;
        if (_selectedBrandId > 0)
            q = q.Where(m => m.BrandId == _selectedBrandId);
        return q.OrderBy(m => m.BrandName).ThenBy(m => m.Name).ThenBy(m => m.Year).ToList();
    }

    private string FormatCatalogModelOption(VehicleCatalogModelDto m)
    {
        if (_selectedBrandId > 0)
            return $"{m.Name} ({m.Year})";
        var brand = string.IsNullOrWhiteSpace(m.BrandName) ? "?" : m.BrandName;
        return $"{brand} — {m.Name} ({m.Year})";
    }

    private static string BuildCatalogHint(VehicleCatalogModelDto m)
    {
        var tr = string.IsNullOrWhiteSpace(m.TransmissionTypeName) ? $"КПП #{m.TransmissionTypeId}" : m.TransmissionTypeName;
        var dr = string.IsNullOrWhiteSpace(m.DriveTypeName) ? $"привод #{m.DriveTypeId}" : m.DriveTypeName;
        return $"Справочник: расход {m.AvgFuelCity:0.#} / {m.AvgFuelHighWay:0.#} л/100 км, двигатель {m.EngineCapacity:0.#} л, {m.HorsePower} л.с., {tr}, {dr}.";
    }

    private void OnVinInput(ChangeEventArgs e)
    {
        _newVehicle.VIN = VinHelper.SanitizeInput(e.Value?.ToString());
    }

    private void CloseAddVehicleModal()
    {
        _showAddVehicleModal = false;
        _showAddBrandPanel = false;
        _showAddModelPanel = false;
    }

    private async Task CreateVehicleAsync()
    {
        if (_lookups is null)
        {
            Notify.ShowError("Справочники ТС не загружены.");
            return;
        }

        if (string.IsNullOrWhiteSpace(_newVehicle.License_plate) || string.IsNullOrWhiteSpace(_newVehicle.VIN))
        {
            Notify.ShowWarning("Укажите гос. номер и VIN.");
            return;
        }
        if (!System.Text.RegularExpressions.Regex.IsMatch(_newVehicle.License_plate, "^[АВЕКМНОРСТУХ]\\d{3}[АВЕКМНОРСТУХ]{2}\\d{2,3}$"))
        {
            Notify.ShowWarning("Гос. номер должен быть в формате А123ВС77.");
            return;
        }
        if (!VinHelper.IsValid(_newVehicle.VIN, out var vinErr))
        {
            Notify.ShowWarning(vinErr ?? "Некорректный VIN.");
            return;
        }
        if ((_newVehicle.Model_id ?? 0) <= 0 &&
            (string.IsNullOrWhiteSpace(_newVehicle.Brand_name) || string.IsNullOrWhiteSpace(_newVehicle.Model_name)))
        {
            Notify.ShowWarning("Выберите модель из справочника или укажите марку и модель вручную.");
            return;
        }
        if (_newVehicle.Category_id <= 0 || _newVehicle.BodyType_id <= 0 || _newVehicle.FuelType_id <= 0)
        {
            Notify.ShowWarning("Выберите категорию, кузов и топливо.");
            return;
        }

        _newVehicle.Year = new DateOnly(Math.Clamp(_newVehicleYear, 1980, 2100), 1, 1);
        _newVehicle.CurrentCourier_id = _newVehicleCourierId > 0 ? _newVehicleCourierId : null;

        _savingVehicle = true;
        try
        {
            var (ok, err, _) = await VehiclesApi.CreateVehicleAsync(_newVehicle);
            if (!ok)
            {
                Notify.ShowError(string.IsNullOrWhiteSpace(err) ? "Не удалось создать ТС." : err!);
                return;
            }

            Notify.ShowSuccess("ТС добавлено.");
            _newVehicle = CreateVehicleDefault();
            _newVehicleYear = DateTime.UtcNow.Year;
            _newVehicleCourierId = 0;
            _showAddVehicleModal = false;
            await ReloadAsync();
        }
        finally
        {
            _savingVehicle = false;
        }
    }

    private static CreateVehicleApiRequest CreateVehicleDefault() => new()
    {
        Year = new DateOnly(DateTime.UtcNow.Year, 1, 1),
        Cargo_volume = 0,
        Max_cargo_weight = 0,
        FuelTank_Capacity = 0,
        Current_mileage = 0,
        Is_available = true
    };

    private void OnLicensePlateInput(ChangeEventArgs e)
    {
        var raw = (e.Value?.ToString() ?? string.Empty).ToUpperInvariant();
        raw = raw.Replace('A', 'А').Replace('B', 'В').Replace('E', 'Е').Replace('K', 'К').Replace('M', 'М')
            .Replace('H', 'Н').Replace('O', 'О').Replace('P', 'Р').Replace('C', 'С').Replace('T', 'Т')
            .Replace('Y', 'У').Replace('X', 'Х');
        raw = new string(raw.Where(ch => char.IsDigit(ch) || "АВЕКМНОРСТУХ".Contains(ch)).ToArray());
        _newVehicle.License_plate = raw.Length > 9 ? raw[..9] : raw;
    }

    private void StartAutoRefreshLoop()
    {
        StopAutoRefreshLoop();
        _refreshCts = new CancellationTokenSource();
        _refreshTimer = new PeriodicTimer(TimeSpan.FromSeconds(20));
        _ = RunAutoRefreshAsync(_refreshCts.Token);
    }

    private async Task RunAutoRefreshAsync(CancellationToken ct)
    {
        try
        {
            while (_refreshTimer is not null && await _refreshTimer.WaitForNextTickAsync(ct))
                await ReloadAsync();
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void StopAutoRefreshLoop()
    {
        _refreshCts?.Cancel();
        _refreshCts?.Dispose();
        _refreshCts = null;
        _refreshTimer?.Dispose();
        _refreshTimer = null;
    }

    public void Dispose()
    {
        StopAutoRefreshLoop();
    }
