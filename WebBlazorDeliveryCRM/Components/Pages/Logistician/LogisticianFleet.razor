    {
        _selectedVehicleId = v.ID_Vehicle;
    }

    private async Task OpenVehicleDetailsAsync(VehicleDto v)
    {
        _selectedVehicleId = v.ID_Vehicle;
        _detailsVehicleId = v.ID_Vehicle;
        _vehicleEditMode = false;
        _showDetailsModal = true;
        _loadingVehicleDetail = true;
        _detailVehicle = null;
        StateHasChanged();

        _detailVehicle = await VehiclesApi.GetVehicleByIdAsync(v.ID_Vehicle) ?? v;
        _loadingVehicleDetail = false;
        StateHasChanged();
