@page "/logistician/couriers/{CourierId:int}"
@layout LogisticianLayout
@using WebBlazorDeliveryCRM.Models
@using WebBlazorDeliveryCRM.Services
@using WebBlazorDeliveryCRM.Components.Shared
@inject CouriersApiService CouriersApi
@inject OrdersApiService OrdersApi
@inject NavigationManager Navigation
@inject AppNotificationService Notify

<PageTitle>Курьер — Логист</PageTitle>

<div class="dms-page-header">
    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
        <a href="/logistician/couriers" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1">
            <HugeIcon Name="user-group" CssClass="dms-icon-sm" />
            К списку
        </a>
    </div>
    <h1 class="courier-detail-page-title">
        <HugeIcon Name="user-03" CssClass="courier-detail-page-title-icon" />
        Карточка курьера
    </h1>
    <p class="subtitle">Транспорт, документы и заказы</p>
</div>

@if (_loading)
{
    <p class="text-muted">Загрузка…</p>
}
else if (_courier is null)
{
    <div class="alert alert-warning">Курьер не найден или нет доступа.</div>
}
else
{
    <div class="row g-3">
        <div class="col-lg-6">
            <div class="dms-card h-100">
                <h2 class="dms-card-title courier-detail-card-title">
                    <HugeIcon Name="user-03" CssClass="courier-detail-card-title-icon" />
                    Профиль
                </h2>
                <div class="d-flex align-items-start gap-3 mb-3">
                    <UserAvatarThumb UserId="_courier.User_id" Large="true" Alt="@FullName(_courier)" />
                    <div class="flex-grow-1 min-w-0">
                        <p class="mb-1 courier-detail-row">
                            <span class="courier-detail-row__label"><HugeIcon Name="user-03" CssClass="dms-icon-sm" /><strong>ФИО</strong></span>
                            <span>@FullName(_courier)</span>
                        </p>
                        <p class="mb-1 courier-detail-row">
                            <span class="courier-detail-row__label"><HugeIcon Name="analytics-up" CssClass="dms-icon-sm" /><strong>Рейтинг</strong></span>
                            <span>@_courier.Rating</span>
                        </p>
                        <p class="mb-1 courier-detail-row">
                            <span class="courier-detail-row__label"><HugeIcon Name="activity-01" CssClass="dms-icon-sm" /><strong>Статус</strong></span>
                            <span>@(_courier.CourierStatus?.Name ?? "—")</span>
                        </p>
                        <p class="mb-1 courier-detail-row">
                            <span class="courier-detail-row__label"><HugeIcon Name="package-moving" CssClass="dms-icon-sm" /><strong>Доставок всего</strong></span>
                            <span>@_courier.Total_deliveries</span>
                        </p>
                        <p class="mb-0 courier-detail-row">
                            <span class="courier-detail-row__label"><HugeIcon Name="clock-01" CssClass="dms-icon-sm" /><strong>Последняя активность</strong></span>
                            <span>@_courier.LastActivity_at.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                        </p>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="dms-card h-100">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                    <h2 class="dms-card-title courier-detail-card-title mb-0">
                        <HugeIcon Name="audit-01" CssClass="courier-detail-card-title-icon" />
                        Документы и допуски
                    </h2>
                    @if (!_editingDocs)
                    {
                        @if (DocsIncomplete)
                        {
                            <button type="button" class="btn btn-sm btn-primary d-inline-flex align-items-center gap-1" @onclick="() => _editingDocs = true">
                                <HugeIcon Name="plus-sign" CssClass="dms-icon-sm" />
                                Заполнить
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1" @onclick="() => _editingDocs = true">
                                <HugeIcon Name="edit-01" CssClass="dms-icon-sm" />
                                Редактировать
                            </button>
                        }
                    }
                    else
                    {
                        <button type="button" class="btn btn-sm btn-primary d-inline-flex align-items-center gap-1" disabled="@_savingDocs" @onclick="SaveDocumentsAsync">
                            <HugeIcon Name="sent" CssClass="dms-icon-sm" />
                            @(_savingDocs ? "Сохранение…" : "Сохранить")
                        </button>
                    }
                </div>
                @if (!_editingDocs)
                {
                    <p class="mb-1 courier-detail-row">
                        <span class="courier-detail-row__label"><HugeIcon Name="car-01" CssClass="dms-icon-sm" /><strong>Категория ТС (допуск)</strong></span>
                        <span>@(CategoryName(_courier))</span>
                    </p>
                    <p class="mb-1 courier-detail-row">
                        <span class="courier-detail-row__label"><HugeIcon Name="calendar-03" CssClass="dms-icon-sm" /><strong>График работы</strong></span>
                        <span>@(ScheduleName(_courier))</span>
                    </p>
                    <p class="mb-1 courier-detail-row">
                        <span class="courier-detail-row__label"><HugeIcon Name="invoice-01" CssClass="dms-icon-sm" /><strong>Водительское удостоверение</strong></span>
                        <span>@(string.IsNullOrWhiteSpace(_courier.DriverLicense) ? "—" : _courier.DriverLicense)</span>
                    </p>
                    <p class="mb-0 courier-detail-row">
                        <span class="courier-detail-row__label"><HugeIcon Name="briefcase-01" CssClass="dms-icon-sm" /><strong>Паспорт / данные</strong></span>
                        <span>@(string.IsNullOrWhiteSpace(_courier.Passport_data) ? "—" : _courier.Passport_data)</span>
                    </p>
                }
                else
                {
                    <p class="small text-muted">Категория ТС и график — в справочниках; здесь можно внести ВУ и паспортные данные.</p>
                    <div class="mb-2">
                        <label class="form-label courier-detail-form-label"><HugeIcon Name="invoice-01" CssClass="dms-icon-sm" />Водительское удостоверение</label>
                        <input class="form-control" @bind="_editDriverLicense" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label courier-detail-form-label"><HugeIcon Name="briefcase-01" CssClass="dms-icon-sm" />Паспорт / данные</label>
                        <textarea class="form-control" rows="3" @bind="_editPassport"></textarea>
                    </div>
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CancelEditDocs">Отмена</button>
                }
            </div>
        </div>
    </div>

    <div class="dms-card mt-3 courier-vehicle-assign-card">
        <h2 class="dms-card-title courier-detail-card-title">
            <HugeIcon Name="car-01" CssClass="courier-detail-card-title-icon" />
            Автомобиль
        </h2>
        @if (_assignedVehicles.Count > 0)
        {
            <p class="mb-2 courier-detail-row">
                <span class="courier-detail-row__label"><HugeIcon Name="delivery-truck-01" CssClass="dms-icon-sm" /><strong>Сейчас закреплено</strong></span>
            </p>
            <ul class="mb-3">
                @foreach (var v in _assignedVehicles)
                {
                    <li class="d-flex align-items-center gap-2">
                        <HugeIcon Name="car-01" CssClass="dms-icon-sm opacity-75" />
                        @FormatVehicleLabel(v)
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="text-muted mb-3 d-flex align-items-start gap-2">
                <HugeIcon Name="car-01" CssClass="dms-icon-sm flex-shrink-0 mt-1" />
                За курьером не закреплено ни одного ТС в системе.
            </p>
        }

        <label class="form-label courier-detail-form-label"><HugeIcon Name="route-02" CssClass="dms-icon-sm" />Назначить / сменить автомобиль</label>
        <div class="row g-2 align-items-end">
            <div class="col-md-8">
                <select class="form-select" @bind="_selectedVehicleId">
                    <option value="0">— выберите ТС компании —</option>
                    @foreach (var v in _vehicles.OrderBy(x => x.License_plate))
                    {
                        <option value="@v.ID_Vehicle">@FormatVehicleLabel(v)</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <button type="button" class="btn btn-primary dms-btn-primary w-100 d-inline-flex align-items-center justify-content-center gap-1" disabled="@(_assigning || _selectedVehicleId == 0)" @onclick="AssignVehicle">
                    <HugeIcon Name="delivery-truck-01" CssClass="dms-icon-sm" />
                    @(_assigning ? "Сохранение…" : "Назначить")
                </button>
            </div>
        </div>
        <p class="text-muted small mt-2 mb-0">Выбирается транспорт вашей компании; текущий водитель на ТС будет заменён на этого курьера.</p>
    </div>

    <div class="dms-card mt-3">
        <h2 class="dms-card-title courier-detail-card-title">
            <HugeIcon Name="package-moving" CssClass="courier-detail-card-title-icon" />
            Заказы, назначенные курьеру
        </h2>
        @if (_orders is { Count: > 0 })
        {
            <div class="table-responsive">
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>
                                <span class="courier-detail-th">
                                    <span>№</span>
                                    <HugeIcon Name="invoice-01" CssClass="courier-detail-th-icon" />
                                </span>
                            </th>
                            <th>
                                <span class="courier-detail-th">
                                    <span>Название</span>
                                    <HugeIcon Name="task-01" CssClass="courier-detail-th-icon" />
                                </span>
                            </th>
                            <th>
                                <span class="courier-detail-th">
                                    <span>Статус</span>
                                    <HugeIcon Name="activity-01" CssClass="courier-detail-th-icon" />
                                </span>
                            </th>
                            <th>
                                <span class="courier-detail-th">
                                    <span>Создан</span>
                                    <HugeIcon Name="clock-01" CssClass="courier-detail-th-icon" />
                                </span>
                            </th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var o in _orders)
                        {
                            <tr>
                                <td>@o.Order_Number</td>
                                <td>@o.Name</td>
                                <td>@(o.OrderStatus?.Name ?? "—")</td>
                                <td>@o.Created_at.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                <td>
                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger"
                                            disabled="@(_revokingOrderId == o.ID_Order)"
                                            @onclick="() => RevokeOrderAsync(o.ID_Order)">
                                        @(_revokingOrderId == o.ID_Order ? "…" : "Отозвать")
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted mb-0 d-flex align-items-center gap-2">
                <HugeIcon Name="package-moving" CssClass="dms-icon-sm flex-shrink-0" />
                Нет заказов в работе у этого курьера.
            </p>
        }
    </div>
}

<style>
    .courier-detail-row {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.35rem 0.75rem;
    }

    .courier-detail-row__label {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        min-width: 11rem;
        color: var(--dms-text-muted, #64748b);
    }

    .courier-detail-row__label strong {
        color: var(--dms-text, #0f172a);
        font-weight: 600;
    }

    .courier-detail-form-label {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        font-weight: 600;
    }

    .courier-detail-th {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        white-space: nowrap;
    }

    .courier-detail-th-icon {
        width: 1.125rem;
        height: 1.125rem;
        flex-shrink: 0;
        opacity: 0.9;
    }
</style>

@code {
    [Parameter] public int CourierId { get; set; }

    private CourierProfileDto? _courier;
    private List<VehicleDto> _vehicles = new();
    private List<VehicleDto> _assignedVehicles = new();
    private List<OrderDto>? _orders;
    private int _selectedVehicleId;
    private bool _assigning;
    private int? _revokingOrderId;
    private bool _loading = true;
    private bool _editingDocs;
    private bool _savingDocs;
    private string _editDriverLicense = "";
    private string _editPassport = "";

    private bool DocsIncomplete =>
        _courier is not null &&
        (string.IsNullOrWhiteSpace(_courier.DriverLicense) || string.IsNullOrWhiteSpace(_courier.Passport_data));

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _courier = await CouriersApi.GetProfileAsync(CourierId);
            if (_courier is null)
            {
                _vehicles = new();
                _assignedVehicles = new();
                _orders = new();
                return;
            }

            _vehicles = await CouriersApi.GetVehiclesByCompanyAsync(_courier.Company_id) ?? new();
            if (_vehicles.Count == 0)
            {
                Notify.ShowWarning("Не удалось загрузить список ТС компании (возможно, временная ошибка API).");
            }
            _assignedVehicles = _vehicles.Where(v => v.CurrentCourier_id == CourierId).ToList();
            _orders = await CouriersApi.GetActiveOrdersAsync(CourierId) ?? new();
            if (_assignedVehicles.Count == 1)
                _selectedVehicleId = _assignedVehicles[0].ID_Vehicle;

            _editDriverLicense = _courier.DriverLicense ?? "";
            _editPassport = _courier.Passport_data ?? "";
            _editingDocs = false;
        }
        catch (Exception ex)
        {
            Notify.ShowError($"Ошибка загрузки карточки курьера: {ex.Message}");
            _vehicles = new();
            _assignedVehicles = new();
            _orders = new();
        }
        finally
        {
            _loading = false;
        }
    }

    private void CancelEditDocs()
    {
        _editingDocs = false;
        if (_courier is not null)
        {
            _editDriverLicense = _courier.DriverLicense ?? "";
            _editPassport = _courier.Passport_data ?? "";
        }
    }

    private async Task SaveDocumentsAsync()
    {
        if (_courier is null) return;
        _savingDocs = true;
        try
        {
            var (ok, err) = await CouriersApi.UpdateDocumentsAsync(CourierId, _editDriverLicense, _editPassport);
            if (ok)
            {
                Notify.ShowSuccess("Данные сохранены.");
                _editingDocs = false;
                await LoadAsync();
            }
            else
                Notify.ShowError(string.IsNullOrWhiteSpace(err) ? "Не удалось сохранить." : err);
        }
        finally
        {
            _savingDocs = false;
        }
    }

    private async Task AssignVehicle()
    {
        if (_selectedVehicleId <= 0 || _courier is null)
        {
            Notify.ShowWarning("Выберите транспортное средство.");
            return;
        }
        _assigning = true;
        try
        {
            var (ok, err) = await CouriersApi.AssignVehicleAsync(CourierId, _selectedVehicleId);
            if (ok)
            {
                Notify.ShowSuccess("Автомобиль назначен.");
                await LoadAsync();
            }
            else
            {
                Notify.ShowError(string.IsNullOrWhiteSpace(err) ? "Не удалось назначить ТС." : err);
            }
        }
        catch (Exception ex)
        {
            Notify.ShowError(ex.Message);
        }
        finally
        {
            _assigning = false;
        }
    }

    private static string FullName(CourierProfileDto c)
        => $"{c.User?.FName} {c.User?.Name} {c.User?.Patronumic}".Trim();

    private static string CategoryName(CourierProfileDto c)
        => c.VehicleCategory?.Name ?? c.VehicleCategoryName ?? "—";

    private static string ScheduleName(CourierProfileDto c)
        => c.ScheduleType?.Name ?? c.ScheduleName ?? "—";

    private static string FormatVehicleLabel(VehicleDto v)
    {
        var brand = v.VehicleModel?.VehicleBrand?.Name ?? v.Brand_name ?? "";
        var model = v.VehicleModel?.Name ?? v.Model_name ?? "";
        var plate = v.License_plate ?? "";
        var parts = new[] { brand, model, plate }.Where(s => !string.IsNullOrWhiteSpace(s));
        var s = string.Join(" ", parts);
        return string.IsNullOrWhiteSpace(s) ? $"ТС #{v.ID_Vehicle}" : s;
    }

    private async Task RevokeOrderAsync(int orderId)
    {
        _revokingOrderId = orderId;
        try
        {
            var (ok, error) = await OrdersApi.RevokeCourierAsync(orderId);
            if (ok)
            {
                Notify.ShowSuccess("Заказ отозван у курьера.");
                await LoadAsync();
            }
            else
                Notify.ShowError(error ?? "Не удалось отозвать заказ.");
        }
        catch (Exception ex)
        {
            Notify.ShowError(ex.Message);
        }
        finally
        {
            _revokingOrderId = null;
        }
    }
}
