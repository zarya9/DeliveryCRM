@page "/logistician/couriers"
@layout LogisticianLayout
@using WebBlazorDeliveryCRM.Models
@using WebBlazorDeliveryCRM.Services
@using WebBlazorDeliveryCRM.Components.Shared
@inject CouriersApiService CouriersApi
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Курьеры — Логист</PageTitle>

<div class="dms-page-header">
    <h1 class="couriers-page-title">
        <HugeIcon Name="user-group" CssClass="couriers-page-title-icon" />
        Управление курьерами
    </h1>
    <p class="subtitle mb-0">
        <a class="text-decoration-none" href="/logistician/fleet">Автопарк компании →</a>
    </p>
</div>

<div class="dms-card">
    <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
        <h2 class="dms-card-title couriers-card-title mb-0">
            <HugeIcon Name="user-group" CssClass="couriers-card-title-icon" />
            Курьеры
        </h2>
        <input class="form-control"
               style="max-width: 280px;"
               placeholder="Поиск по ФИО"
               value="@_searchText"
               @oninput="OnSearchInput" />
    </div>
    @if (_couriers != null && _couriers.Count > 0)
    {
        <table class="table">
            <thead>
                <tr>
                    <th>
                        <span class="couriers-table-th">
                            <span>ФИО</span>
                            <HugeIcon Name="user-03" CssClass="couriers-th-icon" />
                        </span>
                    </th>
                    <th>
                        <span class="couriers-table-th">
                            <span>Смена</span>
                            <HugeIcon Name="calendar-03" CssClass="couriers-th-icon" />
                        </span>
                    </th>
                    <th>
                        <span class="couriers-table-th">
                            <span>Рейтинг</span>
                            <HugeIcon Name="analytics-up" CssClass="couriers-th-icon" />
                        </span>
                    </th>
                    <th>
                        <span class="couriers-table-th">
                            <span>Доставок</span>
                            <HugeIcon Name="package-moving" CssClass="couriers-th-icon" />
                        </span>
                    </th>
                    <th>
                        <span class="couriers-table-th">
                            <span>KPI</span>
                            <HugeIcon Name="task-01" CssClass="couriers-th-icon" />
                        </span>
                    </th>
                    <th>
                        <span class="couriers-table-th">
                            <span>Категория допуска</span>
                            <HugeIcon Name="car-01" CssClass="couriers-th-icon" />
                        </span>
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in _couriers.Where(FilterCourier))
                {
                    <tr style="cursor: pointer;" title="Открыть карточку"
                        @onclick="@(() => Navigation.NavigateTo($"/logistician/couriers/{c.ID_CourierProfile}"))">
                        <td>
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <UserAvatarThumb UserId="c.User_id" Alt="@($"{c.User?.FName} {c.User?.Name}".Trim())" />
                                <span>
                                    <span class="status-dot @(c.Is_online ? "status-dot-online" : "status-dot-offline")"></span>
                                    @(c.User?.FName) @(c.User?.Name)
                                    @if (c.User_id == _currentUserId)
                                    {
                                        <span class="text-muted ms-1">(Вы)</span>
                                    }
                                </span>
                            </div>
                        </td>
                        <td class="couriers-shift-cell">
                            @if (IsOnShift(c.ID_CourierProfile))
                            {
                                <button type="button"
                                        class="couriers-shift-active"
                                        title="Открыть карту смены"
                                        @onclick:stopPropagation="true"
                                        @onclick="@(() => OpenCourierShiftMap(c.ID_CourierProfile))">
                                    На смене — карта
                                </button>
                            }
                            else
                            {
                                <span class="couriers-shift-inactive">Не на смене</span>
                            }
                        </td>
                        <td>@c.Rating</td>
                        <td>@c.Total_deliveries</td>
                        <td>@KpiLabel(c)</td>
                        <td>@(c.VehicleCategory?.Name ?? c.VehicleCategoryName ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-muted">Курьеров нет.</p>
    }
</div>

<style>
    .couriers-table-th {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        white-space: nowrap;
    }

    .couriers-th-icon {
        width: 1.125rem;
        height: 1.125rem;
        flex-shrink: 0;
        opacity: 0.9;
    }

    .couriers-shift-cell {
        vertical-align: middle;
    }

    .couriers-shift-active {
        display: inline-flex;
        align-items: center;
        margin: 0;
        padding: 0.2rem 0 0.2rem 0.6rem;
        border: none;
        border-left: 3px solid #16a34a;
        background: transparent;
        color: var(--dms-primary, #0f766e);
        font-weight: 600;
        font-size: 0.95rem;
        text-align: left;
        cursor: pointer;
        border-radius: 0 4px 4px 0;
        transition: background 0.12s ease;
    }

    .couriers-shift-active:hover {
        background: rgba(22, 163, 74, 0.08);
    }

    .couriers-shift-inactive {
        color: var(--dms-text-muted, #6b7280);
        font-size: 0.95rem;
        padding-left: 0.15rem;
    }
</style>

@code {
    private List<CourierProfileDto>? _couriers;
    private string _searchText = string.Empty;
    private int? _currentUserId;
    private PeriodicTimer? _refreshTimer;
    private CancellationTokenSource? _refreshCts;
    private readonly Dictionary<int, bool> _onShiftByCourier = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await ReloadAsync();
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var userIdStr = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (int.TryParse(userIdStr, out var uid))
        {
            _currentUserId = uid;
        }
        StartAutoRefreshLoop();
        StateHasChanged();
    }

    private async Task ReloadAsync()
    {
        _couriers = await CouriersApi.GetAllAsync(null) ?? new List<CourierProfileDto>();
        _onShiftByCourier.Clear();
        foreach (var courier in _couriers)
        {
            var shift = await CouriersApi.GetActiveShiftAsync(courier.ID_CourierProfile);
            _onShiftByCourier[courier.ID_CourierProfile] = shift.active;
        }
        StateHasChanged();
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _searchText = e.Value?.ToString() ?? "";
    }

    private bool FilterCourier(CourierProfileDto c)
    {
        if (string.IsNullOrWhiteSpace(_searchText)) return true;
        var q = _searchText.Trim().ToLowerInvariant();
        var fullName = $"{c.User?.FName} {c.User?.Name}".ToLowerInvariant();
        return fullName.Contains(q);
    }

    private bool IsOnShift(int courierProfileId)
        => _onShiftByCourier.TryGetValue(courierProfileId, out var onShift) && onShift;

    private void OpenCourierShiftMap(int courierProfileId)
    {
        Navigation.NavigateTo($"/logistician/couriers/{courierProfileId}/map");
    }

    private static string KpiLabel(CourierProfileDto c)
    {
        if (c.Total_deliveries <= 0)
            return "—";
        return $"{(double)c.Rating:0.0} / {c.Total_deliveries}";
    }

    private void StartAutoRefreshLoop()
    {
        StopAutoRefreshLoop();
        _refreshCts = new CancellationTokenSource();
        _refreshTimer = new PeriodicTimer(TimeSpan.FromSeconds(15));
        _ = RunAutoRefreshAsync(_refreshCts.Token);
    }

    private async Task RunAutoRefreshAsync(CancellationToken ct)
    {
        try
        {
            while (_refreshTimer is not null && await _refreshTimer.WaitForNextTickAsync(ct))
                await ReloadAsync();
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void StopAutoRefreshLoop()
    {
        _refreshCts?.Cancel();
        _refreshCts?.Dispose();
        _refreshCts = null;
        _refreshTimer?.Dispose();
        _refreshTimer = null;
    }

    public void Dispose()
    {
        StopAutoRefreshLoop();
    }
}
