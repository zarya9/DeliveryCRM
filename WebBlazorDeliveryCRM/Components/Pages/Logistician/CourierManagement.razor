@page "/logistician/couriers"
@layout LogisticianLayout
@using WebBlazorDeliveryCRM.Models
@using WebBlazorDeliveryCRM.Services
@using WebBlazorDeliveryCRM.Utilities
@inject CouriersApiService CouriersApi
@inject VehiclesApiService VehiclesApi
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject AppNotificationService Notify
@implements IDisposable

<PageTitle>Курьеры — Логист</PageTitle>

<div class="dms-page-header">
    <h1>Управление курьерами</h1>
    <p class="subtitle">Список курьеров — откройте карточку для назначения ТС и просмотра данных</p>
</div>

<div class="dms-card">
    <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
        <h2 class="dms-card-title mb-0">Курьеры</h2>
        <input class="form-control"
               style="max-width: 280px;"
               placeholder="Поиск по ФИО"
               value="@_searchText"
               @oninput="OnSearchInput" />
    </div>
    @if (_couriers != null && _couriers.Count > 0)
    {
        <table class="table">
            <thead>
                <tr>
                    <th>ФИО</th>
                    <th>Рейтинг</th>
                    <th>Доставок</th>
                    <th>KPI</th>
                    <th>Категория допуска</th>
                    <th>Текущий автомобиль</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in _couriers.Where(FilterCourier))
                {
                    <tr style="cursor: pointer;" title="Открыть карточку"
                        @onclick="@(() => Navigation.NavigateTo($"/logistician/couriers/{c.ID_CourierProfile}"))">
                        <td>
                            <span class="status-dot @(c.Is_online ? "status-dot-online" : "status-dot-offline")"></span>
                            @(c.User?.FName) @(c.User?.Name)
                            <StatusBadge Text="@(c.Is_online ? "Онлайн" : "Офлайн")" Tone="@(c.Is_online ? "success" : "neutral")" />
                            @if (c.User_id == _currentUserId)
                            {
                                <span class="text-muted ms-1">(Вы)</span>
                            }
                        </td>
                        <td>@c.Rating</td>
                        <td>@c.Total_deliveries</td>
                        <td>@KpiLabel(c)</td>
                        <td>@(c.VehicleCategory?.Name ?? c.VehicleCategoryName ?? "—")</td>
                        <td>@CurrentVehicleLabel(c.ID_CourierProfile)</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-muted">Курьеров нет.</p>
    }
</div>

<div class="dms-card mt-3">
    <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
        <h2 class="dms-card-title mb-0">Автопарк компании</h2>
        <button type="button" class="btn btn-primary btn-sm dms-btn-primary" @onclick="OpenAddVehicleModalAsync">Добавить авто</button>
    </div>
    @if (_vehicles.Count == 0)
    {
        <p class="text-muted mb-0">ТС пока не добавлены.</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Авто</th>
                    <th>Гос. номер</th>
                    <th>VIN</th>
                    <th>Назначено курьеру</th>
                    <th>Доступность</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in _vehicles.OrderBy(x => x.License_plate))
                {
                    var assignedCourier = _couriers?.FirstOrDefault(c => c.ID_CourierProfile == v.CurrentCourier_id);
                    <tr>
                        <td>@FormatVehicleShort(v)</td>
                        <td>@(string.IsNullOrWhiteSpace(v.License_plate) ? "—" : v.License_plate)</td>
                        <td>@(string.IsNullOrWhiteSpace(v.VIN) ? "—" : v.VIN)</td>
                        <td>@(assignedCourier is null ? "—" : $"{assignedCourier.User?.FName} {assignedCourier.User?.Name}".Trim())</td>
                        <td><StatusBadge Text="@(v.Is_available ? "Доступно" : "Недоступно")" Tone="@(v.Is_available ? "success" : "warning")" /></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@if (_showAddVehicleModal)
{
    <div class="employee-modal-backdrop" @onclick="CloseAddVehicleModal">
        <div class="employee-modal" @onclick:stopPropagation="true">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <h2 class="h5 mb-0">Добавить транспорт</h2>
                <button type="button" class="btn-close" aria-label="Закрыть" @onclick="CloseAddVehicleModal"></button>
            </div>

            @if (_lookups is null)
            {
                <div class="alert alert-warning mb-0">Не удалось загрузить справочники для создания ТС.</div>
            }
            else
            {
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Гос. номер *</label>
                        <input class="form-control" @bind="_newVehicle.License_plate" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">VIN *</label>
                        <input class="form-control" maxlength="17" value="@_newVehicle.VIN" @oninput="OnVinInput" />
                    </div>
                    @if (UseVehicleCatalog)
                    {
                        <div class="col-md-6">
                            <label class="form-label">Марка *</label>
                            <select class="form-select" @bind="_selectedBrandId" @bind:after="OnCatalogBrandChangedAfter">
                                <option value="0">— любая марка (или выберите первой) —</option>
                                @foreach (var b in _catalogBrands)
                                {
                                    <option value="@b.Id">@b.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Модель *</label>
                            <select class="form-select" @bind="_selectedModelId" @bind:after="OnCatalogModelChangedAfter">
                                <option value="0">— выберите модель —</option>
                                @foreach (var m in GetFilteredCatalogModels())
                                {
                                    <option value="@m.Id">@FormatCatalogModelOption(m)</option>
                                }
                            </select>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_catalogHint))
                        {
                            <div class="col-12">
                                <div class="form-text text-info">@_catalogHint</div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="col-md-4">
                            <label class="form-label">Марка *</label>
                            <input class="form-control" @bind="_newVehicle.Brand_name" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Модель *</label>
                            <input class="form-control" @bind="_newVehicle.Model_name" />
                        </div>
                    }
                    <div class="col-md-4">
                        <label class="form-label">Категория *</label>
                        <select class="form-select" @bind="_newVehicle.Category_id">
                            <option value="0">—</option>
                            @foreach (var c in _lookups.Categories)
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Кузов *</label>
                        <select class="form-select" @bind="_newVehicle.BodyType_id">
                            <option value="0">—</option>
                            @foreach (var b in _lookups.BodyTypes)
                            {
                                <option value="@b.Id">@b.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Топливо *</label>
                        <select class="form-select" @bind="_newVehicle.FuelType_id">
                            <option value="0">—</option>
                            @foreach (var f in _lookups.FuelTypes)
                            {
                                <option value="@f.Id">@f.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Год выпуска *</label>
                        <input type="number" min="1980" max="2100" class="form-control" @bind="_newVehicleYear" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Цвет</label>
                        <input class="form-control" @bind="_newVehicle.Color" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Объём кузова, м³</label>
                        <input type="number" step="0.01" class="form-control" @bind="_newVehicle.Cargo_volume" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Макс. груз, кг</label>
                        <input type="number" step="0.01" class="form-control" @bind="_newVehicle.Max_cargo_weight" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Бак, л</label>
                        <input type="number" step="0.01" class="form-control" @bind="_newVehicle.FuelTank_Capacity" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Пробег</label>
                        <input type="number" step="0.01" class="form-control" @bind="_newVehicle.Current_mileage" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Полис страхования</label>
                        <input class="form-control" @bind="_newVehicle.Insurance_policy" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Закрепить за курьером</label>
                        <select class="form-select" @bind="_newVehicleCourierId">
                            <option value="0">— только автопарк —</option>
                            @foreach (var c in (_couriers ?? new List<CourierProfileDto>()).OrderBy(x => x.User?.FName))
                            {
                                <option value="@c.ID_CourierProfile">@($"{c.User?.FName} {c.User?.Name}".Trim())</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="d-flex gap-2 mt-3">
                    <button type="button" class="btn btn-primary dms-btn-primary" disabled="@_savingVehicle" @onclick="CreateVehicleAsync">
                        @(_savingVehicle ? "Сохраняем..." : "Создать ТС")
                    </button>
                    <button type="button" class="btn btn-outline-secondary" disabled="@_savingVehicle" @onclick="CloseAddVehicleModal">Отмена</button>
                </div>
            }
        </div>
    </div>
}

@code {
    private List<CourierProfileDto>? _couriers;
    private List<VehicleDto> _vehicles = new();
    private VehicleFormLookupsDto? _lookups;
    private string _searchText = string.Empty;
    private int? _currentUserId;
    private PeriodicTimer? _refreshTimer;
    private CancellationTokenSource? _refreshCts;
    private bool _showAddVehicleModal;
    private bool _savingVehicle;
    private CreateVehicleApiRequest _newVehicle = CreateVehicleDefault();
    private int _newVehicleYear = DateTime.UtcNow.Year;
    private int _newVehicleCourierId;
    private List<IdNameDto> _catalogBrands = new();
    private List<VehicleCatalogModelDto> _allCatalogModels = new();
    private int _selectedBrandId;
    private int _selectedModelId;
    private string _catalogHint = string.Empty;

    private bool UseVehicleCatalog => _allCatalogModels.Count > 0;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await ReloadAsync();
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var userIdStr = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (int.TryParse(userIdStr, out var uid))
        {
            _currentUserId = uid;
        }
        StartAutoRefreshLoop();
        StateHasChanged();
    }

    private async Task ReloadAsync()
    {
        _couriers = await CouriersApi.GetAllAsync(null) ?? new List<CourierProfileDto>();
        var cid = _couriers.FirstOrDefault()?.Company_id;
        if (!cid.HasValue)
        {
            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            if (int.TryParse(state.User.FindFirst("companyId")?.Value, out var claimCid))
                cid = claimCid;
        }

        _vehicles = cid.HasValue
            ? await CouriersApi.GetVehiclesByCompanyAsync(cid.Value) ?? new List<VehicleDto>()
            : new List<VehicleDto>();
        _lookups ??= await VehiclesApi.GetLookupsAsync();
        StateHasChanged();
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _searchText = e.Value?.ToString() ?? "";
    }

    private bool FilterCourier(CourierProfileDto c)
    {
        if (string.IsNullOrWhiteSpace(_searchText)) return true;
        var q = _searchText.Trim().ToLowerInvariant();
        var fullName = $"{c.User?.FName} {c.User?.Name}".ToLowerInvariant();
        return fullName.Contains(q);
    }

    private string CurrentVehicleLabel(int courierProfileId)
    {
        var v = _vehicles.FirstOrDefault(x => x.CurrentCourier_id == courierProfileId);
        return v is null ? "—" : FormatVehicleShort(v);
    }

    private static string FormatVehicleShort(VehicleDto v)
    {
        var brand = v.VehicleModel?.VehicleBrand?.Name ?? v.Brand_name ?? "";
        var model = v.VehicleModel?.Name ?? v.Model_name ?? "";
        var plate = v.License_plate ?? "";
        var parts = new[] { brand, model, plate }.Where(s => !string.IsNullOrWhiteSpace(s));
        var s = string.Join(" ", parts);
        return string.IsNullOrWhiteSpace(s) ? $"ТС #{v.ID_Vehicle}" : s;
    }

    private static string KpiLabel(CourierProfileDto c)
    {
        if (c.Total_deliveries <= 0)
            return "—";
        return $"{(double)c.Rating:0.0} / {c.Total_deliveries}";
    }

    private async Task OpenAddVehicleModalAsync()
    {
        _newVehicle = CreateVehicleDefault();
        _newVehicleYear = DateTime.UtcNow.Year;
        _newVehicleCourierId = 0;
        var brandsFromApi = await VehiclesApi.GetCatalogBrandsAsync();
        _allCatalogModels = await VehiclesApi.GetCatalogModelsAsync(null);
        _catalogBrands = brandsFromApi.Count > 0
            ? brandsFromApi
            : _allCatalogModels
                .GroupBy(x => x.BrandId)
                .Select(g => new IdNameDto { Id = g.Key, Name = g.First().BrandName ?? "" })
                .OrderBy(b => b.Name)
                .ToList();
        _selectedBrandId = 0;
        _selectedModelId = 0;
        _catalogHint = string.Empty;
        _showAddVehicleModal = true;
    }

    private void OnCatalogBrandChangedAfter()
    {
        if (_selectedModelId <= 0)
        {
            SyncBrandNameFromSelection();
            return;
        }

        var current = _allCatalogModels.FirstOrDefault(x => x.Id == _selectedModelId);
        if (current is null || (_selectedBrandId > 0 && current.BrandId != _selectedBrandId))
        {
            _selectedModelId = 0;
            _newVehicle.Model_id = null;
            _newVehicle.Model_name = string.Empty;
            _catalogHint = string.Empty;
        }

        SyncBrandNameFromSelection();
    }

    private void OnCatalogModelChangedAfter()
    {
        var m = _allCatalogModels.FirstOrDefault(x => x.Id == _selectedModelId);
        if (m is null || _selectedModelId <= 0)
        {
            _newVehicle.Model_id = null;
            _newVehicle.Model_name = string.Empty;
            _catalogHint = string.Empty;
            SyncBrandNameFromSelection();
            return;
        }

        _selectedBrandId = m.BrandId;
        _newVehicle.Model_id = m.Id;
        _newVehicleYear = m.Year.Year;
        _newVehicle.Brand_name = m.BrandName ?? string.Empty;
        _newVehicle.Model_name = m.Name ?? string.Empty;
        _catalogHint = BuildCatalogHint(m);
    }

    private void SyncBrandNameFromSelection()
    {
        if (_selectedBrandId > 0)
            _newVehicle.Brand_name = _catalogBrands.FirstOrDefault(b => b.Id == _selectedBrandId)?.Name ?? string.Empty;
        else if ((_newVehicle.Model_id ?? 0) <= 0)
            _newVehicle.Brand_name = string.Empty;
    }

    private List<VehicleCatalogModelDto> GetFilteredCatalogModels()
    {
        IEnumerable<VehicleCatalogModelDto> q = _allCatalogModels;
        if (_selectedBrandId > 0)
            q = q.Where(m => m.BrandId == _selectedBrandId);
        return q.OrderBy(m => m.BrandName).ThenBy(m => m.Name).ThenBy(m => m.Year).ToList();
    }

    private string FormatCatalogModelOption(VehicleCatalogModelDto m)
    {
        if (_selectedBrandId > 0)
            return $"{m.Name} ({m.Year})";
        var brand = string.IsNullOrWhiteSpace(m.BrandName) ? "?" : m.BrandName;
        return $"{brand} — {m.Name} ({m.Year})";
    }

    private static string BuildCatalogHint(VehicleCatalogModelDto m)
    {
        var tr = string.IsNullOrWhiteSpace(m.TransmissionTypeName) ? $"КПП #{m.TransmissionTypeId}" : m.TransmissionTypeName;
        var dr = string.IsNullOrWhiteSpace(m.DriveTypeName) ? $"привод #{m.DriveTypeId}" : m.DriveTypeName;
        return $"Справочник: расход {m.AvgFuelCity:0.#} / {m.AvgFuelHighWay:0.#} л/100 км, двигатель {m.EngineCapacity:0.#} л, {m.HorsePower} л.с., {tr}, {dr}.";
    }

    private void OnVinInput(ChangeEventArgs e)
    {
        _newVehicle.VIN = VinHelper.SanitizeInput(e.Value?.ToString());
    }

    private void CloseAddVehicleModal()
    {
        _showAddVehicleModal = false;
    }

    private async Task CreateVehicleAsync()
    {
        if (_lookups is null)
        {
            Notify.ShowError("Справочники ТС не загружены.");
            return;
        }

        if (string.IsNullOrWhiteSpace(_newVehicle.License_plate) || string.IsNullOrWhiteSpace(_newVehicle.VIN))
        {
            Notify.ShowWarning("Укажите гос. номер и VIN.");
            return;
        }
        if (!VinHelper.IsValid(_newVehicle.VIN, out var vinErr))
        {
            Notify.ShowWarning(vinErr ?? "Некорректный VIN.");
            return;
        }
        if ((_newVehicle.Model_id ?? 0) <= 0 &&
            (string.IsNullOrWhiteSpace(_newVehicle.Brand_name) || string.IsNullOrWhiteSpace(_newVehicle.Model_name)))
        {
            Notify.ShowWarning("Выберите модель из справочника или укажите марку и модель вручную.");
            return;
        }
        if (_newVehicle.Category_id <= 0 || _newVehicle.BodyType_id <= 0 || _newVehicle.FuelType_id <= 0)
        {
            Notify.ShowWarning("Выберите категорию, кузов и топливо.");
            return;
        }

        _newVehicle.Year = new DateOnly(Math.Clamp(_newVehicleYear, 1980, 2100), 1, 1);
        _newVehicle.CurrentCourier_id = _newVehicleCourierId > 0 ? _newVehicleCourierId : null;

        _savingVehicle = true;
        try
        {
            var (ok, err, _) = await VehiclesApi.CreateVehicleAsync(_newVehicle);
            if (!ok)
            {
                Notify.ShowError(string.IsNullOrWhiteSpace(err) ? "Не удалось создать ТС." : err!);
                return;
            }

            Notify.ShowSuccess("ТС добавлено.");
            _newVehicle = CreateVehicleDefault();
            _newVehicleYear = DateTime.UtcNow.Year;
            _newVehicleCourierId = 0;
            _showAddVehicleModal = false;
            await ReloadAsync();
        }
        finally
        {
            _savingVehicle = false;
        }
    }

    private static CreateVehicleApiRequest CreateVehicleDefault() => new()
    {
        Year = new DateOnly(DateTime.UtcNow.Year, 1, 1),
        Cargo_volume = 0,
        Max_cargo_weight = 0,
        FuelTank_Capacity = 0,
        Current_mileage = 0,
        Is_available = true
    };

    private void StartAutoRefreshLoop()
    {
        StopAutoRefreshLoop();
        _refreshCts = new CancellationTokenSource();
        _refreshTimer = new PeriodicTimer(TimeSpan.FromSeconds(15));
        _ = RunAutoRefreshAsync(_refreshCts.Token);
    }

    private async Task RunAutoRefreshAsync(CancellationToken ct)
    {
        try
        {
            while (_refreshTimer is not null && await _refreshTimer.WaitForNextTickAsync(ct))
            {
                await ReloadAsync();
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void StopAutoRefreshLoop()
    {
        _refreshCts?.Cancel();
        _refreshCts?.Dispose();
        _refreshCts = null;
        _refreshTimer?.Dispose();
        _refreshTimer = null;
    }

    public void Dispose()
    {
        StopAutoRefreshLoop();
    }
}
