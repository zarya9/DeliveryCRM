@page "/logistician/hubs"
@layout LogisticianLayout
@using WebBlazorDeliveryCRM.Services
@using WebBlazorDeliveryCRM.Components.Shared
@inject LogisticsHubsApiService HubsApi
@implements IDisposable

<PageTitle>Склады — Логист</PageTitle>

<div class="dms-page-header">
    <h1>Склады и сортировочные пункты</h1>
    <p class="subtitle">Просмотр складов компании. Создание и изменение складов выполняет менеджер.</p>
</div>

<div class="dms-stat-grid mb-3">
    <KpiCard Title="Доступных складов" Value="@((_list?.Count ?? 0).ToString())" />
</div>

<div class="dms-card">
    <h2 class="dms-card-title">Список складов компании</h2>
    @if (_list?.Count > 0)
    {
        <div class="hub-grid">
            @foreach (var h in _list)
            {
                <div class="hub-card">
                    <h3 class="hub-card-title">@(string.IsNullOrWhiteSpace(h.Name) ? "Склад" : h.Name)</h3>
                    <div class="small text-muted">@FormatAddress(h)</div>
                    @if (h.OrdersOnSite is { Count: > 0 })
                    {
                        <div class="mt-2 small">
                            <strong class="d-block mb-1">Заказы на складе</strong>
                            <ul class="mb-0 ps-3">
                                @foreach (var o in h.OrdersOnSite)
                                {
                                    <li>
                                        Заказ №@o.OrderNumber — от @(o.ClientName ?? "—"), доставка: @(o.DeliveryTo ?? "—")
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                    else
                    {
                        <p class="small text-muted mb-0 mt-2">Нет заказов на этом складе по маршруту.</p>
                    }
                    @if (HasHubCoordinates(h))
                    {
                        <HubMiniLeafletMap ElementId="@($"hub-leaflet-{h.Id}")"
                                           Lat="@((double)h.Latitude!.Value)"
                                           Lon="@((double)h.Longitude!.Value)" />
                    }
                </div>
            }
        </div>
        @if (_list.Any(h => HasHubCoordinates(h)))
        {
            <p class="small text-muted mt-3 mb-0">
                Картография:
                <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">OpenStreetMap</a>
            </p>
        }
    }
    else
    {
        <p class="text-muted">Склады ещё не заведены.</p>
    }
</div>

@code {
    private List<LogisticsHubListItemDto>? _list;
    private PeriodicTimer? _refreshTimer;
    private CancellationTokenSource? _refreshCts;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _list = await HubsApi.GetMineAsync();
        StartAutoRefreshLoop();
        StateHasChanged();
    }

    private static bool HasHubCoordinates(LogisticsHubListItemDto h)
        => h.Latitude.HasValue && h.Longitude.HasValue;

    private static string FormatAddress(LogisticsHubListItemDto h)
    {
        var parts = new[]
        {
            h.City,
            h.Street,
            h.House,
            h.Flat,
            h.Region,
            h.PostalCode
        }.Where(x => !string.IsNullOrWhiteSpace(x)).Select(x => x!.Trim());
        var text = string.Join(", ", parts);
        return string.IsNullOrWhiteSpace(text) ? "Адрес не указан" : text;
    }

    private void StartAutoRefreshLoop()
    {
        StopAutoRefreshLoop();
        _refreshCts = new CancellationTokenSource();
        _refreshTimer = new PeriodicTimer(TimeSpan.FromSeconds(12));
        _ = RunAutoRefreshAsync(_refreshCts.Token);
    }

    private async Task RunAutoRefreshAsync(CancellationToken ct)
    {
        try
        {
            while (_refreshTimer is not null && await _refreshTimer.WaitForNextTickAsync(ct))
            {
                _list = await HubsApi.GetMineAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void StopAutoRefreshLoop()
    {
        _refreshCts?.Cancel();
        _refreshCts?.Dispose();
        _refreshCts = null;
        _refreshTimer?.Dispose();
        _refreshTimer = null;
    }

    public void Dispose()
    {
        StopAutoRefreshLoop();
    }
}
