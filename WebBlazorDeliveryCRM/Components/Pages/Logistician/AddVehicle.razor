@page "/logistician/vehicles/add"
@layout LogisticianLayout
@using System.Security.Claims
@using WebBlazorDeliveryCRM.Models
@using WebBlazorDeliveryCRM.Services
@using WebBlazorDeliveryCRM.Utilities
@inject VehiclesApiService VehiclesApi
@inject CouriersApiService CouriersApi
@inject AuthenticationStateProvider AuthState
@inject AppNotificationService Notify
@inject NavigationManager Nav

<PageTitle>Новое ТС — Логист</PageTitle>

<div class="dms-page-header">
    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
        <a href="/logistician/couriers" class="btn btn-outline-secondary btn-sm">← К курьерам</a>
    </div>
    <h1>Добавить транспорт</h1>
    <p class="subtitle">
        Марка и модель — комбобоксы по справочнику: сначала марка (модели фильтруются) или сначала модель из полного списка (марка и данные справочника подставляются).
        Если в БД нет моделей — ввод вручную. Категория, кузов и топливо — из справочников формы.
    </p>
</div>

@if (_loading)
{
    <p class="text-muted">Загрузка справочников…</p>
}
else if (_lookups is null)
{
    <div class="alert alert-warning">Не удалось загрузить справочники. Проверьте вход и права (логист / менеджер).</div>
}
else
{
    <div class="dms-card">
        <h2 class="dms-card-title">Параметры ТС</h2>
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Гос. номер *</label>
                <input class="form-control" value="@_req.License_plate" @oninput="OnLicensePlateInput" />
            </div>
            <div class="col-md-4">
                <label class="form-label">VIN * (17 символов, без I, O, Q)</label>
                <input class="form-control" maxlength="17" value="@_req.VIN" @oninput="OnVinInput" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Год выпуска *</label>
                <input type="number" class="form-control" @bind="_year" min="1980" max="2100" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Категория * <span class="text-muted small">(справочник)</span></label>
                <select class="form-select" @bind="_req.Category_id" @bind:after="OnCategoryChangedAfter">
                    <option value="0">—</option>
                    @foreach (var c in _lookups.Categories)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </select>
            </div>
            @if (UseVehicleCatalog)
            {
                <div class="col-md-4">
                    <label class="form-label">Марка *</label>
                    <select class="form-select" @bind="_selectedBrandId" @bind:after="OnCatalogBrandChangedAfter">
                        <option value="0">— любая марка (или выберите первой) —</option>
                        @foreach (var b in _catalogBrands)
                        {
                            <option value="@b.Id">@b.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Модель *</label>
                    <select class="form-select" @bind="_selectedModelId" @bind:after="OnCatalogModelChangedAfter">
                        <option value="0">— выберите модель —</option>
                        @foreach (var m in GetFilteredCatalogModels())
                        {
                            <option value="@m.Id">@FormatCatalogModelOption(m)</option>
                        }
                    </select>
                </div>
                @if (!string.IsNullOrWhiteSpace(_catalogHint))
                {
                    <div class="col-12">
                        <div class="form-text text-info">@_catalogHint</div>
                    </div>
                }
            }
            else
            {
                <div class="col-md-4">
                    <label class="form-label">Марка *</label>
                    <input class="form-control" placeholder="Например: Toyota" @bind="_req.Brand_name" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Модель *</label>
                    <input class="form-control" placeholder="Например: Camry" @bind="_req.Model_name" />
                </div>
            }
            <div class="col-md-4">
                <label class="form-label">Кузов * <span class="text-muted small">(справочник)</span></label>
                <select class="form-select" @bind="_req.BodyType_id">
                    <option value="0">—</option>
                    @foreach (var b in _lookups.BodyTypes)
                    {
                        <option value="@b.Id">@b.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Цвет</label>
                <input class="form-control" @bind="_req.Color" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Топливо * <span class="text-muted small">(справочник)</span></label>
                <select class="form-select" @bind="_req.FuelType_id">
                    <option value="0">—</option>
                    @foreach (var f in _lookups.FuelTypes)
                    {
                        <option value="@f.Id">@f.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Объём кузова, м³</label>
                <input type="number" step="0.01" class="form-control" @bind="_req.Cargo_volume" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Макс. груз, кг</label>
                <input type="number" step="0.01" class="form-control" @bind="_req.Max_cargo_weight" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Бак, л</label>
                <input type="number" step="0.01" class="form-control" @bind="_req.FuelTank_Capacity" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Пробег</label>
                <input type="number" step="0.01" class="form-control" @bind="_req.Current_mileage" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Полис страхования</label>
                <input class="form-control" @bind="_req.Insurance_policy" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Сразу закрепить за курьером (необязательно)</label>
                <select class="form-select" @bind="_courierId">
                    <option value="0">— только автопарк —</option>
                    @foreach (var c in _couriers.OrderBy(x => x.User?.FName))
                    {
                        <option value="@c.ID_CourierProfile">@($"{c.User?.FName} {c.User?.Name}".Trim())</option>
                    }
                </select>
            </div>
        </div>
        <div class="mt-3">
            <button type="button" class="btn btn-primary dms-btn-primary" disabled="@_saving" @onclick="Save">
                @(_saving ? "Сохранение…" : "Создать ТС")
            </button>
        </div>
    </div>
}

@code {
    private VehicleFormLookupsDto? _lookups;
    private List<CourierProfileDto> _couriers = new();
    private List<IdNameDto> _catalogBrands = new();
    private List<VehicleCatalogModelDto> _allCatalogModels = new();
    private int _selectedBrandId;
    private int _selectedModelId;
    private string _catalogHint = string.Empty;
    private CreateVehicleApiRequest _req = new()
    {
        Year = new DateOnly(2020, 1, 1),
        Cargo_volume = 0,
        Max_cargo_weight = 0,
        FuelTank_Capacity = 0,
        Current_mileage = 0
    };
    private int _year = DateTime.UtcNow.Year;
    private int _courierId;
    private bool _loading = true;
    private bool _dataLoaded;
    private bool _saving;

    private bool _hasCatalogData;
    private bool UseVehicleCatalog => _hasCatalogData;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _dataLoaded)
            return;
        _dataLoaded = true;

        _loading = true;
        StateHasChanged();

        try
        {
            var state = await AuthState.GetAuthenticationStateAsync();
            if (state.User.Identity?.IsAuthenticated != true)
            {
                _lookups = null;
                Notify.ShowWarning("Требуется вход.");
                Nav.NavigateTo("/login");
                return;
            }

            if (!int.TryParse(state.User.FindFirst("companyId")?.Value, out _))
            {
                _lookups = null;
                return;
            }

            _lookups = await VehiclesApi.GetLookupsAsync();
            if (_lookups is null)
            {
                Notify.ShowWarning("Сессия истекла или нет доступа. Войдите заново.");
                Nav.NavigateTo("/login");
                return;
            }

            var brandsFromApi = await VehiclesApi.GetCatalogBrandsAsync();
            _allCatalogModels = await VehiclesApi.GetCatalogModelsAsync(null);
            _catalogBrands = brandsFromApi.Count > 0
                ? brandsFromApi
                : _allCatalogModels
                    .GroupBy(x => x.BrandId)
                    .Select(g => new IdNameDto { Id = g.Key, Name = g.First().BrandName ?? "" })
                    .OrderBy(b => b.Name)
                    .ToList();
            _hasCatalogData = _catalogBrands.Count > 0 || _allCatalogModels.Count > 0;
            _couriers = await CouriersApi.GetAllAsync(null) ?? new();
        }
        catch (Exception ex)
        {
            Notify.ShowError($"Ошибка загрузки данных: {ex.Message}");
            _lookups = null;
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task OnCatalogBrandChangedAfter()
    {
        _selectedModelId = 0;
        _req.Model_id = null;
        _req.Model_name = string.Empty;
        _catalogHint = string.Empty;

        if (_selectedBrandId > 0)
        {
            // Try dedicated API request first; some datasets are sparse in "all models".
            var byBrand = await VehiclesApi.GetCatalogModelsAsync(_selectedBrandId);
            if (byBrand.Count > 0)
            {
                _allCatalogModels = byBrand;
            }
            else
            {
                // Fallback to local cache by brand name if IDs in dictionaries differ.
                var selectedBrandName = _catalogBrands.FirstOrDefault(b => b.Id == _selectedBrandId)?.Name;
                if (!string.IsNullOrWhiteSpace(selectedBrandName))
                {
                    var all = await VehiclesApi.GetCatalogModelsAsync(null);
                    var byName = all
                        .Where(m => string.Equals((m.BrandName ?? string.Empty).Trim(), selectedBrandName.Trim(), StringComparison.OrdinalIgnoreCase))
                        .ToList();
                    _allCatalogModels = byName.Count > 0 ? byName : all;
                }
            }
        }
        else
        {
            _allCatalogModels = await VehiclesApi.GetCatalogModelsAsync(null);
        }

        if (_selectedModelId <= 0)
        {
            SyncBrandNameFromSelection();
            return;
        }

        var current = _allCatalogModels.FirstOrDefault(x => x.Id == _selectedModelId);
        if (current is null || (_selectedBrandId > 0 && current.BrandId != _selectedBrandId))
        {
            _selectedModelId = 0;
            _req.Model_id = null;
            _req.Model_name = string.Empty;
            _catalogHint = string.Empty;
        }

        SyncBrandNameFromSelection();
    }

    private Task OnCatalogModelChangedAfter()
    {
        var m = _allCatalogModels.FirstOrDefault(x => x.Id == _selectedModelId);
        if (m is null || _selectedModelId <= 0)
        {
            _req.Model_id = null;
            _req.Model_name = string.Empty;
            _catalogHint = string.Empty;
            SyncBrandNameFromSelection();
            return Task.CompletedTask;
        }

        _selectedBrandId = m.BrandId;
        _req.Model_id = m.Id;
        _year = m.Year.Year;
        _req.Brand_name = m.BrandName ?? string.Empty;
        _req.Model_name = m.Name ?? string.Empty;
        _catalogHint = BuildCatalogHint(m);
        SyncBrandNameFromSelection();
        return Task.CompletedTask;
    }

    private Task OnCategoryChangedAfter()
    {
        var maxWeight = _lookups?.Categories.FirstOrDefault(c => c.Id == _req.Category_id)?.MaxWeight;
        if (maxWeight.HasValue && maxWeight.Value > 0)
            _req.Max_cargo_weight = maxWeight.Value;
        return Task.CompletedTask;
    }

    private void SyncBrandNameFromSelection()
    {
        if (_selectedBrandId > 0)
            _req.Brand_name = _catalogBrands.FirstOrDefault(b => b.Id == _selectedBrandId)?.Name ?? string.Empty;
        else if ((_req.Model_id ?? 0) <= 0)
            _req.Brand_name = string.Empty;
    }

    private List<VehicleCatalogModelDto> GetFilteredCatalogModels()
    {
        IEnumerable<VehicleCatalogModelDto> q = _allCatalogModels;
        if (_selectedBrandId > 0)
            q = q.Where(m => m.BrandId == _selectedBrandId);
        return q.OrderBy(m => m.BrandName).ThenBy(m => m.Name).ThenBy(m => m.Year).ToList();
    }

    private string FormatCatalogModelOption(VehicleCatalogModelDto m)
    {
        if (_selectedBrandId > 0)
            return $"{m.Name} ({m.Year})";
        var brand = string.IsNullOrWhiteSpace(m.BrandName) ? "?" : m.BrandName;
        return $"{brand} — {m.Name} ({m.Year})";
    }

    private static string BuildCatalogHint(VehicleCatalogModelDto m)
    {
        var tr = string.IsNullOrWhiteSpace(m.TransmissionTypeName) ? $"КПП #{m.TransmissionTypeId}" : m.TransmissionTypeName;
        var dr = string.IsNullOrWhiteSpace(m.DriveTypeName) ? $"привод #{m.DriveTypeId}" : m.DriveTypeName;
        return $"Справочник: расход {m.AvgFuelCity:0.#} / {m.AvgFuelHighWay:0.#} л/100 км, двигатель {m.EngineCapacity:0.#} л, {m.HorsePower} л.с., {tr}, {dr}.";
    }

    private void OnVinInput(ChangeEventArgs e)
    {
        _req.VIN = VinHelper.SanitizeInput(e.Value?.ToString());
    }

    private void OnLicensePlateInput(ChangeEventArgs e)
    {
        var raw = (e.Value?.ToString() ?? string.Empty).ToUpperInvariant();
        raw = raw.Replace('A', 'А').Replace('B', 'В').Replace('E', 'Е').Replace('K', 'К').Replace('M', 'М')
                 .Replace('H', 'Н').Replace('O', 'О').Replace('P', 'Р').Replace('C', 'С').Replace('T', 'Т')
                 .Replace('Y', 'У').Replace('X', 'Х');
        raw = new string(raw.Where(ch => char.IsDigit(ch) || "АВЕКМНОРСТУХ".Contains(ch)).ToArray());
        _req.License_plate = raw.Length > 9 ? raw[..9] : raw;
    }

    private async Task Save()
    {
        if (_lookups is null) return;
        if (string.IsNullOrWhiteSpace(_req.License_plate) || string.IsNullOrWhiteSpace(_req.VIN))
        {
            Notify.ShowWarning("Укажите гос. номер и VIN.");
            return;
        }
        if (!VinHelper.IsValid(_req.VIN, out var vinErr))
        {
            Notify.ShowWarning(vinErr ?? "Некорректный VIN.");
            return;
        }
        if (!System.Text.RegularExpressions.Regex.IsMatch(_req.License_plate, "^[АВЕКМНОРСТУХ]\\d{3}[АВЕКМНОРСТУХ]{2}\\d{2,3}$"))
        {
            Notify.ShowWarning("Гос. номер должен быть в формате А123ВС77.");
            return;
        }
        if ((_req.Model_id ?? 0) <= 0 &&
            (string.IsNullOrWhiteSpace(_req.Brand_name) || string.IsNullOrWhiteSpace(_req.Model_name)))
        {
            Notify.ShowWarning("Выберите модель из справочника или укажите марку и модель ТС.");
            return;
        }
        if (_req.Category_id <= 0 || _req.BodyType_id <= 0 || _req.FuelType_id <= 0)
        {
            Notify.ShowWarning("Выберите категорию, тип кузова и тип топлива.");
            return;
        }
        if (UseVehicleCatalog && _selectedBrandId > 0 && GetFilteredCatalogModels().Count == 0)
        {
            Notify.ShowWarning("Для выбранной марки в справочнике нет моделей. Выберите другую марку или заполните вручную.");
            return;
        }

        _req.Year = new DateOnly(Math.Clamp(_year, 1980, 2100), 1, 1);
        _req.CurrentCourier_id = _courierId > 0 ? _courierId : null;

        _saving = true;
        StateHasChanged();
        try
        {
            var (ok, err, id) = await VehiclesApi.CreateVehicleAsync(_req);
            if (ok)
            {
                Notify.ShowSuccess(id.HasValue ? $"ТС создано (id {id})." : "ТС создано.");
                Nav.NavigateTo("/logistician/couriers");
            }
            else
                Notify.ShowError(string.IsNullOrWhiteSpace(err) ? "Ошибка создания." : err);
        }
        catch (Exception ex)
        {
            Notify.ShowError(ex.Message);
        }
        finally
        {
            _saving = false;
            StateHasChanged();
        }
    }
}
