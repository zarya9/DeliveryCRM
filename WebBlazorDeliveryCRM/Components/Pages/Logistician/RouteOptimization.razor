@page "/logistician/routes"
@layout LogisticianLayout
@using WebBlazorDeliveryCRM.Models
@using WebBlazorDeliveryCRM.Services
@using WebBlazorDeliveryCRM.Utilities
@using System.Globalization
@using System.Net.Http.Json
@using System.Text.Json
@inject CouriersApiService CouriersApi
@inject OrdersApiService OrdersApi
@inject LogisticsHubsApiService HubsApi
@inject TrackingHubClientService TrackingHubClient
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@inject IHttpClientFactory HttpClientFactory
@inject AppNotificationService Notify
@inject ShiftPlannerApiService PlannerApi
@inject LogisticianRoutePlanningSession RouteSession
@implements IAsyncDisposable

<PageTitle>Маршруты — Логист</PageTitle>

<div class="dms-page-header">
    <h1>Карта оптимизации маршрутов</h1>
    <p class="subtitle">Курьеры и склады на карте компании. После импорта точек из заказов можно <strong>назначить курьера на эти заказы</strong> (блок ниже) или открыть полную панель <a href="/logistician">распределения</a>.</p>
</div>

<div class="dms-card mb-3">
    <h2 class="dms-card-title">Карта курьеров и маршрутов</h2>
    <p class="text-muted">
    </p>
    <div id="logistician-map" style="height: 480px; width: 100%; border-radius: 8px;"></div>
</div>

<div class="dms-card mb-3">
    <h2 class="dms-card-title">Маршрут по адресам (любое количество точек)</h2>
    <p class="text-muted">
    </p>
    <div class="dms-scroll-route-points">
        @if (_routePoints.Count == 0)
        {
            <p class="text-muted mb-0">Список точек пуст. Нажмите «+ Точка» или импортируйте из заказов / курьеров.</p>
        }
        @for (var i = 0; i < _routePoints.Count; i++)
        {
            var idx = i;
            <div class="d-flex gap-2 align-items-center mb-2 p-2 border rounded flex-wrap" @key="_routePoints[idx].Id">
                <span class="text-muted" title="Порядок точек">↕</span>
                <div class="btn-group btn-group-sm" role="group">
                    <button type="button" class="btn btn-outline-secondary" disabled="@(_isBuildingRoute || idx == 0)" @onclick="(() => MovePointUp(idx))" title="Выше">↑</button>
                    <button type="button" class="btn btn-outline-secondary" disabled="@(_isBuildingRoute || idx >= _routePoints.Count - 1)" @onclick="(() => MovePointDown(idx))" title="Ниже">↓</button>
                </div>
                <input class="form-control"
                       placeholder="Введите адрес точки..."
                       @bind="_routePoints[idx].Address"
                       disabled="@(_isBuildingRoute || _routePoints[idx].Source == "courier")" />
                <span class="badge text-bg-secondary">@_routePoints[idx].Source</span>
                <button class="btn btn-outline-danger"
                        disabled="@_isBuildingRoute"
                        @onclick="(() => RemovePoint(idx))">
                    Удалить
                </button>
            </div>
        }
    </div>
    <div class="d-flex gap-2 mt-3">
        <button class="btn btn-outline-secondary" disabled="@_isBuildingRoute" @onclick="AddAddress">+ Точка</button>
        <button class="btn btn-outline-info" disabled="@_isBuildingRoute" @onclick="ImportFromCouriersAsync">Импорт из курьеров</button>
        <button class="btn btn-outline-info" disabled="@_isBuildingRoute" @onclick="ImportFromOrdersAsync">Импорт из заказов</button>
        <button class="btn btn-outline-warning" disabled="@_isBuildingRoute" @onclick="OptimizeRouteOrderAsync">Оптимизировать порядок</button>
        <button class="btn btn-primary" disabled="@_isBuildingRoute" @onclick="BuildRouteFromPointsAsync">
            @(_isBuildingRoute ? "Строю..." : "Построить маршрут")
        </button>
        <button class="btn btn-outline-primary" disabled="@_isBuildingRoute" @onclick="CompareRoutesAsync">Сравнить карты</button>
        <button class="btn btn-outline-secondary" disabled="@_isBuildingRoute" @onclick="ClearCustomRouteAsync">Очистить маршрут</button>
    </div>
    <details class="small text-muted mt-2">
        <summary class="cursor-pointer">Нормы времени вождения (РФ) и разбивка маршрута по 9 ч</summary>
        <p class="mb-0 mt-2">
            Лимит <strong>9 часов</strong> управления за сутки и обязательные перерывы закреплены
            <strong>ПДД РФ (п. 26)</strong> и <strong>приказом Минтранса РФ № 424 от 11.12.2020</strong>
            для случаев, когда водитель подпадает под особый режим (коммерческие перевозки в установленных законом случаях, тахограф и т. п.).
            Для курьерской «последней милицы» на легковом ТС часто применимы <strong>ТК РФ</strong> и договор — квалификация зависит от вида деятельности; это <strong>не юридическая консультация</strong>.
            Разбиение линии на карте по 9 ч — <strong>упрощённая модель планирования</strong> по данным OSRM; сравнение «один водитель с переработкой» vs «несколько отрезков»
            зависит от ставок компании и здесь <strong>не считается</strong>.
        </p>
    </details>
    <div class="border-top pt-3 mt-3">
        <h3 class="h6 mb-2">Назначение курьеру</h3>
        <p class="small text-muted mb-2">
            Нужны точки с импорта <strong>«Из заказов»</strong> (и складские вставки по ним). Если на карте несколько цветных отрезков (лимит ~9 ч по «ногам» OSRM), выберите отрезок — на него пойдут только заказы точек этого участка.
            Полное распределение — на панели <a href="/logistician">распределения заказов</a>.
        </p>
        @if (_routeDriverSegments.Count > 1)
        {
            <div class="mb-2 small">
                <span class="text-muted d-block mb-1">Отрезок на карте (как у цветных линий):</span>
                @for (var si = 0; si < _routeDriverSegments.Count; si++)
                {
                    var seg = _routeDriverSegments[si];
                    var sIdx = si;
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="routeSegPick" id="@($"rseg-{sIdx}")"
                               checked="@(_selectedSegmentIndex == sIdx)"
                               @onchange="@(() => OnSegmentSelected(sIdx))" />
                        <label class="form-check-label" for="@($"rseg-{sIdx}")">
                            Отрезок @(sIdx + 1) (<strong>@seg.ColorLabel</strong>): точки @(seg.FromWaypointIndex + 1)–@(seg.ToWaypointIndex + 1),
                            заказов: <strong>@seg.OrderIds.Count</strong>
                        </label>
                    </div>
                }
            </div>
        }
        <div class="d-flex flex-wrap gap-2 align-items-end">
            <div>
                <label class="form-label small mb-0" for="route-assign-courier">Курьер</label>
                <select id="route-assign-courier" class="form-select form-select-sm" style="min-width: 14rem;" @bind="_routeAssignCourierId">
                    <option value="0">— Выберите —</option>
                    @if (_couriers is not null)
                    {
                        @foreach (var c in _couriers.OrderBy(x => x.User?.FName).ThenBy(x => x.User?.Name))
                        {
                            <option value="@c.ID_CourierProfile">@((c.User?.FName + " " + c.User?.Name).Trim())</option>
                        }
                    }
                </select>
            </div>
            <button type="button"
                    class="btn btn-success btn-sm"
                    disabled="@(_assignRouteBusy || AssignableOrderIdsCount == 0 || _routeAssignCourierId == 0)"
                    @onclick="AssignRouteOrdersToCourierAsync">
                @(_assignRouteBusy ? "Назначаем…" : $"Назначить ({AssignableOrderIdsCount})")
            </button>
            <button type="button"
                    class="btn btn-outline-danger btn-sm"
                    disabled="@(_revokeRouteBusy || _routeAssignCourierId == 0 || AssignableOrderIdsCount == 0)"
                    @onclick="RevokeRouteOrdersFromCourierAsync">
                @(_revokeRouteBusy ? "…" : $"Отозвать ({AssignableOrderIdsCount})")
            </button>
            <a class="btn btn-link btn-sm py-0" href="/logistician">Распределение заказов</a>
        </div>
    </div>
    @if (!string.IsNullOrWhiteSpace(_routeMessage))
    {
        <div class="mt-2 text-muted">@_routeMessage</div>
    }
</div>

<div class="dms-card mb-3">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h2 class="dms-card-title mb-0">Сравнение карт и маршрутов</h2>
        <div class="d-flex align-items-center gap-2">
            <label class="small text-muted mb-0">Расход, л/100 км</label>
            <input type="number" min="3" max="40" step="0.1" class="form-control form-control-sm" style="width: 95px;" @bind="_fuelPer100Km" />
        </div>
    </div>
    @if (_routeCompare.Count == 0)
    {
        <p class="text-muted mb-0">Сначала постройте маршрут или нажмите «Сравнить карты».</p>
    }
    else
    {
        <div class="table-responsive dms-scroll-table-wrap">
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th>Карта</th>
                        <th>Дистанция</th>
                        <th>Время</th>
                        <th>Топливо</th>
                        <th>Комментарий</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in _routeCompare)
                    {
                        <tr class="@(r.IsBest ? "table-success" : string.Empty)">
                            <td><strong>@r.Provider</strong></td>
                            <td>@r.DistanceKm.ToString("0.0") км</td>
                            <td>@FormatDuration(r.Duration)</td>
                            <td>@r.FuelLiters.ToString("0.0") л</td>
                            <td>@r.Note</td>
                            <td class="text-end">
                                <a href="@r.OpenUrl" target="_blank" rel="noopener noreferrer" class="btn btn-outline-secondary btn-sm">Открыть</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (_bestRoute is not null)
        {
            <div class="alert alert-success mb-0">
                Быстрее маршрут у <strong>@_bestRoute.Provider</strong>.
                @if (_savingFuelLiters > 0.01)
                {
                    <span> Экономия топлива: @_savingFuelLiters.ToString("0.0") л.</span>
                }
                @if (_savingTime > TimeSpan.Zero)
                {
                    <span> Экономия времени: @FormatSavings(_savingTime).</span>
                }
            </div>
        }
    }
</div>

<div class="dms-card">
    <h2 class="dms-card-title">Список курьеров</h2>
    @if (_couriers?.Count > 0)
    {
        <div class="table-responsive dms-scroll-table-wrap">
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th>Курьер</th>
                        <th>Рейтинг</th>
                        <th>Статус</th>
                        <th>Транспорт</th>
                        <th>График</th>
                        <th style="min-width: 12rem;">Место</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in _couriers)
                    {
                        <tr class="cursor-pointer" title="Карточка курьера"
                            @onclick="@(() => Navigation.NavigateTo($"/logistician/couriers/{c.ID_CourierProfile}"))">
                            <td>@(c.User?.FName) @(c.User?.Name)</td>
                            <td>@c.Rating</td>
                            <td>@(c.CourierStatus?.Name ?? "—")</td>
                            <td>@(string.IsNullOrEmpty(c.VehicleCategoryName) ? "—" : c.VehicleCategoryName)</td>
                            <td>@(string.IsNullOrEmpty(c.ScheduleName) ? "—" : c.ScheduleName)</td>
                            <td class="text-break small">@GetCourierPlaceLabel(c)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="text-muted">Нет данных о курьерах.</p>
    }
</div>

@code {
    private List<CourierProfileDto>? _couriers;
    private List<LogisticsHubListItemDto> _hubs = new();
    private List<RoutePlanningPointDto> _routePoints => RouteSession.RoutePoints;
    private readonly Dictionary<string, (double lat, double lon)> _geocodeCache = new(StringComparer.OrdinalIgnoreCase);
    private DateTimeOffset _nominatimNextAllowedUtc = DateTimeOffset.MinValue;
    private CancellationTokenSource? _routeCts;
    private bool _isBuildingRoute;
    private string? _routeMessage
    {
        get => RouteSession.RouteMessage;
        set => RouteSession.RouteMessage = value;
    }
    private double _fuelPer100Km
    {
        get => RouteSession.FuelPer100Km;
        set => RouteSession.FuelPer100Km = value;
    }
    private readonly List<RouteCompareItem> _routeCompare = new();
    private RouteCompareItem? _bestRoute;
    private TimeSpan _savingTime = TimeSpan.Zero;
    private double _savingFuelLiters;
    private int _routeAssignCourierId
    {
        get => RouteSession.RouteAssignCourierId;
        set => RouteSession.RouteAssignCourierId = value;
    }
    private bool _assignRouteBusy;
    private bool _revokeRouteBusy;

    /// <summary>Число различных заказов в списке точек (импорт из заказов).</summary>
    private int RouteOrderIdsCount => _routePoints
        .Where(p => p.RelatedOrderId is > 0)
        .Select(p => p.RelatedOrderId!.Value)
        .Distinct()
        .Count();

    private readonly List<RouteDriverSegmentVm> _routeDriverSegments = new();
    private int _selectedSegmentIndex;

    private int AssignableOrderIdsCount => GetDistinctOrderIdsForAssignment().Count;

    private bool _mapReady;
    private IDisposable? _trackingHandler;
    private readonly Dictionary<int, string> _courierPlaceById = new();
    private readonly Dictionary<string, string> _reverseGeocodeCache = new(StringComparer.OrdinalIgnoreCase);
    private CancellationTokenSource? _reverseGeoCts;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _couriers = await CouriersApi.GetAllAsync(null);
        _hubs = await HubsApi.GetMineAsync();
        StateHasChanged();
        if (_couriers != null)
        {
            var courierMarkers = _couriers
                .Where(c => c.Current_lat != 0 || c.Current_lon != 0)
                .Select(c => new
                {
                    id = c.ID_CourierProfile,
                    lat = (double)c.Current_lat,
                    lon = (double)c.Current_lon,
                    title = $"{c.User?.FName} {c.User?.Name} — {c.CourierStatus?.Name}",
                    kind = "courier",
                    online = c.Is_online
                });
            var hubMarkers = _hubs
                .Where(h => h.Latitude.HasValue && h.Longitude.HasValue)
                .Select(h => new
                {
                    lat = (double)h.Latitude!.Value,
                    lon = (double)h.Longitude!.Value,
                    title = $"Склад: {(string.IsNullOrWhiteSpace(h.Name) ? "Склад" : h.Name)}",
                    kind = "hub",
                    online = false
                })
                .ToList();
            var markers = courierMarkers.Cast<object>().Concat(hubMarkers.Cast<object>()).ToList();
            try
            {
                var osrmUrl = Configuration["Osrm:RouterBaseUrl"];
                var routeLang = Configuration["Map:RouteLanguage"];
                // false: клики по карте не задают маршрут (иначе сбивается линия из списка адресов).
                await JS.InvokeVoidAsync("leafletMap.init", "logistician-map", 55.7558, 37.6173, 10, null, osrmUrl, false, routeLang);
                await JS.InvokeVoidAsync("leafletMap.setMarkers", markers);
                _mapReady = true;
                await StartLiveTrackingAsync();
                await RestoreMapAndRouteFromSessionAsync();
                if (_hubs.Count > 0 && !_hubs.Any(h => h.Latitude.HasValue && h.Longitude.HasValue))
                    _routeMessage = "Склады найдены, но у них нет координат (latitude/longitude), поэтому точки не показываются на карте.";
            }
            catch { /* map may fail */ }
        }

        _reverseGeoCts = new CancellationTokenSource();
        if (_couriers is { Count: > 0 })
            _ = LoadCourierPlaceLabelsAsync(_reverseGeoCts.Token);
    }

    private async Task StartLiveTrackingAsync()
    {
        if (!_mapReady) return;
        try
        {
            var hub = await TrackingHubClient.GetConnectionAsync();
            await TrackingHubClient.EnsureStartedAsync();
            _trackingHandler?.Dispose();
            _trackingHandler = hub.On<CourierLocationPushDto>("CourierLocationUpdated", async payload =>
            {
                await InvokeAsync(async () =>
                {
                    if (!_mapReady || payload == null)
                        return;
                    await JS.InvokeVoidAsync(
                        "leafletMap.upsertCourierMarker",
                        payload.CourierProfileId,
                        payload.Lat,
                        payload.Lon,
                        payload.Title ?? $"Курьер #{payload.CourierProfileId}",
                        payload.Online);
                });
            });
        }
        catch
        {
            // SignalR не обязателен для страницы
        }
    }

    private async Task RestoreMapAndRouteFromSessionAsync()
    {
        if (!_mapReady)
            return;
        try
        {
            var withCoords = _routePoints.Where(p => p.Lat.HasValue && p.Lon.HasValue).ToList();
            if (withCoords.Count >= 2)
            {
                var pts = withCoords.Select((p, i) => new
                {
                    lat = p.Lat!.Value,
                    lon = p.Lon!.Value,
                    title = $"{i + 1}. {(string.IsNullOrWhiteSpace(p.Address) ? "Точка" : p.Address)}"
                }).ToList();
                await JS.InvokeVoidAsync("leafletMap.setRouteWaypoints", pts);
            }

            if (RouteSession.MapCenterLat is { } clat &&
                RouteSession.MapCenterLon is { } clon &&
                RouteSession.MapZoom is { } czoom)
            {
                await JS.InvokeVoidAsync("leafletMap.setView", clat, clon, czoom);
            }

            if (withCoords.Count >= 2)
                await RefreshRouteSegmentsAsync(withCoords, CancellationToken.None);
        }
        catch
        {
            // карта может быть недоступна
        }
    }

    private void AddAddress()
    {
        _routePoints.Add(new RoutePlanningPointDto { Address = string.Empty, Source = "manual" });
        ClearRouteSegmentsState();
    }

    private string GetCourierPlaceLabel(CourierProfileDto c)
    {
        if (c.Current_lat == 0 && c.Current_lon == 0)
            return "—";
        if (_courierPlaceById.TryGetValue(c.ID_CourierProfile, out var text))
            return text;
        return "…";
    }

    private async Task LoadCourierPlaceLabelsAsync(CancellationToken ct)
    {
        var list = _couriers;
        if (list is null || list.Count == 0)
            return;

        foreach (var c in list)
        {
            if (ct.IsCancellationRequested)
                return;

            if (c.Current_lat == 0 && c.Current_lon == 0)
            {
                _courierPlaceById[c.ID_CourierProfile] = "—";
                await InvokeAsync(StateHasChanged);
                continue;
            }

            var lat = (double)c.Current_lat;
            var lon = (double)c.Current_lon;
            string label;
            try
            {
                var resolved = await ReverseGeocodePlaceLabelAsync(lat, lon, ct);
                label = string.IsNullOrWhiteSpace(resolved)
                    ? $"{lat.ToString("0.##", CultureInfo.CurrentCulture)}, {lon.ToString("0.##", CultureInfo.CurrentCulture)}"
                    : resolved;
            }
            catch
            {
                label = $"{lat.ToString("0.##", CultureInfo.CurrentCulture)}, {lon.ToString("0.##", CultureInfo.CurrentCulture)}";
            }

            _courierPlaceById[c.ID_CourierProfile] = label;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task<string?> ReverseGeocodePlaceLabelAsync(double lat, double lon, CancellationToken ct)
    {
        var key = $"{lat.ToString(CultureInfo.InvariantCulture)},{lon.ToString(CultureInfo.InvariantCulture)}";
        if (_reverseGeocodeCache.TryGetValue(key, out var hit))
            return hit;

        await RespectNominatimDelayAsync(ct);
        if (ct.IsCancellationRequested)
            return null;

        var url =
            "https://nominatim.openstreetmap.org/reverse?format=jsonv2&addressdetails=1&zoom=18&accept-language=ru"
            + $"&lat={lat.ToString(CultureInfo.InvariantCulture)}&lon={lon.ToString(CultureInfo.InvariantCulture)}";

        var client = HttpClientFactory.CreateClient("UnauthorizedClient");
        client.DefaultRequestHeaders.UserAgent.Clear();
        client.DefaultRequestHeaders.UserAgent.ParseAdd("WebBlazorDeliveryCRM/1.0 (reverse geocode)");

        using var resp = await client.GetAsync(url, HttpCompletionOption.ResponseHeadersRead, ct);
        if (!resp.IsSuccessStatusCode)
            return null;

        await using var stream = await resp.Content.ReadAsStreamAsync(ct);
        using var doc = await JsonDocument.ParseAsync(stream, cancellationToken: ct);
        var label = BuildPlaceLabelFromReverseResult(doc.RootElement);
        if (!string.IsNullOrWhiteSpace(label))
            _reverseGeocodeCache[key] = label;
        return label;
    }

    private static string BuildPlaceLabelFromReverseResult(JsonElement root)
    {
        if (!root.TryGetProperty("address", out var addr))
            return TryDisplayNameShort(root) ?? "—";

        var road = PickAddr(addr, "road", "pedestrian", "path", "footway", "residential");
        var house = PickAddr(addr, "house_number", "building");
        var city = PickAddr(addr, "city", "town", "municipality", "village");
        var county = PickAddr(addr, "county");
        var suburb = PickAddr(addr, "suburb", "neighbourhood", "quarter", "hamlet");

        var streetHouse = JoinNonEmpty(" ", road, house);

        var isKazan = IsKazanArea(city, county, suburb);

        if (isKazan)
        {
            if (!string.IsNullOrWhiteSpace(streetHouse))
                return streetHouse.Trim();
            if (!string.IsNullOrWhiteSpace(suburb) && !string.IsNullOrWhiteSpace(road))
                return JoinNonEmpty(", ", suburb, streetHouse).Trim(' ', ',');
            if (!string.IsNullOrWhiteSpace(suburb))
                return suburb;
            return TryDisplayNameShort(root) ?? "—";
        }

        var place = !string.IsNullOrWhiteSpace(city) ? city : county;
        if (string.IsNullOrWhiteSpace(place))
            place = suburb ?? "";
        if (string.IsNullOrWhiteSpace(place))
            return TryDisplayNameShort(root) ?? "—";

        if (!string.IsNullOrWhiteSpace(streetHouse))
            return $"{place}, {streetHouse}".Trim();
        return place;
    }

    private static string? PickAddr(JsonElement addr, params string[] keys)
    {
        foreach (var k in keys)
        {
            if (!addr.TryGetProperty(k, out var p) || p.ValueKind != JsonValueKind.String)
                continue;
            var s = p.GetString();
            if (!string.IsNullOrWhiteSpace(s))
                return s.Trim();
        }

        return null;
    }

    private static string JoinNonEmpty(string sep, params string?[] parts)
        => string.Join(sep, parts.Where(s => !string.IsNullOrWhiteSpace(s))).Trim();

    private static bool IsKazanArea(string? city, string? county, string? suburb)
    {
        foreach (var s in new[] { city, county, suburb })
        {
            if (string.IsNullOrWhiteSpace(s))
                continue;
            if (s.Contains("азан", StringComparison.OrdinalIgnoreCase))
                return true;
        }

        return false;
    }

    private static string? TryDisplayNameShort(JsonElement root)
    {
        if (!root.TryGetProperty("display_name", out var dn) || dn.ValueKind != JsonValueKind.String)
            return null;
        var full = dn.GetString();
        if (string.IsNullOrWhiteSpace(full))
            return null;
        var parts = full.Split(',');
        var take = Math.Min(3, parts.Length);
        return string.Join(", ", parts.Take(take)).Trim();
    }

    private void RemovePoint(int index)
    {
        if (index < 0 || index >= _routePoints.Count) return;
        _routePoints.RemoveAt(index);
        ClearRouteSegmentsState();
    }

    private void MovePointUp(int index)
    {
        if (index <= 0 || index >= _routePoints.Count) return;
        var item = _routePoints[index];
        _routePoints.RemoveAt(index);
        _routePoints.Insert(index - 1, item);
        ClearRouteSegmentsState();
    }

    private void MovePointDown(int index)
    {
        if (index < 0 || index >= _routePoints.Count - 1) return;
        var item = _routePoints[index];
        _routePoints.RemoveAt(index);
        _routePoints.Insert(index + 1, item);
        ClearRouteSegmentsState();
    }

    private void ClearRouteSegmentsState()
    {
        _routeDriverSegments.Clear();
        _selectedSegmentIndex = 0;
    }

    private void OnSegmentSelected(int index)
    {
        _selectedSegmentIndex = index;
        StateHasChanged();
    }

    private List<int> GetDistinctOrderIdsForAssignment()
    {
        if (_routeDriverSegments.Count > 0 &&
            _selectedSegmentIndex >= 0 &&
            _selectedSegmentIndex < _routeDriverSegments.Count)
        {
            return _routeDriverSegments[_selectedSegmentIndex].OrderIds.Distinct().OrderBy(x => x).ToList();
        }

        return _routePoints
            .Where(p => p.RelatedOrderId is > 0)
            .Select(p => p.RelatedOrderId!.Value)
            .Distinct()
            .OrderBy(x => x)
            .ToList();
    }

    private string GetOsrmHttpBaseUrl()
    {
        var b = (Configuration["Osrm:RouterBaseUrl"] ?? "").Trim().TrimEnd('/');
        return string.IsNullOrEmpty(b) ? "https://router.project-osrm.org" : b;
    }

    private void ApplyRouteSegmentsFromOsrm(List<RoutePlanningPointDto> activePoints, OsrmRouteDto route)
    {
        ClearRouteSegmentsState();
        var wpCount = activePoints.Count;
        if (wpCount < 2)
            return;

        var legDurs = route.legs?.Select(l => l.duration).ToList() ?? new List<double>();
        var ranges = SplitWaypointRangesByLegDuration(legDurs, wpCount, 9 * 3600.0);
        var colors = new[] { "синий", "оранжевый", "зелёный", "фиолетовый", "малиновый" };
        for (var i = 0; i < ranges.Count; i++)
        {
            var (from, to) = ranges[i];
            var orderIds = new List<int>();
            for (var wi = from; wi <= to; wi++)
            {
                var oid = activePoints[wi].RelatedOrderId;
                if (oid is > 0 && !orderIds.Contains(oid.Value))
                    orderIds.Add(oid.Value);
            }

            _routeDriverSegments.Add(new RouteDriverSegmentVm
            {
                FromWaypointIndex = from,
                ToWaypointIndex = to,
                ColorLabel = colors[i % colors.Length],
                OrderIds = orderIds
            });
        }
    }

    private static List<(int from, int to)> SplitWaypointRangesByLegDuration(
        IReadOnlyList<double> legDurations,
        int wpCount,
        double maxLegAccSec)
    {
        if (wpCount < 2 || legDurations.Count == 0)
            return new List<(int, int)> { (0, Math.Max(0, wpCount - 1)) };
        if (legDurations.Count != wpCount - 1)
            return new List<(int, int)> { (0, wpCount - 1) };

        var segs = new List<(int from, int to)>();
        var bs = 0;
        var acc = 0.0;
        for (var li = 0; li < legDurations.Count; li++)
        {
            var d = legDurations[li];
            if (acc + d > maxLegAccSec && acc > 0)
            {
                segs.Add((bs, li));
                bs = li;
                acc = d;
            }
            else
            {
                acc += d;
            }
        }

        segs.Add((bs, wpCount - 1));
        return segs;
    }

    private async Task RefreshRouteSegmentsAsync(List<RoutePlanningPointDto> activePoints, CancellationToken ct)
    {
        if (activePoints.Count < 2)
        {
            ClearRouteSegmentsState();
            return;
        }

        foreach (var p in activePoints)
        {
            if (!p.Lat.HasValue || !p.Lon.HasValue)
            {
                ClearRouteSegmentsState();
                return;
            }
        }

        try
        {
            var coords = string.Join(";",
                activePoints.Select(p =>
                    $"{p.Lon!.Value.ToString(CultureInfo.InvariantCulture)},{p.Lat!.Value.ToString(CultureInfo.InvariantCulture)}"));
            var osrmUrl = $"{GetOsrmHttpBaseUrl()}/route/v1/driving/{coords}?overview=false&steps=false";
            var client = HttpClientFactory.CreateClient("UnauthorizedClient");
            var osrm = await client.GetFromJsonAsync<OsrmRouteResponse>(osrmUrl, ct);
            var best = osrm?.routes?.OrderBy(r => r.duration).FirstOrDefault();
            if (best is null)
            {
                ClearRouteSegmentsState();
                return;
            }

            ApplyRouteSegmentsFromOsrm(activePoints, best);
        }
        catch
        {
            ClearRouteSegmentsState();
        }
    }

    private async Task BuildRouteFromPointsAsync()
    {
        if (_isBuildingRoute) return;
        var activePoints = _routePoints
            .Where(p => p.Lat.HasValue || p.Lon.HasValue || !string.IsNullOrWhiteSpace(p.Address))
            .ToList();

        if (activePoints.Count < 2)
        {
            _routeMessage = "Нужно минимум две заполненные точки.";
            return;
        }

        _routeCts?.Cancel();
        _routeCts?.Dispose();
        _routeCts = new CancellationTokenSource(TimeSpan.FromSeconds(45));
        _isBuildingRoute = true;
        _routeMessage = "Геокодирую адреса...";
        StateHasChanged();

        try
        {
            ClearRouteSegmentsState();
            var points = new List<object>();
            for (var i = 0; i < activePoints.Count; i++)
            {
                _routeCts.Token.ThrowIfCancellationRequested();
                var p = await ResolvePointCoordinatesAsync(activePoints[i], _routeCts.Token);
                if (p is null)
                {
                    var geoq = ExtractGeocodeQuery(activePoints[i].Address);
                    _routeMessage = string.Equals(geoq, activePoints[i].Address.Trim(), StringComparison.Ordinal)
                        ? $"Не удалось найти точку: {activePoints[i].Address}"
                        : $"Не удалось найти точку: {activePoints[i].Address} (запрос к геокодеру: {geoq})";
                    return;
                }

                points.Add(new
                {
                    lat = p.Value.lat,
                    lon = p.Value.lon,
                    title = $"{i + 1}. {activePoints[i].Address}"
                });
            }

            await JS.InvokeVoidAsync("leafletMap.setRouteWaypoints", points);
            await CompareRoutesInternalAsync(activePoints, _routeCts.Token, refreshRouteSegments: true);
        }
        catch (OperationCanceledException)
        {
            _routeMessage = "Операция прервана или заняла слишком много времени. Попробуйте меньше точек.";
        }
        catch
        {
            _routeMessage = "Ошибка построения маршрута.";
        }
        finally
        {
            _isBuildingRoute = false;
            StateHasChanged();
        }
    }

    private async Task ImportFromCouriersAsync()
    {
        if (_couriers == null)
            _couriers = await CouriersApi.GetAllAsync(null);

        var items = _couriers?
            .Where(c => c.Current_lat != 0 || c.Current_lon != 0)
            .Select(c => new RoutePlanningPointDto
            {
                Address = $"{c.User?.FName} {c.User?.Name}".Trim(),
                Source = "courier",
                Lat = (double)c.Current_lat,
                Lon = (double)c.Current_lon
            })
            .ToList() ?? new List<RoutePlanningPointDto>();

        if (items.Count == 0)
        {
            _routeMessage = "Не найдено координат курьеров для импорта.";
            return;
        }

        _routePoints.Clear();
        ClearRouteSegmentsState();
        _routePoints.AddRange(items);
        _routeMessage = $"Импортировано из курьеров: {items.Count} точек.";
    }

    private async Task ImportFromOrdersAsync()
    {
        var orders = await OrdersApi.GetAllAsync(null) ?? new List<OrderDto>();
        var ordered = orders
            .Where(o => !IsOrderClosedForRouting(o) && o.Courier_id is null)
            .OrderBy(o => o.Created_at)
            .ToList();

        _routePoints.Clear();
        ClearRouteSegmentsState();
        const int maxPoints = 120;
        foreach (var o in ordered)
        {
            if (_routePoints.Count >= maxPoints)
                break;

            AppendOrderRoutePoints(o, _routePoints, maxPoints);
        }

        if (_routePoints.Count == 0)
        {
            _routeMessage =
                "Не удалось добавить точки: у активных заказов нет адресов забора/доставки (или только координаты без подписи). Проверьте заказы в списке.";
            StateHasChanged();
            return;
        }

        _routeMessage =
            $"Импорт из заказов: {_routePoints.Count} точек (забор → при межгороде/ViaHub склад(а) → доставка; по дате создания).";
        StateHasChanged();
    }

    private static bool IsOrderClosedForRouting(OrderDto o)
    {
        if (o.Delivered_at.HasValue)
            return true;
        var name = o.OrderStatus?.Name?.Trim() ?? "";
        if (name.Length == 0)
            return false;
        if (name.Contains("Отмен", StringComparison.OrdinalIgnoreCase))
            return true;
        if (name.Contains("cancel", StringComparison.OrdinalIgnoreCase))
            return true;
        return false;
    }

    /// <summary>
    /// Забор → при ViaHub или разных городах — склад(а) компании → доставка.
    /// </summary>
    private void AppendOrderRoutePoints(OrderDto o, List<RoutePlanningPointDto> list, int maxPoints)
    {
        if (list.Count >= maxPoints)
            return;

        TryAppendAddressPoint(o, o.PickupAddress, "забор", list);

        if (ShouldInsertHubWaypoints(o))
        {
            if (list.Count >= maxPoints)
                return;

            if (IsViaHubRouteKind(o) && o.OriginHub_id is > 0 && o.DestinationHub_id is > 0)
            {
                var origin = _hubs.FirstOrDefault(h => h.Id == o.OriginHub_id!.Value);
                var dest = _hubs.FirstOrDefault(h => h.Id == o.DestinationHub_id!.Value);
                if (origin != null)
                    TryAppendHubWaypoint(o, origin, "склад отправления", list);
                if (list.Count >= maxPoints)
                    return;
                if (dest != null && (origin == null || dest.Id != origin.Id))
                    TryAppendHubWaypoint(o, dest, "склад назначения", list);
            }
            else if (CitiesDiffer(o.PickupAddress, o.DeliveryAddress))
            {
                var hub = PickHubForCrossCity(o.PickupAddress);
                if (hub != null)
                    TryAppendHubWaypoint(o, hub, "склад (перегруз межгород)", list);
            }
        }

        if (list.Count >= maxPoints)
            return;

        TryAppendAddressPoint(o, o.DeliveryAddress, "доставка", list);
    }

    private bool ShouldInsertHubWaypoints(OrderDto o)
    {
        if (IsViaHubRouteKind(o) && o.OriginHub_id is > 0 && o.DestinationHub_id is > 0)
            return true;
        return CitiesDiffer(o.PickupAddress, o.DeliveryAddress);
    }

    private static bool IsViaHubRouteKind(OrderDto o)
    {
        var k = o.DeliveryRouteKind?.Trim();
        if (string.IsNullOrEmpty(k))
            return false;
        if (k.Equals("ViaHub", StringComparison.OrdinalIgnoreCase))
            return true;
        return k == "2";
    }

    private static bool CitiesDiffer(AddressShortDto? a, AddressShortDto? b)
    {
        var ca = NormalizeCity(a?.City);
        var cb = NormalizeCity(b?.City);
        if (string.IsNullOrEmpty(ca) || string.IsNullOrEmpty(cb))
            return false;
        return !string.Equals(ca, cb, StringComparison.OrdinalIgnoreCase);
    }

    private static string? NormalizeCity(string? c)
        => string.IsNullOrWhiteSpace(c) ? null : c.Trim();

    private bool TryAppendHubWaypoint(OrderDto order, LogisticsHubListItemDto hub, string legTitleSuffix, List<RoutePlanningPointDto> list)
    {
        if (!hub.Latitude.HasValue || !hub.Longitude.HasValue)
            return false;

        var q = HubGeocodeLine(hub);
        list.Add(new RoutePlanningPointDto
        {
            Address = $"Заказ №{order.Order_Number}: {legTitleSuffix} — {q}",
            Source = "hub",
            Lat = (double)hub.Latitude.Value,
            Lon = (double)hub.Longitude.Value,
            RelatedOrderId = order.ID_Order
        });
        return true;
    }

    private static string HubGeocodeLine(LogisticsHubListItemDto h)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(h.City))
            parts.Add(h.City.Trim());
        if (!string.IsNullOrWhiteSpace(h.Region) &&
            !string.Equals(h.Region.Trim(), h.City?.Trim(), StringComparison.OrdinalIgnoreCase))
            parts.Add(h.Region.Trim());
        if (!string.IsNullOrWhiteSpace(h.Street))
            parts.Add(h.Street.Trim());
        if (!string.IsNullOrWhiteSpace(h.House))
            parts.Add(h.House.Trim());
        if (parts.Count > 0)
            return string.Join(", ", parts);
        return !string.IsNullOrWhiteSpace(h.Name) ? h.Name.Trim() : $"Склад #{h.Id}";
    }

    private LogisticsHubListItemDto? PickHubForCrossCity(AddressShortDto? pickup)
    {
        var with = _hubs.Where(h => h.Latitude.HasValue && h.Longitude.HasValue).ToList();
        if (with.Count == 0)
            return null;

        var pc = NormalizeCity(pickup?.City);
        if (!string.IsNullOrEmpty(pc))
        {
            var sameCity = with.FirstOrDefault(h =>
                string.Equals(NormalizeCity(h.City), pc, StringComparison.OrdinalIgnoreCase));
            if (sameCity != null)
                return sameCity;
        }

        if (pickup?.Latitude is { } plat && pickup.Longitude is { } plon)
        {
            var best = with[0];
            var bestD = double.MaxValue;
            foreach (var h in with)
            {
                var d = HaversineKm((double)plat, (double)plon, (double)h.Latitude!.Value, (double)h.Longitude!.Value);
                if (d < bestD)
                {
                    bestD = d;
                    best = h;
                }
            }

            return best;
        }

        return with[0];
    }

    private static bool TryAppendAddressPoint(
        OrderDto order,
        AddressShortDto? addr,
        string legLabel,
        List<RoutePlanningPointDto> list)
    {
        if (addr is null)
            return false;

        var query = AddressFormat.GeocodeSearchQuery(addr);
        if (string.IsNullOrWhiteSpace(query))
            query = AddressFormat.OneLine(addr);
        if (string.IsNullOrWhiteSpace(query) || query == "—")
        {
            if (addr.Latitude is { } la && addr.Longitude is { } lo)
            {
                list.Add(new RoutePlanningPointDto
                {
                    Address = $"Заказ №{order.Order_Number}: {legLabel}",
                    Source = "order",
                    Lat = (double)la,
                    Lon = (double)lo,
                    RelatedOrderId = order.ID_Order
                });
                return true;
            }

            return false;
        }

        list.Add(new RoutePlanningPointDto
        {
            Address = $"Заказ №{order.Order_Number}: {legLabel} — {query}",
            Source = "order",
            RelatedOrderId = order.ID_Order
        });
        return true;
    }

    private async Task AssignRouteOrdersToCourierAsync()
    {
        if (_assignRouteBusy || _routeAssignCourierId <= 0)
            return;

        var orderIds = GetDistinctOrderIdsForAssignment();
        if (orderIds.Count == 0)
        {
            Notify.ShowWarning(
                _routeDriverSegments.Count > 1
                    ? "В выбранном отрезке нет заказов (только ручные точки). Выберите другой отрезок или импортируйте заказы."
                    : "В списке точек нет заказов. Сначала нажмите «Импорт из заказов» и постройте маршрут.");
            return;
        }

        _assignRouteBusy = true;
        StateHasChanged();
        try
        {
            var stops = await BuildApplyRouteStopsAsync();
            if (stops.Count == 0)
            {
                Notify.ShowWarning("Не удалось получить координаты точек маршрута. Постройте маршрут на карте или укажите адреса.");
                return;
            }

            var plan = await PlannerApi.ApplyCourierRouteAsync(_routeAssignCourierId, stops);
            if (plan == null)
            {
                Notify.ShowError("Не удалось передать маршрут курьеру. Проверьте координаты и заказы.");
                return;
            }

            Notify.ShowSuccess($"Маршрут передан курьеру: {plan.Stops.Count} точек, {plan.OrdersCount} заказ(ов). Курьер увидит тот же порядок на карте.");
        }
        catch (Exception ex)
        {
            Notify.ShowError(ex.Message);
        }
        finally
        {
            _assignRouteBusy = false;
            StateHasChanged();
        }
    }

    private async Task RevokeRouteOrdersFromCourierAsync()
    {
        if (_revokeRouteBusy || _routeAssignCourierId <= 0)
            return;

        var orderIds = GetDistinctOrderIdsForAssignment();
        if (orderIds.Count == 0)
        {
            Notify.ShowWarning("В маршруте нет заказов для отзыва.");
            return;
        }

        _revokeRouteBusy = true;
        StateHasChanged();
        try
        {
            var result = await OrdersApi.RevokeFromCourierAsync(new RevokeCourierOrdersRequestDto
            {
                CourierId = _routeAssignCourierId,
                OrderIds = orderIds
            });
            if (result is null)
            {
                Notify.ShowError("Не удалось отозвать заказы у курьера.");
                return;
            }

            if (result.RevokedCount > 0)
                Notify.ShowSuccess($"Отозвано заказов: {result.RevokedCount}. Они снова доступны для импорта на карту.");
            if (result.FailedCount > 0)
                Notify.ShowWarning($"Не отозвано: {result.FailedCount}. {string.Join(" ", result.Errors.Take(3))}");
        }
        catch (Exception ex)
        {
            Notify.ShowError(ex.Message);
        }
        finally
        {
            _revokeRouteBusy = false;
            StateHasChanged();
        }
    }

    private List<RoutePlanningPointDto> GetRoutePointsForAssignment()
    {
        if (_routeDriverSegments.Count > 0 &&
            _selectedSegmentIndex >= 0 &&
            _selectedSegmentIndex < _routeDriverSegments.Count)
        {
            var seg = _routeDriverSegments[_selectedSegmentIndex];
            return _routePoints
                .Skip(seg.FromWaypointIndex)
                .Take(seg.ToWaypointIndex - seg.FromWaypointIndex + 1)
                .ToList();
        }

        return _routePoints.ToList();
    }

    private async Task<List<ApplyCourierRouteStopDto>> BuildApplyRouteStopsAsync()
    {
        var points = GetRoutePointsForAssignment();
        var list = new List<ApplyCourierRouteStopDto>();
        var seq = 1;
        foreach (var p in points)
        {
            var coords = await ResolvePointCoordinatesAsync(p, CancellationToken.None);
            if (coords is null)
                continue;

            list.Add(new ApplyCourierRouteStopDto
            {
                Sequence = seq++,
                OrderId = p.RelatedOrderId,
                Title = string.IsNullOrWhiteSpace(p.Address) ? null : p.Address.Trim(),
                Latitude = coords.Value.lat,
                Longitude = coords.Value.lon
            });
        }

        return list;
    }

    private async Task OptimizeRouteOrderAsync()
    {
        if (_isBuildingRoute) return;
        var activePoints = _routePoints
            .Where(p => p.Lat.HasValue || p.Lon.HasValue || !string.IsNullOrWhiteSpace(p.Address))
            .ToList();

        if (activePoints.Count < 3)
        {
            _routeMessage = "Для оптимизации нужно минимум 3 точки.";
            return;
        }

        _routeCts?.Cancel();
        _routeCts?.Dispose();
        _routeCts = new CancellationTokenSource(TimeSpan.FromSeconds(45));
        _isBuildingRoute = true;
        _routeMessage = "Оптимизирую порядок точек...";
        StateHasChanged();
        try
        {
            for (var i = 0; i < activePoints.Count; i++)
            {
                _routeCts.Token.ThrowIfCancellationRequested();
                var resolved = await ResolvePointCoordinatesAsync(activePoints[i], _routeCts.Token);
                if (resolved is null)
                {
                    _routeMessage = $"Не удалось геокодировать: {activePoints[i].Address}";
                    return;
                }
            }

            var ordered = OptimizeNearestNeighbor(activePoints);
            _routePoints.Clear();
            ClearRouteSegmentsState();
            _routePoints.AddRange(ordered);
            _routeMessage = "Порядок точек оптимизирован (ближайший сосед).";
        }
        catch (OperationCanceledException)
        {
            _routeMessage = "Оптимизация прервана или заняла слишком много времени.";
        }
        finally
        {
            _isBuildingRoute = false;
            StateHasChanged();
        }
    }

