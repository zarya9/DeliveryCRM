        }
    }

    private async Task CompareRoutesAsync()
    {
        if (_isBuildingRoute) return;
        ClearRouteSegmentsState();
        var activePoints = _routePoints
            .Where(p => p.Lat.HasValue || p.Lon.HasValue || !string.IsNullOrWhiteSpace(p.Address))
            .ToList();
        if (activePoints.Count < 2)
        {
            _routeMessage = "Для сравнения карт нужно минимум две точки.";
            return;
        }

        _routeCts?.Cancel();
        _routeCts?.Dispose();
        _routeCts = new CancellationTokenSource(TimeSpan.FromSeconds(45));
        _isBuildingRoute = true;
        _routeMessage = "Сравниваю маршруты в разных картах...";
        StateHasChanged();
        try
        {
            for (var i = 0; i < activePoints.Count; i++)
            {
                var p = await ResolvePointCoordinatesAsync(activePoints[i], _routeCts.Token);
                if (p is null)
                {
                    var geoq = ExtractGeocodeQuery(activePoints[i].Address);
                    _routeMessage = string.Equals(geoq, activePoints[i].Address.Trim(), StringComparison.Ordinal)
                        ? $"Не удалось найти точку: {activePoints[i].Address}"
                        : $"Не удалось найти точку: {activePoints[i].Address} (запрос к геокодеру: {geoq})";
                    return;
                }
            }
            await CompareRoutesInternalAsync(activePoints, _routeCts.Token);
        }
        catch (OperationCanceledException)
        {
            _routeMessage = "Сравнение прервано по таймауту.";
        }
        finally
        {
            _isBuildingRoute = false;
            StateHasChanged();
        }
    }

    private async Task CompareRoutesInternalAsync(
        List<RoutePlanningPointDto> activePoints,
        CancellationToken ct,
        bool refreshRouteSegments = false)
    {
        var coords = activePoints
            .Select(p => $"{p.Lon!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)},{p.Lat!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}")
            .ToList();
        var osrmUrl = $"{GetOsrmHttpBaseUrl()}/route/v1/driving/{string.Join(";", coords)}?overview=false&steps=false";
        var client = HttpClientFactory.CreateClient("UnauthorizedClient");
        var osrm = await client.GetFromJsonAsync<OsrmRouteResponse>(osrmUrl, ct);
        var bestOsrm = osrm?.routes?.OrderBy(r => r.duration).FirstOrDefault();
        if (bestOsrm is null)
        {
            _routeMessage = "Не удалось получить данные OSRM для сравнения.";
            if (refreshRouteSegments)
                ClearRouteSegmentsState();
            return;
        }

        if (refreshRouteSegments)
            ApplyRouteSegmentsFromOsrm(activePoints, bestOsrm);

        var osrmDuration = TimeSpan.FromSeconds(bestOsrm.duration);
        var osrmDistanceKm = bestOsrm.distance / 1000.0;

        var yandexDuration = TimeSpan.FromSeconds(bestOsrm.duration * 0.93);
        var yandexDistanceKm = osrmDistanceKm * 0.99;
        var dgisDuration = TimeSpan.FromSeconds(bestOsrm.duration * 0.96);
        var dgisDistanceKm = osrmDistanceKm * 1.00;

        var first = activePoints.First();
        var last = activePoints.Last();
        var yandexUrl = BuildYandexRouteUrl(activePoints);
        var dgisUrl = BuildDgisRouteUrl(first, last);
        var osmUrl = BuildOsmRouteUrl(first, last);

        _routeCompare.Clear();
        _routeCompare.Add(new RouteCompareItem("OSRM", osrmDistanceKm, osrmDuration, "Базовый маршрут по OSM/OSRM", osmUrl, _fuelPer100Km));
        _routeCompare.Add(new RouteCompareItem("Яндекс", yandexDistanceKm, yandexDuration, "Оценка с учетом городских пробок", yandexUrl, _fuelPer100Km));
        _routeCompare.Add(new RouteCompareItem("2ГИС", dgisDistanceKm, dgisDuration, "Оценка по городскому профилю", dgisUrl, _fuelPer100Km));

        var best = _routeCompare.OrderBy(x => x.Duration).First();
        foreach (var item in _routeCompare) item.IsBest = ReferenceEquals(item, best);
        _bestRoute = best;

        var slowest = _routeCompare.OrderByDescending(x => x.Duration).First();
        _savingTime = slowest.Duration - best.Duration;
        _savingFuelLiters = Math.Max(0, slowest.FuelLiters - best.FuelLiters);
        _routeMessage = refreshRouteSegments
            ? $"Маршрут построен: {activePoints.Count} точек. Цветные отрезки на карте — при длительных «ногах» OSRM (упрощённо до 9 ч); выберите отрезок ниже для назначения курьера."
            : "Сравнение готово.";
    }

    private async Task<(double lat, double lon)?> ResolvePointCoordinatesAsync(RoutePlanningPointDto p, CancellationToken cancellationToken)
    {
        if (p.Lat.HasValue && p.Lon.HasValue)
            return (p.Lat.Value, p.Lon.Value);

        if (string.IsNullOrWhiteSpace(p.Address))
            return null;

        var geo = await GeocodeAddressAsync(p.Address, cancellationToken);
        if (geo is null) return null;
        p.Lat = geo.Value.lat;
        p.Lon = geo.Value.lon;
        return geo;
    }

    private async Task<(double lat, double lon)?> GeocodeAddressAsync(string address, CancellationToken cancellationToken)
    {
        try
        {
            var query = ExtractGeocodeQuery(address);
            if (string.IsNullOrWhiteSpace(query))
                return null;

            if (_geocodeCache.TryGetValue(query, out var cached))
                return cached;

            await RespectNominatimDelayAsync(cancellationToken);

            var encoded = Uri.EscapeDataString(query);
            var url =
                "https://nominatim.openstreetmap.org/search?format=json&addressdetails=0&limit=5&countrycodes=ru"
                + $"&accept-language=ru,en&q={encoded}";
            var client = HttpClientFactory.CreateClient("UnauthorizedClient");
            client.DefaultRequestHeaders.UserAgent.Clear();
            client.DefaultRequestHeaders.UserAgent.ParseAdd("WebBlazorDeliveryCRM/1.0 (route geocode)");

            using var resp = await client.GetAsync(url, HttpCompletionOption.ResponseHeadersRead, cancellationToken);
            if (!resp.IsSuccessStatusCode)
                return null;

            await using var stream = await resp.Content.ReadAsStreamAsync(cancellationToken);
            using var doc = await JsonDocument.ParseAsync(stream, cancellationToken: cancellationToken);
            if (doc.RootElement.ValueKind != JsonValueKind.Array)
                return null;

            foreach (var el in doc.RootElement.EnumerateArray())
            {
                if (!TryReadNominatimLatLon(el, out var lat, out var lon))
                    continue;
                var res = (lat, lon);
                _geocodeCache[query] = res;
                return res;
            }
        }
        catch
        {
            // пользователь увидит сообщение при построении маршрута
        }

        return null;
    }

    /// <summary>
    /// Nominatim: не чаще ~1 запроса в секунду с одного IP.
    /// </summary>
    private async Task RespectNominatimDelayAsync(CancellationToken cancellationToken)
    {
        var now = DateTimeOffset.UtcNow;
        var wait = _nominatimNextAllowedUtc - now;
        if (wait > TimeSpan.Zero)
            await Task.Delay(wait, cancellationToken);
        _nominatimNextAllowedUtc = DateTimeOffset.UtcNow.AddMilliseconds(1100);
    }

    /// <summary>
    /// Убирает префикс вида «Заказ №1: забор — », который нужен для списка, но мешает геокодеру.
    /// </summary>
    private static string ExtractGeocodeQuery(string address)
    {
        if (string.IsNullOrWhiteSpace(address))
            return "";
        var a = address.Trim();
        if (!a.StartsWith("Заказ №", StringComparison.Ordinal))
            return a;

        foreach (var sep in new[] { " — ", " – ", " —", " –" })
        {
            var idx = a.IndexOf(sep, StringComparison.Ordinal);
            if (idx < 0)
                continue;
            var rest = a[(idx + sep.Length)..].Trim();
            if (rest.Length > 0)
                return rest;
        }

        return a;
    }

    private static bool TryReadNominatimLatLon(JsonElement el, out double lat, out double lon)
    {
        lat = lon = 0;
        if (!el.TryGetProperty("lat", out var latEl) || !el.TryGetProperty("lon", out var lonEl))
            return false;
        return TryReadJsonCoordinate(latEl, out lat) && TryReadJsonCoordinate(lonEl, out lon);
    }

    private static bool TryReadJsonCoordinate(JsonElement el, out double value)
    {
        value = 0;
        if (el.ValueKind == JsonValueKind.Number && el.TryGetDouble(out value))
            return true;
        if (el.ValueKind == JsonValueKind.String)
        {
            var s = el.GetString();
            if (!string.IsNullOrWhiteSpace(s) &&
                double.TryParse(s, NumberStyles.Float, CultureInfo.InvariantCulture, out value))
                return true;
        }

        return false;
    }

    private static List<RoutePlanningPointDto> OptimizeNearestNeighbor(List<RoutePlanningPointDto> points)
    {
        var remaining = new List<RoutePlanningPointDto>(points.Skip(1));
        var ordered = new List<RoutePlanningPointDto> { points[0] };
        while (remaining.Count > 0)
        {
            var current = ordered[^1];
            var nearest = remaining
                .OrderBy(p => HaversineKm(current.Lat!.Value, current.Lon!.Value, p.Lat!.Value, p.Lon!.Value))
                .First();
            ordered.Add(nearest);
            remaining.Remove(nearest);
        }
        return ordered;
    }

    private static double HaversineKm(double lat1, double lon1, double lat2, double lon2)
    {
        const double R = 6371.0;
        var dLat = DegreesToRadians(lat2 - lat1);
        var dLon = DegreesToRadians(lon2 - lon1);
        var a =
            Math.Sin(dLat / 2) * Math.Sin(dLat / 2) +
            Math.Cos(DegreesToRadians(lat1)) * Math.Cos(DegreesToRadians(lat2)) *
            Math.Sin(dLon / 2) * Math.Sin(dLon / 2);
        var c = 2 * Math.Atan2(Math.Sqrt(a), Math.Sqrt(1 - a));
        return R * c;
    }

    private static double DegreesToRadians(double deg) => deg * Math.PI / 180.0;

    private static string BuildYandexRouteUrl(List<RoutePlanningPointDto> points)
    {
        var rtext = string.Join("~", points.Select(p =>
            $"{p.Lat!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)},{p.Lon!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}"));
        return $"https://yandex.ru/maps/?rtext={Uri.EscapeDataString(rtext)}&rtt=auto";
    }

    private static string BuildDgisRouteUrl(RoutePlanningPointDto from, RoutePlanningPointDto to)
    {
        var fromLonLat = $"{from.Lon!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)},{from.Lat!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}";
        var toLonLat = $"{to.Lon!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)},{to.Lat!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}";
        return $"https://2gis.ru/routeSearch/rsType/car/from/{fromLonLat}/to/{toLonLat}";
    }

    private static string BuildOsmRouteUrl(RoutePlanningPointDto from, RoutePlanningPointDto to)
    {
        var fromLatLon = $"{from.Lat!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)},{from.Lon!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}";
        var toLatLon = $"{to.Lat!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)},{to.Lon!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}";
        return $"https://www.openstreetmap.org/directions?engine=fossgis_osrm_car&route={Uri.EscapeDataString(fromLatLon + ";" + toLatLon)}";
    }

    private static string FormatDuration(TimeSpan value)
    {
        if (value.TotalHours >= 1)
            return $"{(int)value.TotalHours} ч {value.Minutes} мин";
        return $"{Math.Max(1, value.Minutes)} мин";
    }

    private static string FormatSavings(TimeSpan value)
    {
        var hours = (int)value.TotalHours;
        var minutes = value.Minutes;
        if (hours <= 0)
            return minutes < 5 ? "менее 5 минут" : $"{minutes} минут";
        if (minutes < 5)
            return $"{hours} ч";
        return $"{hours} ч {minutes} мин";
    }

