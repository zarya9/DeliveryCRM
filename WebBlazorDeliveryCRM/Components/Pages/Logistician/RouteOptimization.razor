    {
        ClearRouteSegmentsState();
        _routeMessage = null;
        _routeCompare.Clear();
        _bestRoute = null;
        _savingTime = TimeSpan.Zero;
        _savingFuelLiters = 0;
        try
        {
            await JS.InvokeVoidAsync("leafletMap.clearRoute");
        }
        catch
