    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_mapReady)
            {
                var v = await JS.InvokeAsync<MapViewSnapshot?>("leafletMap.getView");
                if (v != null)
                {
                    RouteSession.MapCenterLat = v.Lat;
                    RouteSession.MapCenterLon = v.Lng;
                    RouteSession.MapZoom = v.Zoom;
                }
            }
        }
        catch
        {
            // ignore
        }

        try
        {
            _reverseGeoCts?.Cancel();
        }
        catch
        {
            // ignore
        }

        _reverseGeoCts?.Dispose();
        _reverseGeoCts = null;
        _trackingHandler?.Dispose();
        _trackingHandler = null;
        _routeCts?.Cancel();
        _routeCts?.Dispose();
    }
