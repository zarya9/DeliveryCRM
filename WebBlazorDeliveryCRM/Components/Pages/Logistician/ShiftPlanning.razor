@page "/logistician/shifts"
@layout LogisticianLayout
@using WebBlazorDeliveryCRM.Components.Shared
@using WebBlazorDeliveryCRM.Models
@inject AuthenticationStateProvider AuthStateProvider
@inject CouriersApiService CouriersApi
@inject ShiftPlannerApiService PlannerApi
@inject AppNotificationService Notify
@inject NavigationManager Navigation

<PageTitle>Планирование смен — Логист</PageTitle>

<div class="dms-page-header">
    <h1 class="dms-page-title-with-icon">
        <HugeIcon Name="calendar-03" CssClass="logistician-page-title-icon" />
        Планирование смен
    </h1>
    <p class="subtitle">Планировщик строит маршруты автоматически: доступность курьеров и ТС, приоритет, SLA, хабы. Заказы с приоритетом «критически срочный» в одном городе или короткой городской связке получают порядок точек с упором на быстрое выполнение; на длинных плечах порядок оптимизируется по расстоянию (топливо).</p>
</div>

<div class="dms-stat-grid mb-3">
    <KpiCard Title="Курьеров всего" Value="@_totalCouriers.ToString()" Meta="По компании" IconName="user-group" />
    <KpiCard Title="Онлайн сейчас" Value="@_onlineCouriers.ToString()" Meta="По фактическому статусу" IconName="activity-01" />
    <KpiCard Title="Активные смены" Value="@((_planner?.ActiveShifts ?? 0).ToString())" Meta="Доступно для планирования" IconName="clock-01" />
    <KpiCard Title="Маршрутов" Value="@((_planner?.Plans?.Count ?? 0).ToString())" Meta="Текущая версия плана" IconName="route-02" />
</div>

<div class="dms-card mb-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h2 class="dms-card-title logistician-card-title-with-icon mb-0">
            <HugeIcon Name="dashboard-square-01" CssClass="logistician-card-title-icon" />
            Планировщик маршрутов
        </h2>
        <button type="button" class="btn btn-sm btn-primary dms-btn-primary d-inline-flex align-items-center gap-1" disabled="@_plannerBusy" @onclick="RebuildPlannerAsync">
            <HugeIcon Name="analytics-up" CssClass="dms-icon-sm" />
            @(_plannerBusy ? "Планируем..." : "Перепланировать")
        </button>
    </div>
    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger mt-2 mb-0">@_error</div>
    }
    else
    {
        <p class="text-muted mt-2 mb-0">
            Последний запуск: @((_planner?.RunAtUtc ?? DateTime.UtcNow).ToLocalTime().ToString("dd.MM.yyyy HH:mm"))
            @if (!string.IsNullOrWhiteSpace(_planner?.Reason))
            {
                <span> · Причина: @_planner!.Reason</span>
            }
        </p>
    }
</div>

<div class="dms-card">
    <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
        <h2 class="dms-card-title logistician-card-title-with-icon mb-0">
            <HugeIcon Name="user-group" CssClass="logistician-card-title-icon" />
            Курьеры и управление сменами
        </h2>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            @if (_selectedShiftCourierId.HasValue)
            {
                <button type="button" class="btn btn-outline-info btn-sm d-inline-flex align-items-center gap-1" @onclick="OpenSelectedShiftCourierInfo">
                    <HugeIcon Name="audit-01" CssClass="dms-icon-sm" />
                    <span>Инфо</span>
                </button>
                <button type="button" class="btn btn-outline-primary btn-sm d-inline-flex align-items-center gap-1" @onclick="NavigateToSelectedCourier">
                    <HugeIcon Name="user-03" CssClass="dms-icon-sm" />
                    <span>Профиль</span>
                </button>
            }
        </div>
    </div>
    @if (_loading)
    {
        <p class="text-muted mb-0">Загрузка...</p>
    }
    else if (_couriers.Count == 0)
    {
        <p class="text-muted mb-0">Курьеры не найдены.</p>
    }
    else
    {
        <div class="hub-grid">
            @foreach (var c in _couriers.OrderBy(x => x.User?.FName).ThenBy(x => x.User?.Name))
            {
                var state = _shiftByCourier.GetValueOrDefault(c.ID_CourierProfile);
                var plan = _planner?.Plans?.FirstOrDefault(p => p.CourierId == c.ID_CourierProfile);
                <div class="hub-card @(_selectedShiftCourierId == c.ID_CourierProfile ? "hub-card-selected" : "")"
                     @onclick="() => SelectShiftCourier(c)"
                     @ondblclick="() => OpenShiftCourierModal(c)">
                    <div class="courier-hub-card-head">
                        <div class="courier-hub-card-head__main">
                            <h3 class="hub-card-title">@($"{c.User?.FName} {c.User?.Name}".Trim())</h3>
                            <div class="mb-2">
                                <StatusBadge Text="@(state.active ? "На смене" : "Не на смене")" Tone="@(state.active ? "success" : "neutral")" />
                            </div>
                        </div>
                        <UserAvatarThumb @key="c.User_id"
                                         UserId="c.User_id"
                                         Alt="@($"{c.User?.FName} {c.User?.Name}".Trim())" />
                    </div>
                    <div class="small hub-card-orders">
                        @if (plan is null)
                        {
                            <span class="text-muted">Маршрут не построен</span>
                        }
                        else
                        {
                            <div>План v<strong>@plan.Version</strong> · заказов @plan.OrdersCount · стопов @plan.Stops.Count</div>
                            <div class="text-muted">@plan.TotalDistanceKm.ToString("0.0") км · @Math.Round(plan.EstimatedDurationMinutes) мин</div>
                            <div class="text-muted">Загрузка: @Math.Round(plan.LoadFactorWeight * 100, 1)% / @Math.Round(plan.LoadFactorVolume * 100, 1)%</div>
                        }
                    </div>
                    <div class="small text-muted mt-2 pt-2 border-top border-secondary border-opacity-25">
                        Активность: @(c.LastActivity_at == default ? "—" : c.LastActivity_at.ToLocalTime().ToString("dd.MM.yyyy HH:mm"))
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (_showShiftCourierModal && _modalShiftCourier is not null)
{
    var m = _modalShiftCourier;
    var mState = _shiftByCourier.GetValueOrDefault(m.ID_CourierProfile);
    var mPlan = _planner?.Plans?.FirstOrDefault(p => p.CourierId == m.ID_CourierProfile);
    <div class="employee-modal-backdrop">
        <div class="employee-modal employee-modal--fleet-form" @onclick:stopPropagation="true">
            <div class="d-flex align-items-start gap-3 mb-3">
                <UserAvatarThumb UserId="m.User_id"
                                 Large="true"
                                 Alt="@($"{m.User?.FName} {m.User?.Name}".Trim())" />
                <div class="flex-grow-1 min-w-0">
                    <h2 class="h5 mb-0">@($"{m.User?.FName} {m.User?.Name}".Trim())</h2>
                </div>
                <button type="button" class="btn-close flex-shrink-0" aria-label="Закрыть" @onclick="CloseShiftCourierModal"></button>
            </div>
            <div class="mb-2">
                <strong>Статус смены:</strong>
                <StatusBadge Text="@(mState.active ? "На смене" : "Не на смене")" Tone="@(mState.active ? "success" : "neutral")" />
            </div>
            <div class="mb-3">
                <strong>Маршрут:</strong>
                @if (mPlan is null)
                {
                    <span class="text-muted">Маршрут не построен</span>
                }
                else
                {
                    <div class="small mt-1">Версия @mPlan.Version, заказов @mPlan.OrdersCount, стопов @mPlan.Stops.Count · @mPlan.TotalDistanceKm.ToString("0.0") км · @Math.Round(mPlan.EstimatedDurationMinutes) мин</div>
                    <div class="small text-muted">Загрузка: вес @Math.Round(mPlan.LoadFactorWeight * 100, 1)% / объём @Math.Round(mPlan.LoadFactorVolume * 100, 1)%</div>
                }
            </div>
            <div class="mb-3 small text-muted">
                Последняя активность: @(m.LastActivity_at == default ? "—" : m.LastActivity_at.ToLocalTime().ToString("dd.MM.yyyy HH:mm"))
            </div>
            <div class="d-flex flex-wrap gap-2 mb-3">
                @if (mState.active)
                {
                    <button type="button" class="btn btn-outline-danger d-inline-flex align-items-center gap-1" disabled="@(_shiftLoadingCourierId == m.ID_CourierProfile)" @onclick="() => EndShiftFromModal(m.ID_CourierProfile)">
                        <HugeIcon Name="clock-01" CssClass="dms-icon-sm" />
                        Завершить смену
                    </button>
                }
                else
                {
                    <button type="button" class="btn btn-outline-success d-inline-flex align-items-center gap-1" disabled="@(_shiftLoadingCourierId == m.ID_CourierProfile)" @onclick="() => StartShiftFromModal(m.ID_CourierProfile)">
                        <HugeIcon Name="calendar-03" CssClass="dms-icon-sm" />
                        Начать смену
                    </button>
                }
            </div>
            <div class="d-flex justify-content-end gap-2 flex-wrap">
                <button type="button" class="btn btn-outline-secondary" @onclick="CloseShiftCourierModal">Закрыть</button>
                <button type="button" class="btn btn-primary dms-btn-primary d-inline-flex align-items-center gap-1" @onclick="() => GoCourierProfile(m.ID_CourierProfile)">
                    <HugeIcon Name="user-03" CssClass="dms-icon-sm" />
                    Открыть карточку
                </button>
            </div>
        </div>
    </div>
}

@if (_planner?.Plans?.Count > 0)
{
    @foreach (var plan in _planner.Plans.OrderBy(p => p.CourierName))
    {
        <div class="dms-card mt-3">
            <div class="d-flex flex-wrap justify-content-between gap-2 mb-2">
                <h2 class="dms-card-title mb-0">@plan.CourierName</h2>
                <div class="small text-muted">@plan.VehicleLabel</div>
            </div>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Заказ</th>
                            <th>Этап</th>
                            <th>Точка</th>
                            <th>План</th>
                            <th>Км</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var stop in plan.Stops.OrderBy(s => s.Sequence))
                        {
                            <tr>
                                <td>@stop.Sequence</td>
                                <td><strong>#@stop.OrderNumber</strong></td>
                                <td>@FormatStage(stop.Stage)</td>
                                <td>
                                    <div>@(string.IsNullOrWhiteSpace(stop.Title) ? stop.AddressLine : stop.Title)</div>
                                    @if (!string.IsNullOrWhiteSpace(stop.AddressLine))
                                    {
                                        <div class="small text-muted">@stop.AddressLine</div>
                                    }
                                </td>
                                <td class="small">
                                    @stop.PlannedStartUtc?.ToLocalTime().ToString("HH:mm")
                                    -
                                    @stop.PlannedEndUtc?.ToLocalTime().ToString("HH:mm")
                                </td>
                                <td>@stop.SegmentDistanceKm.ToString("0.0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@if (_planner?.Unplanned?.Count > 0)
{
    <div class="dms-card mt-3">
        <h2 class="dms-card-title">Не включено в маршруты</h2>
        <div class="table-responsive">
            <table class="table table-sm mb-0">
                <thead>
                    <tr>
                        <th>Заказ</th>
                        <th>Тип</th>
                        <th>Причина</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _planner.Unplanned)
                    {
                        <tr>
                            <td>#@item.OrderNumber</td>
                            <td>@item.RouteKind</td>
                            <td>@item.Reason</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private bool _dataRequested;
    private string? _error;
    private List<CourierProfileDto> _couriers = new();
    private int _totalCouriers;
    private int _onlineCouriers;
    private readonly Dictionary<int, (bool active, int? shiftId, DateTime? timeStart)> _shiftByCourier = new();
    private int _shiftLoadingCourierId;
    private bool _plannerBusy;
    private CompanyPlannerResultDto? _planner;

    private int? _selectedShiftCourierId;
    private bool _showShiftCourierModal;
    private CourierProfileDto? _modalShiftCourier;

    private void SelectShiftCourier(CourierProfileDto c) => _selectedShiftCourierId = c.ID_CourierProfile;

    private void OpenShiftCourierModal(CourierProfileDto c)
    {
        _modalShiftCourier = c;
        _selectedShiftCourierId = c.ID_CourierProfile;
        _showShiftCourierModal = true;
    }

    private void CloseShiftCourierModal()
    {
        _showShiftCourierModal = false;
        _modalShiftCourier = null;
    }

    private void OpenSelectedShiftCourierInfo()
    {
        if (!_selectedShiftCourierId.HasValue)
            return;
        var c = _couriers.FirstOrDefault(x => x.ID_CourierProfile == _selectedShiftCourierId.Value);
        if (c is null)
            return;
        OpenShiftCourierModal(c);
    }

    private void NavigateToSelectedCourier()
    {
        if (!_selectedShiftCourierId.HasValue)
            return;
        GoCourierProfile(_selectedShiftCourierId.Value);
    }

    private void GoCourierProfile(int id)
    {
        CloseShiftCourierModal();
        Navigation.NavigateTo($"/logistician/couriers/{id}");
    }

    private async Task StartShiftFromModal(int courierId)
    {
        await StartShift(courierId);
        _modalShiftCourier = _couriers.FirstOrDefault(x => x.ID_CourierProfile == courierId);
        StateHasChanged();
    }

    private async Task EndShiftFromModal(int courierId)
    {
        await EndShift(courierId);
        _modalShiftCourier = _couriers.FirstOrDefault(x => x.ID_CourierProfile == courierId);
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _dataRequested)
            return;
        _dataRequested = true;

        try
        {
            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            if (state.User.Identity?.IsAuthenticated != true)
            {
                _error = "Требуется вход.";
                _loading = false;
                StateHasChanged();
                return;
            }

            if (!int.TryParse(state.User.FindFirst("companyId")?.Value, out _))
            {
                _error = "Не удалось определить компанию пользователя.";
                _loading = false;
                StateHasChanged();
                return;
            }

            // Без companyId в query — компания берётся из JWT на API (как на странице «Курьеры»).
            _couriers = await CouriersApi.GetAllAsync(null) ?? new();
            _totalCouriers = _couriers.Count;
            _onlineCouriers = _couriers.Count(c => c.Is_online);
            _shiftByCourier.Clear();
            foreach (var c in _couriers)
                _shiftByCourier[c.ID_CourierProfile] = await CouriersApi.GetActiveShiftAsync(c.ID_CourierProfile);
            _planner = await PlannerApi.GetCurrentAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task StartShift(int courierId)
    {
        _shiftLoadingCourierId = courierId;
        try
        {
            var (ok, shiftId, error) = await CouriersApi.StartShiftAsync(courierId);
            if (!ok)
            {
                Notify.ShowError(error ?? "Не удалось начать смену.");
                return;
            }

            _shiftByCourier[courierId] = (true, shiftId, DateTime.UtcNow);
            _planner = await PlannerApi.GetCurrentAsync();
            Notify.ShowSuccess("Смена начата.");
        }
        finally
        {
            _shiftLoadingCourierId = 0;
            StateHasChanged();
        }
    }

    private async Task EndShift(int courierId)
    {
        _shiftLoadingCourierId = courierId;
        try
        {
            var state = _shiftByCourier.GetValueOrDefault(courierId);
            if (!state.shiftId.HasValue)
            {
                Notify.ShowWarning("Активная смена не найдена.");
                return;
            }

            var (ok, error) = await CouriersApi.EndShiftAsync(state.shiftId.Value);
            if (!ok)
            {
                Notify.ShowError(error ?? "Не удалось завершить смену.");
                return;
            }

            _shiftByCourier[courierId] = (false, null, null);
            _planner = await PlannerApi.GetCurrentAsync();
            Notify.ShowSuccess("Смена завершена.");
        }
        finally
        {
            _shiftLoadingCourierId = 0;
            StateHasChanged();
        }
    }

    private async Task RebuildPlannerAsync()
    {
        _plannerBusy = true;
        try
        {
            var refreshed = await PlannerApi.RebuildAsync(reason: "manual.logistician");
            if (refreshed == null)
            {
                Notify.ShowError("Не удалось перестроить план.");
                return;
            }
            _planner = refreshed;
            Notify.ShowSuccess("План маршрутов обновлен.");
        }
        finally
        {
            _plannerBusy = false;
            StateHasChanged();
        }
    }

    private static string FormatStage(string? stage) => stage switch
    {
        "LocalUrban" => "Город",
        "PickupToHub" => "Забор -> Хаб",
        "HubToHub" => "Хаб -> Хаб",
        "HubToRecipient" => "Хаб -> Получатель",
        "DirectIntercity" => "Прямой межгород",
        _ => string.IsNullOrWhiteSpace(stage) ? "Этап" : stage
    };

}
