@page "/chat"
@layout MainLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Security.Claims
@using Microsoft.AspNetCore.SignalR.Client
@inject ChatHubClientService ChatHubClient
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Чат</PageTitle>

<div class="dms-page-header">
    <h1>Чат</h1>
    <p class="subtitle">Онлайн-общение сотрудников компании</p>
</div>

<div class="dms-card" style="max-height: 480px; display: flex; flex-direction: column;">
    <div class="flex-grow-1 overflow-auto mb-2" style="border: 1px solid var(--dms-card-border, #e2e8f0); border-radius: 8px; padding: 0.75rem;">
        @if (_messages.Count == 0)
        {
            <p class="text-muted mb-0">Сообщений пока нет. Напишите первое сообщение.</p>
        }
        else
        {
            @foreach (var m in _messages)
            {
                <div class="mb-2">
                    <div class="small text-muted">
                        @if (m.IsMine)
                        {
                            <span>Вы</span>
                        }
                        else
                        {
                            <span>Пользователь @m.SenderId</span>
                        }
                        <span class="ms-1">@m.SentAt.ToLocalTime().ToString("HH:mm")</span>
                    </div>
                    <div>@m.Text</div>
                </div>
            }
        }
    </div>

    <div class="d-flex gap-2">
        <input class="form-control" placeholder="Введите сообщение..."
               @bind="_newMessage" @bind:event="oninput"
               @onkeydown="OnKeyDown" />
        <button class="btn btn-primary dms-btn-primary" disabled="@string.IsNullOrWhiteSpace(_newMessage)" @onclick="SendMessageAsync">
            Отправить
        </button>
    </div>
</div>

@code {
    private readonly List<ChatMessageVm> _messages = new();
    private string _newMessage = string.Empty;
    private int _roomId = 1; // общий чат компании
    private int _currentUserId;
    private bool _initialized;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = state.User;
        var idStr = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (!int.TryParse(idStr, out _currentUserId))
        {
            return;
        }

        var connection = await ChatHubClient.GetConnectionAsync();

        connection.On<IncomingMessage>("ReceiveMessage", msg =>
        {
            if (msg.chatRoomId != _roomId) return;
            _messages.Add(new ChatMessageVm
            {
                SenderId = msg.senderId,
                Text = msg.messageText,
                SentAt = msg.sentAt,
                IsMine = msg.senderId == _currentUserId
            });
            InvokeAsync(StateHasChanged);
        });

        await ChatHubClient.StartAsync();
        await connection.SendAsync("JoinRoom", _roomId);
        _initialized = true;
    }

    private async Task SendMessageAsync()
    {
        if (!_initialized) return;
        var text = _newMessage.Trim();
        if (string.IsNullOrEmpty(text)) return;

        var connection = ChatHubClient.Connection;
        if (connection is null) return;

        await connection.SendAsync("SendMessage", _roomId, _currentUserId, text);
        _newMessage = string.Empty;
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessageAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        var connection = ChatHubClient.Connection;
        if (connection != null && _initialized)
        {
            try
            {
                await connection.SendAsync("LeaveRoom", _roomId);
            }
            catch { }
        }
    }

    private sealed class ChatMessageVm
    {
        public int SenderId { get; set; }
        public string Text { get; set; } = "";
        public DateTime SentAt { get; set; }
        public bool IsMine { get; set; }
    }

    private sealed class IncomingMessage
    {
        public int chatRoomId { get; set; }
        public int senderId { get; set; }
        public string messageText { get; set; } = "";
        public string? attachmentUrl { get; set; }
        public DateTime sentAt { get; set; }
    }
}

