@page "/manager/hubs"
@layout ManagerLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Менеджер,Администратор,Админ")]
@using WebBlazorDeliveryCRM.Services
@using WebBlazorDeliveryCRM.Components.Shared
@inject LogisticsHubsApiService HubsApi
@inject AppNotificationService Notify

<PageTitle>Склады (хабы) — Менеджер</PageTitle>

<div class="dms-page-header">
    <h1>Склады и сортировочные пункты</h1>
    <p class="subtitle">Создание складов доступно менеджеру. Используются для маршрутов «через хабы».</p>
</div>

<div class="dms-stat-grid mb-3">
    <KpiCard Title="Складов в системе" Value="@((_list?.Count ?? 0).ToString())" />
</div>

<div class="dms-card mb-3">
    <h2 class="dms-card-title">Новый склад</h2>
    <div class="row g-3">
        <div class="col-md-4">
            <label class="form-label">Название</label>
            <input class="form-control" @bind="_name" placeholder="Склад Север" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Город</label>
            <input class="form-control" @bind="_city" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Улица</label>
            <input class="form-control" @bind="_street" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Дом</label>
            <input class="form-control" @bind="_house" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Квартира / офис</label>
            <input class="form-control" @bind="_flat" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Регион</label>
            <input class="form-control" @bind="_region" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Индекс</label>
            <input class="form-control" @bind="_postal" />
        </div>
        <div class="col-12">
            <button type="button" class="btn btn-primary dms-btn-primary mt-1" disabled="@_saving" @onclick="SaveHub">Сохранить склад</button>
        </div>
    </div>
</div>

<div class="dms-card">
    <h2 class="dms-card-title">Список складов компании</h2>
    @if (_list?.Count > 0)
    {
        <div class="hub-grid">
            @foreach (var h in _list)
            {
                <div class="hub-card">
                    <h3 class="hub-card-title">@(string.IsNullOrWhiteSpace(h.Name) ? "Склад" : h.Name)</h3>
                    <div class="small text-muted">@FormatAddress(h)</div>
                    @if (h.OrdersOnSite is { Count: > 0 })
                    {
                        <div class="mt-2 small">
                            <strong class="d-block mb-1">Заказы на складе</strong>
                            <ul class="mb-0 ps-3">
                                @foreach (var o in h.OrdersOnSite)
                                {
                                    <li>
                                        Заказ №@o.OrderNumber — от @(o.ClientName ?? "—"), доставка: @(o.DeliveryTo ?? "—")
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                    else
                    {
                        <p class="small text-muted mb-0 mt-2">Нет заказов на этом складе по маршруту.</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(BuildMapUrl(h)))
                    {
                        <iframe class="hub-mini-map"
                                src="@BuildMapUrl(h)"
                                loading="lazy"
                                title="Карта склада"
                                tabindex="-1"
                                aria-hidden="true"></iframe>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <p class="text-muted">Склады ещё не заведены.</p>
    }
</div>

@code {
    private List<LogisticsHubListItemDto>? _list;
    private string _name = "";
    private string _street = "";
    private string _house = "";
    private string? _flat;
    private string? _city;
    private string? _region;
    private string? _postal;
    private bool _saving;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await Reload();
        StateHasChanged();
    }

    private async Task Reload()
    {
        _list = await HubsApi.GetMineAsync();
    }

    private async Task SaveHub()
    {
        if (string.IsNullOrWhiteSpace(_name) || string.IsNullOrWhiteSpace(_street) || string.IsNullOrWhiteSpace(_house))
        {
            Notify.ShowWarning("Укажите название, улицу и дом.");
            return;
        }
        _saving = true;
        try
        {
            var ok = await HubsApi.CreateAsync(new CreateLogisticsHubApiRequest
            {
                Name = _name.Trim(),
                Street = _street.Trim(),
                House = _house.Trim(),
                Flat = _flat,
                City = _city,
                Region = _region,
                PostalCode = _postal
            });
            if (ok)
            {
                Notify.ShowSuccess("Склад создан.");
                _name = _street = _house = "";
                _flat = _city = _region = _postal = null;
                await Reload();
            }
            else Notify.ShowError("Не удалось создать склад.");
        }
        catch (Exception ex) { Notify.ShowError(ex.Message); }
        finally { _saving = false; }
    }

    private static string FormatAddress(LogisticsHubListItemDto h)
    {
        var parts = new[]
        {
            h.City,
            h.Street,
            h.House,
            h.Flat,
            h.Region,
            h.PostalCode
        }.Where(x => !string.IsNullOrWhiteSpace(x)).Select(x => x!.Trim());
        var text = string.Join(", ", parts);
        return string.IsNullOrWhiteSpace(text) ? "Адрес не указан" : text;
    }

    private static string BuildMapUrl(LogisticsHubListItemDto h)
    {
        if (!h.Latitude.HasValue || !h.Longitude.HasValue)
            return string.Empty;
        var lat = h.Latitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
        var lon = h.Longitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
        var delta = 0.01m;
        var left = (h.Longitude.Value - delta).ToString(System.Globalization.CultureInfo.InvariantCulture);
        var right = (h.Longitude.Value + delta).ToString(System.Globalization.CultureInfo.InvariantCulture);
        var top = (h.Latitude.Value + delta).ToString(System.Globalization.CultureInfo.InvariantCulture);
        var bottom = (h.Latitude.Value - delta).ToString(System.Globalization.CultureInfo.InvariantCulture);
        return $"https://www.openstreetmap.org/export/embed.html?bbox={left}%2C{bottom}%2C{right}%2C{top}&layer=mapnik&marker={lat}%2C{lon}";
    }
}
