@page "/manager/notifications"
@layout ManagerLayout
@using Microsoft.AspNetCore.SignalR.Client
@using WebBlazorDeliveryCRM.Components.Shared
@using WebBlazorDeliveryCRM.Services
@inject ChatHubClientService ChatHub

<PageTitle>Уведомления</PageTitle>

<div class="dms-page-header">
    <h1>Уведомления</h1>
    <p class="subtitle">
        Сообщения о событиях в CRM: <strong>новые сообщения в чатах</strong>, при появлении — сразу в списке и через SignalR.
        Дальше сюда же можно выводить смену статуса заказа, назначение курьера, лиды и напоминания.
    </p>
    <StatusBadge Text="@(_hubConnected ? "Realtime: подключено" : "Realtime: офлайн")"
                 Tone="@(_hubConnected ? "success" : "warning")" />
</div>

<NotificationsInbox />

@code {
    private bool _hubConnected;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var conn = await ChatHub.GetConnectionAsync();
            await ChatHub.StartAsync();
            _hubConnected = conn.State == HubConnectionState.Connected;
        }
        catch
        {
            _hubConnected = false;
        }
        StateHasChanged();
    }
}
