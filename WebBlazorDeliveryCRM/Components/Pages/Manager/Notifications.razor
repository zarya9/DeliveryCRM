@page "/manager/notifications"
@layout ManagerLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Менеджер,Администратор,Админ")]
@using Microsoft.AspNetCore.SignalR.Client
@using WebBlazorDeliveryCRM.Components.Shared
@using WebBlazorDeliveryCRM.Services
@inject ChatHubClientService ChatHub

<PageTitle>Уведомления</PageTitle>

<div class="dms-page-header">
    <h1 class="dms-page-title-with-icon">
        <HugeIcon Name="notification-01" CssClass="dms-page-title-icon" />
        Уведомления
    </h1>
    <p class="subtitle">События по заказам, сменам и SLA</p>
</div>

<NotificationsInbox ToolbarTitleIconName="notification-01" />

@code {
    private bool _hubConnected;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var conn = await ChatHub.GetConnectionAsync();
            await ChatHub.StartAsync();
            _hubConnected = conn.State == HubConnectionState.Connected;
        }
        catch
        {
            _hubConnected = false;
        }
        StateHasChanged();
    }
}
