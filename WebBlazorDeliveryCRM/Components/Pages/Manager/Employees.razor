@page "/manager/employees"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Менеджер,Администратор,Админ")]
@layout ManagerLayout
@implements IDisposable
@using System.Security.Claims
@using Microsoft.AspNetCore.SignalR.Client
@using WebBlazorDeliveryCRM.Models
@using Microsoft.AspNetCore.Components
@using WebBlazorDeliveryCRM.Services
@using WebBlazorDeliveryCRM.Components.Shared
@using static WebBlazorDeliveryCRM.Services.EmployeesApiService
@inject EmployeesApiService EmployeesApi
@inject RolesApiService RolesApi
@inject UserPresenceApiService PresenceApi
@inject ChatHubClientService ChatHub
@inject AuthenticationStateProvider AuthStateProvider
@inject AppNotificationService Notify
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@inject ChatApiService ChatApi

<PageTitle>Сотрудники — Менеджер</PageTitle>

<div class="dms-page-header">
    <h1>Сотрудники компании</h1>
    <p class="subtitle"></p>
    
</div>

<div class="dms-stat-grid mb-3">
    <KpiCard Title="Всего сотрудников" Value="@_employees.Count.ToString()" />
    <KpiCard Title="Сейчас в сети" Value="@_onlineUserIds.Count.ToString()" />
</div>

<div class="dms-card mb-3">
    <div class="d-flex justify-content-between align-items-center gap-2 mb-2 flex-wrap flex-md-nowrap">
        <h2 class="dms-card-title mb-0 flex-shrink-0">Сотрудники</h2>
        <div class="employees-toolbar d-flex gap-2 align-items-center flex-nowrap justify-content-end flex-grow-1">
            <input class="form-control employees-toolbar-search"
                   placeholder="Поиск по ФИО"
                   @bind="_searchText" @bind:event="oninput" />
            <select class="form-select employees-toolbar-role" @bind="_roleFilter">
                <option value="">Все</option>
                @foreach (var role in RolesForEmployees)
                {
                    <option value="@role.Name">@role.Name</option>
                }
            </select>
            <button type="button" class="btn btn-primary flex-shrink-0" @onclick="OpenCreateEmployeeModal" title="Добавить сотрудника">+</button>
        </div>
    </div>
    @if (_employees is { Count: > 0 })
    {
        <table class="table">
            <thead>
                <tr>
                    <th>
                        <span class="employees-table-th">
                            <span>ФИО</span>
                            <HugeIcon Name="user-03" CssClass="employees-th-icon" />
                        </span>
                    </th>
                    <th>
                        <span class="employees-table-th">
                            <span>Должность</span>
                            <HugeIcon Name="briefcase-01" CssClass="employees-th-icon" />
                        </span>
                    </th>
                    <th>
                        <span class="employees-table-th">
                            <span>Почта</span>
                            <HugeIcon Name="mail-01" CssClass="employees-th-icon" />
                        </span>
                    </th>
                    <th>
                        <span class="employees-table-th">
                            <span>Создан</span>
                            <HugeIcon Name="calendar-03" CssClass="employees-th-icon" />
                        </span>
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in _employees.Where(FilterEmployee))
                {
                    <tr style="cursor: pointer;" @onclick="() => OpenEmployee(e)">
                        <td>
                            <span class="status-dot @(_onlineUserIds.Contains(e.Id) ? "status-dot-online" : "status-dot-offline")"
                                  title="@(_onlineUserIds.Contains(e.Id) ? "В сети" : "Не в сети")"></span>
                            @e.FullName
                            @if (e.Id == _currentUserId)
                            {
                                <span class="text-muted ms-1">(Вы)</span>
                            }
                        </td>
                        <td>
                            <span class="employees-role-cell text-body">
                                <HugeIcon Name="@GetRoleIconName(e.Role)" CssClass="employees-role-icon" />
                                <span>@e.Role</span>
                            </span>
                        </td>
                        <td>@e.Email</td>
                        <td>@e.Created_at.ToString("dd.MM.yyyy HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-muted mb-0">Сотрудников пока нет.</p>
    }
</div>

@if (_showCreateModal)
{
    <div class="employee-modal-backdrop" @onclick="CloseCreateEmployeeModal">
        <div class="employee-modal" @onclick:stopPropagation="true">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <h2 class="h5 mb-0">Новый сотрудник</h2>
                <button type="button" class="btn-close" aria-label="Закрыть" @onclick="CloseCreateEmployeeModal"></button>
            </div>

            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Фамилия</label>
                    <input class="form-control" @bind="_fName" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Имя</label>
                    <input class="form-control" @bind="_name" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Отчество</label>
                    <input class="form-control" @bind="_patronymic" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Дата рождения</label>
                    <input type="date" class="form-control" @bind="_birthDate" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Email (логин)</label>
                    <input type="email" class="form-control" @bind="_email" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Пароль</label>
                    <input type="password" class="form-control" @bind="_password" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Должность</label>
                    <select class="form-select" @bind="_selectedRoleId">
                        <option value="0">— выберите должность —</option>
                        @foreach (var r in RolesForEmployees)
                        {
                            <option value="@r.Id">@r.Name</option>
                        }
                    </select>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="alert alert-danger mt-3">@_error</div>
            }
            @if (!string.IsNullOrEmpty(_success))
            {
                <div class="alert alert-success mt-3">@_success</div>
            }

            <div class="d-flex justify-content-end gap-2 mt-3">
                <button type="button" class="btn btn-outline-secondary" @onclick="CloseCreateEmployeeModal">Отмена</button>
                <button class="btn btn-primary dms-btn-primary" disabled="@_saving" @onclick="SaveEmployee">
                    @(_saving ? "Сохраняем..." : "Создать сотрудника")
                </button>
            </div>
        </div>
    </div>
}

@if (_selectedEmployee is not null)
{
    <div class="employee-modal-backdrop" @onclick="CloseEmployee">
        <div class="employee-modal employee-modal--employee-detail" @onclick:stopPropagation="true">
            <div class="employee-detail-header d-flex justify-content-between align-items-start">
                <h2 class="h5 mb-0">Карточка сотрудника</h2>
                <button type="button" class="btn-close" aria-label="Закрыть" @onclick="CloseEmployee"></button>
            </div>

            <div class="employee-detail-body">
                <div class="employee-detail-avatar-wrap">
                    <img src="@_avatarSrc"
                         alt="Аватар"
                         class="employee-detail-avatar"
                         @onerror="OnAvatarError" />
                    <div class="employee-detail-avatar-actions">
                        <button type="button" class="btn btn-primary btn-sm employee-detail-btn text-white" @onclick="GoToChatAsync">
                            <HugeIcon Name="message-01" CssClass="employee-detail-btn-icon" /> Написать
                        </button>
                    </div>
                </div>
                <div class="employee-detail-fields">
                    <div class="employee-detail-row">
                        <div class="employee-detail-row-text">
                            <span class="employee-detail-label">ФИО</span>
                            <span class="employee-detail-value">@_selectedEmployee.FullName</span>
                        </div>
                        <HugeIcon Name="user-03" CssClass="employee-detail-row-icon" />
                    </div>
                    <div class="employee-detail-row">
                        <div class="employee-detail-row-text">
                            <span class="employee-detail-label">Должность</span>
                            <span class="employee-detail-value">@_selectedEmployee.Role</span>
                        </div>
                        <HugeIcon Name="@GetRoleIconName(_selectedEmployee.Role)" CssClass="employee-detail-row-icon" />
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_selectedEmployee.Email))
                    {
                        <div class="employee-detail-row">
                            <div class="employee-detail-row-text">
                                <span class="employee-detail-label">Почта</span>
                                <span class="employee-detail-value">@_selectedEmployee.Email</span>
                            </div>
                            <HugeIcon Name="mail-01" CssClass="employee-detail-row-icon" />
                        </div>
                    }
                    <div class="employee-detail-row">
                        <div class="employee-detail-row-text">
                            <span class="employee-detail-label">Создан</span>
                            <span class="employee-detail-value">@_selectedEmployee.Created_at.ToString("dd.MM.yyyy HH:mm")</span>
                        </div>
                        <HugeIcon Name="calendar-03" CssClass="employee-detail-row-icon" />
                    </div>
                    <div class="employee-detail-info-actions">
                        @if (_selectedEmployee.Id != _currentUserId)
                        {
                            @if (CanPromoteToLogistician(_selectedEmployee))
                            {
                                <button type="button" class="btn btn-info btn-sm employee-detail-btn text-white" @onclick="PromoteToLogisticianAsync">
                                    <HugeIcon Name="package-moving" CssClass="employee-detail-btn-icon" /> Сделать логистом
                                </button>
                            }
                            @if (CanDemoteToCourier(_selectedEmployee))
                            {
                                <button type="button" class="btn btn-warning btn-sm employee-detail-btn text-dark" @onclick="DemoteToCourierAsync">
                                    <HugeIcon Name="delivery-truck-01" CssClass="employee-detail-btn-icon" /> Сделать курьером
                                </button>
                            }
                            <button type="button" class="btn btn-danger btn-sm employee-detail-btn text-white" @onclick="FireSelectedEmployeeAsync">
                                <HugeIcon Name="delete-02" CssClass="employee-detail-btn-icon" /> Уволить
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<EmployeeDto> _employees = new();
    private List<RolesApiService.RoleDto> _roles = new();
    private int _companyId;
    private int? _currentUserId;
    private EmployeeDto? _selectedEmployee;
    private string _avatarSrc = "/favicon.png";
    private long _avatarVersion = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
    private bool _avatarFallback;

    private string _fName = "";
    private string _name = "";
    private string? _patronymic;
    private DateTime? _birthDate;
    private string _email = "";
    private string _password = "";
    private int _selectedRoleId;
    private bool _saving;
    private string? _error;
    private string? _success;
    private string _searchText = string.Empty;
    private string _roleFilter = string.Empty;
    private HashSet<int> _onlineUserIds = new();
    private IDisposable? _presenceHubSubscription;
    private bool _hubConnected;
    private int _courierRoleId;
    private int _logisticRoleId;
    private bool _showCreateModal;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = state.User;

        var userIdStr = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (int.TryParse(userIdStr, out var uid))
        {
            _currentUserId = uid;
        }
        var companyIdStr = user.FindFirst("companyId")?.Value;
        if (!int.TryParse(companyIdStr, out _companyId))
        {
            _error = "Не удалось определить компанию пользователя.";
            StateHasChanged();
            return;
        }

        _roles = await RolesApi.GetAllAsync();
        _courierRoleId = _roles.FirstOrDefault(r => string.Equals(r.Name, "Курьер", StringComparison.OrdinalIgnoreCase))?.Id ?? 0;
        _logisticRoleId = _roles.FirstOrDefault(r => string.Equals(r.Name, "Логист", StringComparison.OrdinalIgnoreCase))?.Id ?? 0;
        await LoadEmployees();
        await LoadPresenceAsync();
        await StartPresenceSignalRAsync();
        StateHasChanged();
    }

    private async Task StartPresenceSignalRAsync()
    {
        try
        {
            var conn = await ChatHub.GetConnectionAsync();
            await ChatHub.StartAsync();
            _hubConnected = conn.State == HubConnectionState.Connected;
            _presenceHubSubscription = conn.On<UserPresenceChangedDto>("UserPresenceChanged", payload =>
            {
                return InvokeAsync(() =>
                {
                    if (payload.Online)
                        _onlineUserIds.Add(payload.UserId);
                    else
                        _onlineUserIds.Remove(payload.UserId);
                    StateHasChanged();
                });
            });
        }
        catch
        {
            _hubConnected = false;
        }
    }

    private async Task LoadEmployees()
    {
        _employees = await EmployeesApi.GetByCompanyAsync(_companyId);
    }

    private async Task LoadPresenceAsync()
    {
        _onlineUserIds = await PresenceApi.GetOnlineUserIdsAsync(_companyId);
    }

    private async Task SaveEmployee()
    {
        _error = null;
        _success = null;

        if (string.IsNullOrWhiteSpace(_fName))
        {
            _error = "Введите фамилию.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_name))
        {
            _error = "Введите имя.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_email) || string.IsNullOrWhiteSpace(_password))
        {
            _error = "Введите email и пароль.";
            return;
        }
        if (!IsValidEmail(_email))
        {
            _error = "Введите корректный email.";
            return;
        }
        if (_password.Length < 6)
        {
            _error = "Пароль должен быть не короче 6 символов.";
            return;
        }
        if (_selectedRoleId == 0)
        {
            _error = "Выберите роль.";
            return;
        }

        var dto = new CreateEmployeeRequestDto
        {
            FName = _fName.Trim(),
            Name = _name.Trim(),
            Patronymic = string.IsNullOrWhiteSpace(_patronymic) ? null : _patronymic.Trim(),
            BirthDate = _birthDate,
            Email = _email.Trim(),
            Password = _password,
            RoleId = _selectedRoleId
        };

        _saving = true;
        try
        {
            var ok = await EmployeesApi.CreateAsync(dto, _companyId);
            if (ok)
            {
                _success = "Сотрудник создан.";
                await LoadEmployees();
                Notify.ShowSuccess("Сотрудник создан.");
                // очистка формы
                _fName = _name = _email = _password = "";
                _patronymic = null;
                _birthDate = null;
                _selectedRoleId = 0;
                _showCreateModal = false;
            }
            else
            {
                _error = "Не удалось создать сотрудника.";
                Notify.ShowError(_error);
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            Notify.ShowError(_error);
        }
        finally
        {
            _saving = false;
        }
    }

    private static bool IsValidEmail(string email)
    {
        try
        {
            var addr = new System.Net.Mail.MailAddress(email);
            return addr.Address == email;
        }
        catch
        {
            return false;
        }
    }

    /// <summary>Роли, доступные для сотрудников (без «Клиент»).</summary>
    private IEnumerable<RolesApiService.RoleDto> RolesForEmployees =>
        _roles.Where(r => !IsClientRole(r.Name));

    private static bool IsClientRole(string? name) =>
        string.Equals(name?.Trim(), "Клиент", StringComparison.OrdinalIgnoreCase);

    private bool FilterEmployee(EmployeeDto e)
    {
        var byName = string.IsNullOrWhiteSpace(_searchText)
            || (e.FullName ?? string.Empty).ToLowerInvariant().Contains(_searchText.Trim().ToLowerInvariant());
        var byRole = string.IsNullOrWhiteSpace(_roleFilter)
            || string.Equals(e.Role?.Trim(), _roleFilter.Trim(), StringComparison.OrdinalIgnoreCase);
        return byName && byRole;
    }

    private void OpenCreateEmployeeModal()
    {
        _error = null;
        _success = null;
        _showCreateModal = true;
    }

    private void CloseCreateEmployeeModal()
    {
        _showCreateModal = false;
    }

    private void OpenEmployee(EmployeeDto e)
    {
        _selectedEmployee = e;
        _avatarFallback = false;
        _avatarVersion = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        _avatarSrc = BuildAvatarApiUrl(e.Id);
    }

    // Аватар: абсолютный URL на API (как AuthorizedClient). Пустой ApiBaseUrl — тот же дефолт, что в Program.cs.
    private string BuildAvatarApiUrl(int userId)
    {
        var raw = Configuration["ApiBaseUrl"];
        var apiBase = string.IsNullOrWhiteSpace(raw) ? "http://localhost:5220" : raw.TrimEnd('/');
        var q = $"v={_avatarVersion}";
        return $"{apiBase}/api/Files/avatar/{userId}?{q}";
    }

    private void OnAvatarError()
    {
        if (_avatarFallback)
            return;
        _avatarFallback = true;
        _avatarSrc = "/favicon.png";
        StateHasChanged();
    }

    private async Task GoToChatAsync()
    {
        if (_selectedEmployee is null)
            return;

        var peerUserId = _selectedEmployee.Id;
        // #region agent log
        AppendDebugLog("run1", "H1", "Employees.razor:GoToChatAsync:start", "GoToChatAsync invoked", new
        {
            peerUserId,
            selectedEmployeeId = _selectedEmployee?.Id,
            currentUserId = _currentUserId
        });
        // #endregion
        if (peerUserId <= 0)
        {
            Notify.ShowError("Некорректный идентификатор сотрудника для чата.");
            return;
        }

        // Сначала пытаемся получить/создать ЛС сразу, чтобы открыть конкретный room, а не общий чат.
        var direct = await ChatApi.CreateOrGetDirectRoomAsync(peerUserId);
        // #region agent log
        AppendDebugLog("run1", "H1", "Employees.razor:GoToChatAsync:createOrGetResult", "CreateOrGetDirectRoomAsync result", new
        {
            peerUserId,
            ok = direct.ok,
            roomId = direct.roomId
        });
        // #endregion
        if (direct.ok && direct.roomId > 0)
        {
            Navigation.NavigateTo($"/manager/chat?roomId={direct.roomId}");
            return;
        }

        // Фолбэк на старый путь через userId.
        Navigation.NavigateTo($"/manager/chat?userId={peerUserId}");
    }

    // #region agent log
    private static void AppendDebugLog(string runId, string hypothesisId, string location, string message, object data)
    {
        try
        {
            var line = System.Text.Json.JsonSerializer.Serialize(new
            {
                sessionId = "7b40bb",
                runId,
                hypothesisId,
                location,
                message,
                data,
                timestamp = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()
            });
            System.IO.File.AppendAllText(@"c:\Users\zarip\source\repos\DeliveryCRM\debug-7b40bb.log", line + Environment.NewLine);
        }
        catch { }
    }
    // #endregion

    private bool CanDemoteToCourier(EmployeeDto employee)
        => _courierRoleId > 0 && employee.Role.Contains("логист", StringComparison.OrdinalIgnoreCase);

    private bool CanPromoteToLogistician(EmployeeDto employee)
        => _logisticRoleId > 0 && employee.Role.Contains("курьер", StringComparison.OrdinalIgnoreCase);

    private async Task DemoteToCourierAsync()
    {
        if (_selectedEmployee is null || _courierRoleId <= 0)
            return;
        var (ok, error) = await EmployeesApi.ChangeRoleAsync(_selectedEmployee.Id, _companyId, _courierRoleId);
        if (!ok)
        {
            Notify.ShowError($"Не удалось изменить роль: {error}");
            return;
        }

        Notify.ShowSuccess("Роль изменена на Курьер.");
        await LoadEmployees();
        _selectedEmployee = _employees.FirstOrDefault(e => e.Id == _selectedEmployee.Id);
        StateHasChanged();
    }

    private async Task PromoteToLogisticianAsync()
    {
        if (_selectedEmployee is null || _logisticRoleId <= 0)
            return;
        var (ok, error) = await EmployeesApi.ChangeRoleAsync(_selectedEmployee.Id, _companyId, _logisticRoleId);
        if (!ok)
        {
            Notify.ShowError($"Не удалось изменить роль: {error}");
            return;
        }

        Notify.ShowSuccess("Роль изменена на Логист.");
        await LoadEmployees();
        _selectedEmployee = _employees.FirstOrDefault(e => e.Id == _selectedEmployee.Id);
        StateHasChanged();
    }

    private void CloseEmployee()
    {
        _selectedEmployee = null;
    }

    private async Task FireSelectedEmployeeAsync()
    {
        if (_selectedEmployee is null)
            return;
        var targetId = _selectedEmployee.Id;
        var ok = await EmployeesApi.FireAsync(targetId, _companyId);
        if (!ok)
        {
            Notify.ShowError("Не удалось уволить сотрудника.");
            return;
        }

        Notify.ShowSuccess("Сотрудник уволен и скрыт из активного списка.");
        CloseEmployee();
        await LoadEmployees();
        StateHasChanged();
    }

    private static string GetRoleIconName(string? role)
    {
        var r = (role ?? string.Empty).ToLowerInvariant();
        if (r.Contains("менедж"))
            return "manager";
        if (r.Contains("логист"))
            return "package-moving";
        if (r.Contains("курьер"))
            return "delivery-truck-01";
        if (r.Contains("админ"))
            return "settings-01";
        return "briefcase-01";
    }

    public void Dispose()
    {
        _presenceHubSubscription?.Dispose();
    }
}

<style>
    .employees-toolbar {
        min-width: 0;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    .employees-toolbar-search {
        flex: 1 1 140px;
        min-width: 120px;
        max-width: 280px;
    }

    .employees-toolbar-role {
        flex: 0 0 auto;
        width: auto;
        min-width: 160px;
        max-width: 220px;
    }

    .employees-table-th {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        white-space: nowrap;
    }

    .employees-th-icon,
    .employees-role-icon {
        width: 1.125rem;
        height: 1.125rem;
        flex-shrink: 0;
        opacity: 0.9;
    }

    .employees-role-cell {
        display: inline-flex;
        align-items: center;
        gap: 0.35em;
    }

    .employee-modal--employee-detail .employee-detail-body {
        align-items: stretch;
    }

    .employee-modal--employee-detail .employee-detail-avatar-wrap,
    .employee-modal--employee-detail .employee-detail-fields {
        display: flex;
        flex-direction: column;
    }

    .employee-detail-avatar-actions,
    .employee-detail-info-actions {
        margin-top: auto;
        padding-top: 0.35rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        align-items: center;
    }
</style>

