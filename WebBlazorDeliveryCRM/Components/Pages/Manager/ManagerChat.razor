@page "/manager/chat"
@layout ManagerLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Менеджер,Администратор,Админ")]
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web

<PageTitle>Чат — Менеджер</PageTitle>

<CompanyChatPanel TargetUserId="@UserId" TargetRoomId="@RoomId" />

@code {
    [SupplyParameterFromQuery(Name = "userId")]
    public int? UserId { get; set; }

    [SupplyParameterFromQuery(Name = "roomId")]
    public int? RoomId { get; set; }
}
