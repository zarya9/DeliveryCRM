@page "/manager/analytics"
@layout ManagerLayout
@attribute [Authorize(Roles = "Менеджер,Администратор,Админ")]
@using ApexCharts
@using Microsoft.AspNetCore.Authorization
@using WebBlazorDeliveryCRM.Models
@using WebBlazorDeliveryCRM.Services
@using WebBlazorDeliveryCRM.Components.Shared
@inject ReportsApiService ReportsApi
@inject CompanySettingsApiService CompanySettingsApi
@inject AppNotificationService Notify
@inject IJSRuntime JS
@using Microsoft.JSInterop

<PageTitle>Аналитика — Менеджер</PageTitle>

<div class="dms-page-header">
    <h1>Аналитика и отчётность</h1>
    <p class="subtitle">Глубокая аналитика и финансы</p>
</div>

<div class="dms-card mb-3">
    <h2 class="dms-card-title">Период отчёта</h2>
    <div class="row g-2 align-items-end flex-wrap">
        <div class="col-md-3">
            <label class="form-label">С даты (UTC)</label>
            <input class="form-control" type="date" @bind="_periodFrom" @bind:format="yyyy-MM-dd" />
        </div>
        <div class="col-md-3">
            <label class="form-label">По дату (UTC)</label>
            <input class="form-control" type="date" @bind="_periodTo" @bind:format="yyyy-MM-dd" />
        </div>
        <div class="col-md-3">
            <button type="button" class="btn btn-primary" disabled="@_loading" @onclick="ApplyPeriodAsync">
                @(_loading ? "Загрузка…" : "Обновить")
            </button>
            <button type="button" class="btn btn-outline-secondary ms-1" disabled="@_loading" @onclick="ResetPeriodAsync">Текущий месяц</button>
        </div>
        <div class="col-md-3">
            <button type="button" class="btn btn-outline-success" disabled="@_exporting" @onclick="ExportExcelAsync">
                @(_exporting ? "Формирую…" : "Скачать Excel")
            </button>
            <button type="button" class="btn btn-outline-danger ms-1" disabled="@_exportingPdf" @onclick="ExportPdfAsync">
                @(_exportingPdf ? "Формирую…" : "Скачать PDF")
            </button>
        </div>
    </div>
    <div class="small text-muted mt-2">
        Кнопка «Обновить» пересчитывает KPI и график за выбранные даты. Скачать файл — «Excel» или «PDF» справа.<br />
        Фактический период в данных: <strong>@_data.PeriodFromUtc.ToString("dd.MM.yyyy HH:mm")</strong> —
        <strong>@_data.PeriodToUtc.ToString("dd.MM.yyyy HH:mm")</strong> (UTC).
        @if (_lastLoadedUtc.HasValue)
        {
            <span> · обновлено @_lastLoadedUtc.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
        }
    </div>
</div>

<div class="dms-card">
    <h2 class="dms-card-title">SLA настройки компании</h2>
    <div class="row g-3 align-items-end sla-settings-row">
        <div class="col-12 col-md-4 col-lg-3">
            <label class="form-label">Вовремя (часы)</label>
            <input class="form-control" type="number" min="1" max="168" @bind="_slaOnTimeHours" />
        </div>
        <div class="col-12 col-md-4 col-lg-3">
            <label class="form-label">Критичное опоздание (часы)</label>
            <input class="form-control" type="number" min="1" max="720" @bind="_slaLateHours" />
        </div>
        <div class="col-12 col-md-auto">
            <button type="button" class="btn btn-primary dms-btn-primary" @onclick="SaveSlaAsync">Сохранить SLA</button>
        </div>
    </div>
    <div class="small text-muted mt-2">
        KPI «вовремя» по доставкам за период: порог <strong>@_data.SlaOnTimeHours ч</strong>.
        «Опоздания %»: дольше <strong>@_data.SlaLateHours ч</strong> от создания заказа до доставки.
    </div>
</div>

<div class="dms-stat-grid">
    <div class="dms-stat-card">
        <div class="dms-stat-value">@_data.OrdersCreatedInPeriod</div>
        <div class="dms-stat-label">Заказов создано (период)</div>
    </div>
    <div class="dms-stat-card">
        <div class="dms-stat-value">@_data.RevenueDeliveredInPeriod.ToString("N0")</div>
        <div class="dms-stat-label">Выручка (доставлено, период)</div>
    </div>
    <div class="dms-stat-card">
        <div class="dms-stat-value">@_data.OnTimePercent.ToString("0")@("%")</div>
        <div class="dms-stat-label">Вовремя (SLA)</div>
    </div>
    <div class="dms-stat-card">
        <div class="dms-stat-value">@_data.LatePercent.ToString("0")@("%")</div>
        <div class="dms-stat-label">Опоздания</div>
    </div>
    <div class="dms-stat-card">
        <div class="dms-stat-value">@_data.AvgDeliveryHours.ToString("0.0")</div>
        <div class="dms-stat-label">Среднее время доставки, ч</div>
    </div>
    <div class="dms-stat-card">
        <div class="dms-stat-value">@_data.PaidDeliveredCount</div>
        <div class="dms-stat-label">Оплаченных доставок</div>
    </div>
    <div class="dms-stat-card">
        <div class="dms-stat-value">@_data.PaidSharePercent.ToString("0.0")@("%")</div>
        <div class="dms-stat-label">Доля оплаченных доставок</div>
    </div>
    <div class="dms-stat-card">
        <div class="dms-stat-value">@_data.EstimatedFuelSavedLiters.ToString("0.0")</div>
        <div class="dms-stat-label">Экономия топлива, л (оценка)</div>
    </div>
    <div class="dms-stat-card">
        <div class="dms-stat-value">@_data.EstimatedFuelSavingsPercent.ToString("0.0")@("%")</div>
        <div class="dms-stat-label">Экономия топлива, %</div>
    </div>
</div>

@if (_data.LatePercent >= 20)
{
    <div class="alert alert-danger mt-3">
        <strong>Внимание:</strong> доля опозданий @(_data.LatePercent.ToString("0.0"))% превышает порог 20%.
        Рекомендуется проверить загрузку курьеров, геозоны и SLA-настройки.
    </div>
}
else if (_data.LatePercent >= 10)
{
    <div class="alert alert-warning mt-3">
        Доля опозданий @(_data.LatePercent.ToString("0.0"))% выше целевого уровня.
    </div>
}

<div class="dms-card dms-finance-card mb-3">
    <div class="dms-report-card-header">
        <HugeIcon Name="wallet-01" CssClass="dms-report-card-icon" />
        <div>
            <h2 class="dms-card-title mb-0">Финансы</h2>
            <p class="small text-muted mb-0">Выручка и заказы по дням за выбранный период</p>
        </div>
    </div>
    @if (_loading && !_dailyChartItems.Any())
    {
        <p class="text-muted mb-0">Загрузка данных…</p>
    }
    else if (_dailyChartItems.Any(x => x.Count > 0 || x.Revenue > 0))
    {
        <div class="dms-finance-chart-wrap">
            <ApexChart @key="_chartRevision" TItem="DailyChartItem" Title="Динамика по дням (период)" Height="320">
                <ApexPointSeries TItem="DailyChartItem"
                                 Name="Выручка (₽)"
                                 Items="_dailyChartItems"
                                 SeriesType="SeriesType.Bar"
                                 XValue="x => x.Day"
                                 YValue="x => (decimal)x.Revenue" />
                <ApexPointSeries TItem="DailyChartItem"
                                 Name="Заказы"
                                 Items="_dailyChartItems"
                                 SeriesType="SeriesType.Bar"
                                 XValue="x => x.Day"
                                 YValue="x => (decimal)x.Count" />
            </ApexChart>
        </div>
    }
    else
    {
        <p class="text-muted mb-3">За выбранный период нет заказов для графика.</p>
    }
    <div class="row g-3 align-items-stretch">
        <div class="col-md-4">
            <div class="dms-finance-highlight h-100">
                <HugeIcon Name="wallet-01" CssClass="dms-finance-highlight-icon" />
                <div>
                    <div class="dms-finance-highlight-label">Средний чек (доставлено)</div>
                    <div class="dms-finance-highlight-value">@_data.AvgCheckDeliveredInPeriod.ToString("N0") ₽</div>
                </div>
            </div>
        </div>
        <div class="col-md-8">
            <h3 class="h6 dms-report-subtitle mb-2">
                <HugeIcon Name="calendar-03" CssClass="hub-form-label-icon" />
                Таблица по дням
            </h3>
            @if (_data.OrdersByDay.Any())
            {
                <div class="dms-report-table-scroll">
                    <table class="table table-sm table-hover dms-report-table mb-0">
                        <thead>
                            <tr>
                                <th><span class="dms-report-th"><HugeIcon Name="calendar-03" CssClass="dms-report-th-icon" />Дата</span></th>
                                <th class="text-end"><span class="dms-report-th"><HugeIcon Name="package-moving" CssClass="dms-report-th-icon" />Заказов</span></th>
                                <th class="text-end"><span class="dms-report-th"><HugeIcon Name="wallet-01" CssClass="dms-report-th-icon" />Выручка</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _data.OrdersByDay.OrderBy(r => r.Date))
                            {
                                <tr>
                                    <td>@row.Date.ToString("dd.MM")</td>
                                    <td class="text-end">@row.Count</td>
                                    <td class="text-end">@row.Revenue.ToString("N0") ₽</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted mb-0">Недостаточно данных по заказам.</p>
            }
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-12 col-xl-6">
        <div class="dms-card dms-report-card h-100">
            <div class="dms-report-card-header">
                <HugeIcon Name="invoice-01" CssClass="dms-report-card-icon" />
                <h2 class="dms-card-title mb-0">Статусы заказов</h2>
            </div>
            @if (_data.StatusRows.Any())
            {
                <div class="dms-report-table-scroll">
                    <table class="table table-sm table-hover dms-report-table mb-0">
                        <thead>
                            <tr>
                                <th><span class="dms-report-th"><HugeIcon Name="activity-01" CssClass="dms-report-th-icon" />Статус</span></th>
                                <th class="text-end"><span class="dms-report-th"><HugeIcon Name="package-moving" CssClass="dms-report-th-icon" />Количество</span></th>
                                <th class="text-end"><span class="dms-report-th"><HugeIcon Name="analytics-up" CssClass="dms-report-th-icon" />Доля</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _data.StatusRows)
                            {
                                <tr>
                                    <td>@row.Status</td>
                                    <td class="text-end">@row.Count</td>
                                    <td class="text-end">@row.Share.ToString("0")%</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted mb-0">Нет данных по статусам.</p>
            }
        </div>
    </div>
    <div class="col-12 col-xl-6">
        <div class="dms-card dms-report-card h-100">
            <div class="dms-report-card-header">
                <HugeIcon Name="delivery-truck-01" CssClass="dms-report-card-icon" />
                <h2 class="dms-card-title mb-0">Топ курьеров по доставкам</h2>
            </div>
            @if (_data.CourierRows.Any())
            {
                <div class="dms-report-table-scroll">
                    <table class="table table-sm table-hover dms-report-table mb-0">
                        <thead>
                            <tr>
                                <th><span class="dms-report-th"><HugeIcon Name="user-03" CssClass="dms-report-th-icon" />Курьер</span></th>
                                <th class="text-end"><span class="dms-report-th"><HugeIcon Name="package-moving" CssClass="dms-report-th-icon" />Доставок</span></th>
                                <th class="text-end"><span class="dms-report-th"><HugeIcon Name="wallet-01" CssClass="dms-report-th-icon" />Выручка</span></th>
                                <th class="text-end"><span class="dms-report-th"><HugeIcon Name="activity-01" CssClass="dms-report-th-icon" />Рейтинг</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in _data.CourierRows)
                            {
                                <tr>
                                    <td>@c.Name</td>
                                    <td class="text-end">@c.Delivered</td>
                                    <td class="text-end">@c.Revenue.ToString("N0") ₽</td>
                                    <td class="text-end">@c.Rating.ToString("0.0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted mb-0">Нет данных по курьерам.</p>
            }
        </div>
    </div>
    <div class="col-12 col-xl-6">
        <div class="dms-card dms-report-card h-100">
            <div class="dms-report-card-header">
                <HugeIcon Name="user-group" CssClass="dms-report-card-icon" />
                <h2 class="dms-card-title mb-0">Топ клиентов по выручке</h2>
            </div>
            @if (_data.ClientRows.Any())
            {
                <div class="dms-report-table-scroll">
                    <table class="table table-sm table-hover dms-report-table mb-0">
                        <thead>
                            <tr>
                                <th><span class="dms-report-th"><HugeIcon Name="user-03" CssClass="dms-report-th-icon" />Клиент</span></th>
                                <th class="text-end"><span class="dms-report-th"><HugeIcon Name="invoice-01" CssClass="dms-report-th-icon" />Заказов</span></th>
                                <th class="text-end"><span class="dms-report-th"><HugeIcon Name="wallet-01" CssClass="dms-report-th-icon" />Выручка</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in _data.ClientRows)
                            {
                                <tr>
                                    <td>@c.Name</td>
                                    <td class="text-end">@c.Orders</td>
                                    <td class="text-end">@c.Revenue.ToString("N0") ₽</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted mb-0">Нет данных по клиентам.</p>
            }
        </div>
    </div>
    <div class="col-12 col-xl-6">
        <div class="dms-card dms-report-card h-100">
            <div class="dms-report-card-header">
                <HugeIcon Name="manager" CssClass="dms-report-card-icon" />
                <h2 class="dms-card-title mb-0">Эффективность менеджеров по лидам</h2>
            </div>
            @if (_data.ManagerRows.Any())
            {
                <div class="dms-report-table-scroll">
                    <table class="table table-sm table-hover dms-report-table mb-0">
                        <thead>
                            <tr>
                                <th><span class="dms-report-th"><HugeIcon Name="manager" CssClass="dms-report-th-icon" />Менеджер</span></th>
                                <th class="text-end"><span class="dms-report-th"><HugeIcon Name="package-moving" CssClass="dms-report-th-icon" />Лидов</span></th>
                                <th class="text-end"><span class="dms-report-th"><HugeIcon Name="activity-01" CssClass="dms-report-th-icon" />Конверсий</span></th>
                                <th class="text-end"><span class="dms-report-th"><HugeIcon Name="analytics-up" CssClass="dms-report-th-icon" />Конверсия</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _data.ManagerRows)
                            {
                                <tr>
                                    <td>@row.Manager</td>
                                    <td class="text-end">@row.Leads</td>
                                    <td class="text-end">@row.Conversions</td>
                                    <td class="text-end">@row.ConversionPercent.ToString("0.0")%</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted mb-0">Нет данных по лидам менеджеров.</p>
            }
        </div>
    </div>
</div>

@code {
    private FinanceDashboardDto _data = new();
    private List<DailyChartItem> _dailyChartItems = new();
    private int _slaOnTimeHours = 4;
    private int _slaLateHours = 24;
    private DateTime _periodFrom;
    private DateTime _periodTo;
    private bool _loading;
    private bool _exporting;
    private bool _exportingPdf;
    private int _chartRevision;
    private DateTime? _lastLoadedUtc;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var now = DateTime.UtcNow.Date;
        _periodFrom = new DateTime(now.Year, now.Month, 1);
        _periodTo = now;
        _loading = true;
        StateHasChanged();
        try
        {
            await ReloadAsync();
            _chartRevision++;
        }
        catch (Exception ex)
        {
            Notify.ShowError($"Не удалось загрузить аналитику: {ex.Message}");
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task ApplyPeriodAsync()
    {
        await ReloadAsync();
        StateHasChanged();
    }

    private async Task ResetPeriodAsync()
    {
        var now = DateTime.UtcNow.Date;
        _periodFrom = new DateTime(now.Year, now.Month, 1);
        _periodTo = now;
        await ReloadAsync();
        StateHasChanged();
    }

    private async Task ExportExcelAsync()
    {
        _exporting = true;
        try
        {
            var from = DateTime.SpecifyKind(_periodFrom.Date, DateTimeKind.Utc);
            var to = DateTime.SpecifyKind(_periodTo.Date, DateTimeKind.Utc);
            var bytes = await ReportsApi.GetFinanceExcelAsync(from, to);
            if (bytes == null || bytes.Length == 0)
            {
                Notify.ShowError("Не удалось сформировать отчёт. Проверьте авторизацию и доступ к API.");
                return;
            }
            var name = $"finance-report-{from:yyyy-MM-dd}-{to:yyyy-MM-dd}.xlsx";
            await using var ms = new MemoryStream(bytes);
            using var streamRef = new DotNetStreamReference(ms);
            await JS.InvokeVoidAsync("fileDownload.saveFromStream", streamRef, name,
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
            Notify.ShowSuccess("Файл готов к загрузке.");
        }
        catch (Exception ex)
        {
            Notify.ShowError(ex.Message);
        }
        finally
        {
            _exporting = false;
        }
    }

    private async Task ReloadAsync()
    {
        var settings = await CompanySettingsApi.GetSlaAsync();
        if (settings != null)
        {
            _slaOnTimeHours = settings.SlaOnTimeHours;
            _slaLateHours = settings.SlaLateHours;
        }

        var from = DateTime.SpecifyKind(_periodFrom.Date, DateTimeKind.Utc);
        var to = DateTime.SpecifyKind(_periodTo.Date, DateTimeKind.Utc);
        var loaded = await ReportsApi.GetFinanceDashboardAsync(from, to);
        if (loaded == null)
            throw new InvalidOperationException("API не вернул данные. Проверьте вход и что API запущен.");

        _data = loaded;
        _dailyChartItems = _data.OrdersByDay
            .OrderBy(x => x.Date)
            .Select(x => new DailyChartItem
            {
                Day = x.Date.ToString("dd.MM.yyyy"),
                Revenue = (double)x.Revenue,
                Count = x.Count
            })
            .ToList();
        _lastLoadedUtc = DateTime.UtcNow;
    }

    private async Task ExportPdfAsync()
    {
        _exportingPdf = true;
        try
        {
            var from = DateTime.SpecifyKind(_periodFrom.Date, DateTimeKind.Utc);
            var to = DateTime.SpecifyKind(_periodTo.Date, DateTimeKind.Utc);
            var bytes = await ReportsApi.GetFinancePdfAsync(from, to);
            if (bytes == null || bytes.Length == 0)
            {
                Notify.ShowError("Не удалось сформировать PDF отчёт.");
                return;
            }
            var name = $"finance-report-{from:yyyy-MM-dd}-{to:yyyy-MM-dd}.pdf";
            await using var ms = new MemoryStream(bytes);
            using var streamRef = new DotNetStreamReference(ms);
            await JS.InvokeVoidAsync("fileDownload.saveFromStream", streamRef, name, "application/pdf");
            Notify.ShowSuccess("PDF готов к загрузке.");
        }
        catch (Exception ex)
        {
            Notify.ShowError(ex.Message);
        }
        finally
        {
            _exportingPdf = false;
        }
    }

    private async Task SaveSlaAsync()
    {
        var updated = await CompanySettingsApi.UpdateSlaAsync(new UpdateCompanySlaSettingsDto
        {
            SlaOnTimeHours = _slaOnTimeHours,
            SlaLateHours = _slaLateHours
        });
        if (updated == null)
        {
            Notify.ShowError("Не удалось обновить SLA настройки.");
            return;
        }
        _slaOnTimeHours = updated.SlaOnTimeHours;
        _slaLateHours = updated.SlaLateHours;
        await ReloadAsync();
        Notify.ShowSuccess("SLA настройки обновлены.");
    }

    private sealed class DailyChartItem
    {
        public string Day { get; set; } = string.Empty;
        public double Revenue { get; set; }
        public int Count { get; set; }
    }
}
