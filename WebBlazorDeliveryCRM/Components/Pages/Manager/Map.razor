@page "/manager/map"
@layout ManagerLayout
@using WebBlazorDeliveryCRM.Models
@using WebBlazorDeliveryCRM.Services
@inject CouriersApiService CouriersApi
@inject IJSRuntime JS

<PageTitle>Карта — Менеджер</PageTitle>

<div class="dms-page-header">
    <h1>Карта курьеров</h1>
    <p class="subtitle">Наблюдение за курьерами и заказами на карте</p>
</div>

<div class="dms-card mb-3">
    <h2 class="dms-card-title">Курьеры на карте</h2>
    <p class="text-muted">Позиции курьеров по данным из API.</p>
    <div id="manager-map" style="height: 480px; width: 100%; border-radius: 8px;"></div>
</div>

<div class="dms-card">
    <h2 class="dms-card-title">Список курьеров</h2>
    @if (_couriers?.Count > 0)
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Курьер</th>
                    <th>Рейтинг</th>
                    <th>Статус</th>
                    <th>Онлайн</th>
                    <th>Координаты</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in _couriers)
                {
                    <tr>
                        <td>@(c.User?.FName) @(c.User?.Name)</td>
                        <td>@c.Rating</td>
                        <td>@(c.CourierStatus?.Name ?? "—")</td>
                        <td>@(c.Is_online ? "Да" : "Нет")</td>
                        <td>@c.Current_lat.ToString("0.00"), @c.Current_lon.ToString("0.00")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-muted">Нет данных о курьерах.</p>
    }
</div>

@code {
    private List<CourierProfileDto>? _couriers;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _couriers = await CouriersApi.GetAllAsync(null);
        StateHasChanged();

        if (_couriers != null)
        {
            var markers = _couriers
                .Where(c => c.Current_lat != 0 || c.Current_lon != 0)
                .Select(c => new { lat = (double)c.Current_lat, lon = (double)c.Current_lon, title = $"{c.User?.FName} {c.User?.Name} — {c.CourierStatus?.Name}" })
                .ToList();
            try
            {
                await JS.InvokeVoidAsync("leafletMap.init", "manager-map", 55.7558, 37.6173, 10);
                await JS.InvokeVoidAsync("leafletMap.setMarkers", markers);
            }
            catch
            {
                // карта может не инициализироваться при пререндеринге
            }
        }
    }
}

