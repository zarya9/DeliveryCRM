@page "/manager/leads"
@layout ManagerLayout
@using System.Security.Claims
@using WebBlazorDeliveryCRM.Components.Shared
@using WebBlazorDeliveryCRM.Services
@using static WebBlazorDeliveryCRM.Services.LeadsApiService
@inject LeadsApiService LeadsApi
@inject AuthenticationStateProvider AuthStateProvider
@inject AppNotificationService Notify

<PageTitle>Лиды — Менеджер</PageTitle>

<div class="dms-page-header">
    <h1>Лиды и воронка продаж</h1>
    <p class="subtitle">Потенциальные клиенты и статусы по воронке</p>
</div>

<div class="row g-3 mb-3">
    <div class="col-lg-8">
        <div class="dms-card h-100">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h2 class="dms-card-title">Лиды компании</h2>
            </div>

            @if (_leads.Count == 0)
            {
                <p class="text-muted mb-0">Лидов пока нет.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle leads-table">
                        <thead>
                            <tr>
                                <th>
                                    <span class="leads-table-th">
                                        <span>Название</span>
                                        <HugeIcon Name="package-moving" CssClass="leads-th-icon" />
                                    </span>
                                </th>
                                <th>
                                    <span class="leads-table-th">
                                        <span>Контакт</span>
                                        <HugeIcon Name="mail-01" CssClass="leads-th-icon" />
                                    </span>
                                </th>
                                <th>
                                    <span class="leads-table-th">
                                        <span>Источник</span>
                                        <HugeIcon Name="route-02" CssClass="leads-th-icon" />
                                    </span>
                                </th>
                                <th>
                                    <span class="leads-table-th">
                                        <span>Стадия</span>
                                        <HugeIcon Name="activity-01" CssClass="leads-th-icon" />
                                    </span>
                                </th>
                                <th>
                                    <span class="leads-table-th">
                                        <span>Ответственный</span>
                                        <HugeIcon Name="user-03" CssClass="leads-th-icon" />
                                    </span>
                                </th>
                                <th>
                                    <span class="leads-table-th">
                                        <span>Создан</span>
                                        <HugeIcon Name="calendar-03" CssClass="leads-th-icon" />
                                    </span>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var l in _leads)
                            {
                                <tr style="cursor: pointer;" @onclick="() => OpenLead(l)">
                                    <td>@l.Name</td>
                                    <td>@l.Contact</td>
                                    <td>@l.Source</td>
                                    <td><StatusBadge Text="@l.Stage" Tone="@GetLeadStageTone(l.Stage)" /></td>
                                    <td>@(string.IsNullOrWhiteSpace(l.ManagerName) ? "—" : l.ManagerName)</td>
                                    <td>@l.CreatedAt.ToString("dd.MM.yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
    <div class="col-lg-4">
        <div class="dms-card h-100">
            <h2 class="dms-card-title">Новый лид</h2>

            <div class="mb-2">
                <label class="form-label">Название лида</label>
                <input class="form-control" @bind="_newName" />
            </div>
            <div class="mb-2">
                <label class="form-label">Контакт (телефон / email)</label>
                <input class="form-control" @bind="_newContact" />
            </div>
            <div class="mb-2">
                <label class="form-label">Источник</label>
                <select class="form-select" @bind="_selectedSourceId">
                    <option value="0">— выберите источник —</option>
                    @foreach (var s in _meta?.Sources ?? new List<LeadsApiService.IdNameDto>())
                    {
                        <option value="@s.Id">@s.Name</option>
                    }
                </select>
            </div>
            <div class="mb-2">
                <label class="form-label">Стадия</label>
                <select class="form-select" @bind="_selectedStageId">
                    <option value="0">— выберите стадию —</option>
                    @foreach (var s in _meta?.Stages ?? new List<LeadsApiService.IdNameDto>())
                    {
                        <option value="@s.Id">@s.Name</option>
                    }
                </select>
            </div>
            <div class="mb-2">
                <label class="form-label">Комментарий</label>
                <textarea class="form-control" rows="3" @bind="_newComment"></textarea>
            </div>

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="alert alert-danger mt-2">@_error</div>
            }

            <button class="btn btn-primary dms-btn-primary mt-2"
                    type="button"
                    disabled="@_saving"
                    @onclick="SaveLead">
                @(_saving ? "Сохраняем..." : "Создать лид")
            </button>
        </div>
    </div>
</div>

@if (_selectedLead is not null)
{
    <div class="employee-modal-backdrop" @onclick="CloseLead">
        <div class="employee-modal lead-detail-modal" @onclick:stopPropagation="true">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <button type="button" class="btn-close" aria-label="Закрыть" @onclick="CloseLead"></button>
            </div>
            @if (_leadEditMode)
            {
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Название</label>
                        <input class="form-control" @bind="_editLeadName" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Контакт</label>
                        <input class="form-control" @bind="_editLeadContact" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Источник</label>
                        <select class="form-select" @bind="_editLeadSourceId">
                            <option value="0">— выберите источник —</option>
                            @foreach (var s in _meta?.Sources ?? new List<LeadsApiService.IdNameDto>())
                            {
                                <option value="@s.Id">@s.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Стадия</label>
                        <select class="form-select" @bind="_editLeadStageId">
                            <option value="0">— выберите стадию —</option>
                            @foreach (var s in _meta?.Stages ?? new List<LeadsApiService.IdNameDto>())
                            {
                                <option value="@s.Id">@s.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Комментарий</label>
                        <textarea class="form-control" rows="3" @bind="_editLeadComment"></textarea>
                    </div>
                </div>
                <div class="d-flex justify-content-end gap-2 mt-3">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CancelEditLead">Отмена</button>
                    <button type="button" class="btn btn-primary dms-btn-primary" @onclick="SaveLeadChangesAsync" disabled="@_saving">
                        @(_saving ? "Сохраняем..." : "Сохранить")
                    </button>
                </div>
            }
            else
            {
                <div class="lead-detail-row">
                    <HugeIcon Name="package-moving" CssClass="lead-detail-icon" />
                    <p class="mb-0"><strong>Название:</strong> @_selectedLead.Name</p>
                </div>
                <div class="lead-detail-row">
                    <HugeIcon Name="mail-01" CssClass="lead-detail-icon" />
                    <p class="mb-0"><strong>Контакт:</strong> @(string.IsNullOrWhiteSpace(_selectedLead.Contact) ? "—" : _selectedLead.Contact)</p>
                </div>
                <div class="lead-detail-row">
                    <HugeIcon Name="route-02" CssClass="lead-detail-icon" />
                    <p class="mb-0"><strong>Источник:</strong> @_selectedLead.Source</p>
                </div>
                <div class="lead-detail-row">
                    <HugeIcon Name="activity-01" CssClass="lead-detail-icon" />
                    <p class="mb-0"><strong>Стадия:</strong> <StatusBadge Text="@_selectedLead.Stage" Tone="@GetLeadStageTone(_selectedLead.Stage)" /></p>
                </div>
                <div class="lead-detail-row">
                    <HugeIcon Name="user-03" CssClass="lead-detail-icon" />
                    <p class="mb-0"><strong>Ответственный:</strong> @(string.IsNullOrWhiteSpace(_selectedLead.ManagerName) ? "—" : _selectedLead.ManagerName)</p>
                </div>
                <div class="lead-detail-row">
                    <HugeIcon Name="calendar-03" CssClass="lead-detail-icon" />
                    <p class="mb-0"><strong>Создан:</strong> @_selectedLead.CreatedAt.ToString("dd.MM.yyyy HH:mm")</p>
                </div>
                @if (!string.IsNullOrWhiteSpace(_selectedLead.Comment))
                {
                    <div class="lead-detail-row lead-detail-row-comment">
                        <HugeIcon Name="message-01" CssClass="lead-detail-icon" />
                        <div>
                            <p class="mb-0"><strong>Комментарий:</strong></p>
                            <p class="text-muted mb-0 mt-1" style="white-space: pre-wrap;">@_selectedLead.Comment</p>
                        </div>
                    </div>
                }
                <div class="d-flex justify-content-end gap-2 mt-3">
                    <button type="button" class="btn btn-outline-secondary d-inline-flex align-items-center gap-1" @onclick="StartEditLead">
                        <HugeIcon Name="edit-01" CssClass="dms-icon-sm" />
                        <span>Редактировать</span>
                    </button>
                    <button type="button" class="btn btn-danger d-inline-flex align-items-center gap-1" @onclick="DeleteLeadAsync">
                        <HugeIcon Name="delete-02" CssClass="dms-icon-sm" />
                        <span>Удалить</span>
                    </button>
                </div>
            }
        </div>
    </div>
}

<div class="dms-card">
    <h2 class="dms-card-title">Воронка по стадиям</h2>

    @if (_leads.Count == 0)
    {
        <p class="text-muted mb-0">Для построения воронки нужны лиды.</p>
    }
    else if (_meta is null)
    {
        <p class="text-muted mb-0">Загрузка данных по стадиям…</p>
    }
    else
    {
        <div class="d-flex flex-wrap gap-2">
            @foreach (var stage in _meta.Stages.OrderBy(s => s.Id))
            {
                var count = _leads.Count(l => l.Stage == stage.Name);
                <div class="p-2 border rounded-3" style="min-width: 140px;">
                    <div class="fw-semibold">@stage.Name</div>
                    <div class="text-muted">Лидов: @count</div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<LeadDto> _leads = new();
    private LeadMetaDto? _meta;
    private int _companyId;

    private string _newName = string.Empty;
    private string? _newContact;
    private int _selectedSourceId;
    private int _selectedStageId;
    private string? _newComment;
    private string? _error;
    private bool _saving;
    private int _currentUserId;
    private LeadDto? _selectedLead;
    private bool _leadEditMode;
    private string _editLeadName = string.Empty;
    private string? _editLeadContact;
    private int _editLeadSourceId;
    private int _editLeadStageId;
    private string? _editLeadComment;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = state.User;
        var companyIdStr = user.FindFirst("companyId")?.Value;
        var userIdStr = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (!int.TryParse(companyIdStr, out _companyId))
        {
            _error = "Не удалось определить компанию пользователя.";
            StateHasChanged();
            return;
        }
        if (!int.TryParse(userIdStr, out _currentUserId))
        {
            _error = "Не удалось определить пользователя.";
            StateHasChanged();
            return;
        }

        _meta = await LeadsApi.GetMetaAsync();
        await LoadLeads();
        StateHasChanged();
    }

    private async Task LoadLeads()
    {
        _leads = await LeadsApi.GetByCompanyAsync(_companyId);
    }

    private async Task SaveLead()
    {
        _error = null;

        if (string.IsNullOrWhiteSpace(_newName))
        {
            _error = "Введите название лида.";
            return;
        }
        if (_selectedSourceId == 0 || _selectedStageId == 0)
        {
            _error = "Выберите источник и стадию.";
            return;
        }

        var dto = new CreateLeadRequestDto
        {
            Name = _newName.Trim(),
            Contact = string.IsNullOrWhiteSpace(_newContact) ? null : _newContact.Trim(),
            LeadSourceId = _selectedSourceId,
            LeadStageId = _selectedStageId,
            Comment = string.IsNullOrWhiteSpace(_newComment) ? null : _newComment.Trim()
        };

        _saving = true;
        try
        {
            var result = await LeadsApi.CreateAsync(dto, _companyId, _currentUserId);
            if (result.ok)
            {
                _newName = string.Empty;
                _newContact = null;
                _newComment = null;
                _selectedSourceId = 0;
                _selectedStageId = 0;
                await LoadLeads();
                Notify.ShowSuccess("Лид создан.");
            }
            else
            {
                _error = string.IsNullOrWhiteSpace(result.error)
                    ? "Не удалось создать лид."
                    : $"Не удалось создать лид. {result.error}";
                Notify.ShowError(_error);
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            Notify.ShowError(_error);
        }
        finally
        {
            _saving = false;
        }
    }

    private void OpenLead(LeadDto l)
    {
        if (l.Id <= 0)
        {
            Notify.ShowError("Некорректный ID лида.");
            return;
        }
        _leadEditMode = false;
        _selectedLead = l;
    }

    private void CloseLead()
    {
        _leadEditMode = false;
        _selectedLead = null;
    }

    private void StartEditLead()
    {
        if (_selectedLead is null)
            return;
        _leadEditMode = true;
        _editLeadName = _selectedLead.Name;
        _editLeadContact = _selectedLead.Contact;
        _editLeadComment = _selectedLead.Comment;
        _editLeadSourceId = _meta?.Sources.FirstOrDefault(s => string.Equals(s.Name, _selectedLead.Source, StringComparison.OrdinalIgnoreCase))?.Id ?? 0;
        _editLeadStageId = _meta?.Stages.FirstOrDefault(s => string.Equals(s.Name, _selectedLead.Stage, StringComparison.OrdinalIgnoreCase))?.Id ?? 0;
    }

    private void CancelEditLead()
    {
        _leadEditMode = false;
    }

    private async Task SaveLeadChangesAsync()
    {
        if (_selectedLead is null)
            return;
        if (_selectedLead.Id <= 0)
        {
            Notify.ShowError("Не удалось обновить лид: не определён ID.");
            return;
        }
        if (string.IsNullOrWhiteSpace(_editLeadName) || _editLeadSourceId <= 0 || _editLeadStageId <= 0)
        {
            Notify.ShowWarning("Заполните название, источник и стадию.");
            return;
        }

        _saving = true;
        try
        {
            var req = new CreateLeadRequestDto
            {
                Name = _editLeadName.Trim(),
                Contact = string.IsNullOrWhiteSpace(_editLeadContact) ? null : _editLeadContact.Trim(),
                LeadSourceId = _editLeadSourceId,
                LeadStageId = _editLeadStageId,
                Comment = string.IsNullOrWhiteSpace(_editLeadComment) ? null : _editLeadComment.Trim()
            };
            var result = await LeadsApi.UpdateAsync(_selectedLead.Id, req, _companyId, _currentUserId);
            if (!result.ok)
            {
                Notify.ShowError(string.IsNullOrWhiteSpace(result.error) ? "Не удалось обновить лид." : result.error!);
                return;
            }
            await LoadLeads();
            _selectedLead = _leads.FirstOrDefault(x => x.Id == _selectedLead.Id);
            _leadEditMode = false;
            Notify.ShowSuccess("Лид обновлён.");
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteLeadAsync()
    {
        if (_selectedLead is null)
            return;
        if (_selectedLead.Id <= 0)
        {
            Notify.ShowError("Не удалось удалить лид: не определён ID.");
            return;
        }

        var result = await LeadsApi.DeleteAsync(_selectedLead.Id, _companyId);
        if (!result.ok)
        {
            Notify.ShowError(string.IsNullOrWhiteSpace(result.error) ? "Не удалось удалить лид." : result.error!);
            return;
        }

        var removedId = _selectedLead.Id;
        await LoadLeads();
        _selectedLead = null;
        _leadEditMode = false;
        Notify.ShowSuccess($"Лид #{removedId} удалён.");
    }

    private static string GetLeadStageTone(string? stage)
    {
        var s = (stage ?? string.Empty).ToLowerInvariant();
        if (s.Contains("договор") || s.Contains("успеш") || s.Contains("клиент"))
            return "success";
        if (s.Contains("потер") || s.Contains("отказ"))
            return "danger";
        if (s.Contains("нов") || s.Contains("перв"))
            return "info";
        return "primary";
    }
}

