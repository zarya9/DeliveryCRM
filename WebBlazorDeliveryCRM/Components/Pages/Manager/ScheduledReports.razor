@page "/manager/scheduled-reports"
@layout ManagerLayout
@using WebBlazorDeliveryCRM.Models
@using WebBlazorDeliveryCRM.Services
@using WebBlazorDeliveryCRM.Components.Shared
@inject ScheduledReportsApiService Api

<PageTitle>Плановые отчеты</PageTitle>

<div class="dms-page-header">
    <h1>Плановые отчеты</h1>
    <p class="subtitle">Автоматическая генерация отчетов по расписанию.</p>
</div>

<div class="dms-card mb-4">
    <h2 class="dms-card-title">Новое/обновить задание</h2>
    <div class="row g-3">
        <div class="col-md-3">
            <label class="form-label">Тип отчета</label>
            <select class="form-select" @bind="_model.ReportType">
                <option value="FINANCE">FINANCE</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Частота</label>
            <select class="form-select" @bind="_model.Frequency">
                <option value="Daily">Daily</option>
                <option value="Weekly">Weekly</option>
                <option value="Monthly">Monthly</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Время UTC</label>
            <input class="form-control" @bind="_model.TimeUtc" placeholder="06:00" />
        </div>
        <div class="col-md-3 d-flex align-items-end">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" @bind="_model.Is_active" id="jobActive" />
                <label class="form-check-label" for="jobActive">Активно</label>
            </div>
        </div>
        @if (_model.Frequency == "Weekly")
        {
            <div class="col-md-3">
                <label class="form-label">DayOfWeek (0..6)</label>
                <input class="form-control" type="number" @bind="_model.DayOfWeek" />
            </div>
        }
        @if (_model.Frequency == "Monthly")
        {
            <div class="col-md-3">
                <label class="form-label">DayOfMonth (1..28)</label>
                <input class="form-control" type="number" @bind="_model.DayOfMonth" />
            </div>
        }
        <div class="col-12">
            <button class="btn btn-primary" @onclick="Save">Сохранить</button>
        </div>
    </div>
</div>

<div class="dms-card">
    <h2 class="dms-card-title">Список заданий</h2>
    @if (_items.Count == 0)
    {
        <p class="text-muted mb-0">Заданий нет.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Тип</th>
                        <th>Частота</th>
                        <th>Время UTC</th>
                        <th>Next run</th>
                        <th>Last run</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var j in _items)
                    {
                        <tr>
                            <td>@j.ID_ScheduledReportJob</td>
                            <td>@j.ReportType</td>
                            <td><StatusBadge Text="@j.Frequency" Tone="info" /></td>
                            <td>@j.TimeUtc</td>
                            <td>@j.NextRun_at.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@(j.LastRun_at?.ToString("dd.MM.yyyy HH:mm") ?? "—")</td>
                            <td class="text-end">
                                <StatusBadge Text="@(j.Is_active ? "Активно" : "Пауза")" Tone="@(j.Is_active ? "success" : "neutral")" />
                                <button class="btn btn-outline-secondary btn-sm me-2" @onclick="() => Edit(j)">Изменить</button>
                                <button class="btn btn-outline-primary btn-sm" @onclick="() => RunNow(j.ID_ScheduledReportJob)">Запустить</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private readonly UpsertScheduledReportJobRequestDto _model = new();
    private List<ScheduledReportJobDto> _items = new();

    protected override async Task OnInitializedAsync()
    {
        await Reload();
    }

    private async Task Reload()
    {
        _items = await Api.GetMineAsync();
        StateHasChanged();
    }

    private async Task Save()
    {
        await Api.UpsertAsync(_model);
        await Reload();
    }

    private void Edit(ScheduledReportJobDto j)
    {
        _model.JobId = j.ID_ScheduledReportJob;
        _model.ReportType = j.ReportType;
        _model.Frequency = j.Frequency;
        _model.TimeUtc = j.TimeUtc;
        _model.DayOfWeek = j.DayOfWeek;
        _model.DayOfMonth = j.DayOfMonth;
        _model.Is_active = j.Is_active;
    }

    private async Task RunNow(int id)
    {
        await Api.RunNowAsync(id);
        await Reload();
    }
}
