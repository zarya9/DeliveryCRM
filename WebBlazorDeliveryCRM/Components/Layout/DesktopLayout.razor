@implements IDisposable
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject ChatUnreadStateService ChatUnreadState

<div class="desktop-layout">
    <aside class="desktop-sidebar">
        @SidebarContent
    </aside>
    <main class="desktop-main">
        <div class="desktop-main-inner">
            <AppBar />
            <ErrorBoundary @ref="_errorBoundary">
                <ChildContent>
                    @ChildContent
                </ChildContent>
                <ErrorContent>
                    <div class="alert alert-danger">
                        Произошла ошибка при открытии страницы. Попробуйте перейти в раздел еще раз.
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </div>
    </main>
</div>
@if (_mobileNavItems.Count > 0)
{
    <nav class="mobile-nav dms-mobile-nav">
        @foreach (var item in _mobileNavItems)
        {
            <NavLink href="@item.Href" class="mobile-nav-item" Match="@(item.Exact ? NavLinkMatch.All : NavLinkMatch.Prefix)" title="@item.Text" aria-label="@item.Text">
                <span class="mobile-nav-icon-slot mobile-nav-icon-slot--with-badge">
                    <HugeIcon Name="@item.Icon" CssClass="mobile-nav-icon" />
                    @if (_mobileChatUnread > 0 && string.Equals(item.Icon, "message-01", StringComparison.OrdinalIgnoreCase))
                    {
                        <span class="mobile-nav-badge" aria-label="Непрочитанные сообщения">@(_mobileChatUnread > 99 ? "99+" : _mobileChatUnread.ToString())</span>
                    }
                </span>
                <span class="visually-hidden">@item.Text</span>
            </NavLink>
        }
    </nav>
}
<BlazoredToasts />
<GlobalNotificationToasts />

@code {
    private ErrorBoundary? _errorBoundary;
    private List<MobileNavItem> _mobileNavItems = new();
    private int _mobileChatUnread;

    [Parameter]
    public RenderFragment? SidebarContent { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        ChatUnreadState.Changed += OnChatUnreadChanged;
        await ChatUnreadState.RefreshAsync();
        _mobileChatUnread = ChatUnreadState.TotalChatUnreadCount;
        await RefreshMobileNavAsync();
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _errorBoundary?.Recover();
        await RefreshMobileNavAsync();
        InvokeAsync(StateHasChanged);
    }

    private async Task RefreshMobileNavAsync()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Trim().ToLowerInvariant();
        if (string.IsNullOrWhiteSpace(path))
            path = "home";
        var role = await ResolveRoleAsync();
        _mobileNavItems = BuildMobileNav(path, role);
    }

    private void OnChatUnreadChanged()
    {
        _mobileChatUnread = ChatUnreadState.TotalChatUnreadCount;
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task<string?> ResolveRoleAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = state.User;
        return user.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
               ?? user.FindFirst("role")?.Value
               ?? user.FindFirst("http://schemas.microsoft.com/ws/2008/06/identity/claims/role")?.Value;
    }

    private static List<MobileNavItem> BuildMobileNav(string path, string? role)
    {
        if (path.StartsWith("courier"))
            return
            [
                new("/courier/shift", "calendar-03", "Смена", true),
                new("/courier/route", "route-02", "Маршрут", false),
                new("/courier/orders", "invoice-01", "Заказы", false),
                new("/courier/chat", "message-01", "Чат", false),
                new("/courier/profile", "user-03", "Профиль", false)
            ];
        if (path.StartsWith("logistician"))
            return
            [
                new("/logistician", "dashboard-square-01", "Главная", true),
                new("/logistician/shifts", "calendar-03", "Смены", false),
                new("/logistician/monitoring", "maps-location-01", "Карта", false),
                new("/logistician/chat", "message-01", "Чат", false),
                new("/logistician/profile", "user-03", "Профиль", false)
            ];
        if (path.StartsWith("manager") || role is "Менеджер" or "Админ" or "Администратор")
            return
            [
                new("/manager", "dashboard-square-01", "Главная", true),
                new("/manager/orders", "invoice-01", "Заказы", false),
                new("/manager/employees", "user-group", "Команда", false),
                new("/manager/chat", "message-01", "Чат", false),
                new("/manager/profile", "user-03", "Профиль", false)
            ];
        if (path.StartsWith("customer") || role == "Клиент")
            return
            [
                new("/customer", "home-01", "Главная", true),
                new("/customer/orders", "invoice-01", "Заказы", false),
                new("/customer/tracking", "maps-location-01", "Трекинг", false),
                new("/customer/chat", "message-01", "Чат", false),
                new("/customer/profile", "user-03", "Профиль", false)
            ];
        return new List<MobileNavItem>();
    }

    private sealed record MobileNavItem(string Href, string Icon, string Text, bool Exact);

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        ChatUnreadState.Changed -= OnChatUnreadChanged;
    }
}
