@inject AuthenticationStateProvider AuthStateProvider
@inject CustomAuthenticationStateProvider AuthState
@inject ChatHubClientService ChatHub
@inject ChatApiService ChatApi
@inject ChatUnreadStateService ChatUnreadState
@inject AppNotificationService Notify
@inject NavigationManager Navigation
@inject IJSRuntime JS
@using WebBlazorDeliveryCRM.Components.Shared
@using System.Security.Claims

<div class="dms-appbar">
    <a href="/" class="dms-appbar-logo">@DisplayTitle</a>
    <div class="dms-appbar-actions">
        <div style="position: relative;">
            <button type="button" class="dms-btn-outline" @onclick="ToggleUiSettings" title="Вид" aria-label="Вид">
                <HugeIcon Name="settings-01" CssClass="dms-icon me-1" />
                <span class="dms-btn-text">Вид</span>
            </button>
            @if (_showUiSettings)
            {
                <div class="ui-settings-popover">
                    <div class="ui-settings-row">
                        <label class="form-label mb-1">Акцентный цвет</label>
                        <input type="color" class="form-control form-control-color" @bind="_uiAccent" />
                    </div>
                    <div class="ui-settings-row">
                        <label class="form-label mb-1">Фон</label>
                        <select class="form-select form-select-sm" @bind="_uiBackground">
                            <option value="plain">Обычный</option>
                            <option value="grid">Сетка</option>
                            <option value="dots">Точки</option>
                            <option value="gradient">Градиент</option>
                        </select>
                    </div>
                    <div class="ui-settings-row">
                        <label class="form-label mb-1">Скругление карточек</label>
                        <input type="range" class="form-range" min="8" max="24" step="1" @bind="_uiRadius" />
                        <div class="small text-muted">@_uiRadius px</div>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-sm btn-primary" @onclick="ApplyUiSettings">Применить</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ResetUiSettings">Сброс</button>
                    </div>
                </div>
            }
        </div>
        <button type="button" class="dms-btn-outline theme-toggle-btn" @onclick="ToggleTheme" title="Сменить тему">
            <HugeIcon Name="@ThemeIconName" CssClass="dms-icon" />
            <span class="dms-btn-text">@(_theme == "dark" ? "Светлая" : "Тёмная")</span>
        </button>
        @if (_isAuthenticated)
        {
            <a href="@ProfileHref" class="dms-btn-outline dms-icon-btn" title="Профиль" aria-label="Профиль">
                <HugeIcon Name="user-03" CssClass="dms-icon" />
            </a>
            <a href="@NotificationsHref" class="dms-btn-outline dms-icon-btn" title="Уведомления" aria-label="Уведомления">
                <HugeIcon Name="notification-01" CssClass="dms-icon" />
            </a>
            <button type="button" class="dms-btn-outline" @onclick="Logout" title="Выйти" aria-label="Выйти">
                <HugeIcon Name="logout-01" CssClass="dms-icon me-1" />
                <span class="dms-btn-text">Выйти</span>
            </button>
        }
        else
        {
            <a href="/" class="dms-btn-outline" title="Войти" aria-label="Войти">
                <HugeIcon Name="user-03" CssClass="dms-icon me-1" />
                <span class="dms-btn-text">Войти</span>
            </a>
        }
    </div>
</div>

@code {
    private bool _isAuthenticated;
    private string? _companyName;
    private string? _role;
    private string _theme = "light";
    private string ThemeIconName => _theme == "dark" ? "sun-03" : "moon-02";
    private string DisplayTitle =>
        ResolveDisplayTitle(_companyName, _role);
    private string NotificationsHref => _role switch
    {
        "Клиент" => "/customer/notifications",
        "Курьер" => "/courier/notifications",
        _ => "/manager/notifications"
    };
    private string ProfileHref => _role switch
    {
        "Клиент" => "/customer/profile",
        "Курьер" => "/courier/profile",
        "Логист" => "/logistician/profile",
        "Менеджер" => "/manager/profile",
        "Админ" or "Администратор" => "/manager/profile",
        _ => "/customer/profile"
    };
    private bool _showUiSettings;
    private string _uiAccent = "#008b8b";
    private string _uiBackground = "plain";
    private string _uiRadius = "12";
    private int _currentUserId;
    private Dictionary<int, string> _roomKinds = new();
    private bool _chatHandlersAttached;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _theme = await JS.InvokeAsync<string>("dmsTheme.get");
            var settings = await JS.InvokeAsync<UiSettingsDto>("dmsTheme.getSettings");
            _uiAccent = string.IsNullOrWhiteSpace(settings.Accent) ? "#008b8b" : settings.Accent;
            _uiBackground = string.IsNullOrWhiteSpace(settings.Background) ? "plain" : settings.Background;
            _uiRadius = string.IsNullOrWhiteSpace(settings.Radius) ? "12" : settings.Radius;
        }
        catch
        {
            _theme = "light";
        }
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        _isAuthenticated = state.User.Identity?.IsAuthenticated ?? false;
        var user = state.User;
        _companyName = user.FindFirst("company")?.Value;
        _role = user.FindFirst(ClaimTypes.Role)?.Value
             ?? user.FindFirst("role")?.Value
             ?? user.FindFirst("http://schemas.microsoft.com/ws/2008/06/identity/claims/role")?.Value;
        _ = int.TryParse(user.FindFirst(ClaimTypes.NameIdentifier)?.Value, out _currentUserId);

        if (_isAuthenticated)
        {
            try
            {
                await ChatHub.StartAsync();
                await RefreshRoomKindsAsync();
                await ChatUnreadState.RefreshAsync();
                AttachChatHandlers();
            }
            catch
            {
                // SignalR не обязателен для отображения страницы
            }
        }

        StateHasChanged();
    }

    private async Task ToggleTheme()
    {
        try
        {
            _theme = await JS.InvokeAsync<string>("dmsTheme.toggle");
            StateHasChanged();
        }
        catch
        {
            // ignore theme toggle JS failures
        }
    }

    private void ToggleUiSettings()
    {
        _showUiSettings = !_showUiSettings;
    }

    private async Task ApplyUiSettings()
    {
        try
        {
            await JS.InvokeVoidAsync("dmsTheme.applySettings", new
            {
                accent = _uiAccent,
                background = _uiBackground,
                radius = _uiRadius
            });
            _showUiSettings = false;
        }
        catch
        {
            // ignore JS settings errors
        }
    }

    private async Task ResetUiSettings()
    {
        try
        {
            var settings = await JS.InvokeAsync<UiSettingsDto>("dmsTheme.resetSettings");
            _uiAccent = string.IsNullOrWhiteSpace(settings.Accent) ? "#008b8b" : settings.Accent;
            _uiBackground = string.IsNullOrWhiteSpace(settings.Background) ? "plain" : settings.Background;
            _uiRadius = string.IsNullOrWhiteSpace(settings.Radius) ? "12" : settings.Radius;
            _showUiSettings = false;
        }
        catch
        {
            // ignore JS settings errors
        }
    }

    private async Task Logout()
    {
        try
        {
            await ChatHub.StopAsync();
        }
        catch { /* ignore */ }

        await AuthState.MarkUserAsLoggedOutAsync();
        Navigation.NavigateTo("/login", forceLoad: true, replace: true);
    }

    private void AttachChatHandlers()
    {
        if (_chatHandlersAttached || ChatHub.Connection is null)
            return;

        ChatHub.Connection.On<IncomingChatSignal>("ReceiveMessage", payload =>
        {
            return InvokeAsync(async () =>
            {
                if (payload.senderId == _currentUserId)
                    return;

                if (IsDirectRoom(payload.chatRoomId))
                {
                    var sender = string.IsNullOrWhiteSpace(payload.senderName) ? "Сотрудник" : payload.senderName!;
                    Notify.ShowInfo($"Новое личное сообщение от {sender}.", pushWhenHidden: true);
                }

                await ChatUnreadState.RefreshAsync();
            });
        });

        ChatHub.Connection.On<IncomingNotificationSignal>("NotificationReceived", payload =>
        {
            return InvokeAsync(() =>
            {
                var title = string.IsNullOrWhiteSpace(payload.title) ? "Уведомление" : payload.title!;
                var body = string.IsNullOrWhiteSpace(payload.message) ? "Новое событие в системе." : payload.message!;
                Notify.ShowInfo($"{title}: {body}", pushWhenHidden: true);
            });
        });

        _chatHandlersAttached = true;
    }

    private bool IsDirectRoom(int roomId)
        => string.Equals(_roomKinds.GetValueOrDefault(roomId, "company"), "direct", StringComparison.OrdinalIgnoreCase);

    private async Task RefreshRoomKindsAsync()
    {
        var rooms = await ChatApi.GetRoomsListAsync();
        _roomKinds = rooms.ToDictionary(x => x.ChatRoomId, x => x.RoomKind ?? "company");
    }

    private sealed class UiSettingsDto
    {
        public string Accent { get; set; } = string.Empty;
        public string Background { get; set; } = "plain";
        public string Radius { get; set; } = "12";
    }

    private sealed class IncomingChatSignal
    {
        public int chatRoomId { get; set; }
        public int senderId { get; set; }
        public string? senderName { get; set; }
    }

    private sealed class IncomingNotificationSignal
    {
        public int id { get; set; }
        public string? title { get; set; }
        public string? message { get; set; }
    }

    private static string ResolveDisplayTitle(string? companyName, string? role)
    {
        var name = (companyName ?? string.Empty).Trim();
        if (!string.IsNullOrWhiteSpace(name) &&
            !string.Equals(name, "Default Company", StringComparison.OrdinalIgnoreCase))
            return name;

        return role switch
        {
            "Клиент" => "Клиентский кабинет",
            "Курьер" => "Курьерский контур",
            "Менеджер" => "Панель менеджера",
            "Логист" => "Панель логиста",
            "Админ" or "Администратор" => "Панель администратора",
            _ => "Delivery CRM"
        };
    }
}
